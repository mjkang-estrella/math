To state the result, for <math id="S1.p7.m2" class="ltx_Math" alttext="\bm{\lambda},\bm{\mu}\in\mathbb{R}^{V(G)}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝝀</mi><mo>,</mo><mi>𝝁</mi></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">\bm{\lambda},\bm{\mu}\in\mathbb{R}^{V(G)}</annotation></semantics></math>, let</p>
<table id="S1.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S1.Ex4.m1" class="ltx_Math" alttext="Z_{G}^{(2)}(\bm{\lambda},\bm{\mu})\coloneqq\sum_{\begin{subarray}{c}I,J\in\mathcal{I}(G)\\
I\cap J=\emptyset\end{subarray}}\prod_{v\in I}\lambda_{v}\prod_{u\in J}\mu_{u}" display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>Z</mi><mi>G</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝝀</mi><mo>,</mo><mi>𝝁</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">≔</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mrow><mi>I</mi><mo>,</mo><mi>J</mi></mrow><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mi>I</mi><mo>∩</mo><mi>J</mi></mrow><mo>=</mo><mi mathvariant="normal">∅</mi></mrow></mtd></mtr></mtable></munder><mrow><munder><mo movablelimits="false">∏</mo><mrow><mi>v</mi><mo>∈</mo><mi>I</mi></mrow></munder><mrow><msub><mi>λ</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∏</mo><mrow><mi>u</mi><mo>∈</mo><mi>J</mi></mrow></munder><msub><mi>μ</mi><mi>u</mi></msub></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">Z_{G}^{(2)}(\bm{\lambda},\bm{\mu})\coloneqq\sum_{\begin{subarray}{c}I,J\in\mathcal{I}(G)\\
I\cap J=\emptyset\end{subarray}}\prod_{v\in I}\lambda_{v}\prod_{u\in J}\mu_{u}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S1.p7.2" class="ltx_p">and write <math id="S1.p7.m3" class="ltx_Math" alttext="Z_{G}^{(2)}(\lambda,\mu)=Z_{G}^{(2)}(\lambda\mathbf{1},\mu\mathbf{1})" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>Z</mi><mi>G</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>Z</mi><mi>G</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mn>𝟏</mn></mrow><mo>,</mo><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mn>𝟏</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Z_{G}^{(2)}(\lambda,\mu)=Z_{G}^{(2)}(\lambda\mathbf{1},\mu\mathbf{1})</annotation></semantics></math>, where <math id="S1.p7.m4" class="ltx_Math" alttext="\mathbf{1}=(1,1,\dots,1)" display="inline" intent=":literal"><semantics><mrow><mn>𝟏</mn><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{1}=(1,1,\dots,1)</annotation></semantics></math>.
In particular, <math id="S1.p7.m5" class="ltx_Math" alttext="Z_{G}^{(2)}(1,1)=\hom(G,K_{3}^{\circ})" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>Z</mi><mi>G</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>hom</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><msubsup><mi>K</mi><mn>3</mn><mo>∘</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Z_{G}^{(2)}(1,1)=\hom(G,K_{3}^{\circ})</annotation></semantics></math>. This corresponds to the number of <em id="S1.p7.2.1" class="ltx_emph ltx_font_italic">semiproper colourings</em> with two proper colours, i.e., the vertex colouring using two ‘proper’ colours that cannot make an edge monochromatic and one ‘free’ colour that can be used with no restrictions.
Furthermore, <math id="S1.p7.m6" class="ltx_Math" alttext="Z_{G}^{(2)}(\lambda,\mu)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>Z</mi><mi>G</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Z_{G}^{(2)}(\lambda,\mu)</annotation></semantics></math>, <math id="S1.p7.m7" class="ltx_Math" alttext="\lambda,\mu&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>λ</mi><mo>,</mo><mi>μ</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda,\mu&gt;0</annotation></semantics></math>, counts <math id="S1.p7.m8" class="ltx_Math" alttext="\hom(G,H)" display="inline" intent=":literal"><semantics><mrow><mi>hom</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hom(G,H)</annotation></semantics></math>, where <math id="S1.p7.m9" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> is obtained by blowing up vertices of <math id="S1.p7.m10" class="ltx_Math" alttext="K_{3}^{\circ}" display="inline" intent=":literal"><semantics><msubsup><mi>K</mi><mn>3</mn><mo>∘</mo></msubsup><annotation encoding="application/x-tex">K_{3}^{\circ}</annotation></semantics></math> in an appropriate way. For instance, adjusting <math id="S1.p7.m11" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> and <math id="S1.p7.m12" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math> gives a semiproper colouring with two proper colours and multiple free colours as well.
Our second main result is the following.</p>
</div>
<div id="S1.Thmtheorem4" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S1.Thmtheorem4.2" class="ltx_text ltx_font_bold">Theorem 1.4</span></span><span id="S1.Thmtheorem4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S1.Thmtheorem4.p1" class="ltx_para">
<p id="S1.Thmtheorem4.p1.1" class="ltx_p"><span id="S1.Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S1.Thmtheorem4.p1.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> be a graph and let <math id="S1.Thmtheorem4.p1.m2" class="ltx_Math" alttext="\lambda_{v}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mi>v</mi></msub><annotation encoding="application/x-tex">\lambda_{v}</annotation></semantics></math> and <math id="S1.Thmtheorem4.p1.m3" class="ltx_Math" alttext="\mu_{v}" display="inline" intent=":literal"><semantics><msub><mi>μ</mi><mi>v</mi></msub><annotation encoding="application/x-tex">\mu_{v}</annotation></semantics></math>, <math id="S1.Thmtheorem4.p1.m4" class="ltx_Math" alttext="v\in V(G)" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">v\in V(G)</annotation></semantics></math>, be nonnegative reals. Then</span></p>
<table id="S1.E3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S1.E3.m1" class="ltx_Math" alttext="Z_{G}^{(2)}(\bm{\lambda},\bm{\mu})\geq\prod_{v\in V(G)}Z_{K_{d_{v}+1}}^{(2)}(\lambda_{v},\mu_{v})^{\frac{1}{d_{v}+1}}=\prod_{v\in V(G)}\big((d_{v}+1)d_{v}\lambda_{v}\mu_{v}+(d_{v}+1)(\lambda_{v}+\mu_{v})+1\big)^{\frac{1}{d_{v}+1}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>Z</mi><mi>G</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝝀</mi><mo>,</mo><mi>𝝁</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">≥</mo><mrow><munder><mo movablelimits="false">∏</mo><mrow><mi>v</mi><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><msubsup><mi>Z</mi><msub><mi>K</mi><mrow><msub><mi>d</mi><mi>v</mi></msub><mo>+</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>v</mi></msub><mo>,</mo><msub><mi>μ</mi><mi>v</mi></msub><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mrow><msub><mi>d</mi><mi>v</mi></msub><mo>+</mo><mn>1</mn></mrow></mfrac></msup></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false" rspace="0em">∏</mo><mrow><mi>v</mi><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>d</mi><mi>v</mi></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mi>v</mi></msub></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>d</mi><mi>v</mi></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>λ</mi><mi>v</mi></msub><mo>+</mo><msub><mi>μ</mi><mi>v</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mfrac><mn>1</mn><mrow><msub><mi>d</mi><mi>v</mi></msub><mo>+</mo><mn>1</mn></mrow></mfrac></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Z_{G}^{(2)}(\bm{\lambda},\bm{\mu})\geq\prod_{v\in V(G)}Z_{K_{d_{v}+1}}^{(2)}(\lambda_{v},\mu_{v})^{\frac{1}{d_{v}+1}}=\prod_{v\in V(G)}\big((d_{v}+1)d_{v}\lambda_{v}\mu_{v}+(d_{v}+1)(\lambda_{v}+\mu_{v})+1\big)^{\frac{1}{d_{v}+1}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(1.3)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="S1.p8" class="ltx_para">
<p id="S1.p8.1" class="ltx_p">Although letting <math id="S1.p8.m1" class="ltx_Math" alttext="\mu_{v}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>μ</mi><mi>v</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mu_{v}=0</annotation></semantics></math> for all <math id="S1.p8.m2" class="ltx_Math" alttext="v\in V(G)" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">v\in V(G)</annotation></semantics></math> reproves <a href="#S1.Thmtheorem1" title="Theorem 1.1. ‣ 1 Introduction ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">1.1</span></a>, we shall give independent proofs for each of the results.</p>
</div>
<div id="S1.p9" class="ltx_para">
<p id="S1.p9.1" class="ltx_p">As an application of our main results, we give lower bounds slightly weaker than (<a href="#S1.E2" title="Equation 1.2 ‣ Conjecture 1.3. ‣ 1 Introduction ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.2</span></a>) for semiproper colouring partition functions with <math id="S1.p9.m1" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> proper colours, <math id="S1.p9.m2" class="ltx_Math" alttext="q&gt;2" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>&gt;</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">q&gt;2</annotation></semantics></math>, which can be seen as an ‘approximate version’ of <a href="#S1.Thmtheorem3" title="Conjecture 1.3. ‣ 1 Introduction ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Conjecture</span> <span class="ltx_text ltx_ref_tag">1.3</span></a> for semiproper colourings; see <a href="#S4.Thmtheorem3" title="Theorem 4.3. ‣ 4 More towards ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">4.3</span></a>. Moreover, we also settle the conjecture for the case <math id="S1.p9.m3" class="ltx_Math" alttext="\Delta(G)\leq 2" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\Delta(G)\leq 2</annotation></semantics></math>, where <math id="S1.p9.m4" class="ltx_Math" alttext="\Delta(G)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta(G)</annotation></semantics></math> is the maximum degree of <math id="S1.p9.m5" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>; see <a href="#S4.Thmtheorem1" title="Theorem 4.1. ‣ 4 More towards ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">4.1</span></a>.</p>
</div>
<div id="S1.p10" class="ltx_para">
<p id="S1.p10.1" class="ltx_p">An interesting feature of <a href="#S1.Thmtheorem1" title="Theorem 1.1. ‣ 1 Introduction ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorems</span> <span class="ltx_text ltx_ref_tag">1.1</span></a> and <a href="#S1.Thmtheorem4" title="Theorem 1.4. ‣ 1 Introduction ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.4</span></a> is that the key steps in both proofs were obtained, at least in part, by using <em id="S1.p10.1.1" class="ltx_emph ltx_font_italic">Aletheia</em>, a mathematics research agent built upon Gemini Deep Think at Google DeepMind, under the lead of Tony Feng.
We will point out these points of contribution where they arise.
We also refer to <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib2" title="" class="ltx_ref">11</a>]</cite> for more details of the development of <em id="S1.p10.1.2" class="ltx_emph ltx_font_italic">Aletheia</em> and its applications to various problems.</p>
</div>
<div id="S1.p11" class="ltx_para">
<p id="S1.p11.1" class="ltx_p">We also formalised the proof of <a href="#S1.Thmtheorem4" title="Theorem 1.4. ‣ 1 Introduction ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">1.4</span></a> in the Lean 4 proof assistant using Harmonic Aristotle <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib20" title="" class="ltx_ref">1</a>]</cite>. The resulting Lean files are available in the second author’s GitHub repository <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib21" title="" class="ltx_ref">19</a>]</cite>.</p>
</div>
</section>
<section id="S2" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">2 </span>Multivariate independence polynomials</h2>

<div id="S2.p1" class="ltx_para">
<p id="S2.p1.1" class="ltx_p">The starting point of our proof of <a href="#S1.Thmtheorem1" title="Theorem 1.1. ‣ 1 Introduction ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">1.1</span></a> is the standard vertex-deletion recurrence for the independence polynomial. Namely, for a graph <math id="S2.p1.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> and its vertex <math id="S2.p1.m2" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math>, conditioning on whether <math id="S2.p1.m3" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math> is occupied,</p>
<table id="S2.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex1.m1" class="ltx_Math" alttext="Z_{G}(\lambda)=Z_{G\setminus w}(\lambda)+\lambda Z_{G\setminus(\{w\}\cup N(w))}(\lambda)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>Z</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>Z</mi><mrow><mi>G</mi><mo>∖</mo><mi>w</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>Z</mi><mrow><mi>G</mi><mo>∖</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">{</mo><mi>w</mi><mo stretchy="false">}</mo></mrow><mo>∪</mo><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">Z_{G}(\lambda)=Z_{G\setminus w}(\lambda)+\lambda Z_{G\setminus(\{w\}\cup N(w))}(\lambda),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p1.2" class="ltx_p">where <math id="S2.p1.m4" class="ltx_Math" alttext="N(w)" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">N(w)</annotation></semantics></math> is the set of neighbours of <math id="S2.p1.m5" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math> in <math id="S2.p1.m6" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>. Equivalently, in the multivariate setting, deleting <math id="S2.p1.m7" class="ltx_Math" alttext="N(w)" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">N(w)</annotation></semantics></math> is the same as setting <math id="S2.p1.m8" class="ltx_Math" alttext="\lambda_{v}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>v</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda_{v}=0</annotation></semantics></math> for each <math id="S2.p1.m9" class="ltx_Math" alttext="v\in N(w)" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">v\in N(w)</annotation></semantics></math>.
This recurrence and its variants have been used in several places to bound the number of independent sets <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib7" title="" class="ltx_ref">13</a>, <a href="#bib.bib6" title="" class="ltx_ref">17</a>, <a href="#bib.bib12" title="" class="ltx_ref">18</a>, <a href="#bib.bib18" title="" class="ltx_ref">2</a>]</cite>, and it also underlies inductive lower bounds on the independence number <math id="S2.p1.m10" class="ltx_Math" alttext="\alpha(G)" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha(G)</annotation></semantics></math> (see, e.g., <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib19" title="" class="ltx_ref">20</a>]</cite>).</p>
</div>
<div id="S2.p2" class="ltx_para">
<p id="S2.p2.1" class="ltx_p">Let us formalise this inductive idea. First, both sides of (<a href="#S1.E1" title="Equation 1.1 ‣ Theorem 1.1. ‣ 1 Introduction ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.1</span></a>) factor over connected components of <math id="S2.p2.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>, so we may assume that <math id="S2.p2.m2" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> is connected.
For a graph <math id="S2.p2.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> and <math id="S2.p2.m4" class="ltx_Math" alttext="\bm{\lambda}=(\lambda_{v})_{v\in V(G)}" display="inline" intent=":literal"><semantics><mrow><mi>𝝀</mi><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>v</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>v</mi><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\bm{\lambda}=(\lambda_{v})_{v\in V(G)}</annotation></semantics></math>, let</p>
<table id="S2.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex2.m1" class="ltx_Math" alttext="Z^{-}_{G}(\bm{\lambda})\coloneqq\prod_{v\in V(G)}Z_{K_{d_{v}+1}}(\lambda_{v})^{\frac{1}{d_{v}+1}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>Z</mi><mi>G</mi><mo>−</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝝀</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">≔</mo><mrow><munder><mo movablelimits="false">∏</mo><mrow><mi>v</mi><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><msub><mi>Z</mi><msub><mi>K</mi><mrow><msub><mi>d</mi><mi>v</mi></msub><mo>+</mo><mn>1</mn></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>v</mi></msub><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mrow><msub><mi>d</mi><mi>v</mi></msub><mo>+</mo><mn>1</mn></mrow></mfrac></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Z^{-}_{G}(\bm{\lambda})\coloneqq\prod_{v\in V(G)}Z_{K_{d_{v}+1}}(\lambda_{v})^{\frac{1}{d_{v}+1}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p2.2" class="ltx_p">Then <a href="#S1.Thmtheorem1" title="Theorem 1.1. ‣ 1 Introduction ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">1.1</span></a> states that <math id="S2.p2.m5" class="ltx_Math" alttext="Z_{G}(\bm{\lambda})\geq Z^{-}_{G}(\bm{\lambda})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>Z</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝝀</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><msubsup><mi>Z</mi><mi>G</mi><mo>−</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝝀</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Z_{G}(\bm{\lambda})\geq Z^{-}_{G}(\bm{\lambda})</annotation></semantics></math> for all <math id="S2.p2.m6" class="ltx_Math" alttext="\bm{\lambda}\in(\mathbb{R}_{\geq 0})^{V(G)}" display="inline" intent=":literal"><semantics><mrow><mi>𝝀</mi><mo>∈</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>ℝ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">\bm{\lambda}\in(\mathbb{R}_{\geq 0})^{V(G)}</annotation></semantics></math>.
We use induction on <math id="S2.p2.m7" class="ltx_Math" alttext="\lvert V(G)\rvert" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">\lvert V(G)\rvert</annotation></semantics></math> to prove this inequality, where the base case <math id="S2.p2.m8" class="ltx_Math" alttext="\lvert V(G)\rvert=1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\lvert V(G)\rvert=1</annotation></semantics></math> is clear.</p>
</div>
<div id="S2.p3" class="ltx_para">
<p id="S2.p3.1" class="ltx_p">Let <math id="S2.p3.m1" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math> be a vertex in <math id="S2.p3.m2" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> with maximum degree <math id="S2.p3.m3" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math>. Fix <math id="S2.p3.m4" class="ltx_Math" alttext="\bm{\lambda}=(\lambda_{v})_{v\in V(G)}\in(\mathbb{R}_{\geq 0})^{V(G)}" display="inline" intent=":literal"><semantics><mrow><mi>𝝀</mi><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>v</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>v</mi><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo>∈</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>ℝ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">\bm{\lambda}=(\lambda_{v})_{v\in V(G)}\in(\mathbb{R}_{\geq 0})^{V(G)}</annotation></semantics></math> and let <math id="S2.p3.m5" class="ltx_Math" alttext="\bm{\lambda}^{\prime}\coloneqq(\lambda_{v})_{v\in V(G\setminus w)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝝀</mi><mo>′</mo></msup><mo>≔</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>v</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>v</mi><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>G</mi><mo>∖</mo><mi>w</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\bm{\lambda}^{\prime}\coloneqq(\lambda_{v})_{v\in V(G\setminus w)}</annotation></semantics></math>. We begin with the multivariate recursive expression</p>
<table id="S2.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex3.m1" class="ltx_Math" alttext="Z_{G}(\bm{\lambda})=Z_{G\setminus w}(\bm{\lambda}^{\prime})+\lambda_{w}Z_{G\setminus w}(\bm{\lambda}^{\prime})|_{\lambda_{v}=0,\,v\in N(w)}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>Z</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝝀</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>Z</mi><mrow><mi>G</mi><mo>∖</mo><mi>w</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝀</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mrow><mrow><msub><mi>λ</mi><mi>w</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>Z</mi><mrow><mi>G</mi><mo>∖</mo><mi>w</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝀</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mrow><mrow><msub><mi>λ</mi><mi>v</mi></msub><mo>=</mo><mn>0</mn></mrow><mo rspace="0.337em">,</mo><mrow><mi>v</mi><mo>∈</mo><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Z_{G}(\bm{\lambda})=Z_{G\setminus w}(\bm{\lambda}^{\prime})+\lambda_{w}Z_{G\setminus w}(\bm{\lambda}^{\prime})|_{\lambda_{v}=0,\,v\in N(w)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p3.2" class="ltx_p">By the induction hypothesis, it suffices to show that</p>
<table id="S2.E1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E1.m1" class="ltx_Math" alttext="Z^{-}_{G\setminus w}(\bm{\lambda}^{\prime})+\lambda_{w}Z^{-}_{G\setminus w}(\bm{\lambda}^{\prime})|_{\lambda_{v}=0,v\in N(w)}\geq Z^{-}_{G}(\bm{\lambda})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msubsup><mi>Z</mi><mrow><mi>G</mi><mo>∖</mo><mi>w</mi></mrow><mo>−</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝀</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mrow><mrow><msub><mi>λ</mi><mi>w</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>Z</mi><mrow><mi>G</mi><mo>∖</mo><mi>w</mi></mrow><mo>−</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝀</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mrow><mrow><msub><mi>λ</mi><mi>v</mi></msub><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mrow><mi>v</mi><mo>∈</mo><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></msub></mrow><mo>≥</mo><mrow><msubsup><mi>Z</mi><mi>G</mi><mo>−</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝝀</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Z^{-}_{G\setminus w}(\bm{\lambda}^{\prime})+\lambda_{w}Z^{-}_{G\setminus w}(\bm{\lambda}^{\prime})|_{\lambda_{v}=0,v\in N(w)}\geq Z^{-}_{G}(\bm{\lambda}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(2.1)</span></td></tr></tbody>
</table>
<p id="S2.p3.3" class="ltx_p">The definition gives</p>
<table id="S2.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex4.m1" class="ltx_Math" alttext="Z^{-}_{G\setminus w}(\bm{\lambda}^{\prime})=\prod_{v\in N(w)}Z_{K_{d_{v}}}(\lambda_{v})^{\frac{1}{d_{v}}}\prod_{v\in V(G)\setminus(\{w\}\cup N(w))}Z_{K_{d_{v}+1}}(\lambda_{v})^{\frac{1}{d_{v}+1}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>Z</mi><mrow><mi>G</mi><mo>∖</mo><mi>w</mi></mrow><mo>−</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝀</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∏</mo><mrow><mi>v</mi><mo>∈</mo><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><msub><mi>Z</mi><msub><mi>K</mi><msub><mi>d</mi><mi>v</mi></msub></msub></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>v</mi></msub><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><msub><mi>d</mi><mi>v</mi></msub></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∏</mo><mrow><mi>v</mi><mo>∈</mo><mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∖</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">{</mo><mi>w</mi><mo stretchy="false">}</mo></mrow><mo>∪</mo><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><msub><mi>Z</mi><msub><mi>K</mi><mrow><msub><mi>d</mi><mi>v</mi></msub><mo>+</mo><mn>1</mn></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>v</mi></msub><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mrow><msub><mi>d</mi><mi>v</mi></msub><mo>+</mo><mn>1</mn></mrow></mfrac></msup></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">Z^{-}_{G\setminus w}(\bm{\lambda}^{\prime})=\prod_{v\in N(w)}Z_{K_{d_{v}}}(\lambda_{v})^{\frac{1}{d_{v}}}\prod_{v\in V(G)\setminus(\{w\}\cup N(w))}Z_{K_{d_{v}+1}}(\lambda_{v})^{\frac{1}{d_{v}+1}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p3.4" class="ltx_p">so after removing the common factor <math id="S2.p3.m6" class="ltx_Math" alttext="\prod\limits_{v\in V(G)\setminus(\{w\}\cup N(w))}Z_{K_{d_{v}+1}}(\lambda_{v})^{\frac{1}{d_{v}+1}}" display="inline" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">∏</mo><mrow><mi>v</mi><mo>∈</mo><mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∖</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">{</mo><mi>w</mi><mo stretchy="false">}</mo></mrow><mo>∪</mo><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><msub><mi>Z</mi><msub><mi>K</mi><mrow><msub><mi>d</mi><mi>v</mi></msub><mo>+</mo><mn>1</mn></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>v</mi></msub><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mrow><msub><mi>d</mi><mi>v</mi></msub><mo>+</mo><mn>1</mn></mrow></mfrac></msup></mrow></mrow><annotation encoding="application/x-tex">\prod\limits_{v\in V(G)\setminus(\{w\}\cup N(w))}Z_{K_{d_{v}+1}}(\lambda_{v})^{\frac{1}{d_{v}+1}}</annotation></semantics></math>, (<a href="#S2.E1" title="Equation 2.1 ‣ 2 Multivariate independence polynomials ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.1</span></a>) is equivalent to</p>
<table id="S2.E2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E2.m1" class="ltx_Math" alttext="\prod_{v\in N(w)}Z_{K_{d_{v}}}(\lambda_{v})^{\frac{1}{d_{v}}}+\lambda_{w}\geq Z_{K_{\Delta+1}}(\lambda_{w})^{\frac{1}{\Delta+1}}\prod_{v\in N(w)}Z_{K_{d_{v}+1}}(\lambda_{v})^{\frac{1}{d_{v}+1}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><munder><mo movablelimits="false">∏</mo><mrow><mi>v</mi><mo>∈</mo><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><msub><mi>Z</mi><msub><mi>K</mi><msub><mi>d</mi><mi>v</mi></msub></msub></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>v</mi></msub><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><msub><mi>d</mi><mi>v</mi></msub></mfrac></msup></mrow></mrow><mo>+</mo><msub><mi>λ</mi><mi>w</mi></msub></mrow><mo>≥</mo><mrow><msub><mi>Z</mi><msub><mi>K</mi><mrow><mi mathvariant="normal">Δ</mi><mo>+</mo><mn>1</mn></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>w</mi></msub><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mrow><mi mathvariant="normal">Δ</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∏</mo><mrow><mi>v</mi><mo>∈</mo><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><msub><mi>Z</mi><msub><mi>K</mi><mrow><msub><mi>d</mi><mi>v</mi></msub><mo>+</mo><mn>1</mn></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>v</mi></msub><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mrow><msub><mi>d</mi><mi>v</mi></msub><mo>+</mo><mn>1</mn></mrow></mfrac></msup></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\prod_{v\in N(w)}Z_{K_{d_{v}}}(\lambda_{v})^{\frac{1}{d_{v}}}+\lambda_{w}\geq Z_{K_{\Delta+1}}(\lambda_{w})^{\frac{1}{\Delta+1}}\prod_{v\in N(w)}Z_{K_{d_{v}+1}}(\lambda_{v})^{\frac{1}{d_{v}+1}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(2.2)</span></td></tr></tbody>
</table>
<p id="S2.p3.5" class="ltx_p">which is shown by the following <a href="#S2.Thmtheorem1" title="Lemma 2.1. ‣ 2 Multivariate independence polynomials ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span></a>.
We remark that this result is exactly what <em id="S2.p3.5.1" class="ltx_emph ltx_font_italic">Aletheia</em> successfully derived. We integrated this with the correct solutions provided by other models, including Gemini Deep Think 3.0 and its IMO-Gold version, to formulate a cleaner argument.</p>
</div>
<div id="S2.Thmtheorem1" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S2.Thmtheorem1.2" class="ltx_text ltx_font_bold">Lemma 2.1</span></span><span id="S2.Thmtheorem1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S2.Thmtheorem1.p1" class="ltx_para">
<p id="S2.Thmtheorem1.p1.1" class="ltx_p"><span id="S2.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S2.Thmtheorem1.p1.m1" class="ltx_Math" alttext="\Delta\geq 1" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\Delta\geq 1</annotation></semantics></math> be an integer and <math id="S2.Thmtheorem1.p1.m2" class="ltx_Math" alttext="1\leq d_{1},\dots,d_{\Delta}\leq\Delta" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>≤</mo><msub><mi>d</mi><mn>1</mn></msub></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>d</mi><mi mathvariant="normal">Δ</mi></msub><mo>≤</mo><mi mathvariant="normal">Δ</mi></mrow></mrow><annotation encoding="application/x-tex">1\leq d_{1},\dots,d_{\Delta}\leq\Delta</annotation></semantics></math>. Let <math id="S2.Thmtheorem1.p1.m3" class="ltx_Math" alttext="\lambda_{0},\lambda_{1},\dots,\lambda_{\Delta}" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mn>0</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>λ</mi><mi mathvariant="normal">Δ</mi></msub></mrow><annotation encoding="application/x-tex">\lambda_{0},\lambda_{1},\dots,\lambda_{\Delta}</annotation></semantics></math> be nonnegative reals. Then</span></p>
<table id="S2.Ex5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex5.m1" class="ltx_Math" alttext="\prod_{i=1}^{\Delta}(1+d_{i}\lambda_{i})^{\frac{1}{d_{i}}}+\lambda_{0}\geq(1+(\Delta+1)\lambda_{0})^{\frac{1}{\Delta+1}}\prod_{i=1}^{\Delta}(1+(d_{i}+1)\lambda_{i})^{\frac{1}{d_{i}+1}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">Δ</mi></munderover><msup><mrow><mo lspace="0em" stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>d</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>i</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><msub><mi>d</mi><mi>i</mi></msub></mfrac></msup></mrow><mo>+</mo><msub><mi>λ</mi><mn>0</mn></msub></mrow><mo>≥</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Δ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mn>0</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mrow><mi mathvariant="normal">Δ</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">Δ</mi></munderover><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>d</mi><mi>i</mi></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>i</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mrow><msub><mi>d</mi><mi>i</mi></msub><mo>+</mo><mn>1</mn></mrow></mfrac></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\prod_{i=1}^{\Delta}(1+d_{i}\lambda_{i})^{\frac{1}{d_{i}}}+\lambda_{0}\geq(1+(\Delta+1)\lambda_{0})^{\frac{1}{\Delta+1}}\prod_{i=1}^{\Delta}(1+(d_{i}+1)\lambda_{i})^{\frac{1}{d_{i}+1}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S2.p4" class="ltx_para">
<p id="S2.p4.1" class="ltx_p"><span id="S2.p4.1.1" class="ltx_text">Let <math id="S2.p4.m1" class="ltx_Math" alttext="A\coloneqq\prod_{i=1}^{\Delta}A_{i}" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo rspace="0.111em">≔</mo><mrow><msubsup><mo>∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">Δ</mi></msubsup><msub><mi>A</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">A\coloneqq\prod_{i=1}^{\Delta}A_{i}</annotation></semantics></math> and <math id="S2.p4.m2" class="ltx_Math" alttext="B\coloneqq\prod_{i=1}^{\Delta}B_{i}" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo rspace="0.111em">≔</mo><mrow><msubsup><mo>∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">Δ</mi></msubsup><msub><mi>B</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">B\coloneqq\prod_{i=1}^{\Delta}B_{i}</annotation></semantics></math> where</span></p>
<table id="S2.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex6.m1" class="ltx_Math" alttext="A_{i}\coloneqq(1+d_{i}\lambda_{i})^{\frac{1}{d_{i}}}\quad\text{and}\quad B_{i}\coloneqq(1+(d_{i}+1)\lambda_{i})^{\frac{1}{d_{i}+1}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>A</mi><mi>i</mi></msub><mo>≔</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>d</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>i</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><msub><mi>d</mi><mi>i</mi></msub></mfrac></msup></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>and</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><msub><mi>B</mi><mi>i</mi></msub><mo>≔</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>d</mi><mi>i</mi></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>i</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mrow><msub><mi>d</mi><mi>i</mi></msub><mo>+</mo><mn>1</mn></mrow></mfrac></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">A_{i}\coloneqq(1+d_{i}\lambda_{i})^{\frac{1}{d_{i}}}\quad\text{and}\quad B_{i}\coloneqq(1+(d_{i}+1)\lambda_{i})^{\frac{1}{d_{i}+1}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p4.2" class="ltx_p"><span id="S2.p4.2.1" class="ltx_text">The desired inequality then rephrases as</span></p>
<table id="S2.E3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E3.m1" class="ltx_Math" alttext="A+\lambda_{0}\geq(1+(\Delta+1)\lambda_{0})^{\frac{1}{\Delta+1}}B." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>A</mi><mo>+</mo><msub><mi>λ</mi><mn>0</mn></msub></mrow><mo>≥</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Δ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mn>0</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mrow><mi mathvariant="normal">Δ</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">A+\lambda_{0}\geq(1+(\Delta+1)\lambda_{0})^{\frac{1}{\Delta+1}}B.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(2.3)</span></td></tr></tbody>
</table>
<p id="S2.p4.3" class="ltx_p"><span id="S2.p4.3.1" class="ltx_text">By the AM–GM inequality,</span></p>
<table id="S2.EGx1" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S2.Ex7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex7.m1" class="ltx_Math" alttext="\displaystyle(1+(\Delta+1)\lambda_{0})^{\frac{1}{\Delta+1}}B" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Δ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mn>0</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mrow><mi mathvariant="normal">Δ</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><annotation encoding="application/x-tex">\displaystyle(1+(\Delta+1)\lambda_{0})^{\frac{1}{\Delta+1}}B</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex7.m2" class="ltx_Math" alttext="\displaystyle=\bigl((1+(\Delta+1)\lambda_{0})\cdot(B^{\frac{\Delta+1}{\Delta}})^{\Delta}\bigr)^{\frac{1}{\Delta+1}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Δ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mn>0</mn></msub></mrow></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>B</mi><mfrac><mrow><mi mathvariant="normal">Δ</mi><mo>+</mo><mn>1</mn></mrow><mi mathvariant="normal">Δ</mi></mfrac></msup><mo stretchy="false">)</mo></mrow><mi mathvariant="normal">Δ</mi></msup></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mfrac><mn>1</mn><mrow><mi mathvariant="normal">Δ</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msup></mrow><annotation encoding="application/x-tex">\displaystyle=\bigl((1+(\Delta+1)\lambda_{0})\cdot(B^{\frac{\Delta+1}{\Delta}})^{\Delta}\bigr)^{\frac{1}{\Delta+1}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S2.Ex8"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex8.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{(1+(\Delta+1)\lambda_{0})+\Delta B^{\frac{\Delta+1}{\Delta}}}{\Delta+1}=\frac{1+\Delta B^{\frac{\Delta+1}{\Delta}}}{\Delta+1}+\lambda_{0}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Δ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mn>0</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mfrac><mrow><mi mathvariant="normal">Δ</mi><mo>+</mo><mn>1</mn></mrow><mi mathvariant="normal">Δ</mi></mfrac></msup></mrow></mrow><mrow><mi mathvariant="normal">Δ</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mstyle><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mfrac><mrow><mi mathvariant="normal">Δ</mi><mo>+</mo><mn>1</mn></mrow><mi mathvariant="normal">Δ</mi></mfrac></msup></mrow></mrow><mrow><mi mathvariant="normal">Δ</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mstyle><mo>+</mo><msub><mi>λ</mi><mn>0</mn></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{(1+(\Delta+1)\lambda_{0})+\Delta B^{\frac{\Delta+1}{\Delta}}}{\Delta+1}=\frac{1+\Delta B^{\frac{\Delta+1}{\Delta}}}{\Delta+1}+\lambda_{0},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p4.4" class="ltx_p"><span id="S2.p4.4.1" class="ltx_text">so it suffices to show that</span></p>
<table id="S2.E4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E4.m1" class="ltx_Math" alttext="(\Delta+1)A\geq\Delta B^{\frac{\Delta+1}{\Delta}}+1." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Δ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mo>≥</mo><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mfrac><mrow><mi mathvariant="normal">Δ</mi><mo>+</mo><mn>1</mn></mrow><mi mathvariant="normal">Δ</mi></mfrac></msup></mrow><mo>+</mo><mn>1</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(\Delta+1)A\geq\Delta B^{\frac{\Delta+1}{\Delta}}+1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(2.4)</span></td></tr></tbody>
</table>
<p id="S2.p4.5" class="ltx_p"><span id="S2.p4.5.1" class="ltx_text">The proof of this inequality consists of two technical steps. Firstly, we prove that, for each <math id="S2.p4.m3" class="ltx_Math" alttext="1\leq i\leq\Delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi mathvariant="normal">Δ</mi></mrow><annotation encoding="application/x-tex">1\leq i\leq\Delta</annotation></semantics></math>,</span></p>
<table id="S2.E5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E5.m1" class="ltx_Math" alttext="(\Delta+1)A_{i}^{\Delta}=(\Delta+1)(1+d_{i}\lambda_{i})^{\frac{\Delta}{d_{i}}}\geq 1+\Delta(1+(d_{i}+1)\lambda_{i})^{\frac{\Delta+1}{d_{i}+1}}=1+\Delta B_{i}^{\Delta+1}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Δ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>A</mi><mi>i</mi><mi mathvariant="normal">Δ</mi></msubsup></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Δ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>d</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>i</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mfrac><mi mathvariant="normal">Δ</mi><msub><mi>d</mi><mi>i</mi></msub></mfrac></msup></mrow><mo>≥</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>d</mi><mi>i</mi></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>i</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mfrac><mrow><mi mathvariant="normal">Δ</mi><mo>+</mo><mn>1</mn></mrow><mrow><msub><mi>d</mi><mi>i</mi></msub><mo>+</mo><mn>1</mn></mrow></mfrac></msup></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mi>i</mi><mrow><mi mathvariant="normal">Δ</mi><mo>+</mo><mn>1</mn></mrow></msubsup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">(\Delta+1)A_{i}^{\Delta}=(\Delta+1)(1+d_{i}\lambda_{i})^{\frac{\Delta}{d_{i}}}\geq 1+\Delta(1+(d_{i}+1)\lambda_{i})^{\frac{\Delta+1}{d_{i}+1}}=1+\Delta B_{i}^{\Delta+1},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(2.5)</span></td></tr></tbody>
</table>
<p id="S2.p4.6" class="ltx_p"><span id="S2.p4.6.1" class="ltx_text">multiplying which for all <math id="S2.p4.m4" class="ltx_Math" alttext="1\leq i\leq\Delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi mathvariant="normal">Δ</mi></mrow><annotation encoding="application/x-tex">1\leq i\leq\Delta</annotation></semantics></math> gives</span></p>
<table id="S2.E6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E6.m1" class="ltx_Math" alttext="(\Delta+1)^{\Delta}A^{\Delta}\geq\prod_{i=1}^{\Delta}(1+\Delta B_{i}^{\Delta+1})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Δ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi mathvariant="normal">Δ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mi mathvariant="normal">Δ</mi></msup></mrow><mo rspace="0.111em">≥</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">Δ</mi></munderover><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mi>i</mi><mrow><mi mathvariant="normal">Δ</mi><mo>+</mo><mn>1</mn></mrow></msubsup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(\Delta+1)^{\Delta}A^{\Delta}\geq\prod_{i=1}^{\Delta}(1+\Delta B_{i}^{\Delta+1}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(2.6)</span></td></tr></tbody>
</table>
<p id="S2.p4.7" class="ltx_p"><span id="S2.p4.7.1" class="ltx_text">The second step is to show that</span></p>
<table id="S2.E7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E7.m1" class="ltx_Math" alttext="\prod_{i=1}^{\Delta}(1+\Delta B_{i}^{\Delta+1})^{\frac{1}{\Delta}}\geq 1+\Delta B^{\frac{\Delta+1}{\Delta}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">Δ</mi></munderover><msup><mrow><mo lspace="0em" stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mi>i</mi><mrow><mi mathvariant="normal">Δ</mi><mo>+</mo><mn>1</mn></mrow></msubsup></mrow></mrow><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mi mathvariant="normal">Δ</mi></mfrac></msup></mrow><mo>≥</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mfrac><mrow><mi mathvariant="normal">Δ</mi><mo>+</mo><mn>1</mn></mrow><mi mathvariant="normal">Δ</mi></mfrac></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\prod_{i=1}^{\Delta}(1+\Delta B_{i}^{\Delta+1})^{\frac{1}{\Delta}}\geq 1+\Delta B^{\frac{\Delta+1}{\Delta}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(2.7)</span></td></tr></tbody>
</table>
<p id="S2.p4.8" class="ltx_p"><span id="S2.p4.8.1" class="ltx_text">Combining this with (<a href="#S2.E6" title="Equation 2.6 ‣ Proof. ‣ 2 Multivariate independence polynomials ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.6</span></a>) concludes the proof of (<a href="#S2.E4" title="Equation 2.4 ‣ Proof. ‣ 2 Multivariate independence polynomials ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.4</span></a>).</span></p>
</div>
<div id="S2.p5" class="ltx_para">
<p id="S2.p5.1" class="ltx_p"><span id="S2.p5.1.1" class="ltx_text">To prove the first inequality (<a href="#S2.E5" title="Equation 2.5 ‣ Proof. ‣ 2 Multivariate independence polynomials ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.5</span></a>), the following claim with <math id="S2.p5.m1" class="ltx_Math" alttext="d=d_{i}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><msub><mi>d</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">d=d_{i}</annotation></semantics></math> and <math id="S2.p5.m2" class="ltx_Math" alttext="\lambda=\lambda_{i}" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>=</mo><msub><mi>λ</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\lambda=\lambda_{i}</annotation></semantics></math> suffices.</span></p>
</div>
<div id="S2.Thmtheorem2" class="ltx_theorem ltx_theorem_claim">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S2.Thmtheorem2.2" class="ltx_text ltx_font_bold">Claim 2.2</span></span><span id="S2.Thmtheorem2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S2.Thmtheorem2.p1" class="ltx_para">
<p id="S2.Thmtheorem2.p1.1" class="ltx_p"><span id="S2.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">For <math id="S2.Thmtheorem2.p1.m1" class="ltx_Math" alttext="1\leq d\leq\Delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>d</mi><mo>≤</mo><mi mathvariant="normal">Δ</mi></mrow><annotation encoding="application/x-tex">1\leq d\leq\Delta</annotation></semantics></math> and <math id="S2.Thmtheorem2.p1.m2" class="ltx_Math" alttext="\lambda\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda\geq 0</annotation></semantics></math>,</span></p>
<table id="S2.Ex9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex9.m1" class="ltx_Math" alttext="(\Delta+1)(1+d\lambda)^{\Delta/d}\geq 1+\Delta(1+(d+1)\lambda)^{(\Delta+1)/(d+1)}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Δ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi mathvariant="normal">Δ</mi><mo>/</mo><mi>d</mi></mrow></msup></mrow><mo>≥</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Δ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(\Delta+1)(1+d\lambda)^{\Delta/d}\geq 1+\Delta(1+(d+1)\lambda)^{(\Delta+1)/(d+1)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S2.p6" class="ltx_para">
<ul id="S2.p6.1" class="ltx_itemize">
</ul>
</div>
<div id="S2.p7" class="ltx_para">
<p id="S2.p7.1" class="ltx_p"><span id="S2.p7.1.1" class="ltx_text">Let</span></p>
<table id="S2.Ex10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex10.m1" class="ltx_Math" alttext="f(\lambda)\coloneqq(\Delta+1)(1+d\lambda)^{\Delta/d}-\Delta(1+(d+1)\lambda)^{(\Delta+1)/(d+1)}-1," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≔</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Δ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi mathvariant="normal">Δ</mi><mo>/</mo><mi>d</mi></mrow></msup></mrow><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Δ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mo>−</mo><mn>1</mn></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">f(\lambda)\coloneqq(\Delta+1)(1+d\lambda)^{\Delta/d}-\Delta(1+(d+1)\lambda)^{(\Delta+1)/(d+1)}-1,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p7.2" class="ltx_p"><span id="S2.p7.2.1" class="ltx_text">then we want to show <math id="S2.p7.m1" class="ltx_Math" alttext="f(\lambda)\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">f(\lambda)\geq 0</annotation></semantics></math>.
Since <math id="S2.p7.m2" class="ltx_Math" alttext="f(0)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">f(0)=0</annotation></semantics></math>, it suffices to show <math id="S2.p7.m3" class="ltx_Math" alttext="f^{\prime}(\lambda)\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>f</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">f^{\prime}(\lambda)\geq 0</annotation></semantics></math> for all <math id="S2.p7.m4" class="ltx_Math" alttext="\lambda\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda\geq 0</annotation></semantics></math>. We have</span></p>
<table id="S2.EGx2" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S2.Ex11"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex11.m1" class="ltx_Math" alttext="\displaystyle f^{\prime}(\lambda)" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle f^{\prime}(\lambda)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex11.m2" class="ltx_Math" alttext="\displaystyle=\Delta(\Delta+1)(1+d\lambda)^{\Delta/d-1}-\Delta(\Delta+1)(1+(d+1)\lambda)^{(\Delta+1)/(d+1)-1}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Δ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mrow><mi mathvariant="normal">Δ</mi><mo>/</mo><mi>d</mi></mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>−</mo><mrow><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Δ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Δ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\Delta(\Delta+1)(1+d\lambda)^{\Delta/d-1}-\Delta(\Delta+1)(1+(d+1)\lambda)^{(\Delta+1)/(d+1)-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S2.Ex12"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex12.m1" class="ltx_Math" alttext="\displaystyle=\Delta(\Delta+1)\bigl((1+d\lambda)^{(\Delta-d)/d}-(1+(d+1)\lambda)^{(\Delta-d)/(d+1)}\bigr)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Δ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Δ</mi><mo>−</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mi>d</mi></mrow></msup><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Δ</mi><mo>−</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\Delta(\Delta+1)\bigl((1+d\lambda)^{(\Delta-d)/d}-(1+(d+1)\lambda)^{(\Delta-d)/(d+1)}\bigr),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p7.3" class="ltx_p"><span id="S2.p7.3.1" class="ltx_text">which is nonnegative if</span></p>
<table id="S2.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex13.m1" class="ltx_Math" alttext="(1+d\lambda)^{(d+1)/d}\geq 1+(d+1)\lambda." display="block" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mi>d</mi></mrow></msup><mo>≥</mo><mrow><mn>1</mn><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(1+d\lambda)^{(d+1)/d}\geq 1+(d+1)\lambda.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p7.4" class="ltx_p"><span id="S2.p7.4.1" class="ltx_text">This is a consequence of Bernoulli’s inequality <math id="S2.p7.m5" class="ltx_Math" alttext="(1+x)^{\alpha}\geq 1+\alpha x" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mi>α</mi></msup><mo>≥</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">(1+x)^{\alpha}\geq 1+\alpha x</annotation></semantics></math>, for <math id="S2.p7.m6" class="ltx_Math" alttext="x\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">x\geq 0</annotation></semantics></math> and <math id="S2.p7.m7" class="ltx_Math" alttext="\alpha\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\alpha\geq 1</annotation></semantics></math>.
∎It remains to show (<a href="#S2.E7" title="Equation 2.7 ‣ Proof. ‣ 2 Multivariate independence polynomials ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.7</span></a>). Let <math id="S2.p7.m8" class="ltx_Math" alttext="y_{i}\coloneqq\Delta B_{i}^{\Delta+1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mi>i</mi></msub><mo>≔</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mi>i</mi><mrow><mi mathvariant="normal">Δ</mi><mo>+</mo><mn>1</mn></mrow></msubsup></mrow></mrow><annotation encoding="application/x-tex">y_{i}\coloneqq\Delta B_{i}^{\Delta+1}</annotation></semantics></math>. Then (<a href="#S2.E7" title="Equation 2.7 ‣ Proof. ‣ 2 Multivariate independence polynomials ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.7</span></a>) is equivalent to</span></p>
<table id="S2.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex14.m1" class="ltx_Math" alttext="\prod_{i=1}^{\Delta}(1+y_{i})^{1/\Delta}\geq 1+\prod_{i=1}^{\Delta}y_{i}^{1/\Delta}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">Δ</mi></munderover><msup><mrow><mo lspace="0em" stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>y</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mi mathvariant="normal">Δ</mi></mrow></msup></mrow><mo>≥</mo><mrow><mn>1</mn><mo rspace="0.055em">+</mo><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">Δ</mi></munderover><msubsup><mi>y</mi><mi>i</mi><mrow><mn>1</mn><mo>/</mo><mi mathvariant="normal">Δ</mi></mrow></msubsup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\prod_{i=1}^{\Delta}(1+y_{i})^{1/\Delta}\geq 1+\prod_{i=1}^{\Delta}y_{i}^{1/\Delta}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p7.5" class="ltx_p"><span id="S2.p7.5.1" class="ltx_text">This follows from the AM–GM inequality of the form</span></p>
<table id="S2.Ex15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex15.m1" class="ltx_Math" alttext="1=\frac{1}{\Delta}\biggl(\sum_{i=1}^{\Delta}\frac{1}{1+y_{i}}+\sum_{i=1}^{\Delta}\frac{y_{i}}{1+y_{i}}\biggr)\geq\prod_{i=1}^{\Delta}\frac{1}{(1+y_{i})^{1/\Delta}}+\prod_{i=1}^{\Delta}\frac{y_{i}^{1/\Delta}}{(1+y_{i})^{1/\Delta}}," display="block" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>=</mo><mrow><mfrac><mn>1</mn><mi mathvariant="normal">Δ</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">Δ</mi></munderover><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><msub><mi>y</mi><mi>i</mi></msub></mrow></mfrac></mrow><mo rspace="0.055em">+</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">Δ</mi></munderover><mfrac><msub><mi>y</mi><mi>i</mi></msub><mrow><mn>1</mn><mo>+</mo><msub><mi>y</mi><mi>i</mi></msub></mrow></mfrac></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow><mo rspace="0.111em">≥</mo><mrow><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">Δ</mi></munderover><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>y</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mi mathvariant="normal">Δ</mi></mrow></msup></mfrac></mrow><mo rspace="0.055em">+</mo><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">Δ</mi></munderover><mfrac><msubsup><mi>y</mi><mi>i</mi><mrow><mn>1</mn><mo>/</mo><mi mathvariant="normal">Δ</mi></mrow></msubsup><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>y</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mi mathvariant="normal">Δ</mi></mrow></msup></mfrac></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">1=\frac{1}{\Delta}\biggl(\sum_{i=1}^{\Delta}\frac{1}{1+y_{i}}+\sum_{i=1}^{\Delta}\frac{y_{i}}{1+y_{i}}\biggr)\geq\prod_{i=1}^{\Delta}\frac{1}{(1+y_{i})^{1/\Delta}}+\prod_{i=1}^{\Delta}\frac{y_{i}^{1/\Delta}}{(1+y_{i})^{1/\Delta}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p7.6" class="ltx_p"><span id="S2.p7.6.1" class="ltx_text">Indeed, multiplying <math id="S2.p7.m9" class="ltx_Math" alttext="\prod_{i=1}^{\Delta}(1+y_{i})^{1/\Delta}" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">Δ</mi></msubsup><msup><mrow><mo lspace="0em" stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>y</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mi mathvariant="normal">Δ</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\prod_{i=1}^{\Delta}(1+y_{i})^{1/\Delta}</annotation></semantics></math> on both sides concludes the proof.
∎</span></p>
</div>
</div>
<div id="Thmremarkx1" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmremarkx1.2" class="ltx_text ltx_font_italic">Remark</span></span><span id="Thmremarkx1.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="Thmremarkx1.p1" class="ltx_para">
<p id="Thmremarkx1.p1.1" class="ltx_p">It is not hard to see that equality in <a href="#S2.Thmtheorem1" title="Lemma 2.1. ‣ 2 Multivariate independence polynomials ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">2.1</span></a> holds if and only if either</p>
<ol id="S2.I2" class="ltx_enumerate">
<li id="S2.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(i)</span> 
<div id="S2.I2.i1.p1" class="ltx_para">
<p id="S2.I2.i1.p1.1" class="ltx_p"><math id="S2.I2.i1.p1.m1" class="ltx_Math" alttext="\lambda_{0}=\lambda_{1}=\dots=\lambda_{\Delta}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mn>0</mn></msub><mo>=</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>=</mo><mi mathvariant="normal">⋯</mi><mo>=</mo><msub><mi>λ</mi><mi mathvariant="normal">Δ</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda_{0}=\lambda_{1}=\dots=\lambda_{\Delta}=0</annotation></semantics></math> or</p>
</div></li>
<li id="S2.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(ii)</span> 
<div id="S2.I2.i2.p1" class="ltx_para">
<p id="S2.I2.i2.p1.1" class="ltx_p"><math id="S2.I2.i2.p1.m1" class="ltx_Math" alttext="\lambda_{0}=\lambda_{1}=\dots=\lambda_{\Delta}\neq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mn>0</mn></msub><mo>=</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>=</mo><mi mathvariant="normal">⋯</mi><mo>=</mo><msub><mi>λ</mi><mi mathvariant="normal">Δ</mi></msub><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda_{0}=\lambda_{1}=\dots=\lambda_{\Delta}\neq 0</annotation></semantics></math> and <math id="S2.I2.i2.p1.m2" class="ltx_Math" alttext="d_{1}=\dots=d_{\Delta}=\Delta" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>=</mo><mi mathvariant="normal">⋯</mi><mo>=</mo><msub><mi>d</mi><mi mathvariant="normal">Δ</mi></msub><mo>=</mo><mi mathvariant="normal">Δ</mi></mrow><annotation encoding="application/x-tex">d_{1}=\dots=d_{\Delta}=\Delta</annotation></semantics></math>.</p>
</div></li>
</ol>
<p id="Thmremarkx1.p1.2" class="ltx_p">Using this, it follows that equality in (<a href="#S1.E1" title="Equation 1.1 ‣ Theorem 1.1. ‣ 1 Introduction ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.1</span></a>) holds if and only if for each connected component <math id="Thmremarkx1.p1.m1" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> of <math id="Thmremarkx1.p1.m2" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>,</p>
<ol id="S2.I3" class="ltx_enumerate">
<li id="S2.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(i)</span> 
<div id="S2.I3.i1.p1" class="ltx_para">
<p id="S2.I3.i1.p1.1" class="ltx_p"><math id="S2.I3.i1.p1.m1" class="ltx_Math" alttext="\lambda_{v}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>v</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda_{v}=0</annotation></semantics></math> for all <math id="S2.I3.i1.p1.m2" class="ltx_Math" alttext="v\in C" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><mi>C</mi></mrow><annotation encoding="application/x-tex">v\in C</annotation></semantics></math> or</p>
</div></li>
<li id="S2.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(ii)</span> 
<div id="S2.I3.i2.p1" class="ltx_para">
<p id="S2.I3.i2.p1.1" class="ltx_p"><math id="S2.I3.i2.p1.m1" class="ltx_Math" alttext="\lambda_{v}=\lambda\neq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>v</mi></msub><mo>=</mo><mi>λ</mi><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda_{v}=\lambda\neq 0</annotation></semantics></math> for all <math id="S2.I3.i2.p1.m2" class="ltx_Math" alttext="v\in C" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><mi>C</mi></mrow><annotation encoding="application/x-tex">v\in C</annotation></semantics></math> and <math id="S2.I3.i2.p1.m3" class="ltx_Math" alttext="G[C]" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>C</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">G[C]</annotation></semantics></math> is a clique.</p>
</div></li>
</ol>
<p id="Thmremarkx1.p1.3" class="ltx_p">To see this, we use induction on <math id="Thmremarkx1.p1.m3" class="ltx_Math" alttext="\lvert V(G)\rvert" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">\lvert V(G)\rvert</annotation></semantics></math>, where the base case is clear. We may assume that <math id="Thmremarkx1.p1.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> is connected. Suppose equality in (<a href="#S1.E1" title="Equation 1.1 ‣ Theorem 1.1. ‣ 1 Introduction ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.1</span></a>) holds so that <math id="Thmremarkx1.p1.m5" class="ltx_Math" alttext="Z_{G}(\bm{\lambda})=Z^{-}_{G}(\bm{\lambda})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>Z</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝝀</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>Z</mi><mi>G</mi><mo>−</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝝀</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Z_{G}(\bm{\lambda})=Z^{-}_{G}(\bm{\lambda})</annotation></semantics></math>. Recall that <math id="Thmremarkx1.p1.m6" class="ltx_Math" alttext="Z_{G}(\bm{\lambda})\geq Z^{-}_{G}(\bm{\lambda})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>Z</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝝀</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><msubsup><mi>Z</mi><mi>G</mi><mo>−</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝝀</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Z_{G}(\bm{\lambda})\geq Z^{-}_{G}(\bm{\lambda})</annotation></semantics></math> follows from</p>
<table id="S2.EGx3" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S2.Ex16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex16.m1" class="ltx_Math" alttext="\displaystyle Z_{G}(\bm{\lambda})" display="inline" intent=":literal"><semantics><mrow><msub><mi>Z</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝝀</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle Z_{G}(\bm{\lambda})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex16.m2" class="ltx_Math" alttext="\displaystyle=Z_{G\setminus w}(\bm{\lambda}^{\prime})+\lambda_{w}Z_{G\setminus w}(\bm{\lambda}^{\prime})|_{\lambda_{v}=0,\,v\in N(w)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>Z</mi><mrow><mi>G</mi><mo>∖</mo><mi>w</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝀</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mrow><mrow><msub><mi>λ</mi><mi>w</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>Z</mi><mrow><mi>G</mi><mo>∖</mo><mi>w</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝀</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mrow><mrow><msub><mi>λ</mi><mi>v</mi></msub><mo>=</mo><mn>0</mn></mrow><mo rspace="0.337em">,</mo><mrow><mi>v</mi><mo>∈</mo><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=Z_{G\setminus w}(\bm{\lambda}^{\prime})+\lambda_{w}Z_{G\setminus w}(\bm{\lambda}^{\prime})|_{\lambda_{v}=0,\,v\in N(w)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S2.E8"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.E8.m1" class="ltx_Math" alttext="\displaystyle\geq Z^{-}_{G\setminus w}(\bm{\lambda}^{\prime})+\lambda_{w}Z^{-}_{G\setminus w}(\bm{\lambda}^{\prime})|_{\lambda_{v}=0,\,v\in N(w)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><mrow><msubsup><mi>Z</mi><mrow><mi>G</mi><mo>∖</mo><mi>w</mi></mrow><mo>−</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝀</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mrow><mrow><msub><mi>λ</mi><mi>w</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>Z</mi><mrow><mi>G</mi><mo>∖</mo><mi>w</mi></mrow><mo>−</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝀</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mrow><mrow><msub><mi>λ</mi><mi>v</mi></msub><mo>=</mo><mn>0</mn></mrow><mo rspace="0.337em">,</mo><mrow><mi>v</mi><mo>∈</mo><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq Z^{-}_{G\setminus w}(\bm{\lambda}^{\prime})+\lambda_{w}Z^{-}_{G\setminus w}(\bm{\lambda}^{\prime})|_{\lambda_{v}=0,\,v\in N(w)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(2.8)</span></td></tr></tbody>
<tbody id="S2.E9"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.E9.m1" class="ltx_Math" alttext="\displaystyle\geq Z^{-}_{G}(\bm{\lambda})," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≥</mo><mrow><msubsup><mi>Z</mi><mi>G</mi><mo>−</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝝀</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\geq Z^{-}_{G}(\bm{\lambda}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(2.9)</span></td></tr></tbody>
</table>
<p id="Thmremarkx1.p1.4" class="ltx_p">and that (<a href="#S2.E9" title="Equation 2.9 ‣ Remark. ‣ 2 Multivariate independence polynomials ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.9</span></a>) is equivalent to (<a href="#S2.E2" title="Equation 2.2 ‣ 2 Multivariate independence polynomials ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.2</span></a>), where the latter holds by <a href="#S2.Thmtheorem1" title="Lemma 2.1. ‣ 2 Multivariate independence polynomials ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">2.1</span></a>.
Equality occurs in (<a href="#S2.E8" title="Equation 2.8 ‣ Remark. ‣ 2 Multivariate independence polynomials ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.8</span></a>) if and only if both of the following hold:</p>
<ol id="S2.I4" class="ltx_enumerate">
<li id="S2.I4.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(A1)</span> 
<div id="S2.I4.i1.p1" class="ltx_para">
<p id="S2.I4.i1.p1.1" class="ltx_p"><math id="S2.I4.i1.p1.m1" class="ltx_Math" alttext="Z_{G\setminus w}(\bm{\lambda}^{\prime})=Z^{-}_{G\setminus w}(\bm{\lambda}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>Z</mi><mrow><mi>G</mi><mo>∖</mo><mi>w</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝀</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>Z</mi><mrow><mi>G</mi><mo>∖</mo><mi>w</mi></mrow><mo>−</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝀</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Z_{G\setminus w}(\bm{\lambda}^{\prime})=Z^{-}_{G\setminus w}(\bm{\lambda}^{\prime})</annotation></semantics></math>.</p>
</div></li>
<li id="S2.I4.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(A2)</span> 
<div id="S2.I4.i2.p1" class="ltx_para">
<p id="S2.I4.i2.p1.1" class="ltx_p"><math id="S2.I4.i2.p1.m1" class="ltx_Math" alttext="\lambda_{w}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>w</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda_{w}=0</annotation></semantics></math> or <math id="S2.I4.i2.p1.m2" class="ltx_Math" alttext="Z^{-}_{G\setminus w}(\bm{\lambda}^{\prime})|_{\lambda_{v}=0,\,v\in N(w)}=Z_{G\setminus w}(\bm{\lambda}^{\prime})|_{\lambda_{v}=0,\,v\in N(w)}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mrow><msubsup><mi>Z</mi><mrow><mi>G</mi><mo>∖</mo><mi>w</mi></mrow><mo>−</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝀</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mrow><mrow><msub><mi>λ</mi><mi>v</mi></msub><mo>=</mo><mn>0</mn></mrow><mo rspace="0.337em">,</mo><mrow><mi>v</mi><mo>∈</mo><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></msub><mo>=</mo><msub><mrow><mrow><msub><mi>Z</mi><mrow><mi>G</mi><mo>∖</mo><mi>w</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝀</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mrow><mrow><msub><mi>λ</mi><mi>v</mi></msub><mo>=</mo><mn>0</mn></mrow><mo rspace="0.337em">,</mo><mrow><mi>v</mi><mo>∈</mo><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">Z^{-}_{G\setminus w}(\bm{\lambda}^{\prime})|_{\lambda_{v}=0,\,v\in N(w)}=Z_{G\setminus w}(\bm{\lambda}^{\prime})|_{\lambda_{v}=0,\,v\in N(w)}</annotation></semantics></math>.</p>
</div></li>
</ol>
<p id="Thmremarkx1.p1.5" class="ltx_p"><a href="#S2.I4.i1" title="Item (A1) ‣ Remark. ‣ 2 Multivariate independence polynomials ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">(A1)</span></a> occurs, by the induction hypothesis, only if <math id="Thmremarkx1.p1.m7" class="ltx_Math" alttext="\lambda_{v}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mi>v</mi></msub><annotation encoding="application/x-tex">\lambda_{v}</annotation></semantics></math> is constant on each connected component of <math id="Thmremarkx1.p1.m8" class="ltx_Math" alttext="G\setminus w" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>∖</mo><mi>w</mi></mrow><annotation encoding="application/x-tex">G\setminus w</annotation></semantics></math>.
In addition, <a href="#S2.I4.i2" title="Item (A2) ‣ Remark. ‣ 2 Multivariate independence polynomials ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">(A2)</span></a> occurs, again by the induction hypothesis, if and only if either

<span id="S2.I5" class="ltx_inline-enumerate">
<span id="S2.I5.i1" class="ltx_inline-item"><span class="ltx_tag ltx_tag_inline-item">(B1)</span> <math id="S2.I5.i1.m1" class="ltx_Math" alttext="\lambda_{w}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>w</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda_{w}=0</annotation></semantics></math><span id="S2.I5.i1.2" class="ltx_text">or

</span></span>
<span id="S2.I5.i2" class="ltx_inline-item"><span class="ltx_tag ltx_tag_inline-item">(B2)</span> <math id="S2.I5.i2.m1" class="ltx_Math" alttext="\lambda_{v}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>v</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda_{v}=0</annotation></semantics></math><span id="S2.I5.i2.2" class="ltx_text">for all <math id="S2.I5.i2.m2" class="ltx_Math" alttext="v\in V(G)\setminus(\{w\}\cup N(w))" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∖</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">{</mo><mi>w</mi><mo stretchy="false">}</mo></mrow><mo>∪</mo><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">v\in V(G)\setminus(\{w\}\cup N(w))</annotation></semantics></math>.</span></span>
</span></p>
</div>
<div id="Thmremarkx1.p2" class="ltx_para">
<p id="Thmremarkx1.p2.1" class="ltx_p">Equality occurs in (<a href="#S2.E9" title="Equation 2.9 ‣ Remark. ‣ 2 Multivariate independence polynomials ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.9</span></a>), by the equality case of (<a href="#S2.E2" title="Equation 2.2 ‣ 2 Multivariate independence polynomials ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.2</span></a>), if and only if either</p>
<ol id="S2.I6" class="ltx_enumerate">
<li id="S2.I6.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(C1)</span> 
<div id="S2.I6.i1.p1" class="ltx_para">
<p id="S2.I6.i1.p1.1" class="ltx_p"><math id="S2.I6.i1.p1.m1" class="ltx_Math" alttext="\lambda_{w}=\lambda_{v}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>w</mi></msub><mo>=</mo><msub><mi>λ</mi><mi>v</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda_{w}=\lambda_{v}=0</annotation></semantics></math> for all <math id="S2.I6.i1.p1.m2" class="ltx_Math" alttext="v\in N(w)" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">v\in N(w)</annotation></semantics></math> or</p>
</div></li>
<li id="S2.I6.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(C2)</span> 
<div id="S2.I6.i2.p1" class="ltx_para">
<p id="S2.I6.i2.p1.1" class="ltx_p"><math id="S2.I6.i2.p1.m1" class="ltx_Math" alttext="\lambda_{w}=\lambda_{v}" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>w</mi></msub><mo>=</mo><msub><mi>λ</mi><mi>v</mi></msub></mrow><annotation encoding="application/x-tex">\lambda_{w}=\lambda_{v}</annotation></semantics></math> and <math id="S2.I6.i2.p1.m2" class="ltx_Math" alttext="d_{v}=\Delta" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>v</mi></msub><mo>=</mo><mi mathvariant="normal">Δ</mi></mrow><annotation encoding="application/x-tex">d_{v}=\Delta</annotation></semantics></math> for all <math id="S2.I6.i2.p1.m3" class="ltx_Math" alttext="v\in N(w)" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">v\in N(w)</annotation></semantics></math>.</p>
</div></li>
</ol>
<p id="Thmremarkx1.p2.2" class="ltx_p">In either of the cases, since <math id="Thmremarkx1.p2.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> is connected and <math id="Thmremarkx1.p2.m2" class="ltx_Math" alttext="\lambda_{v}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mi>v</mi></msub><annotation encoding="application/x-tex">\lambda_{v}</annotation></semantics></math> is constant on each connected component of <math id="Thmremarkx1.p2.m3" class="ltx_Math" alttext="G\setminus w" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>∖</mo><mi>w</mi></mrow><annotation encoding="application/x-tex">G\setminus w</annotation></semantics></math>, <math id="Thmremarkx1.p2.m4" class="ltx_Math" alttext="\lambda_{v}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mi>v</mi></msub><annotation encoding="application/x-tex">\lambda_{v}</annotation></semantics></math> is constant on <math id="Thmremarkx1.p2.m5" class="ltx_Math" alttext="V(G)" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">V(G)</annotation></semantics></math>.
If <a href="#S2.I6.i1" title="Item (C1) ‣ Remark. ‣ 2 Multivariate independence polynomials ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">(C1)</span></a> occurs, <math id="Thmremarkx1.p2.m6" class="ltx_Math" alttext="\lambda_{v}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>v</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda_{v}=0</annotation></semantics></math> for all <math id="Thmremarkx1.p2.m7" class="ltx_Math" alttext="v\in V(G)" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">v\in V(G)</annotation></semantics></math>.
Otherwise, suppose <a href="#S2.I6.i2" title="Item (C2) ‣ Remark. ‣ 2 Multivariate independence polynomials ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">(C2)</span></a> occurs but <math id="Thmremarkx1.p2.m8" class="ltx_Math" alttext="\lambda_{w}=\lambda_{v}\neq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>w</mi></msub><mo>=</mo><msub><mi>λ</mi><mi>v</mi></msub><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda_{w}=\lambda_{v}\neq 0</annotation></semantics></math> for all <math id="Thmremarkx1.p2.m9" class="ltx_Math" alttext="v\in N(w)" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">v\in N(w)</annotation></semantics></math>. Then <a href="#S2.I5.i1" title="Item (B1) ‣ Remark. ‣ 2 Multivariate independence polynomials ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">(B1)</span></a> is not the case, so <a href="#S2.I5.i2" title="Item (B2) ‣ Remark. ‣ 2 Multivariate independence polynomials ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">(B2)</span></a> must occur. This implies that <math id="Thmremarkx1.p2.m10" class="ltx_Math" alttext="V(G)\setminus(\{w\}\cup N(w))" display="inline" intent=":literal"><semantics><mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∖</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">{</mo><mi>w</mi><mo stretchy="false">}</mo></mrow><mo>∪</mo><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">V(G)\setminus(\{w\}\cup N(w))</annotation></semantics></math> is empty, since otherwise <math id="Thmremarkx1.p2.m11" class="ltx_Math" alttext="\lambda_{v}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>v</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda_{v}=0</annotation></semantics></math> for all <math id="Thmremarkx1.p2.m12" class="ltx_Math" alttext="v\in V(G)" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">v\in V(G)</annotation></semantics></math>. Thus, <math id="Thmremarkx1.p2.m13" class="ltx_Math" alttext="V(G)=\{w\}\cup N(w)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">{</mo><mi>w</mi><mo stretchy="false">}</mo></mrow><mo>∪</mo><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">V(G)=\{w\}\cup N(w)</annotation></semantics></math>, and since <math id="Thmremarkx1.p2.m14" class="ltx_Math" alttext="d_{v}=\Delta" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>v</mi></msub><mo>=</mo><mi mathvariant="normal">Δ</mi></mrow><annotation encoding="application/x-tex">d_{v}=\Delta</annotation></semantics></math> for all <math id="Thmremarkx1.p2.m15" class="ltx_Math" alttext="v\in N(w)" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">v\in N(w)</annotation></semantics></math>, <math id="Thmremarkx1.p2.m16" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> must be a clique.</p>
</div>
</div>
</section>
<section id="S3" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">3 </span>Semiproper colourings</h2>

<div id="S3.p1" class="ltx_para">
<p id="S3.p1.1" class="ltx_p">In our proof of <a href="#S1.Thmtheorem4" title="Theorem 1.4. ‣ 1 Introduction ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">1.4</span></a>, we used <em id="S3.p1.1.1" class="ltx_emph ltx_font_italic">Aletheia</em> in a more complex and rather interactive way than in the proof of <a href="#S1.Thmtheorem1" title="Theorem 1.1. ‣ 1 Introduction ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">1.1</span></a>, where we essentially outsourced one key lemma. Because of this, we shall first give a full proof and then discuss how the AI agent helped along the way in the remark at the very end of this section.</p>
</div>
<div id="S3.p2" class="ltx_para">
<p id="S3.p2.1" class="ltx_p">To prove <a href="#S1.Thmtheorem4" title="Theorem 1.4. ‣ 1 Introduction ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">1.4</span></a>, we may assume that <math id="S3.p2.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> is connected, analogously to the proof of <a href="#S1.Thmtheorem1" title="Theorem 1.1. ‣ 1 Introduction ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">1.1</span></a>. For a graph <math id="S3.p2.m2" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> and <math id="S3.p2.m3" class="ltx_Math" alttext="\bm{\lambda}=(\lambda_{v})_{v\in V(G)}" display="inline" intent=":literal"><semantics><mrow><mi>𝝀</mi><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>v</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>v</mi><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\bm{\lambda}=(\lambda_{v})_{v\in V(G)}</annotation></semantics></math>, <math id="S3.p2.m4" class="ltx_Math" alttext="\bm{\mu}=(\mu_{v})_{v\in V(G)}" display="inline" intent=":literal"><semantics><mrow><mi>𝝁</mi><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>μ</mi><mi>v</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>v</mi><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\bm{\mu}=(\mu_{v})_{v\in V(G)}</annotation></semantics></math>, let</p>
<table id="S3.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex1.m1" class="ltx_Math" alttext="Z_{G}^{(2)-}(\bm{\lambda},\bm{\mu})\coloneqq\prod_{v\in V(G)}Z^{(2)}_{K_{d_{v}+1}}(\lambda_{v},\mu_{v})^{\frac{1}{d_{v}+1}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>Z</mi><mi>G</mi><mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><mo>−</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝝀</mi><mo>,</mo><mi>𝝁</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">≔</mo><mrow><munder><mo movablelimits="false">∏</mo><mrow><mi>v</mi><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><msubsup><mi>Z</mi><msub><mi>K</mi><mrow><msub><mi>d</mi><mi>v</mi></msub><mo>+</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>v</mi></msub><mo>,</mo><msub><mi>μ</mi><mi>v</mi></msub><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mrow><msub><mi>d</mi><mi>v</mi></msub><mo>+</mo><mn>1</mn></mrow></mfrac></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Z_{G}^{(2)-}(\bm{\lambda},\bm{\mu})\coloneqq\prod_{v\in V(G)}Z^{(2)}_{K_{d_{v}+1}}(\lambda_{v},\mu_{v})^{\frac{1}{d_{v}+1}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p2.2" class="ltx_p">Then <a href="#S1.Thmtheorem4" title="Theorem 1.4. ‣ 1 Introduction ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">1.4</span></a> states that <math id="S3.p2.m5" class="ltx_Math" alttext="Z^{(2)}_{G}(\bm{\lambda},\bm{\mu})\geq Z_{G}^{(2)-}(\bm{\lambda},\bm{\mu})" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>Z</mi><mi>G</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝝀</mi><mo>,</mo><mi>𝝁</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><msubsup><mi>Z</mi><mi>G</mi><mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><mo>−</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝝀</mi><mo>,</mo><mi>𝝁</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Z^{(2)}_{G}(\bm{\lambda},\bm{\mu})\geq Z_{G}^{(2)-}(\bm{\lambda},\bm{\mu})</annotation></semantics></math> for all <math id="S3.p2.m6" class="ltx_Math" alttext="\bm{\lambda},\bm{\mu}\in(\mathbb{R}_{\geq 0})^{V(G)}" display="inline" intent=":literal"><semantics><mrow><mi>𝝀</mi><mo>,</mo><mrow><mi>𝝁</mi><mo>∈</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>ℝ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\bm{\lambda},\bm{\mu}\in(\mathbb{R}_{\geq 0})^{V(G)}</annotation></semantics></math>. To prove this inequality, we again use the idea of ‘conditioning on the state assigned to <math id="S3.p2.m7" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math>’ to obtain a recurrence.</p>
</div>
<div id="S3.p3" class="ltx_para">
<p id="S3.p3.1" class="ltx_p">To elaborate, we proceed by induction on <math id="S3.p3.m1" class="ltx_Math" alttext="\lvert V(G)\rvert" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">\lvert V(G)\rvert</annotation></semantics></math>, where the base case <math id="S3.p3.m2" class="ltx_Math" alttext="\lvert V(G)\rvert=1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\lvert V(G)\rvert=1</annotation></semantics></math> holds clearly.
Let <math id="S3.p3.m3" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math> be a vertex in <math id="S3.p3.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> with maximum degree <math id="S3.p3.m5" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math>. Fix <math id="S3.p3.m6" class="ltx_Math" alttext="\bm{\lambda},\bm{\mu}\in(\mathbb{R}_{\geq 0})^{V(G)}" display="inline" intent=":literal"><semantics><mrow><mi>𝝀</mi><mo>,</mo><mrow><mi>𝝁</mi><mo>∈</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>ℝ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\bm{\lambda},\bm{\mu}\in(\mathbb{R}_{\geq 0})^{V(G)}</annotation></semantics></math> and let <math id="S3.p3.m7" class="ltx_Math" alttext="\bm{\lambda}^{\prime}\coloneqq(\lambda_{v})_{v\in V(G\setminus w)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝝀</mi><mo>′</mo></msup><mo>≔</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>v</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>v</mi><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>G</mi><mo>∖</mo><mi>w</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\bm{\lambda}^{\prime}\coloneqq(\lambda_{v})_{v\in V(G\setminus w)}</annotation></semantics></math> and <math id="S3.p3.m8" class="ltx_Math" alttext="\bm{\mu}^{\prime}\coloneqq(\mu_{v})_{v\in V(G\setminus w)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝝁</mi><mo>′</mo></msup><mo>≔</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>μ</mi><mi>v</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>v</mi><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>G</mi><mo>∖</mo><mi>w</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\bm{\mu}^{\prime}\coloneqq(\mu_{v})_{v\in V(G\setminus w)}</annotation></semantics></math>. The recurrence relation obtained by fixing the image of <math id="S3.p3.m9" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math> in <math id="S3.p3.m10" class="ltx_Math" alttext="K_{3}^{\circ}" display="inline" intent=":literal"><semantics><msubsup><mi>K</mi><mn>3</mn><mo>∘</mo></msubsup><annotation encoding="application/x-tex">K_{3}^{\circ}</annotation></semantics></math> is</p>
<table id="S3.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex2.m1" class="ltx_Math" alttext="Z^{(2)}_{G}(\bm{\lambda},\bm{\mu})=Z^{(2)}_{G\setminus w}(\bm{\lambda}^{\prime},\bm{\mu}^{\prime})+\lambda_{w}Z^{(2)}_{G\setminus w}(\bm{\lambda}^{\prime},\bm{\mu}^{\prime})|_{\lambda_{v}=0,\,v\in N(w)}+\mu_{w}Z^{(2)}_{G\setminus w}(\bm{\lambda}^{\prime},\bm{\mu}^{\prime})|_{\mu_{v}=0,\,v\in N(w)}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>Z</mi><mi>G</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝝀</mi><mo>,</mo><mi>𝝁</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msubsup><mi>Z</mi><mrow><mi>G</mi><mo>∖</mo><mi>w</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝀</mi><mo>′</mo></msup><mo>,</mo><msup><mi>𝝁</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mrow><mrow><msub><mi>λ</mi><mi>w</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>Z</mi><mrow><mi>G</mi><mo>∖</mo><mi>w</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝀</mi><mo>′</mo></msup><mo>,</mo><msup><mi>𝝁</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mrow><mrow><msub><mi>λ</mi><mi>v</mi></msub><mo>=</mo><mn>0</mn></mrow><mo rspace="0.337em">,</mo><mrow><mi>v</mi><mo>∈</mo><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></msub><mo>+</mo><msub><mrow><mrow><msub><mi>μ</mi><mi>w</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>Z</mi><mrow><mi>G</mi><mo>∖</mo><mi>w</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝀</mi><mo>′</mo></msup><mo>,</mo><msup><mi>𝝁</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mrow><mrow><msub><mi>μ</mi><mi>v</mi></msub><mo>=</mo><mn>0</mn></mrow><mo rspace="0.337em">,</mo><mrow><mi>v</mi><mo>∈</mo><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Z^{(2)}_{G}(\bm{\lambda},\bm{\mu})=Z^{(2)}_{G\setminus w}(\bm{\lambda}^{\prime},\bm{\mu}^{\prime})+\lambda_{w}Z^{(2)}_{G\setminus w}(\bm{\lambda}^{\prime},\bm{\mu}^{\prime})|_{\lambda_{v}=0,\,v\in N(w)}+\mu_{w}Z^{(2)}_{G\setminus w}(\bm{\lambda}^{\prime},\bm{\mu}^{\prime})|_{\mu_{v}=0,\,v\in N(w)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p3.2" class="ltx_p">Using the induction hypothesis, it suffices to show that</p>
