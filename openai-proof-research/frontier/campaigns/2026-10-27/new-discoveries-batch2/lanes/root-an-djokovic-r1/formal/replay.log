def AnDjokovic.doubleStar.{u_1} : {R : Type u_1} → [CommRing R] → ℕ → ℕ → (ℕ → R) → R :=
fun {R} [CommRing R] n k x => (∏ i ∈ Icc 1 k, (x n - x i)) * ∏ i ∈ Ico (k + 1) n, (x i - x 1)
def AnDjokovic.twoLevel.{u_1} : {R : Type u_1} → [CommRing R] → ℕ → R → ℕ → R :=
fun {R} [CommRing R] j t i => if i ≤ j then t else 1
def AnDjokovic.sourcePairs : ℕ → ℕ → Finset (ℕ × ℕ) :=
fun n k => {p ∈ Icc 1 n ×ˢ Icc 1 n | p.1 + 1 < p.2 ∨ p.1 = n ∧ p.2 ≤ k ∨ p.2 = 1 ∧ k < p.1 ∧ p.1 < n}
def AnDjokovic.sourcePolynomial : ℕ → ℕ → MvPolynomial ℕ ℤ :=
fun n k => ∏ p ∈ sourcePairs n k, (MvPolynomial.X p.1 - MvPolynomial.X p.2)
def AnDjokovic.vandermonde : ℕ → MvPolynomial ℕ ℤ :=
fun n => ∏ p ∈ Icc 1 n ×ˢ Icc 1 n with p.1 < p.2, (MvPolynomial.X p.1 - MvPolynomial.X p.2)
def AnDjokovic.sourceInner : ℕ → ℕ → ℤ :=
fun n k => ∑ d ∈ (sourcePolynomial n k).support, (sourcePolynomial n k).coeff d * (vandermonde n).coeff d
def AnDjokovic.doubleStarPolynomial : ℕ → ℕ → MvPolynomial ℕ ℤ :=
fun n k => doubleStar n k MvPolynomial.X
AnDjokovic.numerator_twoLevel (n k j : ℕ) (t : ℤ) (hk : 1 ≤ k) (hkn : k < n) (hjn : j < n) :
  (MvPolynomial.eval (twoLevel j t)) (doubleStarPolynomial n k) = if j = k then (1 - t) ^ (n - 1) else 0
'AnDjokovic.numerator_twoLevel' depends on axioms: [propext, Classical.choice, Quot.sound]
AnDjokovic.twoGroup_evaluation (n k : ℕ) (hk : 1 ≤ k) (hkn : k < n) :
  -((-1) ^ k * ↑((n - 2).choose (k - 1))) * ((-1) ^ (n - k) * ↑((n - 1).choose (k - 1))) +
      (-1) ^ k * ↑((n - 2).choose (k - 1)) * ((-1) ^ (n - (k + 1)) * ↑((n - 1).choose k)) =
    (-1) ^ (n - 1) * ↑(n.choose k) * ↑((n - 2).choose (k - 1))
'AnDjokovic.twoGroup_evaluation' depends on axioms: [propext, Quot.sound]
AnDjokovic.sourceInner (n k : ℕ) : ℤ
AnDjokovic.doubleStar_twoLevel.{u_1} {R : Type u_1} [CommRing R] (n k j : ℕ) (t : R) (hk : 1 ≤ k) (hkn : k < n)
  (hjn : j < n) : doubleStar n k (twoLevel j t) = if j = k then (1 - t) ^ (n - 1) else 0
'AnDjokovic.doubleStar_twoLevel' depends on axioms: [propext, Classical.choice, Quot.sound]
AnDjokovic.alternating_tail (n k : ℕ) (hk : 1 ≤ k) (hkn : k < n) :
  ∑ d ∈ Ico k n, (-1) ^ d * ↑((n - 1).choose d) = (-1) ^ k * ↑((n - 2).choose (k - 1))
'AnDjokovic.alternating_tail' depends on axioms: [propext, Classical.choice, Quot.sound]
AnDjokovic.prefixDefect_antitone (a : ℕ → ℕ) (n : ℕ) (ha : ∀ (i : ℕ), 2 ≤ i → i ≤ n - 1 → a i ≤ 1) :
  AntitoneOn (fun j => ∑ i ∈ Icc 1 j, ↑(a i) - ↑j) (Set.Icc 1 (n - 1))
'AnDjokovic.prefixDefect_antitone' depends on axioms: [propext, Classical.choice, Quot.sound]
