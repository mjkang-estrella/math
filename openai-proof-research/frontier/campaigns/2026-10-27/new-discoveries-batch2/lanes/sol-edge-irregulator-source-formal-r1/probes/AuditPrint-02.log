def EdgeIrregulator.SourceClaim : Prop :=
∃ c,
  1 ≤ c ∧
    ∀ (n : ℕ) (G : SimpleGraph (Fin n)),
      G.Connected → ∃ S, EdgeIrregulator.Valid G S ∧ ↑S.card ≤ ↑G.edgeFinset.card / 3 + c
def EdgeIrregulator.MinimumSourceClaim : Prop :=
∃ c,
  1 ≤ c ∧ ∀ (n : ℕ) (G : SimpleGraph (Fin n)), G.Connected → ↑(EdgeIrregulator.minimum G) ≤ ↑G.edgeFinset.card / 3 + c
