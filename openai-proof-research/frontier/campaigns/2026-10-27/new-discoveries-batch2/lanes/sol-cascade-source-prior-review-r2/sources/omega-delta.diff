+private lemma tsum_interval (r : ℕ) (k : ℤ) (f : ℤ → ℂ)
+    (hf : ∀ z, (r : ℤ) < |z - k| → f z = 0) :
+    ∑' z, f z = ∑ z ∈ Finset.Icc (k - r) (k + r), f z := by
