+theorem paritySign_pow (n : ℕ) : paritySign n * (2 : ℤ) ^ n = (-2 : ℤ) ^ n := by
+  induction n with
+  | zero => simp
+  | succ n ih => rw [paritySign_succ, pow_succ, pow_succ, ← ih]; ring
+
+/-- A SMALL departure followed by a free number of LARGE steps, with its
