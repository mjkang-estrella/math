<p id="S6.F4.2" class="ltx_p ltx_figure_panel ltx_align_center"><span id="S6.F4.2.1" class="ltx_text">

 </span>
<span id="S6.F4.2.2" class="ltx_text">
  </span></p></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
<figure id="S6.F4.sf1" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="0804.3989v1/data.png" id="S6.F4.sf1.g1" class="ltx_graphics ltx_img_portrait" style="aspect-ratio:248/351;" width="248" height="351" alt="Refer to caption">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="S6.F4.sf1.3" class="ltx_text" style="font-size:80%;">(a)</span> </span><span id="S6.F4.sf1.4" class="ltx_text" style="font-size:80%;">Data</span></figcaption>
</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_2">
