<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.E14.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad-\int_{K}\log\left(\det DT_{-}(x)\det DT_{+}(x)\right)\,d\nu_{1}(x)." display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><msub><mo>∫</mo><mi>K</mi></msub></mstyle><mi>log</mi><mrow><mo>(</mo><mo lspace="0em" movablelimits="false" rspace="0.167em">det</mo><mi>D</mi><msub><mi>T</mi><mo>−</mo></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" movablelimits="false" rspace="0.167em">det</mo><mi>D</mi><msub><mi>T</mi><mo>+</mo></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.170em">)</mo></mrow><mi>d</mi><msub><mi>ν</mi><mn>1</mn></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad-\int_{K}\log\left(\det DT_{-}(x)\det DT_{+}(x)\right)\,d\nu_{1}(x).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(14)</span></td></tr></tbody>
</table>
</div>
<div id="S6.p20" class="ltx_para">
<p id="S6.p20.1" class="ltx_p"><span id="S6.p20.1.1" class="ltx_text">The Monge–Ampère change-of-variables identity</span></p>
<table id="S6.Ex125" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex125.m1" class="ltx_Math" alttext="n_{2}(T(x))\det DT(x)=n_{1}(x)" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>n</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mo movablelimits="false" rspace="0.167em">det</mo><mrow><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>=</mo><mrow><msub><mi>n</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">n_{2}(T(x))\det DT(x)=n_{1}(x)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p20.2" class="ltx_p"><span id="S6.p20.2.1" class="ltx_text">similarly gives</span></p>
<table id="S6.E15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.E15.m1" class="ltx_math_unparsed" alttext="H(\nu_{2}\mid\lambda)=H(\nu_{1}\mid\lambda)-\int_{K}\log\det DT(x)\,d\nu_{1}(x)." display="block" intent=":literal"><semantics><mrow><mi>H</mi><mrow><mo stretchy="false">(</mo><msub><mi>ν</mi><mn>2</mn></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>H</mi><mrow><mo stretchy="false">(</mo><msub><mi>ν</mi><mn>1</mn></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.055em">−</mo><msub><mo>∫</mo><mi>K</mi></msub><mi>log</mi><mo lspace="0.167em" movablelimits="false" rspace="0.167em">det</mo><mi>D</mi><mi>T</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0.170em" stretchy="false">)</mo></mrow><mi>d</mi><msub><mi>ν</mi><mn>1</mn></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">H(\nu_{2}\mid\lambda)=H(\nu_{1}\mid\lambda)-\int_{K}\log\det DT(x)\,d\nu_{1}(x).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(15)</span></td></tr></tbody>
</table>
<p id="S6.p20.3" class="ltx_p"><span id="S6.p20.3.1" class="ltx_text">Hence</span></p>
<table id="S6.EGx14" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S6.E16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S6.E16.m1" class="ltx_Math" alttext="\displaystyle H(\nu_{1}\mid\lambda)+H(\nu_{2}\mid\lambda)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ν</mi><mn>1</mn></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ν</mi><mn>2</mn></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle H(\nu_{1}\mid\lambda)+H(\nu_{2}\mid\lambda)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.E16.m2" class="ltx_math_unparsed" alttext="\displaystyle=2H(\nu_{1}\mid\lambda)-\int_{K}\log\det DT(x)\,d\nu_{1}(x)." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mn>2</mn><mi>H</mi><mrow><mo stretchy="false">(</mo><msub><mi>ν</mi><mn>1</mn></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mstyle displaystyle="true"><msub><mo>∫</mo><mi>K</mi></msub></mstyle><mi>log</mi><mo lspace="0.167em" movablelimits="false" rspace="0.167em">det</mo><mi>D</mi><mi>T</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0.170em" stretchy="false">)</mo></mrow><mi>d</mi><msub><mi>ν</mi><mn>1</mn></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=2H(\nu_{1}\mid\lambda)-\int_{K}\log\det DT(x)\,d\nu_{1}(x).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(16)</span></td></tr></tbody>
</table>
</div>
<div id="S6.p21" class="ltx_para">
<p id="S6.p21.1" class="ltx_p"><span id="S6.p21.1.1" class="ltx_text">By (<a href="#S6.E11" title="In Proof. ‣ 6 A transport proof of the min–max entropy inequality ‣ Four Function Theorems Through Optimal Transport and Entropic Analogs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>),</span></p>
<table id="S6.Ex126" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex126.m1" class="ltx_math_unparsed" alttext="\log\left(\det DT_{-}(x)\det DT_{+}(x)\right)\geq\log\det DT(x)." display="block" intent=":literal"><semantics><mrow><mi>log</mi><mrow><mo>(</mo><mo lspace="0em" movablelimits="false" rspace="0.167em">det</mo><mi>D</mi><msub><mi>T</mi><mo>−</mo></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" movablelimits="false" rspace="0.167em">det</mo><mi>D</mi><msub><mi>T</mi><mo>+</mo></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>≥</mo><mi>log</mi><mo lspace="0.167em" movablelimits="false" rspace="0.167em">det</mo><mi>D</mi><mi>T</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\log\left(\det DT_{-}(x)\det DT_{+}(x)\right)\geq\log\det DT(x).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p21.2" class="ltx_p"><span id="S6.p21.2.1" class="ltx_text">Comparing (<a href="#S6.E14" title="In Proof. ‣ 6 A transport proof of the min–max entropy inequality ‣ Four Function Theorems Through Optimal Transport and Entropic Analogs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>) with
(<a href="#S6.E16" title="In Proof. ‣ 6 A transport proof of the min–max entropy inequality ‣ Four Function Theorems Through Optimal Transport and Entropic Analogs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>) proves the result.
∎</span></p>
</div>
</div>
<div id="S6.p22" class="ltx_para">
<p id="S6.p22.1" class="ltx_p">We can now remove the regularity assumptions to prove the theorem in full generality.</p>
</div>
<div id="S6.6" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Theorem <a href="#S3.Thmthm3" title="Theorem 3.3. ‣ 3 The Euclidean Ahlswede–Daykin 4-function theorem ‣ Four Function Theorems Through Optimal Transport and Entropic Analogs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.3</span></a>.</h6>
<div id="S6.p23" class="ltx_para">
<p id="S6.p23.1" class="ltx_p"><span id="S6.p23.1.1" class="ltx_text">For an absolutely continuous measure in <math id="S6.p23.m1" class="ltx_Math" alttext="\mathcal{P}_{2}(\mathbb{R}^{d})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>ℝ</mi><mi>d</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{P}_{2}(\mathbb{R}^{d})</annotation></semantics></math>,
the entropy relative to Lebesgue measure is bounded below by a finite
quantity. Thus
<math id="S6.p23.m2" class="ltx_math_unparsed" alttext="H(\nu\mid\lambda)\in(-\infty,+\infty]" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mrow><mo stretchy="false">(</mo><mi>ν</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi mathvariant="normal">∞</mi><mo rspace="0em">,</mo><mo lspace="0em">+</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">H(\nu\mid\lambda)\in(-\infty,+\infty]</annotation></semantics></math>.
If
<math id="S6.p23.m3" class="ltx_Math" alttext="H(\nu_{1}\mid\lambda)+H(\nu_{2}\mid\lambda)=+\infty" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ν</mi><mn>1</mn></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ν</mi><mn>2</mn></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></mrow><annotation encoding="application/x-tex">H(\nu_{1}\mid\lambda)+H(\nu_{2}\mid\lambda)=+\infty</annotation></semantics></math>,
the desired inequality is automatic. We may therefore assume that
both terms on the right-hand side are finite.</span></p>
</div>
<div id="S6.p24" class="ltx_para">
<p id="S6.p24.1" class="ltx_p"><span id="S6.p24.1.1" class="ltx_text">For every absolutely continuous <math id="S6.p24.m1" class="ltx_Math" alttext="\nu\in\mathcal{P}_{2}(\mathbb{R}^{d})" display="inline" intent=":literal"><semantics><mrow><mi>ν</mi><mo>∈</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>ℝ</mi><mi>d</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\nu\in\mathcal{P}_{2}(\mathbb{R}^{d})</annotation></semantics></math>,</span></p>
<table id="S6.E17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.E17.m1" class="ltx_Math" alttext="H(\nu\mid\gamma)=H(\nu\mid\lambda)+\frac{1}{2}\int_{\mathbb{R}^{d}}|x|^{2}\,d\nu(x)+\frac{d}{2}\log(2\pi)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ν</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ν</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mo rspace="0em">∫</mo><msup><mi>ℝ</mi><mi>d</mi></msup></msub><mrow><msup><mrow><mo stretchy="false">|</mo><mi>x</mi><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>ν</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mfrac><mi>d</mi><mn>2</mn></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">H(\nu\mid\gamma)=H(\nu\mid\lambda)+\frac{1}{2}\int_{\mathbb{R}^{d}}|x|^{2}\,d\nu(x)+\frac{d}{2}\log(2\pi).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(17)</span></td></tr></tbody>
</table>
<p id="S6.p24.2" class="ltx_p"><span id="S6.p24.2.1" class="ltx_text">It follows that
<math id="S6.p24.m2" class="ltx_Math" alttext="H(\nu_{1}\mid\gamma)+H(\nu_{2}\mid\gamma)&lt;\infty" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ν</mi><mn>1</mn></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ν</mi><mn>2</mn></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>&lt;</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">H(\nu_{1}\mid\gamma)+H(\nu_{2}\mid\gamma)&lt;\infty</annotation></semantics></math>.</span></p>
</div>
<div id="S6.p25" class="ltx_para">
<p id="S6.p25.1" class="ltx_p"><span id="S6.p25.1.1" class="ltx_text">Choose the approximating measures <math id="S6.p25.m1" class="ltx_Math" alttext="\nu_{1}^{k},\nu_{2}^{k}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ν</mi><mn>1</mn><mi>k</mi></msubsup><mo>,</mo><msubsup><mi>ν</mi><mn>2</mn><mi>k</mi></msubsup></mrow><annotation encoding="application/x-tex">\nu_{1}^{k},\nu_{2}^{k}</annotation></semantics></math> supplied by
Lemma <a href="#S6.Thmthm2" title="Lemma 6.2. ‣ 6 A transport proof of the min–max entropy inequality ‣ Four Function Theorems Through Optimal Transport and Entropic Analogs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.2</span></a>, and let <math id="S6.p25.m2" class="ltx_Math" alttext="\pi_{k}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\pi_{k}</annotation></semantics></math> be their
quadratic optimal couplings. Define
<math id="S6.p25.m3" class="ltx_Math" alttext="\nu_{-}^{k}=(m_{-})_{\#}\pi_{k}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ν</mi><mo>−</mo><mi>k</mi></msubsup><mo>=</mo><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><mi>#</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mi>k</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\nu_{-}^{k}=(m_{-})_{\#}\pi_{k}</annotation></semantics></math> and <math id="S6.p25.m4" class="ltx_Math" alttext="\nu_{+}^{k}=(m_{+})_{\#}\pi_{k}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ν</mi><mo>+</mo><mi>k</mi></msubsup><mo>=</mo><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow><mi>#</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mi>k</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\nu_{+}^{k}=(m_{+})_{\#}\pi_{k}</annotation></semantics></math>.
By Lemma <a href="#S6.Thmthm4" title="Lemma 6.4. ‣ 6 A transport proof of the min–max entropy inequality ‣ Four Function Theorems Through Optimal Transport and Entropic Analogs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.4</span></a>,</span></p>
<table id="S6.E18" class="ltx_equation ltx_eqn_table">

