<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex149.m1" class="ltx_Math" alttext="\nu_{3}=(M_{\alpha}^{s})_{\#}\pi,\qquad\nu_{4}=(M_{\beta}^{t})_{\#}\pi." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>ν</mi><mn>3</mn></msub><mo>=</mo><mrow><msub><mrow><mo stretchy="false">(</mo><msubsup><mi>M</mi><mi>α</mi><mi>s</mi></msubsup><mo stretchy="false">)</mo></mrow><mi>#</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>π</mi></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mi>ν</mi><mn>4</mn></msub><mo>=</mo><mrow><msub><mrow><mo stretchy="false">(</mo><msubsup><mi>M</mi><mi>β</mi><mi>t</mi></msubsup><mo stretchy="false">)</mo></mrow><mi>#</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>π</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\nu_{3}=(M_{\alpha}^{s})_{\#}\pi,\qquad\nu_{4}=(M_{\beta}^{t})_{\#}\pi.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.Thmthm6.p1.3" class="ltx_p"><span id="S7.Thmthm6.p1.3.1" class="ltx_text ltx_font_italic">Then</span></p>
<table id="S7.E24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.E24.m1" class="ltx_Math" alttext="rH(\nu_{3}\mid\lambda)+(1-r)H(\nu_{4}\mid\lambda)\leq mH(\nu_{1}\mid\lambda)+(1-m)H(\nu_{2}\mid\lambda)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ν</mi><mn>3</mn></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ν</mi><mn>4</mn></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ν</mi><mn>1</mn></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ν</mi><mn>2</mn></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">rH(\nu_{3}\mid\lambda)+(1-r)H(\nu_{4}\mid\lambda)\leq mH(\nu_{1}\mid\lambda)+(1-m)H(\nu_{2}\mid\lambda).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(24)</span></td></tr></tbody>
</table>
<p id="S7.Thmthm6.p1.4" class="ltx_p"><span id="S7.Thmthm6.p1.4.1" class="ltx_text ltx_font_italic">Moreover, if nonnegative integrable functions <math id="S7.Thmthm6.p1.m7" class="ltx_Math" alttext="f_{1},f_{2},f_{3},f_{4}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>1</mn></msub><mo>,</mo><msub><mi>f</mi><mn>2</mn></msub><mo>,</mo><msub><mi>f</mi><mn>3</mn></msub><mo>,</mo><msub><mi>f</mi><mn>4</mn></msub></mrow><annotation encoding="application/x-tex">f_{1},f_{2},f_{3},f_{4}</annotation></semantics></math>
on <math id="S7.Thmthm6.p1.m8" class="ltx_Math" alttext="(0,\infty)^{d}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow><mi>d</mi></msup><annotation encoding="application/x-tex">(0,\infty)^{d}</annotation></semantics></math> satisfy</span></p>
<table id="S7.E25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.E25.m1" class="ltx_Math" alttext="f_{1}(x)^{m}f_{2}(y)^{1-m}\leq f_{3}\bigl(M_{\alpha}^{s}(x,y)\bigr)^{r}f_{4}\bigl(M_{\beta}^{t}(x,y)\bigr)^{1-r}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>f</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mi>m</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mi>m</mi></mrow></msup></mrow><mo>≤</mo><mrow><msub><mi>f</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msubsup><mi>M</mi><mi>α</mi><mi>s</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mi>r</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mn>4</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msubsup><mi>M</mi><mi>β</mi><mi>t</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mi>r</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">f_{1}(x)^{m}f_{2}(y)^{1-m}\leq f_{3}\bigl(M_{\alpha}^{s}(x,y)\bigr)^{r}f_{4}\bigl(M_{\beta}^{t}(x,y)\bigr)^{1-r}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(25)</span></td></tr></tbody>
</table>
<p id="S7.Thmthm6.p1.5" class="ltx_p"><span id="S7.Thmthm6.p1.5.1" class="ltx_text ltx_font_italic">for all <math id="S7.Thmthm6.p1.m9" class="ltx_Math" alttext="x,y\in(0,\infty)^{d}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow><mo>∈</mo><msup><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">x,y\in(0,\infty)^{d}</annotation></semantics></math>, then</span></p>
<table id="S7.E26" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.E26.m1" class="ltx_Math" alttext="\left(\int_{(0,\infty)^{d}}f_{1}\right)^{m}\left(\int_{(0,\infty)^{d}}f_{2}\right)^{1-m}\leq\left(\int_{(0,\infty)^{d}}f_{3}\right)^{r}\left(\int_{(0,\infty)^{d}}f_{4}\right)^{1-r}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mrow><mo>(</mo><mrow><msub><mo lspace="0em">∫</mo><msup><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow><mi>d</mi></msup></msub><msub><mi>f</mi><mn>1</mn></msub></mrow><mo>)</mo></mrow><mi>m</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msub><mo lspace="0em">∫</mo><msup><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow><mi>d</mi></msup></msub><msub><mi>f</mi><mn>2</mn></msub></mrow><mo>)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mi>m</mi></mrow></msup></mrow><mo>≤</mo><mrow><msup><mrow><mo>(</mo><mrow><msub><mo lspace="0em">∫</mo><msup><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow><mi>d</mi></msup></msub><msub><mi>f</mi><mn>3</mn></msub></mrow><mo>)</mo></mrow><mi>r</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msub><mo lspace="0em">∫</mo><msup><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow><mi>d</mi></msup></msub><msub><mi>f</mi><mn>4</mn></msub></mrow><mo>)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mi>r</mi></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left(\int_{(0,\infty)^{d}}f_{1}\right)^{m}\left(\int_{(0,\infty)^{d}}f_{2}\right)^{1-m}\leq\left(\int_{(0,\infty)^{d}}f_{3}\right)^{r}\left(\int_{(0,\infty)^{d}}f_{4}\right)^{1-r}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(26)</span></td></tr></tbody>
</table>
<p id="S7.Thmthm6.p1.6" class="ltx_p"><span id="S7.Thmthm6.p1.6.1" class="ltx_text ltx_font_italic">The scalar condition (<a href="#S7.E23" title="In Theorem 7.6 (A scalar criterion for power-mean inequalities). ‣ 7.2 A scalar criterion and its transport proof ‣ 7 Connections with Prékopa–Leindler in the continuous setting ‣ Four Function Theorems Through Optimal Transport and Entropic Analogs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a>) is necessary
for either assertion to hold for all admissible inputs, already in
dimension one.</span></p>
</div>
</div>
<div id="S7.SS2.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S7.SS2.p5" class="ltx_para">
<p id="S7.SS2.p5.1" class="ltx_p"><em id="S7.SS2.p5.1.1" class="ltx_emph ltx_font_italic">Entropy inequality for regular densities.</em><span id="S7.SS2.p5.1.2" class="ltx_text">
We first assume that <math id="S7.SS2.p5.m1" class="ltx_Math" alttext="\nu_{1},\nu_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ν</mi><mn>1</mn></msub><mo>,</mo><msub><mi>ν</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\nu_{1},\nu_{2}</annotation></semantics></math> have densities smooth on the
closure and bounded above and below by positive constants on a
common bounded, smooth, uniformly convex domain
<math id="S7.SS2.p5.m2" class="ltx_Math" alttext="\Omega\Subset(0,\infty)^{d}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ω</mi><mo>⋐</mo><msup><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\Omega\Subset(0,\infty)^{d}</annotation></semantics></math>. Under these assumptions the global
regularity theory for the second boundary value problem for the
Monge–Ampère equation <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib1" title="" class="ltx_ref">9</a>, <a href="#bib.bib2" title="" class="ltx_ref">10</a>]</cite>, used also in
Lemma <a href="#S6.Thmthm4" title="Lemma 6.4. ‣ 6 A transport proof of the min–max entropy inequality ‣ Four Function Theorems Through Optimal Transport and Entropic Analogs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.4</span></a>, gives a <math id="S7.SS2.p5.m3" class="ltx_Math" alttext="C^{1}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mn>1</mn></msup><annotation encoding="application/x-tex">C^{1}</annotation></semantics></math>
diffeomorphism <math id="S7.SS2.p5.m4" class="ltx_Math" alttext="T\colon\Omega\to\Omega" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Ω</mi><mo stretchy="false">→</mo><mi mathvariant="normal">Ω</mi></mrow></mrow><annotation encoding="application/x-tex">T\colon\Omega\to\Omega</annotation></semantics></math> for which
<math id="S7.SS2.p5.m5" class="ltx_Math" alttext="A(x):=DT(x)=D^{2}\varphi(x)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>D</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>φ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">A(x):=DT(x)=D^{2}\varphi(x)</annotation></semantics></math> is symmetric and positive definite.</span></p>
</div>
<div id="S7.SS2.p6" class="ltx_para">
<p id="S7.SS2.p6.1" class="ltx_p"><span id="S7.SS2.p6.1.1" class="ltx_text">Put <math id="S7.SS2.p6.m1" class="ltx_Math" alttext="(q_{3},\theta_{3})=(\alpha,s)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mn>3</mn></msub><mo>,</mo><msub><mi>θ</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo>,</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(q_{3},\theta_{3})=(\alpha,s)</annotation></semantics></math> and
<math id="S7.SS2.p6.m2" class="ltx_Math" alttext="(q_{4},\theta_{4})=(\beta,t)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mn>4</mn></msub><mo>,</mo><msub><mi>θ</mi><mn>4</mn></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>β</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(q_{4},\theta_{4})=(\beta,t)</annotation></semantics></math>, and set</span></p>
<table id="S7.Ex150" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex150.m1" class="ltx_math_unparsed" alttext="G_{j}(x)=M_{q_{j}}^{\theta_{j}}(x,T(x)),\qquad j=3,4." display="block" intent=":literal"><semantics><mrow><msub><mi>G</mi><mi>j</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msubsup><mi>M</mi><msub><mi>q</mi><mi>j</mi></msub><msub><mi>θ</mi><mi>j</mi></msub></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>T</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo rspace="2.167em">,</mo><mi>j</mi><mo>=</mo><mn>3</mn><mo>,</mo><mn>4</mn><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">G_{j}(x)=M_{q_{j}}^{\theta_{j}}(x,T(x)),\qquad j=3,4.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS2.p6.2" class="ltx_p"><span id="S7.SS2.p6.2.1" class="ltx_text">Differentiating coordinatewise gives <math id="S7.SS2.p6.m3" class="ltx_Math" alttext="DG_{j}=U_{j}+V_{j}A" display="inline" intent=":literal"><semantics><mrow><mrow><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>G</mi><mi>j</mi></msub></mrow><mo>=</mo><mrow><msub><mi>U</mi><mi>j</mi></msub><mo>+</mo><mrow><msub><mi>V</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">DG_{j}=U_{j}+V_{j}A</annotation></semantics></math>, where</span></p>
<table id="S7.Ex151" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex151.m1" class="ltx_Math" alttext="(U_{j})_{ii}=\partial_{1}M_{q_{j}}^{\theta_{j}}(x_{i},T_{i}(x)),\qquad(V_{j})_{ii}=\partial_{2}M_{q_{j}}^{\theta_{j}}(x_{i},T_{i}(x))." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi>U</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo rspace="0.111em">=</mo><mrow><msub><mo>∂</mo><mn>1</mn></msub><mrow><msubsup><mi>M</mi><msub><mi>q</mi><mi>j</mi></msub><msub><mi>θ</mi><mi>j</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo rspace="0.111em">=</mo><mrow><msub><mo>∂</mo><mn>2</mn></msub><mrow><msubsup><mi>M</mi><msub><mi>q</mi><mi>j</mi></msub><msub><mi>θ</mi><mi>j</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(U_{j})_{ii}=\partial_{1}M_{q_{j}}^{\theta_{j}}(x_{i},T_{i}(x)),\qquad(V_{j})_{ii}=\partial_{2}M_{q_{j}}^{\theta_{j}}(x_{i},T_{i}(x)).</annotation></semantics></math></td>
