space="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ν</mi><mn>2</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\int_{\mathbb{R}^{d}}|z|^{2}\,d\nu_{-}^{k}(z)+\int_{\mathbb{R}^{d}}|z|^{2}\,d\nu_{+}^{k}(z)=\int_{\mathbb{R}^{d}}|x|^{2}\,d\nu_{1}^{k}(x)+\int_{\mathbb{R}^{d}}|y|^{2}\,d\nu_{2}^{k}(y).</annotation></semantics></math></td>
