<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex106.m1" class="ltx_Math" alttext="(m_{-})_{\#}\pi_{j}\longrightarrow(m_{-})_{\#}\pi,\qquad(m_{+})_{\#}\pi_{j}\longrightarrow(m_{+})_{\#}\pi" display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><mi>#</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mi>j</mi></msub></mrow><mo stretchy="false">⟶</mo><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><mi>#</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>π</mi></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow><mi>#</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mi>j</mi></msub></mrow><mo stretchy="false">⟶</mo><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow><mi>#</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>π</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">(m_{-})_{\#}\pi_{j}\longrightarrow(m_{-})_{\#}\pi,\qquad(m_{+})_{\#}\pi_{j}\longrightarrow(m_{+})_{\#}\pi</annotation></semantics></math></td>
