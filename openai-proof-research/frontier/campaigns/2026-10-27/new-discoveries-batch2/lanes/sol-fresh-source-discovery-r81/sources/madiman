<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S7.Ex152.m1" class="ltx_Math" alttext="\displaystyle(\det DG_{3})^{r}(\det DG_{4})^{1-r}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" movablelimits="false" rspace="0.167em">det</mo><mrow><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>G</mi><mn>3</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mi>r</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" movablelimits="false" rspace="0.167em">det</mo><mrow><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>G</mi><mn>4</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mi>r</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle(\det DG_{3})^{r}(\det DG_{4})^{1-r}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex152.m2" class="ltx_Math" alttext="\displaystyle\geq\prod_{i=1}^{d}D_{\alpha,s}(x_{i},T_{i}(x);\delta_{i})^{r}D_{\beta,t}(x_{i},T_{i}(x);\delta_{i})^{1-r}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover></mstyle><mrow><msub><mi>D</mi><mrow><mi>α</mi><mo>,</mo><mi>s</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>δ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mi>r</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>D</mi><mrow><mi>β</mi><mo>,</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>δ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mi>r</mi></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq\prod_{i=1}^{d}D_{\alpha,s}(x_{i},T_{i}(x);\delta_{i})^{r}D_{\beta,t}(x_{i},T_{i}(x);\delta_{i})^{1-r}</annotation></semantics></math></td>
