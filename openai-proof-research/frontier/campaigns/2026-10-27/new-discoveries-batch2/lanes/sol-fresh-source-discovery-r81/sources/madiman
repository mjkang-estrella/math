<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex105.m1" class="ltx_Math" alttext="W_{2}(\nu^{k},\nu^{R_{k}})\leq k^{-1},\qquad|H(\nu^{k}\mid\gamma)-H(\nu^{R_{k}}\mid\gamma)|\leq k^{-1};" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>W</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>ν</mi><mi>k</mi></msup><mo>,</mo><msup><mi>ν</mi><msub><mi>R</mi><mi>k</mi></msub></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><msup><mi>k</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mo stretchy="false">|</mo><mrow><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>ν</mi><mi>k</mi></msup><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>ν</mi><msub><mi>R</mi><mi>k</mi></msub></msup><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><msup><mi>k</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><mo>;</mo></mrow><annotation encoding="application/x-tex">W_{2}(\nu^{k},\nu^{R_{k}})\leq k^{-1},\qquad|H(\nu^{k}\mid\gamma)-H(\nu^{R_{k}}\mid\gamma)|\leq k^{-1};</annotation></semantics></math></td>
