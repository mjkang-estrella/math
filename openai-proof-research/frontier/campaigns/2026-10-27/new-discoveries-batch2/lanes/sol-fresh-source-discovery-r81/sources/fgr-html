<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex69.m1" class="ltx_Math" alttext="|G(b)-G(a)|\leq\frac{2\mu}{M}\log{\frac{1}{\mu}}+|b-a|\log{\frac{eD}{\mu}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow><mi>M</mi></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mn>1</mn><mi>μ</mi></mfrac></mrow></mrow><mo rspace="0em">+</mo></mrow></mrow><mo fence="false" lspace="0em">|</mo><mrow><mrow><mi>b</mi><mo>−</mo><mi>a</mi></mrow><mo fence="false">|</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow><mi>μ</mi></mfrac></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">|G(b)-G(a)|\leq\frac{2\mu}{M}\log{\frac{1}{\mu}}+|b-a|\log{\frac{eD}{\mu}},</annotation></semantics></math></td>
