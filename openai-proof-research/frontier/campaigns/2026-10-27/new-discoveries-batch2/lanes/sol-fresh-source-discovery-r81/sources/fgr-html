<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E26.m1" class="ltx_Math" alttext="p_{n+1}(k)\leq 3\cdot 4^{d+1}\frac{c_{2}(d)c_{2}^{\prime}(d,n)^{2}}{\sigma^{d}}e^{-\frac{\|k\|_{1}}{2\sigma c_{2}^{\prime}(d,n)}}\leq\frac{c_{2}^{\prime}(d,n+1)}{\sigma^{d}}e^{-\frac{\|k\|_{1}}{\sigma c_{2}^{\prime}(d,n+1)}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>p</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mn>3</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mn>4</mn><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><msub><mi>c</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>c</mi><mn>2</mn><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><mi>n</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><msup><mi>σ</mi><mi>d</mi></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mfrac><msub><mrow><mo stretchy="false">‖</mo><mi>k</mi><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>c</mi><mn>2</mn><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo mathsize="1.400em">,</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></msup></mrow><mo>≤</mo><mrow><mfrac><mrow><msubsup><mi>c</mi><mn>2</mn><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><msup><mi>σ</mi><mi>d</mi></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mfrac><msub><mrow><mo stretchy="false">‖</mo><mi>k</mi><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mrow><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>c</mi><mn>2</mn><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo mathsize="1.400em">,</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">p_{n+1}(k)\leq 3\cdot 4^{d+1}\frac{c_{2}(d)c_{2}^{\prime}(d,n)^{2}}{\sigma^{d}}e^{-\frac{\|k\|_{1}}{2\sigma c_{2}^{\prime}(d,n)}}\leq\frac{c_{2}^{\prime}(d,n+1)}{\sigma^{d}}e^{-\frac{\|k\|_{1}}{\sigma c_{2}^{\prime}(d,n+1)}},</annotation></semantics></math></td>
