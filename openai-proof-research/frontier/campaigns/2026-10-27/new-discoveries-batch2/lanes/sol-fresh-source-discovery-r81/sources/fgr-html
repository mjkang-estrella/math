<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.E40.m2" class="ltx_Math" alttext="\displaystyle=O_{d,n}\Bigl(\frac{\log{\sigma}}{\sigma}\Bigr)+O_{d,n}\Bigl(\frac{\sigma}{e^{\Theta_{d,n}(\sigma)}}\Bigr)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>O</mi><mrow><mi>d</mi><mo>,</mo><mi>n</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>σ</mi></mrow><mi>σ</mi></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>O</mi><mrow><mi>d</mi><mo>,</mo><mi>n</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="true"><mfrac><mi>σ</mi><msup><mi>e</mi><mrow><msub><mi mathvariant="normal">Θ</mi><mrow><mi>d</mi><mo>,</mo><mi>n</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow></mrow></msup></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=O_{d,n}\Bigl(\frac{\log{\sigma}}{\sigma}\Bigr)+O_{d,n}\Bigl(\frac{\sigma}{e^{\Theta_{d,n}(\sigma)}}\Bigr)</annotation></semantics></math></td>
