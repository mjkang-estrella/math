<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex62.m2" class="ltx_math_unparsed" alttext="\displaystyle\lesssim_{d,n}\Bigl|H(S_{n})-\sum_{k:\|k\|_{\infty}\leq\sigma^{2}}{F(p_{S_{n}}(k))}\Bigr|+\frac{\log{\sigma}}{\sigma}" display="inline" intent=":literal"><semantics><mrow><msub><mo>≲</mo><mrow><mi>d</mi><mo>,</mo><mi>n</mi></mrow></msub><mo fence="false" lspace="0em" maxsize="1.600em" minsize="1.600em" rspace="0.167em" stretchy="true">|</mo><mi>H</mi><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>k</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mrow></munder></mstyle><mi>F</mi><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><msub><mi>S</mi><mi>n</mi></msub></msub><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo fence="false" maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mo lspace="0em">+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>σ</mi></mrow><mi>σ</mi></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim_{d,n}\Bigl|H(S_{n})-\sum_{k:\|k\|_{\infty}\leq\sigma^{2}}{F(p_{S_{n}}(k))}\Bigr|+\frac{\log{\sigma}}{\sigma}</annotation></semantics></math></td>
