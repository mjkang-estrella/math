<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex114.m1" class="ltx_Math" alttext="\displaystyle\geq\sum_{k\in\mathbb{Z}}kf(k)-k_{0}f(k_{0})-k_{0}f(k_{0}+1)+k_{0}\min\{f(k_{0}),f(k_{0}+1)\}-\sum_{k\in\mathbb{Z}}f(k)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≥</mo><mrow><mrow><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>∈</mo><mi>ℤ</mi></mrow></munder></mstyle><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>k</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>k</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>k</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>k</mi><mn>0</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>k</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>∈</mo><mi>ℤ</mi></mrow></munder></mstyle><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\geq\sum_{k\in\mathbb{Z}}kf(k)-k_{0}f(k_{0})-k_{0}f(k_{0}+1)+k_{0}\min\{f(k_{0}),f(k_{0}+1)\}-\sum_{k\in\mathbb{Z}}f(k).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS4.p6.4" class="ltx_p"><span id="S3.SS4.p6.4.1" class="ltx_text">Therefore,</span></p>
<table id="S3.EGx27" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex115"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex115.m1" class="ltx_Math" alttext="\displaystyle\int_{\mathbb{R}}xf(x)dx" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi>ℝ</mi></msub></mstyle><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\int_{\mathbb{R}}xf(x)dx</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex115.m2" class="ltx_Math" alttext="\displaystyle\geq\sum_{k\in\mathbb{Z}}kf(k)-\sum_{k\in\mathbb{Z}}f(k)-k_{0}\max f" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>∈</mo><mi>ℤ</mi></mrow></munder></mstyle><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>∈</mo><mi>ℤ</mi></mrow></munder></mstyle><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>k</mi><mn>0</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>max</mi><mo lspace="0.167em">⁡</mo><mi>f</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq\sum_{k\in\mathbb{Z}}kf(k)-\sum_{k\in\mathbb{Z}}f(k)-k_{0}\max f</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex116"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex116.m1" class="ltx_Math" alttext="\displaystyle\geq\sum_{k\in\mathbb{Z}}kf(k)-\sum_{k\in\mathbb{Z}}f(k)-e\sum_{k\in\mathbb{Z}}f(k)=\sum_{k\in\mathbb{Z}}kf(k)-(e+1)\sum_{k\in\mathbb{Z}}f(k)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≥</mo><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>∈</mo><mi>ℤ</mi></mrow></munder></mstyle><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>∈</mo><mi>ℤ</mi></mrow></munder></mstyle><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>∈</mo><mi>ℤ</mi></mrow></munder></mstyle><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>∈</mo><mi>ℤ</mi></mrow></munder></mstyle><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>e</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>∈</mo><mi>ℤ</mi></mrow></munder></mstyle><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\geq\sum_{k\in\mathbb{Z}}kf(k)-\sum_{k\in\mathbb{Z}}f(k)-e\sum_{k\in\mathbb{Z}}f(k)=\sum_{k\in\mathbb{Z}}kf(k)-(e+1)\sum_{k\in\mathbb{Z}}f(k),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS4.p6.5" class="ltx_p"><span id="S3.SS4.p6.5.1" class="ltx_text">where in the last line we have used the inequality (<a href="#S3.E55" title="In Proof. ‣ 3.4 Approximating the integral, mean and covariance discretely ‣ 3 Discrete isotropic log-concave random vectors ‣ On the monotonicity of discrete entropy for log-concave random vectors on ℤ^𝑑" class="ltx_ref"><span class="ltx_text ltx_ref_tag">55</span></a>). Bounding from the above <math id="S3.SS4.p6.m13" class="ltx_Math" alttext="\int_{\mathbb{R}}xf(x)dx" display="inline" intent=":literal"><semantics><mrow><msub><mo>∫</mo><mi>ℝ</mi></msub><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\int_{\mathbb{R}}xf(x)dx</annotation></semantics></math> we obtain a similar inequality.
Thus, we get</span></p>
<table id="S3.Ex117" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex117.m1" class="ltx_Math" alttext="\left|\int_{\mathbb{R}}xf(x)dx-\sum_{k\in\mathbb{Z}}kf(k)\right|\leq(e+1)\sum_{k\in\mathbb{Z}}f(k)\hskip 2.84544pt," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><mrow><msub><mo lspace="0em">∫</mo><mi>ℝ</mi></msub><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow><mo rspace="0.055em">−</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>∈</mo><mi>ℤ</mi></mrow></munder><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>e</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>∈</mo><mi>ℤ</mi></mrow></munder><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\left|\int_{\mathbb{R}}xf(x)dx-\sum_{k\in\mathbb{Z}}kf(k)\right|\leq(e+1)\sum_{k\in\mathbb{Z}}f(k)\hskip 2.84544pt,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS4.p6.6" class="ltx_p"><span id="S3.SS4.p6.6.1" class="ltx_text">and the one-dimensional case follows by Proposition <a href="#Thmtheorem26" title="Proposition 26. ‣ 3.4 Approximating the integral, mean and covariance discretely ‣ 3 Discrete isotropic log-concave random vectors ‣ On the monotonicity of discrete entropy for log-concave random vectors on ℤ^𝑑" class="ltx_ref"><span class="ltx_text ltx_ref_tag">26</span></a>.</span></p>
</div>
<div id="S3.SS4.p7" class="ltx_para">
<p id="S3.SS4.p7.1" class="ltx_p"><span id="S3.SS4.p7.1.1" class="ltx_text">For the inductive step, let <math id="S3.SS4.p7.m1" class="ltx_Math" alttext="F:\mathbb{R}^{d-1}\to\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">F:\mathbb{R}^{d-1}\to\mathbb{R}</annotation></semantics></math> be defined, for <math id="S3.SS4.p7.m2" class="ltx_Math" alttext="x\in\mathbb{R},y\in\mathbb{R}^{d-1}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo>∈</mo><mi>ℝ</mi></mrow><mo>,</mo><mrow><mi>y</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">x\in\mathbb{R},y\in\mathbb{R}^{d-1}</annotation></semantics></math>, by</span></p>
<table id="S3.Ex118" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex118.m1" class="ltx_Math" alttext="F(y):=\int_{\mathbb{R}}f(x,y)dx." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">:=</mo><mrow><msub><mo>∫</mo><mi>ℝ</mi></msub><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">F(y):=\int_{\mathbb{R}}f(x,y)dx.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS4.p7.2" class="ltx_p"><span id="S3.SS4.p7.2.1" class="ltx_text">Then <math id="S3.SS4.p7.m3" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> is log-concave, centered and isotropic as the marginal of a log-concave, centered and isotropic density and, for <math id="S3.SS4.p7.m4" class="ltx_Math" alttext="i=1,\ldots,d-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">i=1,\ldots,d-1</annotation></semantics></math></span></p>
<table id="S3.Ex119" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex119.m1" class="ltx_Math" alttext="\int_{\mathbb{R}^{d}}y_{i}f(x,y)dxdy=\int_{\mathbb{R}^{d-1}}y_{i}F(y)dy." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mo>∫</mo><msup><mi>ℝ</mi><mi>d</mi></msup></msub><mrow><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>y</mi></mrow></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msub><mo>∫</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></msub><mrow><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>y</mi></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\int_{\mathbb{R}^{d}}y_{i}f(x,y)dxdy=\int_{\mathbb{R}^{d-1}}y_{i}F(y)dy.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS4.p7.3" class="ltx_p"><span id="S3.SS4.p7.3.1" class="ltx_text">We have</span></p>
<table id="S3.EGx28" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex120"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex120.m1" class="ltx_Math" alttext="\displaystyle\left|\int_{\mathbb{R}^{d}}y_{i}f(x,y)dxdy-\sum_{k_{1}\in\mathbb{Z},k\in\mathbb{Z}^{d-1}}k_{i}f(k_{1},k)\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msup><mi>ℝ</mi><mi>d</mi></msup></msub></mstyle><mrow><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>y</mi></mrow></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><msub><mi>k</mi><mn>1</mn></msub><mo>∈</mo><mi>ℤ</mi></mrow><mo>,</mo><mrow><mi>k</mi><mo>∈</mo><msup><mi>ℤ</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow></munder></mstyle><mrow><msub><mi>k</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>1</mn></msub><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\int_{\mathbb{R}^{d}}y_{i}f(x,y)dxdy-\sum_{k_{1}\in\mathbb{Z},k\in\mathbb{Z}^{d-1}}k_{i}f(k_{1},k)\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex121"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex121.m1" class="ltx_Math" alttext="\displaystyle\leq\left|\int_{\mathbb{R}^{d}}y_{i}f(x,y)dxdy-\sum_{k\in\mathbb{Z}^{d-1}}k_{i}F(k)\right|+\left|\sum_{k\in\mathbb{Z}^{d-1}}k_{i}F(k)-\sum_{k\in\mathbb{Z}^{d}}k_{i}f(k)\right|." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo>|</mo><mrow><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msup><mi>ℝ</mi><mi>d</mi></msup></msub></mstyle><mrow><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>y</mi></mrow></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>∈</mo><msup><mi>ℤ</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></munder></mstyle><mrow><msub><mi>k</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>|</mo></mrow><mo>+</mo><mrow><mo>|</mo><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>∈</mo><msup><mi>ℤ</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></munder></mstyle><mrow><msub><mi>k</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>∈</mo><msup><mi>ℤ</mi><mi>d</mi></msup></mrow></munder></mstyle><mrow><msub><mi>k</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>|</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left|\int_{\mathbb{R}^{d}}y_{i}f(x,y)dxdy-\sum_{k\in\mathbb{Z}^{d-1}}k_{i}F(k)\right|+\left|\sum_{k\in\mathbb{Z}^{d-1}}k_{i}F(k)-\sum_{k\in\mathbb{Z}^{d}}k_{i}f(k)\right|.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS4.p7.4" class="ltx_p"><span id="S3.SS4.p7.4.1" class="ltx_text">But the first term is <math id="S3.SS4.p7.m5" class="ltx_Math" alttext="O_{d}(1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>O</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O_{d}(1)</annotation></semantics></math> by inductive hypothesis and for the second we note that <math id="S3.SS4.p7.m6" class="ltx_Math" alttext="f(\cdot,k)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f(\cdot,k)</annotation></semantics></math> is log-concave for every <math id="S3.SS4.p7.m7" class="ltx_Math" alttext="k\in\mathbb{Z}^{d-1}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><msup><mi>ℤ</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">k\in\mathbb{Z}^{d-1}</annotation></semantics></math>, so we may apply (<a href="#S3.E53" title="In Proof. ‣ 3.4 Approximating the integral, mean and covariance discretely ‣ 3 Discrete isotropic log-concave random vectors ‣ On the monotonicity of discrete entropy for log-concave random vectors on ℤ^𝑑" class="ltx_ref"><span class="ltx_text ltx_ref_tag">53</span></a>) to get, for any <math id="S3.SS4.p7.m8" class="ltx_Math" alttext="k\in\mathbb{Z}^{d-1}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><msup><mi>ℤ</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">k\in\mathbb{Z}^{d-1}</annotation></semantics></math>,</span></p>
<table id="S3.Ex122" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex122.m1" class="ltx_Math" alttext="\left|F(k)-\sum_{k_{1}\in\mathbb{Z}}f(k_{1},k)\right|=\left|\int_{\mathbb{R}}{f(x,k)dx}-\sum_{k_{1}\in\mathbb{Z}}{f(k_{1},k)}\right|\leq\max_{x\in\mathbb{R}}f(x,k)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em">−</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><msub><mi>k</mi><mn>1</mn></msub><mo>∈</mo><mi>ℤ</mi></mrow></munder><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>1</mn></msub><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>|</mo></mrow><mo>=</mo><mrow><mo>|</mo><mrow><mrow><msub><mo lspace="0em">∫</mo><mi>ℝ</mi></msub><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow><mo rspace="0.055em">−</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><msub><mi>k</mi><mn>1</mn></msub><mo>∈</mo><mi>ℤ</mi></mrow></munder><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>1</mn></msub><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><munder><mi>max</mi><mrow><mi>x</mi><mo>∈</mo><mi>ℝ</mi></mrow></munder><mo lspace="0.167em">⁡</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\left|F(k)-\sum_{k_{1}\in\mathbb{Z}}f(k_{1},k)\right|=\left|\int_{\mathbb{R}}{f(x,k)dx}-\sum_{k_{1}\in\mathbb{Z}}{f(k_{1},k)}\right|\leq\max_{x\in\mathbb{R}}f(x,k),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS4.p7.5" class="ltx_p"><span id="S3.SS4.p7.5.1" class="ltx_text">which gives</span></p>
<table id="S3.Ex123" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex123.m1" class="ltx_Math" alttext="\left|\int_{\mathbb{R}^{d}}y_{i}f(x,y)dxdy-\sum_{k_{1}\in\mathbb{Z},k\in\mathbb{Z}^{d-1}}k_{i}f(k_{1},k)\right|\leq O_{d}(1)+\sum_{k\in\mathbb{Z}^{d-1}}k_{i}\max_{x\in\mathbb{R}}f(x,k)=O_{d}\bigl({1}\bigr)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><mrow><msub><mo lspace="0em">∫</mo><msup><mi>ℝ</mi><mi>d</mi></msup></msub><mrow><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>y</mi></mrow></mrow></mrow><mo rspace="0.055em">−</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mrow><msub><mi>k</mi><mn>1</mn></msub><mo>∈</mo><mi>ℤ</mi></mrow><mo>,</mo><mrow><mi>k</mi><mo>∈</mo><msup><mi>ℤ</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow></munder><mrow><msub><mi>k</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>1</mn></msub><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><mrow><msub><mi>O</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em">+</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>∈</mo><msup><mi>ℤ</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></munder><mrow><msub><mi>k</mi><mi>i</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><munder><mi>max</mi><mrow><mi>x</mi><mo>∈</mo><mi>ℝ</mi></mrow></munder><mo lspace="0.167em">⁡</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><mo>=</mo><mrow><msub><mi>O</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mn>1</mn><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\left|\int_{\mathbb{R}^{d}}y_{i}f(x,y)dxdy-\sum_{k_{1}\in\mathbb{Z},k\in\mathbb{Z}^{d-1}}k_{i}f(k_{1},k)\right|\leq O_{d}(1)+\sum_{k\in\mathbb{Z}^{d-1}}k_{i}\max_{x\in\mathbb{R}}f(x,k)=O_{d}\bigl({1}\bigr),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS4.p7.6" class="ltx_p"><span id="S3.SS4.p7.6.1" class="ltx_text">where the last equality follows by Lemma <a href="#Thmtheorem25" title="Lemma 25. ‣ 3.3 Sum of maxima of isotropic log-concave functions ‣ 3 Discrete isotropic log-concave random vectors ‣ On the monotonicity of discrete entropy for log-concave random vectors on ℤ^𝑑" class="ltx_ref"><span class="ltx_text ltx_ref_tag">25</span></a>.
∎</span></p>
</div>
</div>
<div id="S3.SS4.p8" class="ltx_para">
<p id="S3.SS4.p8.1" class="ltx_p">We wish to show that a continuous isotropic, log-concave density <math id="S3.SS4.p8.m1" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> in <math id="S3.SS4.p8.m2" class="ltx_Math" alttext="\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mi>d</mi></msup><annotation encoding="application/x-tex">\mathbb{R}^{d}</annotation></semantics></math> is almost isotropic in the discrete sense, meaning that its discrete covariance matrix <math id="S3.SS4.p8.m3" class="ltx_Math" alttext="\mathrm{Cov}_{\mathbb{Z}}{(f)}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Cov</mi><mi>ℤ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Cov}_{\mathbb{Z}}{(f)}</annotation></semantics></math> has <math id="S3.SS4.p8.m4" class="ltx_Math" alttext="O(\sigma)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(\sigma)</annotation></semantics></math> off-diagonal elements and <math id="S3.SS4.p8.m5" class="ltx_Math" alttext="\sigma^{2}+O(\sigma)" display="inline" intent=":literal"><semantics><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sigma^{2}+O(\sigma)</annotation></semantics></math> diagonal elements.</p>
</div>
<div id="Thmtheorem30" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem30.2" class="ltx_text ltx_font_bold">Proposition 30</span></span><span id="Thmtheorem30.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem30.p1" class="ltx_para">
<p id="Thmtheorem30.p1.1" class="ltx_p"><span id="Thmtheorem30.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmtheorem30.p1.m1" class="ltx_Math" alttext="f:\mathbb{R}^{d}\rightarrow\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mi>d</mi></msup><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">f:\mathbb{R}^{d}\rightarrow\mathbb{R}</annotation></semantics></math> be a centered, isotropic, log-concave density with <math id="Thmtheorem30.p1.m2" class="ltx_Math" alttext="\mathrm{Cov}{(f)}=\sigma^{2}\mathrm{I}_{\mathrm{d}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Cov</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">I</mi><mi mathvariant="normal">d</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Cov}{(f)}=\sigma^{2}\mathrm{I}_{\mathrm{d}}</annotation></semantics></math>. Then</span></p>
<table id="S3.Ex124" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex124.m1" class="ltx_Math" alttext="\sum_{k\in\mathbb{Z}^{d}}f(k)k_{i}^{2}=\sigma^{2}+O_{d}\big(\sigma\big),\hskip 2.84544pt\text{for every }\ 1\leq i\leq d." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>∈</mo><msup><mi>ℤ</mi><mi>d</mi></msup></mrow></munder><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>k</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow><mo>=</mo><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo>+</mo><mrow><msub><mi>O</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>σ</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow><mo rspace="0.447em">,</mo><mrow><mrow><mtext class="ltx_mathvariant_italic">for every </mtext><mo lspace="0em" rspace="0em">​</mo><mn> 1</mn></mrow><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>d</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{k\in\mathbb{Z}^{d}}f(k)k_{i}^{2}=\sigma^{2}+O_{d}\big(\sigma\big),\hskip 2.84544pt\text{for every }\ 1\leq i\leq d.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S3.SS4.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS4.p9" class="ltx_para">
<p id="S3.SS4.p9.1" class="ltx_p"><span id="S3.SS4.p9.1.1" class="ltx_text">We proceed by induction on the dimension.
For the one-dimensional case let 
<br class="ltx_break"><math id="S3.SS4.p9.m1" class="ltx_Math" alttext="x_{0}=\inf\{x\in\mathbb{R}:f(x)=\max{f}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>0</mn></msub><mo rspace="0.1389em">=</mo><mrow><mo lspace="0.1389em" rspace="0em">inf</mo><mrow><mo stretchy="false">{</mo><mrow><mi>x</mi><mo>∈</mo><mi>ℝ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>max</mi><mo lspace="0.167em">⁡</mo><mi>f</mi></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x_{0}=\inf\{x\in\mathbb{R}:f(x)=\max{f}\}</annotation></semantics></math>.
Then</span></p>
<table id="S3.Ex125" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex125.m1" class="ltx_Math" alttext="\int_{\mathbb{R}}f(x)x^{2}=\int_{x\leq x_{0}}f(x)x^{2}dx+\int_{x&gt;x_{0}}f(x)x^{2}dx." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mo>∫</mo><mi>ℝ</mi></msub><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mn>2</mn></msup></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mrow><msub><mo>∫</mo><mrow><mi>x</mi><mo>≤</mo><msub><mi>x</mi><mn>0</mn></msub></mrow></msub><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow><mo rspace="0.055em">+</mo><mrow><msub><mo>∫</mo><mrow><mi>x</mi><mo>&gt;</mo><msub><mi>x</mi><mn>0</mn></msub></mrow></msub><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\int_{\mathbb{R}}f(x)x^{2}=\int_{x\leq x_{0}}f(x)x^{2}dx+\int_{x&gt;x_{0}}f(x)x^{2}dx.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS4.p9.2" class="ltx_p"><span id="S3.SS4.p9.2.1" class="ltx_text">Noting that <math id="S3.SS4.p9.m2" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> is non-decreasing on <math id="S3.SS4.p9.m3" class="ltx_math_unparsed" alttext="(-\infty,x_{0}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi mathvariant="normal">∞</mi><mo>,</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">(-\infty,x_{0}]</annotation></semantics></math> and non-increasing on <math id="S3.SS4.p9.m4" class="ltx_math_unparsed" alttext="[x_{0},+\infty)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><msub><mi>x</mi><mn>0</mn></msub><mo rspace="0em">,</mo><mo lspace="0em">+</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">[x_{0},+\infty)</annotation></semantics></math> by log-concavity, we get</span></p>
<table id="S3.EGx29" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex126"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex126.m1" class="ltx_Math" alttext="\displaystyle\int_{\mathbb{R}}f(x)x^{2}dx" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi>ℝ</mi></msub></mstyle><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\int_{\mathbb{R}}f(x)x^{2}dx</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex126.m2" class="ltx_math_unparsed" alttext="\displaystyle=\sum_{k&lt;\lfloor x_{0}\rfloor}\int_{[k,k+1)}f(x)x^{2}dx+\sum_{k&gt;\lfloor x_{0}\rfloor}\int_{[k,k+1)}f(x)x^{2}dx+\int_{\lfloor x_{0}\rfloor}^{\lfloor x_{0}\rfloor+1}f(x)x^{2}dx" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>&lt;</mo><mrow><mo stretchy="false">⌊</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">⌋</mo></mrow></mrow></munder></mstyle><mstyle displaystyle="true"><msub><mo>∫</mo><mrow><mo stretchy="false">[</mo><mi>k</mi><mo>,</mo><mi>k</mi><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msub></mstyle><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><msup><mi>x</mi><mn>2</mn></msup><mi>d</mi><mi>x</mi><mo>+</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>&gt;</mo><mrow><mo stretchy="false">⌊</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">⌋</mo></mrow></mrow></munder></mstyle><mstyle displaystyle="true"><msub><mo>∫</mo><mrow><mo stretchy="false">[</mo><mi>k</mi><mo>,</mo><mi>k</mi><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msub></mstyle><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><msup><mi>x</mi><mn>2</mn></msup><mi>d</mi><mi>x</mi><mo>+</mo><mstyle displaystyle="true"><msubsup><mo>∫</mo><mrow><mo stretchy="false">⌊</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">⌋</mo></mrow><mrow><mrow><mo stretchy="false">⌊</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">⌋</mo></mrow><mo>+</mo><mn>1</mn></mrow></msubsup></mstyle><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><msup><mi>x</mi><mn>2</mn></msup><mi>d</mi><mi>x</mi></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{k&lt;\lfloor x_{0}\rfloor}\int_{[k,k+1)}f(x)x^{2}dx+\sum_{k&gt;\lfloor x_{0}\rfloor}\int_{[k,k+1)}f(x)x^{2}dx+\int_{\lfloor x_{0}\rfloor}^{\lfloor x_{0}\rfloor+1}f(x)x^{2}dx</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex127"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex127.m1" class="ltx_Math" alttext="\displaystyle\leq\sum_{k&lt;\lfloor x_{0}\rfloor}f(k+1)(k^{2}+k+\frac{1}{3})+\sum_{k&gt;\lfloor x_{0}\rfloor}f(k)(k^{2}+k+\frac{1}{3})+\int_{\lfloor x_{0}\rfloor}^{\lfloor x_{0}\rfloor+1}f(x)x^{2}dx" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>&lt;</mo><mrow><mo stretchy="false">⌊</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">⌋</mo></mrow></mrow></munder></mstyle><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>k</mi><mn>2</mn></msup><mo>+</mo><mi>k</mi><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>3</mn></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>&gt;</mo><mrow><mo stretchy="false">⌊</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">⌋</mo></mrow></mrow></munder></mstyle><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>k</mi><mn>2</mn></msup><mo>+</mo><mi>k</mi><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>3</mn></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mrow><mo stretchy="false">⌊</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">⌋</mo></mrow><mrow><mrow><mo stretchy="false">⌊</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">⌋</mo></mrow><mo>+</mo><mn>1</mn></mrow></msubsup></mstyle><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{k&lt;\lfloor x_{0}\rfloor}f(k+1)(k^{2}+k+\frac{1}{3})+\sum_{k&gt;\lfloor x_{0}\rfloor}f(k)(k^{2}+k+\frac{1}{3})+\int_{\lfloor x_{0}\rfloor}^{\lfloor x_{0}\rfloor+1}f(x)x^{2}dx</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
