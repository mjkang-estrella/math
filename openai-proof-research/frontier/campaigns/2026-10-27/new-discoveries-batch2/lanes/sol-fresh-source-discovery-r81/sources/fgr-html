<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex35.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{c_{2}^{\prime}(d,n)}{\sigma^{d}}e^{\frac{-\|k\|_{1}}{c_{2}^{\prime}(d,n)\sigma}+\sqrt{d}}\sum_{j\in\mathbb{Z}}p(k-j)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>c</mi><mn>2</mn><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><msup><mi>σ</mi><mi>d</mi></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mfrac><mrow><mo>−</mo><msub><mrow><mo stretchy="false">‖</mo><mi>k</mi><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub></mrow><mrow><msubsup><mi>c</mi><mn>2</mn><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo mathsize="1.400em">,</mo><mi>n</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi></mrow></mfrac><mo>+</mo><msqrt><mi>d</mi></msqrt></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>∈</mo><mi>ℤ</mi></mrow></munder></mstyle><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{c_{2}^{\prime}(d,n)}{\sigma^{d}}e^{\frac{-\|k\|_{1}}{c_{2}^{\prime}(d,n)\sigma}+\sqrt{d}}\sum_{j\in\mathbb{Z}}p(k-j)</annotation></semantics></math></td>
