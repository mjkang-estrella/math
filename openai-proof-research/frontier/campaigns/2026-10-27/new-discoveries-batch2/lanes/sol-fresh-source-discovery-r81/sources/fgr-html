<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex128.m1" class="ltx_Math" alttext="\displaystyle\leq\sum_{k\in\mathbb{Z}}f(k)k^{2}-\sum_{k&lt;\lfloor x_{0}\rfloor}f(k+1)k-\sum_{k&gt;\lfloor x_{0}\rfloor}f(k)k+f(x_{0})\Bigl(\lfloor x_{0}\rfloor^{2}+\lfloor x_{0}\rfloor+\frac{1}{3}\Bigr)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>∈</mo><mi>ℤ</mi></mrow></munder></mstyle><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mn>2</mn></msup></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>&lt;</mo><mrow><mo stretchy="false">⌊</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">⌋</mo></mrow></mrow></munder></mstyle><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>&gt;</mo><mrow><mo stretchy="false">⌊</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">⌋</mo></mrow></mrow></munder></mstyle><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msup><mrow><mo stretchy="false">⌊</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">⌋</mo></mrow><mn>2</mn></msup><mo>+</mo><mrow><mo stretchy="false">⌊</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">⌋</mo></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>3</mn></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{k\in\mathbb{Z}}f(k)k^{2}-\sum_{k&lt;\lfloor x_{0}\rfloor}f(k+1)k-\sum_{k&gt;\lfloor x_{0}\rfloor}f(k)k+f(x_{0})\Bigl(\lfloor x_{0}\rfloor^{2}+\lfloor x_{0}\rfloor+\frac{1}{3}\Bigr)</annotation></semantics></math></td>
