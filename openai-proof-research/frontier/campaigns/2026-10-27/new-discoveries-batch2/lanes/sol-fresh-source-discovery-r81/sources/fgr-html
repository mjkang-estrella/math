</table>
<p id="S2.p13.6" class="ltx_p"><span id="S2.p13.6.1" class="ltx_text">Thus, by the triangular inequality, summing up to the last coordinate which can be either <math id="S2.p13.m19" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> or <math id="S2.p13.m20" class="ltx_Math" alttext="-1" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">-1</annotation></semantics></math>, we obtain</span></p>
<table id="S2.EGx12" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S2.Ex50"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex50.m1" class="ltx_Math" alttext="\displaystyle\left|\sum_{i\in\mathbb{Z}^{d}}u(i)v(i)\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><msup><mi>ℤ</mi><mi>d</mi></msup></mrow></munder></mstyle><mrow><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\sum_{i\in\mathbb{Z}^{d}}u(i)v(i)\right|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex50.m2" class="ltx_Math" alttext="\displaystyle\leq\sum_{i\in\mathbb{Z}^{d}}\sum_{\epsilon\in\{-1,1\}^{d-1}}\left|u\left(i-\sum_{k=1}^{d}\frac{\epsilon_{k}+1}{2}e_{k}\right)-u\left(i-\sum_{k=1}^{d-1}\frac{\epsilon_{k}+1}{2}e_{k}-e_{d}\right)\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><msup><mi>ℤ</mi><mi>d</mi></msup></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>ϵ</mi><mo>∈</mo><msup><mrow><mo stretchy="false">{</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></munder></mstyle><mrow><mo>|</mo><mrow><mrow><mi>u</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>i</mi><mo>−</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ϵ</mi><mi>k</mi></msub><mo>+</mo><mn>1</mn></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mi>k</mi></msub></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mi>u</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>i</mi><mo>−</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ϵ</mi><mi>k</mi></msub><mo>+</mo><mn>1</mn></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mi>k</mi></msub></mrow></mrow><mo>−</mo><msub><mi>e</mi><mi>d</mi></msub></mrow><mo>)</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{i\in\mathbb{Z}^{d}}\sum_{\epsilon\in\{-1,1\}^{d-1}}\left|u\left(i-\sum_{k=1}^{d}\frac{\epsilon_{k}+1}{2}e_{k}\right)-u\left(i-\sum_{k=1}^{d-1}\frac{\epsilon_{k}+1}{2}e_{k}-e_{d}\right)\right|</annotation></semantics></math></td>
