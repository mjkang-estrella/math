<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex40.m1" class="ltx_Math" alttext="f_{n}^{(d)}(x)\leq\Bigl(n^{d}(e^{\frac{nd}{c_{2}\sigma}}+1)+1\Bigr)\frac{c_{2}}{\sigma^{d}}e^{-\frac{\|k\|_{1}}{c_{2}\sigma}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>f</mi><mi>n</mi><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><msup><mi>n</mi><mi>d</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>e</mi><mfrac><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mrow><msub><mi>c</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi></mrow></mfrac></msup><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><msub><mi>c</mi><mn>2</mn></msub><msup><mi>σ</mi><mi>d</mi></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mfrac><msub><mrow><mo stretchy="false">‖</mo><mi>k</mi><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mrow><msub><mi>c</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi></mrow></mfrac></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">f_{n}^{(d)}(x)\leq\Bigl(n^{d}(e^{\frac{nd}{c_{2}\sigma}}+1)+1\Bigr)\frac{c_{2}}{\sigma^{d}}e^{-\frac{\|k\|_{1}}{c_{2}\sigma}}.</annotation></semantics></math></td>
