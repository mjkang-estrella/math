<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S1.Ex11"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S1.Ex11.m1" class="ltx_Math" alttext="\displaystyle\Bigl|\int_{\mathbb{R}^{d}}xf-\sum_{k\in\mathbb{Z}^{d}}kf(k)\Bigr|" display="inline" intent=":literal"><semantics><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mrow><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msup><mi>ℝ</mi><mi>d</mi></msup></msub></mstyle><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>∈</mo><msup><mi>ℤ</mi><mi>d</mi></msup></mrow></munder></mstyle><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Bigl|\int_{\mathbb{R}^{d}}xf-\sum_{k\in\mathbb{Z}^{d}}kf(k)\Bigr|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S1.Ex11.m2" class="ltx_Math" alttext="\displaystyle=O_{d}(1),\quad\text{as }\sigma\to\infty," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>O</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mtext>as </mtext><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi></mrow><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=O_{d}(1),\quad\text{as }\sigma\to\infty,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
