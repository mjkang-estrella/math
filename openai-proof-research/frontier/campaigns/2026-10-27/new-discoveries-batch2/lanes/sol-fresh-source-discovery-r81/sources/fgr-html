<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E68.m1" class="ltx_Math" alttext="\displaystyle\int_{\mathbb{R}}{\sum_{k\geq N_{\max}}xf(x,k)dx}\leq\Bigl(\int_{\mathbb{R}}{\sum_{k\in\mathbb{Z}}x^{2}f(x,k)dx}\Bigr)^{\frac{1}{2}}=O(\sigma)" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi>ℝ</mi></msub></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>≥</mo><msub><mi>N</mi><mi>max</mi></msub></mrow></munder></mstyle><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow></mrow><mo>≤</mo><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi>ℝ</mi></msub></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>∈</mo><mi>ℤ</mi></mrow></munder></mstyle><mrow><msup><mi>x</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\int_{\mathbb{R}}{\sum_{k\geq N_{\max}}xf(x,k)dx}\leq\Bigl(\int_{\mathbb{R}}{\sum_{k\in\mathbb{Z}}x^{2}f(x,k)dx}\Bigr)^{\frac{1}{2}}=O(\sigma)</annotation></semantics></math></td>
