<p id="S2.p14.3" class="ltx_p"><span id="S2.p14.3.1" class="ltx_text">and the claimed bound follows since <math id="S2.p14.m5" class="ltx_Math" alttext="f_{n}^{(d)}(x)\leq|f_{n}^{(d)}(x)-p(k)|+p(k)" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>f</mi><mi>n</mi><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mo stretchy="false">|</mo><mrow><mrow><msubsup><mi>f</mi><mi>n</mi><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>+</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">f_{n}^{(d)}(x)\leq|f_{n}^{(d)}(x)-p(k)|+p(k)</annotation></semantics></math>.
∎</span></p>
