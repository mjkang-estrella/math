<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex71.m1" class="ltx_Math" alttext="p(k)\leq\frac{C_{2}(d)}{\sigma^{d}}e^{-\frac{\|k\|_{1}}{c_{2}(d)\sigma}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mfrac><mrow><msub><mi>C</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><msup><mi>σ</mi><mi>d</mi></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mfrac><msub><mrow><mo stretchy="false">‖</mo><mi>k</mi><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mrow><msub><mi>c</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi></mrow></mfrac></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">p(k)\leq\frac{C_{2}(d)}{\sigma^{d}}e^{-\frac{\|k\|_{1}}{c_{2}(d)\sigma}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S3.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">3.</span> 
