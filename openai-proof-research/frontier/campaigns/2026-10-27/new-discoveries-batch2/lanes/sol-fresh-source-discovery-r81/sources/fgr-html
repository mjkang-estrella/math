<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex34.m2" class="ltx_Math" alttext="\displaystyle\leq\sum_{\|j\|_{\infty}&gt;c_{2}(d)\sigma,\|k-j\|_{\infty}\leq c_{2}(d)\sigma}\frac{c_{2}(d)}{\sigma^{d}}e^{-\frac{\|j\|_{1}}{c_{2}(d)\sigma}}p_{n}(k-j)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>j</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>&gt;</mo><mrow><msub><mi>c</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi></mrow></mrow><mo>,</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>k</mi><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mrow><msub><mi>c</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi></mrow></mrow></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>c</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><msup><mi>σ</mi><mi>d</mi></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mfrac><msub><mrow><mo stretchy="false">‖</mo><mi>j</mi><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mrow><msub><mi>c</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi></mrow></mfrac></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{\|j\|_{\infty}&gt;c_{2}(d)\sigma,\|k-j\|_{\infty}\leq c_{2}(d)\sigma}\frac{c_{2}(d)}{\sigma^{d}}e^{-\frac{\|j\|_{1}}{c_{2}(d)\sigma}}p_{n}(k-j)</annotation></semantics></math></td>
