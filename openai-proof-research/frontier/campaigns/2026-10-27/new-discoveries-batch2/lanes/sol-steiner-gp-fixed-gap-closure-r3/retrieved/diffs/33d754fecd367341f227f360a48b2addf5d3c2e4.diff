+private lemma annular_vertices {n : ℕ} (sigma : Equiv.Perm (Fin n))
+    (z : Fin n → ℂ) (hz : RadialChamber sigma z) :
+    ∃ a b : Fin n → ℝ,
+      (∀ i, 0 < a i ∧ a i < ‖z i‖ ∧ ‖z i‖ < b i) ∧
+      ∀ s, RadialChamber sigma (vertex a b s) := by
+  let r : Fin n → ℝ := fun i => ‖z i‖
