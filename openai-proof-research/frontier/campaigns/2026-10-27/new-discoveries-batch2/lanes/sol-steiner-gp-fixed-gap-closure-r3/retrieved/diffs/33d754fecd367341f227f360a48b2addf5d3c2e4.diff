+/-- Every maximizing prime is allowed, including ties between occupied prime powers. -/
+def MaximalPrimePower (m q : ℕ) : Prop :=
+  q ∈ m.primeFactors ∧ ∀ p ∈ m.primeFactors,
+    p ^ m.factorization p ≤ q ^ m.factorization q
