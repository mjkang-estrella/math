+private theorem witness_default (q : Slot) (h : q.val < 8 ∨ 16 ≤ q.val) :
+    witnessSources q = sourceChart 1 1 := by
+  have hn : q.val ≠ 9 := by omega
+  have hn13 : q.val ≠ 13 := by omega
