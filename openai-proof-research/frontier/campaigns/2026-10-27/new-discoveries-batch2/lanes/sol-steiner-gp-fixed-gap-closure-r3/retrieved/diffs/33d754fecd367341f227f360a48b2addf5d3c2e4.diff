+  let q : ℝ := Real.sqrt 145
+  have hq : q^2 = 145 := Real.sq_sqrt (by norm_num)
+  let ρ : Matrix (Fin 2) (Fin 2) ℂ := !![5/34, (q : ℂ)/34; (q : ℂ)/34, 29/34]
+  let σ : Matrix (Fin 2) (Fin 2) ℂ := !![5/34, -(q : ℂ)/34; -(q : ℂ)/34, 29/34]
