+  actual := actual
+  bridge := Iff.rfl
+  variation := ⟨@normalized_eval, rejected, rejected_law⟩
+  sensitivity := Reg.Support.SingleDependentReadout.sensitivity arena.Law actual rejected rejected_law
+  dependence := dependence
