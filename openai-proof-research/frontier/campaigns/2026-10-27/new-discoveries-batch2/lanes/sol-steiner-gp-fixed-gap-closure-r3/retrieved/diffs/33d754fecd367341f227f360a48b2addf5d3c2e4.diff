+      dsimp only [rounded]
+      rw [← sub_mul, abs_mul, abs_of_nonneg hd.le]
+    have herror : |rounded s - rounded t| ≤ |s.val - t.val| + 2 * d := by
+      calc
+        |rounded s - rounded t| =
+            |(rounded s - s.val) + (s.val - t.val) + (t.val - rounded t)| := by
+          congr 1
