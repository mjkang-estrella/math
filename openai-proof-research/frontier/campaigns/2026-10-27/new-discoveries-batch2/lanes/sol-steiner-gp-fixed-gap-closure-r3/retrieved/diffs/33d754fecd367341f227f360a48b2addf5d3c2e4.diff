+    R.readout () () (spectralCoordinates hP (cubicLinear P E) i j,
+      ((hP.eigenvalues i ^ 2 + hP.eigenvalues i * hP.eigenvalues j +
+        hP.eigenvalues j ^ 2 : ℝ) : ℂ) * spectralCoordinates hP E i j)
