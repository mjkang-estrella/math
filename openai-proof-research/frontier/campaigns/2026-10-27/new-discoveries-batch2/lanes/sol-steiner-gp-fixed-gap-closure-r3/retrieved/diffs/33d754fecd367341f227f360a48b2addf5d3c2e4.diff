+
+private theorem delta_clock_bound {m q : ℕ} (hm : 0 < m)
+    (hX : Real.exp 1 ≤ Real.log (m : ℝ)) (hq : MaximalPrimePower m q) :
+    divisorLog m - divisorLog (m / q) ≤
