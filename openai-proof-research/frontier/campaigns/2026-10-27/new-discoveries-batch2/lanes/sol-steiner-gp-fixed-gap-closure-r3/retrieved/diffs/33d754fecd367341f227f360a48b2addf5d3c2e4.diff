+  apply Int.cast_injective (α := ℚ)
+  simp only [Int.cast_sub, Int.cast_mul, Int.cast_sum, Int.cast_ofNat,
+    Int.cast_ite, Int.cast_one, Int.cast_zero, Int.cast_natCast, num_cast]
