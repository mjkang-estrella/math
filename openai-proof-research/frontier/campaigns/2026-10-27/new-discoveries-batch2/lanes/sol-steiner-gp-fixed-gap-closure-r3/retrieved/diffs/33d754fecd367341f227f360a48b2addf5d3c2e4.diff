+  refine ⟨hn, Nat.div_lt_self hm hp.one_lt, ?_, ?_⟩
+  · rw [h]
+    exact mul_pos (D5.S3.Arith.GoldenResource.GoldenResourcePriceInterval.marginal_pos hp ha) hlq
