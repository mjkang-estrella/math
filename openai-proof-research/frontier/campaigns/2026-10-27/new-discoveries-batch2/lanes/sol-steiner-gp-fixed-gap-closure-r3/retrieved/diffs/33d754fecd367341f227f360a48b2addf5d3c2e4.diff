+      path := #["body", "body", "body", "arg", "body", "arg", "body", "body", "body", "domain", "arg"]
+      stateBinder := 4
+      functionOperand := false
+      stateOperand := none
+      booleanPredicate := false }] }
+  continuation := .unknown
