+def witnessSources (q : Slot) : Mat :=
+  if q.val = 9 then sourceChart 3 (5/3)
+  else if q.val = 13 then sourceChart (1/2) (8/5)
+  else if 8 ≤ q.val ∧ q.val < 16 then sourceChart (3/2) (4/3)
+  else sourceChart 1 1
