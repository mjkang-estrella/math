+      rw [eCoeff_sinh]
+      by_cases he : Even n
+      · simp [he]
+      · simp [he, (Nat.not_even_iff_odd.mp he).neg_one_pow]
+    _ = (n.factorial : ℚ) * coeff n (-sinh) := by simp [eCoeff]
