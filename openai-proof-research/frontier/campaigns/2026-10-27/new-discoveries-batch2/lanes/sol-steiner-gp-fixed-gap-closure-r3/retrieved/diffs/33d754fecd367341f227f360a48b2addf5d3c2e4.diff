+  intro i
+  refine ⟨0, 0, 3, ?_⟩
+  change actualHeight 0 0 ≠ actualHeight 0 3
+  simp only [actualHeight, Real.rpow_zero, one_mul]
+  have hz : originalObjective 0 = 0 := by simp [originalObjective]
+  rw [hz]
+  linarith [ActualIntegerLogEnvelope.objective_three_pos]
+
