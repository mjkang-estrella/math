+theorem chamber_compact_summable_majorant {n : ℕ}
+    (sigma : Equiv.Perm (Fin n)) (c : (Fin n → ℤ) → ℂ)
+    (habs : ∀ z : Fin n → ℂ, RadialChamber sigma z →
