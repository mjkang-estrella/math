+private lemma annular_term_bound {n : ℕ} (a b : Fin n → ℝ)
+    (ha : ∀ i, 0 < a i) (w : Fin n → ℂ)
+    (hw : ∀ i, a i ≤ ‖w i‖ ∧ ‖w i‖ ≤ b i)
+    (c : ℂ) (e : Fin n → ℤ) :
+    ‖c * monomial w e‖ ≤ ∑ s : Fin n → Bool, ‖c * monomial (vertex a b s) e‖ := by
