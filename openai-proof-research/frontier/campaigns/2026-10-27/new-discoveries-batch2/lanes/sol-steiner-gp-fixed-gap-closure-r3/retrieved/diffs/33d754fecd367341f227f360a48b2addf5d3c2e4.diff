+  let b : Fin n → ℝ := fun i => r i + ε / 2
+  have hv (s : Fin n → Bool) :
+      (fun i => if s i then b i else a i) ∈ radiusDomain sigma := by
+    apply hball
+    apply lt_of_le_of_lt ((dist_pi_le_iff (by linarith : 0 ≤ ε / 2)).mpr ?_)
