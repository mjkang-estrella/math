+    have h2 := congrFun ha 2
+    have h3 := congrFun ha 3
+    norm_num [Fin.sum_univ_two, u, v] at h2 h3
+    fin_cases i <;> assumption
+  have hr := finrank_span_eq_card li
+  rw [heq] at hr
+  simpa using hr
