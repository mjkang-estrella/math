JacobiShifted.SourceClaim : Prop
sourceKappa_one : JacobiShifted.sourceKappa 1 = MvPolynomial.C (1 / 4) * (MvPolynomial.X 0 - MvPolynomial.X 1)
JacobiShifted.binomialOddSum_valuation (m : ℕ) :
  padicValRat 2 (JacobiShifted.binomialOddSum m) = ↑m + ↑(padicValNat 2 (m + 1))
JacobiShifted.Midpoint.h_odd_normalForm_ring (n i j : ℕ) (hn : Odd n) :
  ∃ A,
    (JacobiShifted.Midpoint.h n).coeff (JacobiShifted.BinaryFiltration.bidegree i j) =
      (1 + JacobiShifted.Midpoint.x ^ 2) * JacobiShifted.Midpoint.C (Polynomial.comp A (Polynomial.X ^ 2)) +
        JacobiShifted.Midpoint.w * JacobiShifted.Midpoint.x *
          JacobiShifted.Midpoint.C
            (Polynomial.comp
              (JacobiShifted.Midpoint.oddExtract
                ((JacobiShifted.Midpoint.h n).coeff (JacobiShifted.BinaryFiltration.bidegree i j)).im)
              (Polynomial.X ^ 2))
JacobiShifted.Midpoint.h_odd_extraction_divisible (n i j : ℕ) (hj : Odd j) :
  2 ^ JacobiShifted.BinaryFiltration.sigma (i + j - 1) ∣
    JacobiShifted.Midpoint.oddExtract
      ((JacobiShifted.Midpoint.h n).coeff (JacobiShifted.BinaryFiltration.bidegree i j)).im
JacobiShifted.MidpointRational.h_odd_primitive_closed (n i j : ℕ) (hn : Odd n) :
  ∃! p,
    JacobiShifted.MidpointRational.delta p =
        JacobiShifted.MidpointRational.lift
          ((JacobiShifted.Midpoint.h n).coeff (JacobiShifted.BinaryFiltration.bidegree i j)) ∧
      JacobiShifted.MidpointRational.tau p = -p ∧
        JacobiShifted.MidpointRational.TwoLocal
          (JacobiShifted.MidpointRational.midpoint p / 2 ^ JacobiShifted.BinaryFiltration.sigma (i + j - 1))

