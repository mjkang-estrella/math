def JacobiShifted.SourceClaim : Prop :=
∀ (r : ℕ),
  1 ≤ r →
    (∀ (m : Fin 2 →₀ ℕ),
        JacobiShifted.TwoLocal (2 ^ JacobiShifted.dyadicExponent r * (JacobiShifted.sourceKappa r).coeff m)) ∧
      ¬JacobiShifted.TwoLocal
          (2 ^ (JacobiShifted.dyadicExponent r - 1) * (JacobiShifted.sourceKappa r).coeff (Finsupp.single 0 r))
def JacobiShifted.sourceKappa : ℕ → JacobiShifted.QPoly :=
fun r => if r = 0 then 0 else MvPolynomial.C (2 ^ (2 * r - 1))⁻¹ * (JacobiShifted.sourceLogCoeff (2 * r - 1)).im
def JacobiShifted.dyadicExponent : ℕ → ℕ :=
fun r => 2 * r + padicValNat 2 (r - 1).factorial
def JacobiShifted.TwoLocal : ℚ → Prop :=
fun q => Odd q.den
