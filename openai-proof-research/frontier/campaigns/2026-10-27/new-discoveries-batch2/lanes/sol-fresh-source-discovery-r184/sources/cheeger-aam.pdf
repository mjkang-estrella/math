    <script type='text/javascript'>
//<![CDATA[
(function() {
    var head = document.getElementsByTagName("head")[0];
    var faviconLink = head.querySelector("link[rel~='icon']");
    if (!faviconLink) {
        faviconLink = document.createElement("link");
        head.appendChild(faviconLink);
    }
    faviconLink.rel = "icon";
    faviconLink.type = "image/x-icon";
    faviconLink.href = "/adfs/portal/images/favicon.ico";

    var scripts = [
        "/adfs/portal/script/jquery-4.0.0.min.js"
    ];
    var appScriptUrl = "/adfs/portal/script/onload-app.js";
    var appPreload = document.createElement("link");
    appPreload.rel = "preload";
    appPreload.as = "script";
    appPreload.href = appScriptUrl;
    document.getElementsByTagName("head")[0].appendChild(appPreload);

    var pending = scripts.length;
    var failed = false;

    function startApplication() {
        var appScript = document.createElement("script");
        appScript.type = "text/javascript";
        appScript.src = appScriptUrl;
        appScript.onerror = function() {
            if (window.console && window.console.error) {
                window.console.error("Unable to load the AD FS theme application script.");
            }
        };
        document.getElementsByTagName("head")[0].appendChild(appScript);
    }

    function waitForDomAndStart() {
        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", startApplication, false);
        } else {
            startApplication();
        }
    }

    function vendorLoaded() {
        pending--;
        if (!pending && !failed) {
            waitForDomAndStart();
        }
    }

    function loadVendorScript(url) {
        var script = document.createElement("script");
        var completed = false;

        function onLoad() {
            if (completed || (script.readyState && !/loaded|complete/.test(script.readyState))) {
                return;
            }
            completed = true;
            script.onload = null;
            script.onreadystatechange = null;
            vendorLoaded();
        }

        script.type = "text/javascript";
        script.src = url;
        script.onload = onLoad;
        script.onreadystatechange = onLoad;
        script.onerror = function() {
            if (completed) {
                return;
            }
            completed = true;
            failed = true;
            if (window.console && window.console.error) {
                window.console.error("Unable to load an AD FS theme dependency: " + url);
            }
        };
        document.getElementsByTagName("head")[0].appendChild(script);
    }

    for (var i = 0; i < scripts.length; i++) {
        loadVendorScript(scripts[i]);
    }
})();

//]]>
</script>


    </body>
</html> 

