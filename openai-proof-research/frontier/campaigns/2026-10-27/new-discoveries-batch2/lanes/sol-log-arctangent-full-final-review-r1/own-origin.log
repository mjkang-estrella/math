def LogArctangentSource.SourceClaim : Prop :=
∀ (a b : ℝ),
  0 < a →
    0 < b →
      a ≠ b →
        LogArctangentSource.mean a b < LogArctangentSource.resultant (√17) ((5 - √17) / 2) a b ∧
          LogArctangentSource.mean a b < LogArctangentSource.resultant (-√17) ((5 + √17) / 2) a b
theorem LogArctangentSource.source_conjecture37 : LogArctangentSource.SourceClaim :=
LogArctangentSource.sourceClaim_of_E_pos fun x ht => LogArctangentMean.E_pos ht
'LogArctangentSource.source_conjecture37' depends on axioms: [propext, Classical.choice, Quot.sound]
