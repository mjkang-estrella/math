raph V) {v : V} (c : G.Walk v v) : Prop :=\n  c.IsCycle ∧ ∀ w, w ∈ c.support\n\n/--\n**Sheehan's conjecture (1977).**\n\nEvery $4$-regular graph with a Hamiltonian c"]]
