<!-- FILE: /srv/sequoia/main/data/assets/site/ir_series/article/article_info.inc (cont) --><div id='title' class='element'>
<h1>An optimal design framework for lasso sign recovery</h1>
</div>
<div class='clear'></div>
<div id='authors' class='element'>
<h2 class='visually-hidden'>Authors</h2>
<ul class="author"><li><a href='https://scholarlycommons.henryford.com/do/search/?q=author%3A%22Jonathan%20W.%20Stallrich%22&start=0&context=12785255'><strong>Jonathan W. Stallrich</strong></a></li>
<li><a href='https://scholarlycommons.henryford.com/do/search/?q=author%3A%22Kade%20Young%22&start=0&context=12785255'><strong>Kade Young</strong></a></li>
<li><a href='https://scholarlycommons.henryford.com/do/search/?q=author%3A%22Maria%20L.%20Weese%22&start=0&context=12785255'><strong>Maria L. Weese</strong></a></li>
<li><a href='https://scholarlycommons.henryford.com/do/search/?q=%28author%3A%22Byran%20J.%20Smucker%22%20AND%20-bp_author_id%3A%5B%2A%20TO%20%2A%5D%29%20OR%20bp_author_id%3A%28%226aee4111-136c-44a7-84ac-0f7c82714611%22%29&start=0&context=12785255'><strong>Byran J. Smucker</strong>, <em>Henry Ford Health</em></a><a rel="nofollow" href="https://network.bepress.com/api/follow/subscribe?user=YzM1OGJhNTg2YmVhMTgyMg%3D%3D&amp;institution=N2FiZGU1NDY0N2Y1MzFjMzZlMzk1MzkwZDE1NjEzZDE%3D&amp;format=html" data-follow-set="user:YzM1OGJhNTg2YmVhMTgyMg== institution:N2FiZGU1NDY0N2Y1MzFjMzZlMzk1MzkwZDE1NjEzZDE=" title="Follow Byran J. Smucker" class="btn followable">Follow</a></li>
<li><a href='https://scholarlycommons.henryford.com/do/search/?q=author%3A%22David%20J.%20Edwards%22&start=0&context=12785255'><strong>David J. Edwards</strong></a></li>
</ul></div>
<div class='clear'></div>
<div id='recommended_citation' class='element'>
<h2 class='field-heading'>Recommended Citation</h2>
<p class='citation'>Stallrich JW, Young K, Weese ML, Smucker BJ, and Edwards DJ. An optimal design framework for lasso sign recovery. J R Stat Soc Series B Stat Methodol 2025:24.</p>
</div>
<div class='clear'></div>
<div id='document_type' class='element'>
<h2 class='field-heading'>Document Type</h2>
<p>Article</p>
</div>
<div class='clear'></div>
<div id='publication_date' class='element'>
<h2 class='field-heading'>Publication Date</h2>
<p>5-20-2025</p>
</div>
<div class='clear'></div>
<div id='source_publication' class='element'>
