def MittagModulus.SourceClaim370772 : Prop :=
∀ (a : ℝ), 0 < a → a ≤ 1 / 2 → MittagModulus.CompletelyMonotonePositive (MittagModulus.sourceExpression a)
def MittagModulus.CompletelyMonotonePositive : (ℝ → ℝ) → Prop :=
fun f => ContDiffOn ℝ (↑⊤) f (Set.Ioi 0) ∧ ∀ (k : ℕ) (t : ℝ), 0 < t → 0 ≤ (-1) ^ k * iteratedDeriv k f t
def MittagModulus.sourceExpression : ℝ → ℝ → ℝ :=
fun a t =>
  Complex.normSq (MittagModulus.mittagLeffler (2 * a) 1 (-↑t)) +
    t * Complex.normSq (MittagModulus.mittagLeffler (2 * a) (1 + a) (-↑t))
