def MittagModulus.SourceClaim370772 : Prop :=
∀ (a : ℝ), 0 < a → a ≤ 1 / 2 → MittagModulus.CompletelyMonotonePositive (MittagModulus.sourceExpression a)
def MittagModulus.CompletelyMonotonePositive : (ℝ → ℝ) → Prop :=
fun f => ContDiffOn ℝ (↑⊤) f (Set.Ioi 0) ∧ ∀ (k : ℕ) (t : ℝ), 0 < t → 0 ≤ (-1) ^ k * iteratedDeriv k f t
def MittagModulus.sourceExpression : ℝ → ℝ → ℝ :=
fun a t =>
  Complex.normSq (MittagModulus.mittagLeffler (2 * a) 1 (-↑t)) +
    t * Complex.normSq (MittagModulus.mittagLeffler (2 * a) (1 + a) (-↑t))
theorem MittagModulus.sourceClaim_of_positiveMixedApprox : (∀ (a : ℝ),
    0 < a → a ≤ 1 / 2 → ∀ (N : ℕ), MittagModulus.PositiveMixedDifferences (MittagModulus.squaredApprox a N)) →
  MittagModulus.SourceClaim370772 :=
fun hpos a ha ha2 =>
  have hdiff :=
    MittagModulus.PositiveMixedDifferences.of_tendsto_positive (hpos a ha ha2) fun t ht =>
      MittagModulus.squaredApprox_tendsto ha ha2 (LT.lt.le ht);
  MittagModulus.PositiveMixedDifferences.completelyMonotone hdiff (MittagModulus.sourceExpression_contDiff ha)
