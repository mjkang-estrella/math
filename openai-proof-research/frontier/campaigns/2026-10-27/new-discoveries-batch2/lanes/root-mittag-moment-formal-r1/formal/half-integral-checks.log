MittagModulus.halfBetaMoment (n : ℕ) : ℝ
'MittagModulus.halfBetaMoment' depends on axioms: [propext, Classical.choice, Quot.sound]
MittagModulus.halfBetaMoment_zero : MittagModulus.halfBetaMoment 0 = 1
'MittagModulus.halfBetaMoment_zero' depends on axioms: [propext, Classical.choice, Quot.sound]
MittagModulus.halfBetaMoment_succ (n : ℕ) :
  MittagModulus.halfBetaMoment (n + 1) = 2 * (↑n + 1) / (2 * ↑n + 3) * MittagModulus.halfBetaMoment n
'MittagModulus.halfBetaMoment_succ' depends on axioms: [propext, Classical.choice, Quot.sound]
MittagModulus.Gamma_three_halves : Real.Gamma (3 / 2) = √Real.pi / 2
'MittagModulus.Gamma_three_halves' depends on axioms: [propext, Classical.choice, Quot.sound]
MittagModulus.halfBetaMoment_eq_gamma (n : ℕ) :
  MittagModulus.halfBetaMoment n = √Real.pi * ↑n.factorial / (2 * Real.Gamma (↑n + 3 / 2))
'MittagModulus.halfBetaMoment_eq_gamma' depends on axioms: [propext, Classical.choice, Quot.sound]
MittagModulus.hasSum_mittagReal {a b : ℝ} (ha : 0 < a) (hb : 0 < b) (x : ℝ) :
  HasSum (fun n => x ^ n / Real.Gamma (a * ↑n + b)) (MittagModulus.mittagReal a b x)
'MittagModulus.hasSum_mittagReal' depends on axioms: [propext, Classical.choice, Quot.sound]
MittagModulus.mittag_one_eq_exp (z : ℂ) : MittagModulus.mittagLeffler 1 1 z = Complex.exp z
'MittagModulus.mittag_one_eq_exp' depends on axioms: [propext, Classical.choice, Quot.sound]
MittagModulus.exp_series_real (x : ℝ) : HasSum (fun n => x ^ n / ↑n.factorial) (Real.exp x)
'MittagModulus.exp_series_real' depends on axioms: [propext, Classical.choice, Quot.sound]
MittagModulus.halfExp_partial_bound (x : ℝ) (N : ℕ) {u : ℝ} (hu : u ∈ Set.Icc 0 1) :
  ‖∑ n ∈ Finset.range N, (-x * (1 - u ^ 2)) ^ n / ↑n.factorial‖ ≤ Real.exp |x|
'MittagModulus.halfExp_partial_bound' depends on axioms: [propext, Classical.choice, Quot.sound]
MittagModulus.integral_halfExp_term (x : ℝ) (n : ℕ) :
  ∫ (u : ℝ) in 0..1, (-x * (1 - u ^ 2)) ^ n / ↑n.factorial = √Real.pi / 2 * ((-x) ^ n / Real.Gamma (↑n + 3 / 2))
'MittagModulus.integral_halfExp_term' depends on axioms: [propext, Classical.choice, Quot.sound]
MittagModulus.integral_halfExp_eq_mittagReal (x : ℝ) :
  ∫ (u : ℝ) in 0..1, Real.exp (-x * (1 - u ^ 2)) = √Real.pi / 2 * MittagModulus.mittagReal 1 (3 / 2) (-x)
'MittagModulus.integral_halfExp_eq_mittagReal' depends on axioms: [propext, Classical.choice, Quot.sound]
