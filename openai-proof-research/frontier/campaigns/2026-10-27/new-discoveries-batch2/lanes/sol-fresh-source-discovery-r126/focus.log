frontier/campaigns/2026-10-26/new-discoveries/lanes/parent-analysis-screen-r6/sources/mathdb-414106.json [[1, '{"id":"ffade067-a130-4990-a707-4e5df4a0c805","lean_formalization_count":0,"has_bounty":false,"number":414106,"title":"Mahmoud–Qi and Zhu completely-monotonic-degree conjectures","statement":"Let $n\\\\ge 2$ and define the signed Stirling remainder, for $x>0$, by $R_n(x)=\\\\log\\\\Gamma(x)-\\\\left(x-\\\\frac12\\\\right)\\\\log x+x-\\\\frac12\\\\log(2\\\\pi)-\\\\sum_{k=1}^{n}\\\\frac{B_{2k}}{2k(2k-1)x^{2k-1}}$. For each $m\\\\ge 0$, set $F_{n,m}(x)=(-1)^{n+m}R_n^{(m)}(x)$. Determine exactly the completely monotonic degree $d_{n,m}=\\\\sup\\\\{r\\\\in\\\\mathbb{R}:x^rF_{n,m}(x)\\\\text{ is completely monotonic on }(0,\\\\infty)\\\\}$, where a function $g$ is completely monotonic if $(-1)^jg^{(j)}(x)\\\\ge 0$ for every integer $j\\\\ge 0$ and every $x>0$. In particular, determine the exact real degrees for the signed Stirling remainders and all their derivatives, beyond the previously conjectured integer-degree formulas.","post_type":"open_problem","status":"claimed_progress","tags":["inequalities","real-analysis","special-functions"],"collections":[],"author":null,"is_author":false,"importance":"named","first_stated_year":null,"first_stated_year_source_url":null,"documented_by_year":null,"documented_by_source_url":null,"refer']]
