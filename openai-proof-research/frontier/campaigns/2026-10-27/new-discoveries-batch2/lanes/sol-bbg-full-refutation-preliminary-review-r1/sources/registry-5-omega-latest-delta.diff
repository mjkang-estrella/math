+private def block (h : ℕ) : Finset Edge :=
+  ((List.finite_length_le Bool h).toFinset).subtype (· ≠ [])
+
+private theorem mem_block (h : ℕ) (p : Edge) : p ∈ block h ↔ p.val.length ≤ h := by
+  classical
+  simp [block]
