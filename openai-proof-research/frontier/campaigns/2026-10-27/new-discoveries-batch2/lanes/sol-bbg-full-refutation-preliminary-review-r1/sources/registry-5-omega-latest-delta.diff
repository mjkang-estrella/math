+  induction p with
+  | nil => rfl
+  | cons c p ih =>
+    change (if c then a^2 else a) * BiasedBoundaryTrace.mass p = _
+    rw [ih]
+    cases c <;> simp only [Bool.false_eq_true, ite_false, ite_true,
+      Observer.NativeRankedNavigationCompiler.pathCost, pow_add] <;> ring
+
