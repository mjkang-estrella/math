theorem wH_coordinate : ∀ k s x, (∑ i, wH k s i * dot (qH i) x) = (if s then x k else -x k) := by
  intro k s x
  fin_cases k <;> cases s
  · exact wH_coordinate_0_false x
  · exact wH_coordinate_0_true x
  · exact wH_coordinate_1_false x
  · exact wH_coordinate_1_true x
  · exact wH_coordinate_2_false x
  · exact wH_coordinate_2_true x
theorem compact_H : IsCompact (poly qH) := compact_of_positive_span qH wH wH_nonneg wH_coordinate
theorem interior_H : (0 : E) ∈ interior (poly qH) := zero_interior qH
end FullereneGeometry
