theorem wG_coordinate : ∀ k s x, (∑ i, wG k s i * dot (qG i) x) = (if s then x k else -x k) := by
  intro k s x
  fin_cases k <;> cases s
  · exact wG_coordinate_0_false x
  · exact wG_coordinate_0_true x
  · exact wG_coordinate_1_false x
  · exact wG_coordinate_1_true x
  · exact wG_coordinate_2_false x
  · exact wG_coordinate_2_true x
theorem compact_G : IsCompact (poly qG) := compact_of_positive_span qG wG wG_nonneg wG_coordinate
theorem interior_G : (0 : E) ∈ interior (poly qG) := zero_interior qG
end FullereneGeometry
