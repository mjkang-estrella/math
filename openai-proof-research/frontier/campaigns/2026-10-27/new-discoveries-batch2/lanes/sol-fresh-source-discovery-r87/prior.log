 = DATA.families.filter(hasPaper)
    .filter(f => !state.cat || catOf(f) === state.cat)
    .sort((a, b) => (a.paper_title || a.title).localeCompare(b.paper_title || b.title));
  const P = document.getElementById("papers");
  P.innerHTML = papers.length ? `<h2 class="section">Papers</h2>` : "";
  papers.forEach(f => P.appendChild(entryEl(f)));

  // Then the rest, one flat list in the same order as the table of contents
  // (the category is on the idline).
  const rank = new Map(cats.map((c, i) => [c, i]));
  const W = document.getElementById("wip");
  W.innerHTML = "";
  {
    const fs = DATA.families.filter(f => !hasPaper(f))
      .filter(f => !state.cat || catOf(f) === state.cat)
      .sort((a, b) => rank.get(catOf(a)) - rank.get(catOf(b)) ||
        a.title.localeCompare(b.title));
    if (fs.length) {
      W.innerHTML = `<h2 class="section">Work in progress</h2>`;
      fs.forEach(f => W.appendChild(entryEl(f)));
    }
  }

  document.getElementById("foot").textContent =
    `${DATA.totals.theorems.toLocaleString("en-US")} machine-checked theorems in total · ` +
    `snapshot of ${DATA.generated_at} · ${DATA.commit}`;
}

/* Researcher-derived tracks (family.json derived_from) are listed here like
   every other family; /r/<slug> (unlinked) shows one researcher's subset. */
fetch("/api/data").then(r => r.json()).then(j => { DATA = j; render(); })
  .catch(() => { document.getElementById("totals").textContent = "snapshot not available"; });

