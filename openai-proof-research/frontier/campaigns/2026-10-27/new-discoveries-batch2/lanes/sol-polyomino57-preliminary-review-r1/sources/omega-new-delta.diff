+    · rw [Fin.sum_univ_castSucc]
+      simp only [Fin.lastCases_castSucc, Fin.lastCases_last, Finset.sum_add_distrib,
+        Finset.sum_const, Finset.card_univ, Fintype.card_fin, smul_eq_mul]
