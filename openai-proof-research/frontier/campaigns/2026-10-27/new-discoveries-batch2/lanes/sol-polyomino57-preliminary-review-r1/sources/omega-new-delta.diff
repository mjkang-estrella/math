+        have ht := Fin.le_iff_val_le_val.mp
+          (t.property.2.1 ⟨j.val-(r+1),by have hj' := j.isLt; simp only [List.length_cons, Nat.mul_add, Nat.mul_one] at hj'; omega⟩)
