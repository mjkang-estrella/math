+        have he := h.property.2.2.1
+        omega
+    · have hn : ¬j.val < r+1 := by have := Fin.le_iff_val_le_val.mp hij; omega
+      simp only [assemble, dif_neg hi, dif_neg hn]
+      exact t.property.1 (Fin.le_iff_val_le_val.mpr
