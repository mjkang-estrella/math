+    (z : (v : Fin (U+1)) × (Level r U u.val v.val a × FlatFiber r U as v)) :
+    FlatFiber r U (a::as) u := by
+  let h := z.2.1
+  let t := z.2.2
+  refine ⟨assemble r U as h.val t.val, ?_, ?_, ?_⟩
+  · intro i j hij
+    by_cases hi : i.val < r+1
