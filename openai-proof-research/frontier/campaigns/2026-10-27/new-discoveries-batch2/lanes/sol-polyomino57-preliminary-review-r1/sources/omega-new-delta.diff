+/-- A single level has r+1 rows; its last row has length v. -/
+abbrev Level (r U u v a : ℕ) :=
+  {x : Fin (r+1) → Fin (U+1) // Antitone x ∧
+    (∀ i, (x i).val ≤ u) ∧ (x (Fin.last r)).val = v ∧
+    ∑ i, (x i).val = a}
