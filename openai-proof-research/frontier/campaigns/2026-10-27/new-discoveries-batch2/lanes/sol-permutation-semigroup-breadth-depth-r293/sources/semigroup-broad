    <id>http://arxiv.org/abs/1806.05972v4</id>
    <title>Cancellable elements of the lattice of semigroup varieties: varieties satisfying a permutational identity of length 3</title>
    <updated>2018-08-05T15:30:56Z</updated>
    <link href="https://arxiv.org/abs/1806.05972v4" rel="alternate" type="text/html"/>
