F(z,x)= -(4*x**6*z**3 + 2*x**5*z**3 + 6*x**4*z**2 + 3*x**3*z**2 - 4*x**3*z + x**2*z - 2*x**2 + x*z - 4*x - 1)/((2*x**3*z**2 + x*z - 1)*(2*x**3*z**2 + x**2*z**2 + 2*x*z + z - 1))
num= Poly((-4*x**6 - 2*x**5)*z**3 + (-6*x**4 - 3*x**3)*z**2 + (4*x**3 - x**2 - x)*z + 2*x**2 + 4*x + 1, z, domain='ZZ[x]')
den= Poly((4*x**6 + 2*x**5)*z**4 + (6*x**4 + 3*x**3)*z**3 + (-4*x**3 + x**2 + x)*z**2 + (-3*x - 1)*z + 1, z, domain='ZZ[x]')
eigen poly= (-lambda**2 + lambda*x + 2*x**3)*(-lambda**2 + 2*lambda*x + lambda + 2*x**3 + x**2)
negative minor 0 1 0 2 -x**3 - x**2
