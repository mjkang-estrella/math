AUDIT Transfer LogArctangentSource.subinterval_ratio
TYPE ∀ {a b c : ℝ},
  StrictMonoOn.{0, 0} LogArctangentSource.centeredLogGap (Set.Ioi.{0} 0) →
    LT.lt.{0} 0 a →
      LT.lt.{0} a c →
        LT.lt.{0} c b →
          LT.lt.{0}
              (HMul.hMul.{0, 0, 0} (HDiv.hDiv.{0, 0, 0} (LogArctangentSource.mean a b) (LogArctangentSource.fixedS a b))
                (LogArctangentSource.fixedS a c))
              (LogArctangentSource.mean a c) ∧
            LT.lt.{0}
              (HMul.hMul.{0, 0, 0} (HDiv.hDiv.{0, 0, 0} (LogArctangentSource.mean a b) (LogArctangentSource.fixedS a b))
                (LogArctangentSource.fixedS c b))
              (LogArctangentSource.mean c b)
AXIOMS [propext, Classical.choice, Quot.sound]
FLAGS unsafe=false partial=false axiom=false
