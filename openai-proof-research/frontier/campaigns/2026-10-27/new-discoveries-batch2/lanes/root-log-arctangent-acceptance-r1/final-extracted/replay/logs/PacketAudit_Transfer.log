AUDIT Transfer LogArctangentSource.transfer_of_stabilization
TYPE ∀ {p q a b : ℝ},
  StrictMonoOn.{0, 0} LogArctangentSource.centeredLogGap (Set.Ioi.{0} 0) →
    Ne.{1} p 0 →
      Ne.{1} q 0 →
        LT.lt.{0} 0 a →
          LT.lt.{0} a b →
            Eq.{1}
                (LogArctangentSource.powerMean p (LogArctangentSource.fixedS a (LogArctangentSource.powerMean q a b))
                  (LogArctangentSource.fixedS (LogArctangentSource.powerMean q a b) b))
                (LogArctangentSource.fixedS a b) →
              LT.lt.{0} (LogArctangentSource.mean a b) (LogArctangentSource.resultant p q a b)
AXIOMS [propext, Classical.choice, Quot.sound]
FLAGS unsafe=false partial=false axiom=false
AUDIT Transfer LogArctangentSource.gap_log_ratio
TYPE ∀ {a b : ℝ},
  LT.lt.{0} 0 a →
    LT.lt.{0} 0 b →
      Eq.{1}
        (LogArctangentSource.centeredLogGap (HDiv.hDiv.{0, 0, 0} (HSub.hSub.{0, 0, 0} (Real.log b) (Real.log a)) 2))
        (Real.log (HDiv.hDiv.{0, 0, 0} (LogArctangentSource.fixedS a b) (LogArctangentSource.mean a b)))
AXIOMS [propext, Classical.choice, Quot.sound]
FLAGS unsafe=false partial=false axiom=false
AUDIT Transfer LogArctangentSource.centered_representation
TYPE ∀ {a b : ℝ},
  LT.lt.{0} 0 a →
    LT.lt.{0} 0 b →
      have t := HDiv.hDiv.{0, 0, 0} (HSub.hSub.{0, 0, 0} (Real.log b) (Real.log a)) 2;
      have k := Real.exp (HDiv.hDiv.{0, 0, 0} (HAdd.hAdd.{0, 0, 0} (Real.log a) (Real.log b)) 2);
      Eq.{1} (HMul.hMul.{0, 0, 0} k (Real.exp (Neg.neg.{0} t))) a ∧ Eq.{1} (HMul.hMul.{0, 0, 0} k (Real.exp t)) b
AXIOMS [propext, Classical.choice, Quot.sound]
FLAGS unsafe=false partial=false axiom=false
AUDIT_TOTAL 5
