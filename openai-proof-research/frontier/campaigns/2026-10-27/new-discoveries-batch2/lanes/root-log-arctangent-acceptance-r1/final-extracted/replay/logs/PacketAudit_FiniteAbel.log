AUDIT FiniteAbel LogArctangentMean.finiteAbel
TYPE ∀ (c w : ℕ → ℝ) (n : ℕ),
  Eq.{1} (∑ i ∈ Finset.range n, HMul.hMul.{0, 0, 0} (c i) (w i))
    (HAdd.hAdd.{0, 0, 0} (HMul.hMul.{0, 0, 0} (∑ i ∈ Finset.range n, c i) (w n))
      (∑ i ∈ Finset.range n,
        HMul.hMul.{0, 0, 0} (∑ j ∈ Finset.range (HAdd.hAdd.{0, 0, 0} i 1), c j)
          (HSub.hSub.{0, 0, 0} (w i) (w (HAdd.hAdd.{0, 0, 0} i 1)))))
AXIOMS [propext, Classical.choice, Quot.sound]
FLAGS unsafe=false partial=false axiom=false
AUDIT FiniteAbel LogArctangentMean.finiteAbel_nonneg
TYPE ∀ (c w : ℕ → ℝ) (n : ℕ),
  (∀ (k : ℕ), LE.le.{0} k n → LE.le.{0} 0 (∑ i ∈ Finset.range k, c i)) →
    LE.le.{0} 0 (w n) →
      (∀ (i : ℕ), LT.lt.{0} i n → LE.le.{0} (w (HAdd.hAdd.{0, 0, 0} i 1)) (w i)) →
        LE.le.{0} 0 (∑ i ∈ Finset.range n, HMul.hMul.{0, 0, 0} (c i) (w i))
AXIOMS [propext, Classical.choice, Quot.sound]
FLAGS unsafe=false partial=false axiom=false
AUDIT FiniteAbel LogArctangentMean.finiteAbel_pos
TYPE ∀ (c w : ℕ → ℝ) (n : ℕ),
  (∀ (k : ℕ), LE.le.{0} k n → LE.le.{0} 0 (∑ i ∈ Finset.range k, c i)) →
    LT.lt.{0} 0 (∑ i ∈ Finset.range n, c i) →
      LT.lt.{0} 0 (w n) →
        (∀ (i : ℕ), LT.lt.{0} i n → LE.le.{0} (w (HAdd.hAdd.{0, 0, 0} i 1)) (w i)) →
          LT.lt.{0} 0 (∑ i ∈ Finset.range n, HMul.hMul.{0, 0, 0} (c i) (w i))
AXIOMS [propext, Classical.choice, Quot.sound]
FLAGS unsafe=false partial=false axiom=false
AUDIT_TOTAL 3
