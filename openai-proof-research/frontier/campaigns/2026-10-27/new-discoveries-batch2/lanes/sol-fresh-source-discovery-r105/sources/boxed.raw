<tr id="S5.F2.2.1" class="ltx_tr">
<th id="S5.F2.2.1.1" class="ltx_td ltx_align_center ltx_th ltx_th_column"><span id="S5.F2.2.1.1.1" class="ltx_text ltx_markedasmath" style="position:relative; bottom:2.6pt;"><span class="ltx_inline-block"><svg id="S5.F2.m1.pic1" class="ltx_picture" height="47.21" overflow="visible" style="vertical-align:-23.61px" version="1.1" viewBox="0 0 47.21 47.21" width="47.21"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,47.21) matrix(1 0 0 -1 0 0) translate(0.18,0) translate(0,0.18)"><g style="--ltx-stroke-color:#BFBFBF;--ltx-fill-color:#BFBFBF;--ltx-fg-color:#BFBFBF;" color="#BFBFBF" fill="#BFBFBF" stroke="#BFBFBF"><path style="stroke:none" d="M 9.37 9.37 M 9.37 9.37 L 9.37 18.74 L 18.74 18.74 L 18.74 9.37 Z M 18.74 18.74"></path></g><g style="--ltx-stroke-color:#BFBFBF;--ltx-fill-color:#BFBFBF;--ltx-fg-color:#BFBFBF;" color="#BFBFBF" fill="#BFBFBF" stroke="#BFBFBF"><path style="stroke:none" d="M 9.37 18.74 M 9.37 18.74 L 9.37 28.11 L 18.74 28.11 L 18.74 18.74 Z M 18.74 28.11"></path></g><g style="--ltx-stroke-color:#BFBFBF;--ltx-fill-color:#BFBFBF;--ltx-fg-color:#BFBFBF;" color="#BFBFBF" fill="#BFBFBF" stroke="#BFBFBF"><path style="stroke:none" d="M 9.37 28.11 M 9.37 28.11 L 9.37 37.48 L 18.74 37.48 L 18.74 28.11 Z M 18.74 37.48"></path></g><g style="--ltx-stroke-color:#BFBFBF;--ltx-fill-color:#BFBFBF;--ltx-fg-color:#BFBFBF;" color="#BFBFBF" fill="#BFBFBF" stroke="#BFBFBF"><path style="stroke:none" d="M 18.74 9.37 M 18.74 9.37 L 18.74 18.74 L 28.11 18.74 L 28.11 9.37 Z M 28.11 18.74"></path></g><g style="--ltx-stroke-color:#BFBFBF;--ltx-fill-color:#BFBFBF;--ltx-fg-color:#BFBFBF;" color="#BFBFBF" fill="#BFBFBF" stroke="#BFBFBF"><path style="stroke:none" d="M 18.74 18.74 M 18.74 18.74 L 18.74 28.11 L 28.11 28.11 L 28.11 18.74 Z M 28.11 28.11"></path></g><g style="--ltx-stroke-color:#BFBFBF;--ltx-fill-color:#BFBFBF;--ltx-fg-color:#BFBFBF;" color="#BFBFBF" fill="#BFBFBF" stroke="#BFBF