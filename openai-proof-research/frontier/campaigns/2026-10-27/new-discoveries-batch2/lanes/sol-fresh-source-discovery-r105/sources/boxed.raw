<th id="S2.F1.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column"><span id="S2.F1.2.1.3.1" class="ltx_text ltx_markedasmath" style="position:relative; bottom:2.6pt;"><span class="ltx_inline-block"><svg id="S2.F1.m3.pic1" class="ltx_picture" height="51.01" overflow="visible" style="vertical-align:-25.5px" version="1.1" viewBox="0 0 51.01 51.01" width="51.01"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,51.01) matrix(1 0 0 -1 0 0) translate(0.15,0) translate(0,0.15)"><g style="--ltx-stroke-color:#BFBFBF;--ltx-fill-color:#BFBFBF;--ltx-fg-color:#BFBFBF;" color="#BFBFBF" fill="#BFBFBF" stroke="#BFBFBF"><path style="stroke:none" d="M 12.68 12.68 M 12.68 12.68 L 12.68 25.35 L 25.35 25.35 L 25.35 12.68 Z M 25.35 25.35"></path></g><g style="--ltx-stroke-color:#BFBFBF;--ltx-fill-color:#BFBFBF;--ltx-fg-color:#BFBFBF;" color="#BFBFBF" fill="#BFBFBF" stroke="#BFBFBF"><path style="stroke:none" d="M 12.68 25.35 M 12.68 25.35 L 12.68 38.03 L 25.35 38.03 L 25.35 25.35 Z M 25.35 38.03"></path></g><g style="--ltx-stroke-color:#BFBFBF;--ltx-fill-color:#BFBFBF;--ltx-fg-color:#BFBFBF;" color="#BFBFBF" fill="#BFBFBF" stroke="#BFBFBF"><path style="stroke:none" d="M 25.35 12.68 M 25.35 12.68 L 25.35 25.35 L 38.03 25.35 L 38.03 12.68 Z M 38.03 25.35"></path></g><g style="--ltx-stroke-color:#BFBFBF;--ltx-fill-color:#BFBFBF;--ltx-fg-color:#BFBFBF;" color="#BFBFBF" fill="#BFBFBF" stroke="#BFBFBF"><path style="stroke:none" d="M 25.35 25.35 M 25.35 25.35 L 25.35 38.03 L 38.03 38.03 L 38.03 25.35 Z M 38.03 38.03"></path></g><g style="--ltx-stroke-color:#E08D86;--ltx-fill-color:#E08D86;--ltx-fg-color:#E08D86;" color="#E08D86" fill="#E08D86" stroke="#E08D86"><path style="stroke:none" d="M 12.68 25.35 M 12.68 25.35 L 12.68 38.03 L 25.35 38.03 L 25.35 25.35 Z M 25.35 38.03"></path></g><g style="--ltx-stroke-color:#E08D86;--ltx-fill-color:#E08D86;--ltx-fg-color:#E08D86;" color="#E08D86" fill="#E08D86"