<th id="S5.p15.2.1.4" class="ltx_td ltx_nopad_l ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="S5.p15.2.1.4.1" class="ltx_text" style="font-size:90%;">boxed candidates; blockers</span></th></tr>
