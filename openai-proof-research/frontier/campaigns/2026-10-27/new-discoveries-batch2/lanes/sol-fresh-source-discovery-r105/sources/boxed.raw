\lxSVG@closescope {}{{}}{}
{{}{}}{{}}{}{}{}{}{{}}{}\lxSVG@begingroup@{_scopebegin=1} \color[rgb]{0.75,0.75,0.75}\lxSVG@fill\lxSVG@drawpath@unclipped{M 14.33 7.17 M 14.33 7.17 L 14.33 14.33 L 21.5 14.33 L 21.5 7.17 Z M 21.5 14.33}{stroke:none} \lx@inpgf@ignorespaces
\lxSVG@closescope {}{{}}{}
{{}{}}{{}}{}{}{}{}{{}}{}\lxSVG@begingroup@{_scopebegin=1} \color[rgb]{0.75,0.75,0.75}\lxSVG@fill\lxSVG@drawpath@unclipped{M 14.33 14.33 M 14.33 14.33 L 14.33 21.5 L 21.5 21.5 L 21.5 14.33 Z M 21.5 21.5}{stroke:none} \lx@inpgf@ignorespaces
\lxSVG@closescope 
