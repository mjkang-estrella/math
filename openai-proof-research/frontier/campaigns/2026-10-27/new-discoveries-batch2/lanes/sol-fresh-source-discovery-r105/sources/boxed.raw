g></span></span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S5.F2.2.2" class="ltx_tr">
<td id="S5.F2.2.2.1" class="ltx_td ltx_align_center"><math id="S5.F2.m4" class="ltx_Math" alttext="\operatorname{Box}(2413)" display="inline" intent=":literal"><semantics><mrow><mi>Box</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2413</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{Box}(2413)</annotation></semantics></math></td>
<td id="S5.F2.2.2.2" class="ltx_td ltx_align_center"><math id="S5.F2.m5" class="ltx_Math" alttext="2\underline{41}3" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mn>41</mn><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">2\underline{41}3</annotation></semantics></math></td>
<td id="S5.F2.2.2.3" class="ltx_td ltx_align_center"><math id="S5.F2.m6" class="ltx_Math" alttext="(2413,\{2\},\{2\})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>2413</mn><mo>,</mo><mrow><mo stretchy="false">{</mo><mn>2</mn><mo stretchy="false">}</mo></mrow><mo>,</mo><mrow><mo stretchy="false">{</mo><mn>2</mn><mo stretchy="false">}</mo></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(2413,\{2\},\{2\})</annotation></semantics></math></td></tr>
</tbody>
</table>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 2: </span>A boxed, a vincular and a genuinely bivincular presentation of the
same containment condition.</figcaption>
</figure>
<div id="S5.Thmtheorem4" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmtheorem4.2" class="ltx_text ltx_font_bold">Theorem 5.4</span></span><span id="S5.Thmtheorem4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmtheorem4.p1" class="ltx_para">
<p id="S5.Thmtheorem4.p1.1" class="ltx_p"><span id="S5.Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S5.Thmtheorem4.p1.m1" class="ltx_Math" alttext="\tau\in\mathfrak{S}_{k}" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>∈</mo><msub><mi>𝔖</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">\tau\in\mathfrak{S}_{k}</annotation></semantics></math>, and let <math id="S5.Thmtheorem4.p1.m2" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> be a bivincular pattern of length
<math id="S5.Thmtheorem4.p1.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>. If <math id="S5.Thmtheorem4.p1.m4" class="ltx_Math" alttext="\operatorname{Box}(\tau)\mathrel{\equiv_{\rm c}}B" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Box</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mo>≡</mo><msub><mrow></mrow><mi mathvariant="normal">c</mi></msub></mrow><mi>B</mi></mrow><annotation encoding="application/x-tex">\operatorname{Box}(\tau)\mathrel{\equiv_{\rm c}}B</annotation></semantics></math>, then <math id="S5.Thmtheorem4.p1.m5" class="ltx_Math" alttext="k\leq 4" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≤</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">k\leq 4</annotation></semantics></math>. In particular, boxed–bivincular coincidences do not occur in
arbitrarily large lengths.</span></p>
</div>
</div>
<div id="S5.5" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S5.p19" class="ltx_para">
<p id="S5.p19.1" class="ltx_p"><span id="S5.p19.1.1" class="ltx_text">Write <math id="S5.p19.m1" class="ltx_Math" alttext="B=(\sigma,X,Y)" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>σ</mi><mo>,</mo><mi>X</mi><mo>,</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B=(\sigma,X,Y)</annotation></semantics></math>, where <math id="S5.p19.m2" class="ltx_Math" alttext="X,Y\subseteq[k-1]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>X</mi><mo>,</mo><mi>Y</mi></mrow><mo>⊆</mo><mrow><mo stretchy="false">[</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">X,Y\subseteq[k-1]</annotation></semantics></math> are respectively its sets
of position and value bonds. By Proposition <a href="#S2.Thmtheorem1" title="Proposition 2.1 ([], Lemmas 4.1 and 4.2). ‣ 2 Preliminaries ‣ Coincidences and Growth of Boxed Mesh Patterns" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.1</span></a>,
coincidence implies</span></p>
<table id="S5.E7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E7.m1" class="ltx_Math" alttext="\sigma=\tau\qquad\text{and}\qquad\operatorname{enc}(\operatorname{Box}(\tau))=\operatorname{enc}(B)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>σ</mi><mo>=</mo><mi>τ</mi></mrow><mspace style="width:2em;" width="2em"></mspace><mtext>and</mtext><mspace style="width:2.167em;" width="2.167em"></mspace><mrow><mrow><mi>enc</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>Box</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>enc</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sigma=\tau\qquad\text{and}\qquad\operatorname{enc}(\operatorname{Box}(\tau))=\operatorname{enc}(B).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(7)</span></td></tr></tbody>
</table>
<p id="S5.p19.2" class="ltx_p"><span id="S5.p19.2.1" class="ltx_text">If <math id="S5.p19.m3" class="ltx_Math" alttext="X=Y=\varnothing" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>=</mo><mi>Y</mi><mo>=</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">X=Y=\varnothing</annotation></semantics></math>, the result follows from
Proposition <a href="#S5.Thmtheorem1" title="Proposition 5.1. ‣ 5 Classical, vincular and bivincular coincidences ‣ Coincidences and Growth of Boxed Mesh Patterns" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a>. If exactly one of <math id="S5.p19.m4" class="ltx_Math" alttext="X,Y" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>,</mo><mi>Y</mi></mrow><annotation encoding="application/x-tex">X,Y</annotation></semantics></math> is nonempty, it
follows from <a href="#S5.Thmtheorem2" title="Theorem 5.2. ‣ 5 Classical, vincular and bivincular coincidences ‣ Coincidences and Growth of Boxed Mesh Patterns" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">5.2</span></a>, after applying inversion when
the bonds are value bonds. We may therefore assume that <math id="S5.p19.m5" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> and <math id="S5.p19.m6" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math> are both
nonempty.</span></p>
</div>
<div id="S5.p20" class="ltx_para">
<p id="S5.p20.1" class="ltx_p"><span id="S5.p20.1.1" class="ltx_text">Fix <math id="S5.p20.m1" class="ltx_Math" alttext="c\in X" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>∈</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">c\in X</annotation></semantics></math>. The complete shaded column <math id="S5.p20.m2" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math> of <math id="S5.p20.m3" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> contains the boundary
squares <math id="S5.p20.m4" class="ltx_Math" alttext="(c,0)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(c,0)</annotation></semantics></math> and <math id="S5.p20.m5" class="ltx_Math" alttext="(c,k)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(c,k)</annotation></semantics></math>, neither of which is shaded in the boxed mesh.
Equality in (<a href="#S5.E7" title="Equation 7 ‣ Proof. ‣ 5 Classical, vincular and bivincular coincidences ‣ Coincidences and Growth of Boxed Mesh Patterns" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>) implies that neither boundary square
can be pointless. The first must touch a plot point of value <math id="S5.p20.m6" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>, and the
second a plot point of value <math id="S5.p20.m7" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>. Hence <math id="S5.p20.m8" class="ltx_Math" alttext="\{\tau_{c},\tau_{c+1}\}=\{1,k\}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><msub><mi>τ</mi><mi>c</mi></msub><mo>,</mo><msub><mi>τ</mi><mrow><mi>c</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">}</mo></mrow><mo>=</mo><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mi>k</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\{\tau_{c},\tau_{c+1}\}=\{1,k\}</annotation></semantics></math>. The values <math id="S5.p20.m9" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> and <math id="S5.p20.m10" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> occur only once, so <math id="S5.p20.m11" class="ltx_Math" alttext="X=\{c\}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mi>c</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">X=\{c\}</annotation></semantics></math>. Applying the same
argument after inversion gives, for the unique <math id="S5.p20.m12" class="ltx_Math" alttext="d\in Y" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>∈</mo><mi>Y</mi></mrow><annotation encoding="application/x-tex">d\in Y</annotation></semantics></math>,</span></p>
<table id="S5.E8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E8.m1" class="ltx_Math" alttext="\{\tau^{-1}(d),\tau^{-1}(d+1)\}=\{1,k\},\qquad Y=\{d\}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">{</mo><mrow><msup><mi>τ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msup><mi>τ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mo>=</mo><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mi>k</mi><mo stretchy="false">}</mo></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mi>Y</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mi>d</mi><mo stretchy="false">}</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\{\tau^{-1}(d),\tau^{-1}(d+1)\}=\{1,k\},\qquad Y=\{d\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(8)</span></td></tr></tbody>
</table>
<p id="S5.p20.2" class="ltx_p"><span id="S5.p20.2.1" class="ltx_text">Thus the mesh of <math id="S5.p20.m13" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> consists of one complete column <math id="S5.p20.m14" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math> and one complete row
<math id="S5.p20.m15" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>.</span></p>
</div>
<div id="S5.p21" class="ltx_para">
<p id="S5.p21.1" class="ltx_p"><span id="S5.p21.1.1" class="ltx_text">Every internal square outside row <math id="S5.p21.m1" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> and column <math id="S5.p21.m2" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math> must touch a point of
<math id="S5.p21.m3" class="ltx_Math" alttext="G(\tau)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G(\tau)</annotation></semantics></math>. Otherwise it would be a pointless enclosed diagonal of
<math id="S5.p21.m4" class="ltx_Math" alttext="\operatorname{Box}(\tau)" display="inline" intent=":literal"><semantics><mrow><mi>Box</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{Box}(\tau)</annotation></semantics></math> absent from <math id="S5.p21.m5" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math>, contradicting (<a href="#S5.E7" title="Equation 7 ‣ Proof. ‣ 5 Classical, vincular and bivincular coincidences ‣ Coincidences and Growth of Boxed Mesh Patterns" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>).</span></p>
</div>
<div id="S5.p22" class="ltx_para">
<p id="S5.p22.1" class="ltx_p"><span id="S5.p22.1.1" class="ltx_text">Suppose first that <math id="S5.p22.m1" class="ltx_Math" alttext="k\geq 6" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≥</mo><mn>6</mn></mrow><annotation encoding="application/x-tex">k\geq 6</annotation></semantics></math> and <math id="S5.p22.m2" class="ltx_Math" alttext="c\leq k-2" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>≤</mo><mrow><mi>k</mi><mo>−</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">c\leq k-2</annotation></semantics></math>. Apart from the square in row <math id="S5.p22.m3" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>,
internal column <math id="S5.p22.m4" class="ltx_Math" alttext="c+1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c+1</annotation></semantics></math> contains <math id="S5.p22.m5" class="ltx_Math" alttext="k-2\geq 4" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>−</mo><mn>2</mn></mrow><mo>≥</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">k-2\geq 4</annotation></semantics></math> squares that must touch
<math id="S5.p22.m6" class="ltx_Math" alttext="G(\tau)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G(\tau)</annotation></semantics></math>. They can touch only the plot points in positions <math id="S5.p22.m7" class="ltx_Math" alttext="c+1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c+1</annotation></semantics></math> and
<math id="S5.p22.m8" class="ltx_Math" alttext="c+2" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>+</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">c+2</annotation></semantics></math>. By <math id="S5.p22.m9" class="ltx_Math" alttext="\{\tau_{c},\tau_{c+1}\}=\{1,k\}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><msub><mi>τ</mi><mi>c</mi></msub><mo>,</mo><msub><mi>τ</mi><mrow><mi>c</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">}</mo></mrow><mo>=</mo><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mi>k</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\{\tau_{c},\tau_{c+1}\}=\{1,k\}</annotation></semantics></math>, the first of these has value
<math id="S5.p22.m10" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> or <math id="S5.p22.m11" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> and touches only one internal square of the column; the second
touches at most two. This is impossible, so <math id="S5.p22.m12" class="ltx_Math" alttext="c=k-1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>=</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">c=k-1</annotation></semantics></math>. The analogous argument
in column <math id="S5.p22.m13" class="ltx_Math" alttext="c-1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c-1</annotation></semantics></math>, when <math id="S5.p22.m14" class="ltx_Math" alttext="c\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">c\geq 2</annotation></semantics></math>, gives <math id="S5.p22.m15" class="ltx_Math" alttext="c=1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c=1</annotation></semantics></math>, a contradiction. Hence <math id="S5.p22.m16" class="ltx_Math" alttext="k\leq 5" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≤</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">k\leq 5</annotation></semantics></math>.</span></p>
</div>
<div id="S5.p23" class="ltx_para">
<p id="S5.p23.1" class="ltx_p"><span id="S5.p23.1.1" class="ltx_text">It remains to exclude <math id="S5.p23.m1" class="ltx_Math" alttext="k=5" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">k=5</annotation></semantics></math>. Complementing if necessary, assume <math id="S5.p23.m2" class="ltx_Math" alttext="\tau_{c}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>τ</mi><mi>c</mi></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\tau_{c}=1</annotation></semantics></math> and <math id="S5.p23.m3" class="ltx_Math" alttext="\tau_{c+1}=5" display="inline" intent=":literal"><semantics><mrow><msub><mi>τ</mi><mrow><mi>c</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">\tau_{c+1}=5</annotation></semantics></math>.</span></p>
</div>
<div id="S5.p24" class="ltx_para">
<p id="S5.p24.1" class="ltx_p"><span id="S5.p24.1.1" class="ltx_text">If <math id="S5.p24.m1" class="ltx_Math" alttext="c\leq 3" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>≤</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">c\leq 3</annotation></semantics></math>, the three squares of column <math id="S5.p24.m2" class="ltx_Math" alttext="c+1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c+1</annotation></semantics></math> outside row <math id="S5.p24.m3" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> must all be
touched. The point <math id="S5.p24.m4" class="ltx_Math" alttext="(c+1,5)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mn>5</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(c+1,5)</annotation></semantics></math> touches only row <math id="S5.p24.m5" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math>, while the point in position
<math id="S5.p24.m6" class="ltx_Math" alttext="c+2" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>+</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">c+2</annotation></semantics></math>, writing <math id="S5.p24.m7" class="ltx_Math" alttext="q=\tau_{c+2}" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>=</mo><msub><mi>τ</mi><mrow><mi>c</mi><mo>+</mo><mn>2</mn></mrow></msub></mrow><annotation encoding="application/x-tex">q=\tau_{c+2}</annotation></semantics></math>, touches rows <math id="S5.p24.m8" class="ltx_Math" alttext="q-1" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">q-1</annotation></semantics></math> and <math id="S5.p24.m9" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> when these are
internal. For the touched rows to contain <math id="S5.p24.m10" class="ltx_Math" alttext="[4]\setminus\{d\}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mn>4</mn><mo stretchy="false">]</mo></mrow><mo>∖</mo><mrow><mo stretchy="false">{</mo><mi>d</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">[4]\setminus\{d\}</annotation></semantics></math>, either
<math id="S5.p24.m11" class="ltx_Math" alttext="q=2" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">q=2</annotation></semantics></math> and <math id="S5.p24.m12" class="ltx_Math" alttext="d=3" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">d=3</annotation></semantics></math>, or <math id="S5.p24.m13" class="ltx_Math" alttext="q=3" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>=</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">q=3</annotation></semantics></math> and <math id="S5.p24.m14" class="ltx_Math" alttext="d=1" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">d=1</annotation></semantics></math>; in particular, <math id="S5.p24.m15" class="ltx_Math" alttext="d\in\{1,3\}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>3</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">d\in\{1,3\}</annotation></semantics></math>. Similarly, if <math id="S5.p24.m16" class="ltx_Math" alttext="c\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">c\geq 2</annotation></semantics></math>, column <math id="S5.p24.m17" class="ltx_Math" alttext="c-1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c-1</annotation></semantics></math> is touched by <math id="S5.p24.m18" class="ltx_Math" alttext="(c,1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(c,1)</annotation></semantics></math> in row <math id="S5.p24.m19" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> and by
the point in position <math id="S5.p24.m20" class="ltx_Math" alttext="c-1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c-1</annotation></semantics></math>. If <math id="S5.p24.m21" class="ltx_Math" alttext="q=\tau_{c-1}" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>=</mo><msub><mi>τ</mi><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">q=\tau_{c-1}</annotation></semantics></math>, the available rows are
<math id="S5.p24.m22" class="ltx_Math" alttext="\{1,q-1,q\}\cap[4]" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi>q</mi></mrow><mo stretchy="false">}</mo></mrow><mo>∩</mo><mrow><mo stretchy="false">[</mo><mn>4</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\{1,q-1,q\}\cap[4]</annotation></semantics></math>. Covering the three required squares forces <math id="S5.p24.m23" class="ltx_Math" alttext="d\in\{2,4\}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>2</mn><mo>,</mo><mn>4</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">d\in\{2,4\}</annotation></semantics></math>. Therefore <math id="S5.p24.m24" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math> cannot lie in <math id="S5.p24.m25" class="ltx_Math" alttext="\{2,3\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mn>2</mn><mo>,</mo><mn>3</mn><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{2,3\}</annotation></semantics></math>, and so <math id="S5.p24.m26" class="ltx_Math" alttext="c\in\{1,4\}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>4</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">c\in\{1,4\}</annotation></semantics></math>.</span></p>
</div>
<div id="S5.p25" class="ltx_para">
<p id="S5.p25.1" class="ltx_p"><span id="S5.p25.1.1" class="ltx_text">After reversing and, if necessary, complementing, we may take <math id="S5.p25.m1" class="ltx_Math" alttext="c=1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c=1</annotation></semantics></math>, <math id="S5.p25.m2" class="ltx_Math" alttext="\tau_{1}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>τ</mi><mn>1</mn></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\tau_{1}=1</annotation></semantics></math>, and <math id="S5.p25.m3" class="ltx_Math" alttext="\tau_{2}=5" display="inline" intent=":literal"><semantics><mrow><msub><mi>τ</mi><mn>2</mn></msub><mo>=</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">\tau_{2}=5</annotation></semantics></math>. Equation (<a href="#S5.E8" title="Equation 8 ‣ Proof. ‣ 5 Classical, vincular and bivincular coincidences ‣ Coincidences and Growth of Boxed Mesh Patterns" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>) says that the values <math id="S5.p25.m4" class="ltx_Math" alttext="d,d+1" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>,</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">d,d+1</annotation></semantics></math> occupy
the first and last positions. It follows that <math id="S5.p25.m5" class="ltx_Math" alttext="d=1" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">d=1</annotation></semantics></math> and <math id="S5.p25.m6" class="ltx_Math" alttext="\tau_{5}=2" display="inline" intent=":literal"><semantics><mrow><msub><mi>τ</mi><mn>5</mn></msub><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\tau_{5}=2</annotation></semantics></math>.
The preceding column-<math id="S5.p25.m7" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math> argument then forces <math id="S5.p25.m8" class="ltx_Math" alttext="\tau_{3}=3" display="inline" intent=":literal"><semantics><mrow><msub><mi>τ</mi><mn>3</mn></msub><mo>=</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">\tau_{3}=3</annotation></semantics></math>, and hence
<math id="S5.p25.m9" class="ltx_Math" alttext="\tau=15342" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>=</mo><mn>15342</mn></mrow><annotation encoding="application/x-tex">\tau=15342</annotation></semantics></math>.</span></p>
</div>
<div id="S5.p26" class="ltx_para">
<p id="S5.p26.1" class="ltx_p"><span id="S5.p26.1.1" class="ltx_text">The mesh of <math id="S5.p26.m1" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> now contains the two boundary squares <math id="S5.p26.m2" class="ltx_Math" alttext="D=\{(0,1),(1,0)\}" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">D=\{(0,1),(1,0)\}</annotation></semantics></math>. They form a proper enclosed SE-diagonal surrounding the plot point <math id="S5.p26.m3" class="ltx_Math" alttext="(1,1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1,1)</annotation></semantics></math>.
Neither square is shaded in <math id="S5.p26.m4" class="ltx_Math" alttext="\operatorname{Box}(15342)" display="inline" intent=":literal"><semantics><mrow><mi>Box</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>15342</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{Box}(15342)</annotation></semantics></math>, so <math id="S5.p26.m5" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> is absent from its set of
enclosed diagonals. This contradicts (<a href="#S5.E7" title="Equation 7 ‣ Proof. ‣ 5 Classical, vincular and bivincular coincidences ‣ Coincidences and Growth of Boxed Mesh Patterns" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>) and rules
out <math id="S5.p26.m6" class="ltx_Math" alttext="k=5" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">k=5</annotation></semantics></math>.
∎</span></p>
</div>
</div>
</section>
<section id="S6" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">6 </span>The boxed mesh pattern
<math id="S6.m1" class="ltx_Math" alttext="123" display="inline" intent=":literal"><semantics><mn>123</mn><annotation encoding="application/x-tex">123</annotation></semantics></math></h2>

<div id="S6.p1" class="ltx_para">
<p id="S6.p1.1" class="ltx_p">No closed formula is known for the number of permutations avoiding
<math id="S6.p1.m1" class="ltx_Math" alttext="\operatorname{Box}(123)" display="inline" intent=":literal"><semantics><mrow><mi>Box</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>123</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{Box}(123)</annotation></semantics></math>. In this section we give an exact maximum-insertion identity,
use it to extend the known sequence, and prove a subfactorial upper bound.
We then obtain a pattern-independent first-moment formula; in particular, the
mean number of <math id="S6.p1.m2" class="ltx_Math" alttext="\operatorname{Box}(123)" display="inline" intent=":literal"><semantics><mrow><mi>Box</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>123</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{Box}(123)</annotation></semantics></math> occurrences is <math id="S6.p1.m3" class="ltx_Math" alttext="(n+2)H_{n}-3n\sim n\log n" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>H</mi><mi>n</mi></msub></mrow><mo>−</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>∼</mo><mrow><mi>n</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">(n+2)H_{n}-3n\sim n\log n</annotation></semantics></math>, where
<math id="S6.p1.m4" class="ltx_Math" alttext="H_{n}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mi>n</mi></msub><annotation encoding="application/x-tex">H_{n}</annotation></semantics></math> is the <math id="S6.p1.m5" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>-th harmonic number.</p>
</div>
<section id="S6.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">6.1 </span>Exact enumeration</h3>

<div id="S6.SS1.p1" class="ltx_para">
<p id="S6.SS1.p1.1" class="ltx_p">Let <math id="S6.SS1.p1.m1" class="ltx_Math" alttext="\mathcal{A}_{n}=\operatorname{Av}_{n}(\operatorname{Box}(123))" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>n</mi></msub><mo>=</mo><mrow><msub><mi>Av</mi><mi>n</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>Box</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>123</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{A}_{n}=\operatorname{Av}_{n}(\operatorname{Box}(123))</annotation></semantics></math> and <math id="S6.SS1.p1.m2" class="ltx_Math" alttext="a_{n}=|\mathcal{A}_{n}|" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>n</mi></msub><mo>=</mo><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>n</mi></msub><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">a_{n}=|\mathcal{A}_{n}|</annotation></semantics></math>. For a word <math id="S6.SS1.p1.m3" class="ltx_math_unparsed" alttext="w=w_{1}\cdots w_{t}" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>=</mo><mi>w</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>w</mi><msub><mrow></mrow><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">w=w_{1}\cdots w_{t}</annotation></semantics></math> with distinct entries, set <math id="S6.SS1.p1.m4" class="ltx_math_unparsed" alttext="R_{i}(w)=|\{j:i&lt;j\leq t,\ w_{j}&gt;w_{i}\}|" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo rspace="0em">=</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mrow><mo stretchy="false">{</mo><mi>j</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi><mo>&lt;</mo><mi>j</mi><mo>≤</mo><mi>t</mi><mo rspace="0.667em">,</mo><msub><mi>w</mi><mi>j</mi></msub><mo>&gt;</mo><msub><mi>w</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><mo fence="false" stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">R_{i}(w)=|\{j:i&lt;j\leq t,\ w_{j}&gt;w_{i}\}|</annotation></semantics></math> and <math id="S6.SS1.p1.m5" class="ltx_Math" alttext="\mathcal{Q}_{t}=\{w\in\mathfrak{S}_{t}:R_{i}(w)\neq 1\text{ for all }i\}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒬</mi><mi>t</mi></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mi>w</mi><mo>∈</mo><msub><mi>𝔖</mi><mi>t</mi></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>R</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mtext> for all </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{Q}_{t}=\{w\in\mathfrak{S}_{t}:R_{i}(w)\neq 1\text{ for all }i\}</annotation></semantics></math>.
We call the gap after the first <math id="S6.SS1.p1.m6" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> entries of <math id="S6.SS1.p1.m7" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> <span id="S6.SS1.p1.1.1" class="ltx_text ltx_font_italic">active</span> if insertion of the
new maximum in that gap preserves boxed <math id="S6.SS1.p1.m8" class="ltx_Math" alttext="123" display="inline" intent=":literal"><semantics><mn>123</mn><annotation encoding="application/x-tex">123</annotation></semantics></math> avoidance.</p>
</div>
<div id="S6.Thmtheorem1" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmtheorem1.2" class="ltx_text ltx_font_bold">Theorem 6.1</span></span><span id="S6.Thmtheorem1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmtheorem1.p1" class="ltx_para">
<p id="S6.Thmtheorem1.p1.1" class="ltx_p"><span id="S6.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S6.Thmtheorem1.p1.m1" class="ltx_Math" alttext="\pi\in\mathcal{A}_{n}" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\pi\in\mathcal{A}_{n}</annotation></semantics></math>, and let <math id="S6.Thmtheorem1.p1.m2" class="ltx_math_unparsed" alttext="w=\pi_{1}\cdots\pi_{t}" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>=</mo><mi>π</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">w=\pi_{1}\cdots\pi_{t}</annotation></semantics></math>. The gap following
<math id="S6.Thmtheorem1.p1.m3" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math> is active if and only if <math id="S6.Thmtheorem1.p1.m4" class="ltx_Math" alttext="\operatorname{st}(w)\in\mathcal{Q}_{t}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>st</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒬</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">\operatorname{st}(w)\in\mathcal{Q}_{t}</annotation></semantics></math>. Moreover, <math id="S6.Thmtheorem1.p1.m5" class="ltx_Math" alttext="|\mathcal{Q}_{0}|=1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒬</mi><mn>0</mn></msub><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">|\mathcal{Q}_{0}|=1</annotation></semantics></math> and <math id="S6.Thmtheorem1.p1.m6" class="ltx_Math" alttext="|\mathcal{Q}_{t}|=(t-1)!" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒬</mi><mi>t</mi></msub><mo stretchy="false">|</mo></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow></mrow><annotation encoding="application/x-tex">|\mathcal{Q}_{t}|=(t-1)!</annotation></semantics></math> for <math id="S6.Thmtheorem1.p1.m7" class="ltx_Math" alttext="t\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t\geq 1</annotation></semantics></math>. Consequently,</span></p>
<table id="S6.E9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.E9.m1" class="ltx_math_unparsed" alttext="a_{n+1}=\sum_{\pi\in\mathcal{A}_{n}}\sum_{t=0}^{n}\mathbf{1}\!\left[\operatorname{st}(\pi_{1}\cdots\pi_{t})\in\mathcal{Q}_{t}\right]." display="block" intent=":literal"><semantics><mrow><msub><mi>a</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo rspace="0.111em">=</mo><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>π</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>n</mi></msub></mrow></munder><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mi>n</mi></munderover><mrow><mo>[</mo><mi>st</mi><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><msub><mi>π</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒬</mi><mi>t</mi></msub><mo>]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">a_{n+1}=\sum_{\pi\in\mathcal{A}_{n}}\sum_{t=0}^{n}\mathbf{1}\!\left[\operatorname{st}(\pi_{1}\cdots\pi_{t})\in\mathcal{Q}_{t}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(9)</span></td></tr></tbody>
</table>
<p id="S6.Thmtheorem1.p1.2" class="ltx_p"><span id="S6.Thmtheorem1.p1.2.1" class="ltx_text ltx_font_italic">Here <math id="S6.Thmtheorem1.p1.m8" class="ltx_Math" alttext="\mathbf{1}[\mathcal{E}]" display="inline" intent=":literal"><semantics><mrow><mn>𝟏</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{1}[\mathcal{E}]</annotation></semantics></math> denotes the indicator of a statement
<math id="S6.Thmtheorem1.p1.m9" class="ltx_Math" alttext="\mathcal{E}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℰ</mi><annotation encoding="application/x-tex">\mathcal{E}</annotation></semantics></math>: it equals <math id="S6.Thmtheorem1.p1.m10" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> when <math id="S6.Thmtheorem1.p1.m11" class="ltx_Math" alttext="\mathcal{E}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℰ</mi><annotation encoding="application/x-tex">\mathcal{E}</annotation></semantics></math> is true and <math id="S6.Thmtheorem1.p1.m12" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>
otherwise.</span></p>
</div>
</div>
<div id="S6.SS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S6.SS1.p2" class="ltx_para">
<p id="S6.SS1.p2.1" class="ltx_p"><span id="S6.SS1.p2.1.1" class="ltx_text">Any new boxed <math id="S6.SS1.p2.m1" class="ltx_Math" alttext="123" display="inline" intent=":literal"><semantics><mn>123</mn><annotation encoding="application/x-tex">123</annotation></semantics></math> occurrence must use the inserted maximum as its last and
largest selected entry. If its first selected entry is <math id="S6.SS1.p2.m2" class="ltx_Math" alttext="w_{i}" display="inline" intent=":literal"><semantics><msub><mi>w</mi><mi>i</mi></msub><annotation encoding="application/x-tex">w_{i}</annotation></semantics></math>, the boxed
condition says that exactly one entry to the right of <math id="S6.SS1.p2.m3" class="ltx_Math" alttext="w_{i}" display="inline" intent=":literal"><semantics><msub><mi>w</mi><mi>i</mi></msub><annotation encoding="application/x-tex">w_{i}</annotation></semantics></math> in the prefix <math id="S6.SS1.p2.m4" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math>
is larger than <math id="S6.SS1.p2.m5" class="ltx_Math" alttext="w_{i}" display="inline" intent=":literal"><semantics><msub><mi>w</mi><mi>i</mi></msub><annotation encoding="application/x-tex">w_{i}</annotation></semantics></math>: this unique entry is the middle selected point. This
condition is also sufficient, since every other entry between <math id="S6.SS1.p2.m6" class="ltx_Math" alttext="w_{i}" display="inline" intent=":literal"><semantics><msub><mi>w</mi><mi>i</mi></msub><annotation encoding="application/x-tex">w_{i}</annotation></semantics></math> and the
new maximum is then below <math id="S6.SS1.p2.m7" class="ltx_Math" alttext="w_{i}" display="inline" intent=":literal"><semantics><msub><mi>w</mi><mi>i</mi></msub><annotation encoding="application/x-tex">w_{i}</annotation></semantics></math> and hence outside the bounding rectangle.
Thus the gap is inactive precisely when some <math id="S6.SS1.p2.m8" class="ltx_Math" alttext="R_{i}(w)" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R_{i}(w)</annotation></semantics></math> equals one.</span></p>
</div>
<div id="S6.SS1.p3" class="ltx_para">
<p id="S6.SS1.p3.1" class="ltx_p"><span id="S6.SS1.p3.1.1" class="ltx_text">For the enumeration, recall that the <em id="S6.SS1.p3.1.1.1" class="ltx_emph ltx_font_italic">Lehmer code</em> of
<math id="S6.SS1.p3.m1" class="ltx_math_unparsed" alttext="w=w_{1}\cdots w_{t}\in\mathfrak{S}_{t}" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>=</mo><mi>w</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>w</mi><msub><mrow></mrow><mi>t</mi></msub><mo>∈</mo><mi>𝔖</mi><msub><mrow></mrow><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">w=w_{1}\cdots w_{t}\in\mathfrak{S}_{t}</annotation></semantics></math> is</span></p>
<table id="S6.Ex19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex19.m1" class="ltx_math_unparsed" alttext="\ell_{i}(w)=|\{j:i&lt;j\leq t,\ w_{j}&lt;w_{i}\}|,\qquad 1\leq i\leq t." display="block" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">ℓ</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo rspace="0em">=</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mrow><mo stretchy="false">{</mo><mi>j</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi><mo>&lt;</mo><mi>j</mi><mo>≤</mo><mi>t</mi><mo rspace="0.667em">,</mo><msub><mi>w</mi><mi>j</mi></msub><mo>&lt;</mo><msub><mi>w</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo rspace="2.167em">,</mo><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>t</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\ell_{i}(w)=|\{j:i&lt;j\leq t,\ w_{j}&lt;w_{i}\}|,\qquad 1\leq i\leq t.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS1.p3.2" class="ltx_p"><span id="S6.SS1.p3.2.1" class="ltx_text">The map <math id="S6.SS1.p3.m2" class="ltx_Math" alttext="w\longmapsto(\ell_{1}(w),\ldots,\ell_{t}(w))" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo stretchy="false">⟼</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi mathvariant="normal">ℓ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi mathvariant="normal">ℓ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">w\longmapsto(\ell_{1}(w),\ldots,\ell_{t}(w))</annotation></semantics></math> is a bijection between <math id="S6.SS1.p3.m3" class="ltx_Math" alttext="\mathfrak{S}_{t}" display="inline" intent=":literal"><semantics><msub><mi>𝔖</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\mathfrak{S}_{t}</annotation></semantics></math> and the set of vectors satisfying
<math id="S6.SS1.p3.m4" class="ltx_Math" alttext="0\leq\ell_{i}\leq t-i" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><msub><mi mathvariant="normal">ℓ</mi><mi>i</mi></msub><mo>≤</mo><mrow><mi>t</mi><mo>−</mo><mi>i</mi></mrow></mrow><annotation encoding="application/x-tex">0\leq\ell_{i}\leq t-i</annotation></semantics></math>. Indeed, the permutation can be reconstructed successively by choosing <math id="S6.SS1.p3.m5" class="ltx_Math" alttext="w_{i}" display="inline" intent=":literal"><semantics><msub><mi>w</mi><mi>i</mi></msub><annotation encoding="application/x-tex">w_{i}</annotation></semantics></math>
to be the <math id="S6.SS1.p3.m6" class="ltx_Math" alttext="(\ell_{i}+1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><msub><mi mathvariant="normal">ℓ</mi><mi>i</mi></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\ell_{i}+1)</annotation></semantics></math>-st smallest of the values not yet used.</span></p>
</div>
<div id="S6.SS1.p4" class="ltx_para">
<p id="S6.SS1.p4.1" class="ltx_p"><span id="S6.SS1.p4.1.1" class="ltx_text">Since every entry to the right of <math id="S6.SS1.p4.m1" class="ltx_Math" alttext="w_{i}" display="inline" intent=":literal"><semantics><msub><mi>w</mi><mi>i</mi></msub><annotation encoding="application/x-tex">w_{i}</annotation></semantics></math> is either smaller or larger than
<math id="S6.SS1.p4.m2" class="ltx_Math" alttext="w_{i}" display="inline" intent=":literal"><semantics><msub><mi>w</mi><mi>i</mi></msub><annotation encoding="application/x-tex">w_{i}</annotation></semantics></math>, we have <math id="S6.SS1.p4.m3" class="ltx_Math" alttext="R_{i}(w)=t-i-\ell_{i}(w)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>R</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>t</mi><mo>−</mo><mi>i</mi><mo>−</mo><mrow><msub><mi mathvariant="normal">ℓ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">R_{i}(w)=t-i-\ell_{i}(w)</annotation></semantics></math>. Thus <math id="S6.SS1.p4.m4" class="ltx_Math" alttext="(R_{1}(w),\ldots,R_{t}(w))" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><msub><mi>R</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>R</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(R_{1}(w),\ldots,R_{t}(w))</annotation></semantics></math>, which we call the
<em id="S6.SS1.p4.1.1.1" class="ltx_emph ltx_font_italic">complementary Lehmer code</em>, is also a bijective code in which the
coordinates may independently take the values</span></p>
<table id="S6.Ex20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex20.m1" class="ltx_Math" alttext="R_{i}(w)\in\{0,1,\ldots,t-i\}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>R</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><mi>i</mi></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">R_{i}(w)\in\{0,1,\ldots,t-i\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS1.p4.2" class="ltx_p"><span id="S6.SS1.p4.2.1" class="ltx_text">For <math id="S6.SS1.p4.m5" class="ltx_Math" alttext="i&lt;t" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>&lt;</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">i&lt;t</annotation></semantics></math>, excluding the value <math id="S6.SS1.p4.m6" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> leaves <math id="S6.SS1.p4.m7" class="ltx_Math" alttext="t-i" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>−</mo><mi>i</mi></mrow><annotation encoding="application/x-tex">t-i</annotation></semantics></math> choices, while
<math id="S6.SS1.p4.m8" class="ltx_Math" alttext="R_{t}(w)=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>R</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">R_{t}(w)=0</annotation></semantics></math> has one choice. Therefore
<math id="S6.SS1.p4.m9" class="ltx_Math" alttext="|\mathcal{Q}_{t}|=\prod_{i=1}^{t-1}(t-i)=(t-1)!." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒬</mi><mi>t</mi></msub><mo stretchy="false">|</mo></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo rspace="0em">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">|\mathcal{Q}_{t}|=\prod_{i=1}^{t-1}(t-i)=(t-1)!.</annotation></semantics></math>
∎</span></p>
</div>
</div>
<div id="S6.SS1.p5" class="ltx_para">
<p id="S6.SS1.p5.2" class="ltx_p">Iterating (<a href="#S6.E9" title="Equation 9 ‣ Theorem 6.1. ‣ 6.1 Exact enumeration ‣ 6 The boxed mesh pattern 123 ‣ Coincidences and Growth of Boxed Mesh Patterns" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>) by maximum insertion provides an efficient
recursive generation and gives</p>
<table id="S6.E10" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S6.E10X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S6.E10X.m2" class="ltx_Math" alttext="\displaystyle(a_{n})_{n=0}^{17}={}" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>n</mi><mo>=</mo><mn>0</mn></mrow><mn>17</mn></msubsup><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle(a_{n})_{n=0}^{17}={}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.E10X.m3" class="ltx_Math" alttext="\displaystyle 1,1,2,5,15,51,194,810,3675,17935," display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>5</mn><mo>,</mo><mn>15</mn><mo>,</mo><mn>51</mn><mo>,</mo><mn>194</mn><mo>,</mo><mn>810</mn><mo>,</mo><mn>3675</mn><mo>,</mo><mn>17935</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle 1,1,2,5,15,51,194,810,3675,17935,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(10)</span></td></tr>
<tr id="S6.E10Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.E10Xa.m2" class="ltx_Math" alttext="\displaystyle 93481,517129,3021133,18559966,119468349," display="inline" intent=":literal"><semantics><mrow><mrow><mn>93481</mn><mo>,</mo><mn>517129</mn><mo>,</mo><mn>3021133</mn><mo>,</mo><mn>18559966</mn><mo>,</mo><mn>119468349</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle 93481,517129,3021133,18559966,119468349,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="S6.E10Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.E10Xb.m2" class="ltx_Math" alttext="\displaystyle 803213656,5624984106,40932781511." display="inline" intent=":literal"><semantics><mrow><mrow><mn>803213656</mn><mo>,</mo><mn>5624984106</mn><mo>,</mo><mn>40932781511</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle 803213656,5624984106,40932781511.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS1.p5.3" class="ltx_p">The terms through <math id="S6.SS1.p5.m1" class="ltx_Math" alttext="n=12" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>12</mn></mrow><annotation encoding="application/x-tex">n=12</annotation></semantics></math> agree with OEIS entry A201168
<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib26" title="" class="ltx_ref">26</a>]</cite>, which listed no further terms; the five terms <math id="S6.SS1.p5.m2" class="ltx_Math" alttext="a_{13},\ldots,a_{17}" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mn>13</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>a</mi><mn>17</mn></msub></mrow><annotation encoding="application/x-tex">a_{13},\ldots,a_{17}</annotation></semantics></math> are computed here.
In particular <math id="S6.SS1.p5.m3" class="ltx_Math" alttext="a_{6}=194" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mn>6</mn></msub><mo>=</mo><mn>194</mn></mrow><annotation encoding="application/x-tex">a_{6}=194</annotation></semantics></math>, which differs from the value recorded in
<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib3" title="" class="ltx_ref">3</a>]</cite>; we have verified <math id="S6.SS1.p5.m4" class="ltx_Math" alttext="a_{6}=194" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mn>6</mn></msub><mo>=</mo><mn>194</mn></mrow><annotation encoding="application/x-tex">a_{6}=194</annotation></semantics></math> by exhaustive inspection of all
<math id="S6.SS1.p5.m5" class="ltx_Math" alttext="720" display="inline" intent=":literal"><semantics><mn>720</mn><annotation encoding="application/x-tex">720</annotation></semantics></math> permutations of length six.</p>
</div>
<div id="S6.SS1.p6" class="ltx_para">
<p id="S6.SS1.p6.1" class="ltx_p">Finding a closed coefficient formula for the sequence in (<a href="#S6.E10" title="Equation 10 ‣ 6.1 Exact enumeration ‣ 6 The boxed mesh pattern 123 ‣ Coincidences and Growth of Boxed Mesh Patterns" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>) remains an open problem. One possible route is to refine <math id="S6.SS1.p6.m1" class="ltx_Math" alttext="\mathcal{A}_{n}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\mathcal{A}_{n}</annotation></semantics></math> by the set of prefix lengths
<math id="S6.SS1.p6.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> for which the complementary Lehmer code avoids the digit one.
<a href="#S6.Thmtheorem1" title="Theorem 6.1. ‣ 6.1 Exact enumeration ‣ 6 The boxed mesh pattern 123 ‣ Coincidences and Growth of Boxed Mesh Patterns" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">6.1</span></a> identifies exactly the statistic that a successful refinement
must track.</p>
</div>
</section>
<section id="S6.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">6.2 </span>A subfactorial upper bound</h3>

<div id="S6.SS2.p1" class="ltx_para">
<p id="S6.SS2.p1.1" class="ltx_p">The factorial lower bound for <math id="S6.SS2.p1.m1" class="ltx_Math" alttext="a_{n}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>n</mi></msub><annotation encoding="application/x-tex">a_{n}</annotation></semantics></math> rules out the Stanley–Wilf property, but
it does not determine how close the avoidance sequence is to <math id="S6.SS2.p1.m2" class="ltx_Math" alttext="n!" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>!</mo></mrow><annotation encoding="application/x-tex">n!</annotation></semantics></math>. The next
result gives a genuinely subfactorial upper bound.</p>
</div>
<div id="S6.Thmtheorem2" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmtheorem2.2" class="ltx_text ltx_font_bold">Theorem 6.2</span></span><span id="S6.Thmtheorem2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmtheorem2.p1" class="ltx_para">
<p id="S6.Thmtheorem2.p1.1" class="ltx_p"><span id="S6.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S6.Thmtheorem2.p1.m1" class="ltx_Math" alttext="0&lt;x\leq 1" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><mi>x</mi><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">0&lt;x\leq 1</annotation></semantics></math> satisfy</span></p>
<table id="S6.E11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.E11.m1" class="ltx_Math" alttext="2x+\sqrt{x}\leq x(1+\sqrt{x})^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>+</mo><msqrt><mi>x</mi></msqrt></mrow><mo>≤</mo><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msqrt><mi>x</mi></msqrt></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">2x+\sqrt{x}\leq x(1+\sqrt{x})^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(11)</span></td></tr></tbody>
</table>
<p id="S6.Thmtheorem2.p1.2" class="ltx_p"><span id="S6.Thmtheorem2.p1.2.1" class="ltx_text ltx_font_italic">Then, for every <math id="S6.Thmtheorem2.p1.m2" class="ltx_Math" alttext="n\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">n\geq 1</annotation></semantics></math>,</span></p>
<table id="S6.E12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.E12.m1" class="ltx_Math" alttext="a_{n}\leq 2^{5n}n^{\,n\log_{2}(1+\sqrt{x})}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>a</mi><mi>n</mi></msub><mo>≤</mo><mrow><msup><mn>2</mn><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mi>n</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msqrt><mi>x</mi></msqrt></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">a_{n}\leq 2^{5n}n^{\,n\log_{2}(1+\sqrt{x})}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(12)</span></td></tr></tbody>
</table>
<p id="S6.Thmtheorem2.p1.3" class="ltx_p"><span id="S6.Thmtheorem2.p1.3.1" class="ltx_text ltx_font_italic">The smallest admissible value is <math id="S6.Thmtheorem2.p1.m3" class="ltx_Math" alttext="x^{*}=\left(2\cos\frac{\pi}{7}-1\right)^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mi>x</mi><mo>∗</mo></msup><mo>=</mo><msup><mrow><mo>(</mo><mrow><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>cos</mi><mo lspace="0.167em">⁡</mo><mfrac><mi>π</mi><mn>7</mn></mfrac></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">x^{*}=\left(2\cos\frac{\pi}{7}-1\right)^{2}</annotation></semantics></math>, and hence</span></p>
<table id="S6.E13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.E13.m1" class="ltx_Math" alttext="a_{n}\leq 2^{5n}n^{\beta n},\qquad\beta=\log_{2}\!\left(2\cos\frac{\pi}{7}\right)\approx 0.8496." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>a</mi><mi>n</mi></msub><mo>≤</mo><mrow><msup><mn>2</mn><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msup></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mi>β</mi><mo>=</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>cos</mi><mo lspace="0.167em">⁡</mo><mfrac><mi>π</mi><mn>7</mn></mfrac></mrow></mrow><mo>)</mo></mrow></mrow><mo>≈</mo><mn>0.8496</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">a_{n}\leq 2^{5n}n^{\beta n},\qquad\beta=\log_{2}\!\left(2\cos\frac{\pi}{7}\right)\approx 0.8496.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(13)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="S6.SS2.p2" class="ltx_para">
<p id="S6.SS2.p2.1" class="ltx_p">Consequently,</p>
<table id="S6.E14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.E14.m1" class="ltx_Math" alttext="\frac{1}{2}\leq\liminf_{n\to\infty}\frac{\log a_{n}}{n\log n}\leq\limsup_{n\to\infty}\frac{\log a_{n}}{n\log n}\leq\beta&lt;1." display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo rspace="0.1389em">≤</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">lim inf</mo><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>a</mi><mi>n</mi></msub></mrow><mrow><mi>n</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mrow></mfrac></mrow><mo rspace="0.1389em">≤</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">lim sup</mo><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>a</mi><mi>n</mi></msub></mrow><mrow><mi>n</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mrow></mfrac></mrow><mo>≤</mo><mi>β</mi><mo>&lt;</mo><mn>1</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{1}{2}\leq\liminf_{n\to\infty}\frac{\log a_{n}}{n\log n}\leq\limsup_{n\to\infty}\frac{\log a_{n}}{n\log n}\leq\beta&lt;1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(14)</span></td></tr></tbody>
</table>
<p id="S6.SS2.p2.2" class="ltx_p">Here the lower bound follows from the doubled-letter injection recalled in the
introduction, together with the fact that <math id="S6.SS2.p2.m1" class="ltx_Math" alttext="a_{n}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>n</mi></msub><annotation encoding="application/x-tex">a_{n}</annotation></semantics></math> is nondecreasing. Indeed,
inserting a new maximum in front of an avoider creates no boxed <math id="S6.SS2.p2.m2" class="ltx_Math" alttext="123" display="inline" intent=":literal"><semantics><mn>123</mn><annotation encoding="application/x-tex">123</annotation></semantics></math>
occurrence, because the new entry has no entry to its left and can only play
the last selected point; hence
<math id="S6.SS2.p2.m3" class="ltx_Math" alttext="a_{n}\geq a_{2\lfloor n/2\rfloor}\geq\lfloor n/2\rfloor!" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>n</mi></msub><mo>≥</mo><msub><mi>a</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⌊</mo><mrow><mi>n</mi><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">⌋</mo></mrow></mrow></msub><mo>≥</mo><mrow><mrow><mo stretchy="false">⌊</mo><mrow><mi>n</mi><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">⌋</mo></mrow><mo>!</mo></mrow></mrow><annotation encoding="application/x-tex">a_{n}\geq a_{2\lfloor n/2\rfloor}\geq\lfloor n/2\rfloor!</annotation></semantics></math> for every <math id="S6.SS2.p2.m4" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>. We call
<math id="S6.SS2.p2.m5" class="ltx_Math" alttext="\limsup_{n\to\infty}\log a_{n}/(n\log n)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>lim sup</mo><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>a</mi><mi>n</mi></msub></mrow></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\limsup_{n\to\infty}\log a_{n}/(n\log n)</annotation></semantics></math> the <em id="S6.SS2.p2.2.1" class="ltx_emph ltx_font_italic">growth exponent</em> of
<math id="S6.SS2.p2.m6" class="ltx_Math" alttext="\operatorname{Av}(\operatorname{Box}(123))" display="inline" intent=":literal"><semantics><mrow><mi>Av</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>Box</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>123</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{Av}(\operatorname{Box}(123))</annotation></semantics></math>; by (<a href="#S6.E14" title="Equation 14 ‣ 6.2 A subfactorial upper bound ‣ 6 The boxed mesh pattern 123 ‣ Coincidences and Growth of Boxed Mesh Patterns" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>) it lies between
<math id="S6.SS2.p2.m7" class="ltx_Math" alttext="\tfrac{1}{2}" display="inline" intent=":literal"><semantics><mfrac><mn>1</mn><mn>2</mn></mfrac><annotation encoding="application/x-tex">\tfrac{1}{2}</annotation></semantics></math> and <math id="S6.SS2.p2.m8" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math>. The upper bound also shows that a uniformly random
permutation avoids <math id="S6.SS2.p2.m9" class="ltx_Math" alttext="\operatorname{Box}(123)" display="inline" intent=":literal"><semantics><mrow><mi>Box</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>123</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{Box}(123)</annotation></semantics></math> with probability at most <math id="S6.SS2.p2.m10" class="ltx_Math" alttext="n^{-(1-\beta)n+O(n/\log n)}" display="inline" intent=":literal"><semantics><msup><mi>n</mi><mrow><mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>/</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><annotation encoding="application/x-tex">n^{-(1-\beta)n+O(n/\log n)}</annotation></semantics></math>.</p>
</div>
<div id="S6.SS2.p3" class="ltx_para">
<p id="S6.SS2.p3.1" class="ltx_p">To prove the theorem, for a permutation <math id="S6.SS2.p3.m1" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> let
<math id="S6.SS2.p3.m2" class="ltx_Math" alttext="\operatorname{asc}(\pi)" display="inline" intent=":literal"><semantics><mrow><mi>asc</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{asc}(\pi)</annotation></semantics></math> be its number of ascents, and, for <math id="S6.SS2.p3.m3" class="ltx_Math" alttext="0&lt;x\leq 1" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><mi>x</mi><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">0&lt;x\leq 1</annotation></semantics></math>, set</p>
<table id="S6.Ex21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex21.m1" class="ltx_Math" alttext="Z_{n}(x)=\sum_{\pi\in\mathcal{A}_{n}}x^{\operatorname{asc}(\pi)},\qquad\tau(x)=\frac{2x+\sqrt{x}}{(1+\sqrt{x})^{2}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>Z</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>π</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>n</mi></msub></mrow></munder><msup><mi>x</mi><mrow><mi>asc</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow></mrow></msup></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>+</mo><msqrt><mi>x</mi></msqrt></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msqrt><mi>x</mi></msqrt></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Z_{n}(x)=\sum_{\pi\in\mathcal{A}_{n}}x^{\operatorname{asc}(\pi)},\qquad\tau(x)=\frac{2x+\sqrt{x}}{(1+\sqrt{x})^{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.p3.2" class="ltx_p">For <math id="S6.SS2.p3.m4" class="ltx_Math" alttext="0&lt;x\leq 1" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><mi>x</mi><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">0&lt;x\leq 1</annotation></semantics></math> one has <math id="S6.SS2.p3.m5" class="ltx_Math" alttext="0&lt;\tau(x)\leq 1" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">0&lt;\tau(x)\leq 1</annotation></semantics></math>.</p>
</div>
<div id="S6.Thmtheorem3" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmtheorem3.2" class="ltx_text ltx_font_bold">Lemma 6.3</span></span><span id="S6.Thmtheorem3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmtheorem3.p1" class="ltx_para">
<p id="S6.Thmtheorem3.p1.1" class="ltx_p"><span id="S6.Thmtheorem3.p1.1.1" class="ltx_text ltx_font_italic">For <math id="S6.Thmtheorem3.p1.m1" class="ltx_Math" alttext="n\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">n\geq 2</annotation></semantics></math>, with <math id="S6.Thmtheorem3.p1.m2" class="ltx_Math" alttext="h_{1}=\lfloor n/2\rfloor" display="inline" intent=":literal"><semantics><mrow><msub><mi>h</mi><mn>1</mn></msub><mo>=</mo><mrow><mo stretchy="false">⌊</mo><mrow><mi>n</mi><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">⌋</mo></mrow></mrow><annotation encoding="application/x-tex">h_{1}=\lfloor n/2\rfloor</annotation></semantics></math> and
<math id="S6.Thmtheorem3.p1.m3" class="ltx_Math" alttext="h_{2}=\lceil n/2\rceil" display="inline" intent=":literal"><semantics><mrow><msub><mi>h</mi><mn>2</mn></msub><mo>=</mo><mrow><mo stretchy="false">⌈</mo><mrow><mi>n</mi><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">⌉</mo></mrow></mrow><annotation encoding="application/x-tex">h_{2}=\lceil n/2\rceil</annotation></semantics></math>, one has</span></p>
<table id="S6.E15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.E15.m1" class="ltx_Math" alttext="Z_{n}(x)\leq\frac{2(1+\sqrt{x})^{n-1}}{\tau(x)}Z_{h_{1}}(\tau(x))Z_{h_{2}}(\tau(x))." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>Z</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msqrt><mi>x</mi></msqrt></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>Z</mi><msub><mi>h</mi><mn>1</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>Z</mi><msub><mi>h</mi><mn>2</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Z_{n}(x)\leq\frac{2(1+\sqrt{x})^{n-1}}{\tau(x)}Z_{h_{1}}(\tau(x))Z_{h_{2}}(\tau(x)).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(15)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="S6.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S6.SS2.p4" class="ltx_para">
<p id="S6.SS2.p4.1" class="ltx_p"><span id="S6.SS2.p4.1.1" class="ltx_text">For <math id="S6.SS2.p4.m1" class="ltx_Math" alttext="\pi\in\mathfrak{S}_{n}" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo>∈</mo><msub><mi>𝔖</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\pi\in\mathfrak{S}_{n}</annotation></semantics></math>, call the entries with values at most <math id="S6.SS2.p4.m2" class="ltx_Math" alttext="h_{1}" display="inline" intent=":literal"><semantics><msub><mi>h</mi><mn>1</mn></msub><annotation encoding="application/x-tex">h_{1}</annotation></semantics></math>
<em id="S6.SS2.p4.1.1.1" class="ltx_emph ltx_font_italic">low</em> and the remaining entries <em id="S6.SS2.p4.1.1.2" class="ltx_emph ltx_font_italic">high</em>. Let
<math id="S6.SS2.p4.m3" class="ltx_Math" alttext="L\in\mathfrak{S}_{h_{1}}" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>∈</mo><msub><mi>𝔖</mi><msub><mi>h</mi><mn>1</mn></msub></msub></mrow><annotation encoding="application/x-tex">L\in\mathfrak{S}_{h_{1}}</annotation></semantics></math> and <math id="S6.SS2.p4.m4" class="ltx_Math" alttext="H\in\mathfrak{S}_{h_{2}}" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>∈</mo><msub><mi>𝔖</mi><msub><mi>h</mi><mn>2</mn></msub></msub></mrow><annotation encoding="application/x-tex">H\in\mathfrak{S}_{h_{2}}</annotation></semantics></math> be the patterns of the
low and high subsequences. Number the gaps around the low entries from <math id="S6.SS2.p4.m5" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> to
<math id="S6.SS2.p4.m6" class="ltx_Math" alttext="h_{1}" display="inline" intent=":literal"><semantics><msub><mi>h</mi><mn>1</mn></msub><annotation encoding="application/x-tex">h_{1}</annotation></semantics></math>, and number the slots between consecutive high entries from <math id="S6.SS2.p4.m7" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> to
<math id="S6.SS2.p4.m8" class="ltx_Math" alttext="h_{2}-1" display="inline" intent=":literal"><semantics><mrow><msub><mi>h</mi><mn>2</mn></msub><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">h_{2}-1</annotation></semantics></math>. Define</span></p>
<table id="S6.EGx2" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S6.Ex22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S6.Ex22.m1" class="ltx_Math" alttext="\displaystyle U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">\displaystyle U</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.Ex22.m2" class="ltx_Math" alttext="\displaystyle=\{i:\text{low gap $i$ contains a high entry}\}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mo stretchy="false">{</mo><mi>i</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mtext>low gap </mtext><mi>i</mi><mtext> contains a high entry</mtext></mrow><mo stretchy="false">}</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\{i:\text{low gap $i$ contains a high entry}\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S6.Ex23"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S6.Ex23.m1" class="ltx_Math" alttext="\displaystyle D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">\displaystyle D</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.Ex23.m2" class="ltx_Math" alttext="\displaystyle=\{j:\text{high slot $j$ contains a low entry}\}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mo stretchy="false">{</mo><mi>j</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mtext>high slot </mtext><mi>j</mi><mtext> contains a low entry</mtext></mrow><mo stretchy="false">}</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\{j:\text{high slot $j$ contains a low entry}\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.p4.2" class="ltx_p"><span id="S6.SS2.p4.2.1" class="ltx_text">The nonempty low gaps contain the maximal blocks of high entries. Thus
<math id="S6.SS2.p4.m9" class="ltx_Math" alttext="|D|=|U|-1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>D</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">|</mo><mi>U</mi><mo stretchy="false">|</mo></mrow><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">|D|=|U|-1</annotation></semantics></math>, and <math id="S6.SS2.p4.m10" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> is recovered from <math id="S6.SS2.p4.m11" class="ltx_Math" alttext="(L,H,U,D)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>L</mi><mo>,</mo><mi>H</mi><mo>,</mo><mi>U</mi><mo>,</mo><mi>D</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(L,H,U,D)</annotation></semantics></math> by cutting <math id="S6.SS2.p4.m12" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> at the
slots in <math id="S6.SS2.p4.m13" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> and placing the resulting blocks in the gaps in <math id="S6.SS2.p4.m14" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math>.</span></p>
</div>
<div id="S6.SS2.p5" class="ltx_para">
<p id="S6.SS2.p5.1" class="ltx_p"><span id="S6.SS2.p5.1.1" class="ltx_text">Put <math id="S6.SS2.p5.m1" class="ltx_Math" alttext="T=|U\setminus\{0\}|" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><mrow><mo stretchy="false">|</mo><mrow><mi>U</mi><mo>∖</mo><mrow><mo stretchy="false">{</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">T=|U\setminus\{0\}|</annotation></semantics></math>. This is the number of adjacent low–high pairs,
and <math id="S6.SS2.p5.m2" class="ltx_Math" alttext="T\geq|D|" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>≥</mo><mrow><mo stretchy="false">|</mo><mi>D</mi><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">T\geq|D|</annotation></semantics></math>. Let <math id="S6.SS2.p5.m3" class="ltx_Math" alttext="I_{L}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><mi>L</mi></msub><annotation encoding="application/x-tex">I_{L}</annotation></semantics></math> be the number of ascents <math id="S6.SS2.p5.m4" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> of <math id="S6.SS2.p5.m5" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> for which
<math id="S6.SS2.p5.m6" class="ltx_Math" alttext="i\notin U" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∉</mo><mi>U</mi></mrow><annotation encoding="application/x-tex">i\notin U</annotation></semantics></math>, and let <math id="S6.SS2.p5.m7" class="ltx_Math" alttext="I_{H}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><mi>H</mi></msub><annotation encoding="application/x-tex">I_{H}</annotation></semantics></math> be the number of ascents <math id="S6.SS2.p5.m8" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> of <math id="S6.SS2.p5.m9" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> for which
<math id="S6.SS2.p5.m10" class="ltx_Math" alttext="j\notin D" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∉</mo><mi>D</mi></mrow><annotation encoding="application/x-tex">j\notin D</annotation></semantics></math>. For <math id="S6.SS2.p5.m11" class="ltx_Math" alttext="\pi\in\mathcal{A}_{n}" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\pi\in\mathcal{A}_{n}</annotation></semantics></math> the following elementary restrictions
hold:</span></p>
<ol id="S6.I1" class="ltx_enumerate">
<li id="S6.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(i)</span> 
<div id="S6.I1.i1.p1" class="ltx_para">
<p id="S6.I1.i1.p1.1" class="ltx_p"><math id="S6.I1.i1.p1.m1" class="ltx_Math" alttext="L\in\mathcal{A}_{h_{1}}" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><msub><mi>h</mi><mn>1</mn></msub></msub></mrow><annotation encoding="application/x-tex">L\in\mathcal{A}_{h_{1}}</annotation></semantics></math> and <math id="S6.I1.i1.p1.m2" class="ltx_Math" alttext="H\in\mathcal{A}_{h_{2}}" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><msub><mi>h</mi><mn>2</mn></msub></msub></mrow><annotation encoding="application/x-tex">H\in\mathcal{A}_{h_{2}}</annotation></semantics></math>;</p>
</div></li>
<li id="S6.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(ii)</span> 
<div id="S6.I1.i2.p1" class="ltx_para">
<p id="S6.I1.i2.p1.1" class="ltx_p">neither <math id="S6.I1.i2.p1.m1" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> nor <math id="S6.I1.i2.p1.m2" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> has two consecutive ascents;</p>
</div></li>
<li id="S6.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(iii)</span> 
<div id="S6.I1.i3.p1" class="ltx_para">
<p id="S6.I1.i3.p1.1" class="ltx_p">if <math id="S6.I1.i3.p1.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> is an ascent of <math id="S6.I1.i3.p1.m2" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>, then it is not the case that
<math id="S6.I1.i3.p1.m3" class="ltx_Math" alttext="i\notin U" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∉</mo><mi>U</mi></mrow><annotation encoding="application/x-tex">i\notin U</annotation></semantics></math> and <math id="S6.I1.i3.p1.m4" class="ltx_Math" alttext="i+1\in U" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo>∈</mo><mi>U</mi></mrow><annotation encoding="application/x-tex">i+1\in U</annotation></semantics></math>;</p>
</div></li>
<li id="S6.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(iv)</span> 
<div id="S6.I1.i4.p1" class="ltx_para">
<p id="S6.I1.i4.p1.1" class="ltx_p">if <math id="S6.I1.i4.p1.m1" class="ltx_Math" alttext="j\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">j\geq 2</annotation></semantics></math> is an ascent of <math id="S6.I1.i4.p1.m2" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>, then it is not the case that
<math id="S6.I1.i4.p1.m3" class="ltx_Math" alttext="j-1\in D" display="inline" intent=":literal"><semantics><mrow><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow><mo>∈</mo><mi>D</mi></mrow><annotation encoding="application/x-tex">j-1\in D</annotation></semantics></math> and <math id="S6.I1.i4.p1.m4" class="ltx_Math" alttext="j\notin D" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∉</mo><mi>D</mi></mrow><annotation encoding="application/x-tex">j\notin D</annotation></semantics></math>.</p>
</div></li>
</ol>
<p id="S6.SS2.p5.2" class="ltx_p"><span id="S6.SS2.p5.2.1" class="ltx_text">For (i), a point inside the rectangle of an occurrence among the low entries
would itself be low, and similarly for the high entries. For (ii), three
entries occupying consecutive positions of <math id="S6.SS2.p5.m12" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> and increasing in value form a
boxed occurrence in <math id="S6.SS2.p5.m13" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math>: between them there are no other low entries, while
all intervening high entries lie above their vertical range. The argument for <math id="S6.SS2.p5.m14" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> is
analogous. In (iii) the entries <math id="S6.SS2.p5.m15" class="ltx_Math" alttext="L_{i},L_{i+1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>,</mo><msub><mi>L</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">L_{i},L_{i+1}</annotation></semantics></math> followed by the first high
entry in gap <math id="S6.SS2.p5.m16" class="ltx_Math" alttext="i+1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i+1</annotation></semantics></math> occupy three consecutive positions of <math id="S6.SS2.p5.m17" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> and increase;
in (iv), use the last low entry of slot <math id="S6.SS2.p5.m18" class="ltx_Math" alttext="j-1" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">j-1</annotation></semantics></math> followed by <math id="S6.SS2.p5.m19" class="ltx_Math" alttext="H_{j},H_{j+1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mi>j</mi></msub><mo>,</mo><msub><mi>H</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">H_{j},H_{j+1}</annotation></semantics></math>.
These triples would be boxed occurrences, proving the restrictions.</span></p>
</div>
<div id="S6.SS2.p6" class="ltx_para">
<p id="S6.SS2.p6.1" class="ltx_p"><span id="S6.SS2.p6.1.1" class="ltx_text">Every adjacent ascent of <math id="S6.SS2.p6.m1" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> is either low–high, low–low, or high–high,
and therefore</span></p>
<table id="S6.E16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.E16.m1" class="ltx_Math" alttext="\operatorname{asc}(\pi)=T+I_{L}+I_{H}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>asc</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>T</mi><mo>+</mo><msub><mi>I</mi><mi>L</mi></msub><mo>+</mo><msub><mi>I</mi><mi>H</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\operatorname{asc}(\pi)=T+I_{L}+I_{H}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(16)</span></td></tr></tbody>
</table>
<p id="S6.SS2.p6.2" class="ltx_p"><span id="S6.SS2.p6.2.1" class="ltx_text">Let <math id="S6.SS2.p6.m2" class="ltx_Math" alttext="E_{L}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mi>L</mi></msub><annotation encoding="application/x-tex">E_{L}</annotation></semantics></math> be the set of ascents of <math id="S6.SS2.p6.m3" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>, and let <math id="S6.SS2.p6.m4" class="ltx_Math" alttext="E_{H}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mi>H</mi></msub><annotation encoding="application/x-tex">E_{H}</annotation></semantics></math> be the set of ascents
<math id="S6.SS2.p6.m5" class="ltx_Math" alttext="j\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">j\geq 2</annotation></semantics></math> of <math id="S6.SS2.p6.m6" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>. From (<a href="#S6.E16" title="Equation 16 ‣ Proof. ‣ 6.2 A subfactorial upper bound ‣ 6 The boxed mesh pattern 123 ‣ Coincidences and Growth of Boxed Mesh Patterns" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>), <math id="S6.SS2.p6.m7" class="ltx_Math" alttext="T\geq|D|" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>≥</mo><mrow><mo stretchy="false">|</mo><mi>D</mi><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">T\geq|D|</annotation></semantics></math>, and
<math id="S6.SS2.p6.m8" class="ltx_Math" alttext="0&lt;x\leq 1" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><mi>x</mi><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">0&lt;x\leq 1</annotation></semantics></math>, we obtain <math id="S6.SS2.p6.m9" class="ltx_Math" alttext="x^{\operatorname{asc}(\pi)}\leq f(U)g(D)" display="inline" intent=":literal"><semantics><mrow><msup><mi>x</mi><mrow><mi>asc</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo>≤</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x^{\operatorname{asc}(\pi)}\leq f(U)g(D)</annotation></semantics></math>, where</span></p>
<table id="S6.Ex24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex24.m1" class="ltx_math_unparsed" alttext="f(U)=x^{|U\setminus\{0\}|/2}x^{|\{i\in E_{L}:i\notin U\}|},\ \ \ \ g(D)=x^{|D|/2}x^{|\{j\in E_{H}:j\notin D\}|}." display="block" intent=":literal"><semantics><mrow><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>U</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msup><mi>x</mi><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>U</mi><mo>∖</mo><mrow><mo stretchy="false">{</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>/</mo><mn>2</mn></mrow></msup><msup><mi>x</mi><mrow><mo stretchy="false">|</mo><mrow><mo stretchy="false">{</mo><mrow><mi>i</mi><mo>∈</mo><msub><mi>E</mi><mi>L</mi></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>i</mi><mo>∉</mo><mi>U</mi></mrow><mo stretchy="false">}</mo></mrow><mo stretchy="false">|</mo></mrow></msup><mo rspace="2.167em">,</mo><mi>g</mi><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msup><mi>x</mi><mrow><mrow><mo stretchy="false">|</mo><mi>D</mi><mo stretchy="false">|</mo></mrow><mo>/</mo><mn>2</mn></mrow></msup><msup><mi>x</mi><mrow><mo stretchy="false">|</mo><mrow><mo stretchy="false">{</mo><mrow><mi>j</mi><mo>∈</mo><msub><mi>E</mi><mi>H</mi></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>j</mi><mo>∉</mo><mi>D</mi></mrow><mo stretchy="false">}</mo></mrow><mo stretchy="false">|</mo></mrow></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">f(U)=x^{|U\setminus\{0\}|/2}x^{|\{i\in E_{L}:i\notin U\}|},\ \ \ \ g(D)=x^{|D|/2}x^{|\{j\in E_{H}:j\notin D\}|}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.p6.3" class="ltx_p"><span id="S6.SS2.p6.3.1" class="ltx_text">If <math id="S6.SS2.p6.m10" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> is an ascent of <math id="S6.SS2.p6.m11" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>, its contribution has been omitted from <math id="S6.SS2.p6.m12" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math>; since
<math id="S6.SS2.p6.m13" class="ltx_Math" alttext="x\leq 1" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">x\leq 1</annotation></semantics></math>, this only enlarges the right-hand side.</span></p>
</div>
<div id="S6.SS2.p7" class="ltx_para">
<p id="S6.SS2.p7.1" class="ltx_p"><span id="S6.SS2.p7.1.1" class="ltx_text">By (ii), the pairs <math id="S6.SS2.p7.m1" class="ltx_Math" alttext="\{i,i+1\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mi>i</mi><mo>,</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{i,i+1\}</annotation></semantics></math> with <math id="S6.SS2.p7.m2" class="ltx_Math" alttext="i\in E_{L}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><msub><mi>E</mi><mi>L</mi></msub></mrow><annotation encoding="application/x-tex">i\in E_{L}</annotation></semantics></math> are disjoint. In summing
<math id="S6.SS2.p7.m3" class="ltx_Math" alttext="f(U)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f(U)</annotation></semantics></math> over all subsets <math id="S6.SS2.p7.m4" class="ltx_Math" alttext="U\subseteq\{0,1,\ldots,h_{1}\}" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>⊆</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>h</mi><mn>1</mn></msub></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">U\subseteq\{0,1,\ldots,h_{1}\}</annotation></semantics></math> allowed by (iii), the
index <math id="S6.SS2.p7.m5" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> contributes <math id="S6.SS2.p7.m6" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>, each
index in no such pair contributes <math id="S6.SS2.p7.m7" class="ltx_Math" alttext="1+\sqrt{x}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>+</mo><msqrt><mi>x</mi></msqrt></mrow><annotation encoding="application/x-tex">1+\sqrt{x}</annotation></semantics></math>, and each pair contributes <math id="S6.SS2.p7.m8" class="ltx_Math" alttext="x+\sqrt{x}+x=2x+\sqrt{x}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo>+</mo><msqrt><mi>x</mi></msqrt><mo>+</mo><mi>x</mi></mrow><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>+</mo><msqrt><mi>x</mi></msqrt></mrow></mrow><annotation encoding="application/x-tex">x+\sqrt{x}+x=2x+\sqrt{x}</annotation></semantics></math>; the fourth membership pattern is excluded by (iii). Hence</span></p>
<table id="S6.Ex25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex25.m1" class="ltx_Math" alttext="\sum_{U}f(U)=2(1+\sqrt{x})^{h_{1}}\tau(x)^{|E_{L}|}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">∑</mo><mi>U</mi></munder><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msqrt><mi>x</mi></msqrt></mrow><mo stretchy="false">)</mo></mrow><msub><mi>h</mi><mn>1</mn></msub></msup><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">|</mo><msub><mi>E</mi><mi>L</mi></msub><mo stretchy="false">|</mo></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{U}f(U)=2(1+\sqrt{x})^{h_{1}}\tau(x)^{|E_{L}|}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.p7.2" class="ltx_p"><span id="S6.SS2.p7.2.1" class="ltx_text">The same calculation, carried out over all subsets
<math id="S6.SS2.p7.m9" class="ltx_Math" alttext="D\subseteq\{1,\ldots,h_{2}-1\}" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>⊆</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>h</mi><mn>2</mn></msub><mo>−</mo><mn>1</mn></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">D\subseteq\{1,\ldots,h_{2}-1\}</annotation></semantics></math> allowed by (iv), gives</span></p>
<table id="S6.Ex26" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex26.m1" class="ltx_Math" alttext="\sum_{D}g(D)=(1+\sqrt{x})^{h_{2}-1}\tau(x)^{|E_{H}|}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">∑</mo><mi>D</mi></munder><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msqrt><mi>x</mi></msqrt></mrow><mo stretchy="false">)</mo></mrow><mrow><msub><mi>h</mi><mn>2</mn></msub><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">|</mo><msub><mi>E</mi><mi>H</mi></msub><mo stretchy="false">|</mo></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{D}g(D)=(1+\sqrt{x})^{h_{2}-1}\tau(x)^{|E_{H}|}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.p7.3" class="ltx_p"><span id="S6.SS2.p7.3.1" class="ltx_text">The encoding by <math id="S6.SS2.p7.m10" class="ltx_Math" alttext="(L,H,U,D)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>L</mi><mo>,</mo><mi>H</mi><mo>,</mo><mi>U</mi><mo>,</mo><mi>D</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(L,H,U,D)</annotation></semantics></math> is injective, and every <math id="S6.SS2.p7.m11" class="ltx_Math" alttext="\pi\in\mathcal{A}_{n}" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\pi\in\mathcal{A}_{n}</annotation></semantics></math>
yields a pair <math id="S6.SS2.p7.m12" class="ltx_Math" alttext="(U,D)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mi>D</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(U,D)</annotation></semantics></math> allowed by (iii) and (iv) and satisfying
<math id="S6.SS2.p7.m13" class="ltx_Math" alttext="|D|=|U|-1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>D</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">|</mo><mi>U</mi><mo stretchy="false">|</mo></mrow><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">|D|=|U|-1</annotation></semantics></math>. Dropping that last relation enlarges the set of encodings summed
over, so summing over all allowed pairs <math id="S6.SS2.p7.m14" class="ltx_Math" alttext="(U,D)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mi>D</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(U,D)</annotation></semantics></math> gives</span></p>
<table id="S6.EGx3" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S6.Ex27"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S6.Ex27.m1" class="ltx_Math" alttext="\displaystyle Z_{n}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>Z</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle Z_{n}(x)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.Ex27.m2" class="ltx_Math" alttext="\displaystyle\leq 2(1+\sqrt{x})^{n-1}\sum_{L\in\mathcal{A}_{h_{1}}}\sum_{H\in\mathcal{A}_{h_{2}}}\tau(x)^{|E_{L}|+|E_{H}|}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msqrt><mi>x</mi></msqrt></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>L</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><msub><mi>h</mi><mn>1</mn></msub></msub></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>H</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><msub><mi>h</mi><mn>2</mn></msub></msub></mrow></munder></mstyle><mrow><mi>τ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mrow><mrow><mo stretchy="false">|</mo><msub><mi>E</mi><mi>L</mi></msub><mo stretchy="false">|</mo></mrow><mo>+</mo><mrow><mo stretchy="false">|</mo><msub><mi>E</mi><mi>H</mi></msub><mo stretchy="false">|</mo></mrow></mrow></msup></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2(1+\sqrt{x})^{n-1}\sum_{L\in\mathcal{A}_{h_{1}}}\sum_{H\in\mathcal{A}_{h_{2}}}\tau(x)^{|E_{L}|+|E_{H}|}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S6.Ex28"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.Ex28.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{2(1+\sqrt{x})^{n-1}}{\tau(x)}Z_{h_{1}}(\tau(x))Z_{h_{2}}(\tau(x))," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msqrt><mi>x</mi></msqrt></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>Z</mi><msub><mi>h</mi><mn>1</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>Z</mi><msub><mi>h</mi><mn>2</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{2(1+\sqrt{x})^{n-1}}{\tau(x)}Z_{h_{1}}(\tau(x))Z_{h_{2}}(\tau(x)),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.p7.4" class="ltx_p"><span id="S6.SS2.p7.4.1" class="ltx_text">because <math id="S6.SS2.p7.m15" class="ltx_Math" alttext="|E_{L}|+|E_{H}|\geq\operatorname{asc}(L)+\operatorname{asc}(H)-1" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><msub><mi>E</mi><mi>L</mi></msub><mo stretchy="false">|</mo></mrow><mo rspace="0em">+</mo></mrow><mo fence="false" lspace="0em">|</mo><mrow><msub><mi>E</mi><mi>H</mi></msub><mo fence="false">|</mo><mrow><mphantom></mphantom><mo>≥</mo><mrow><mrow><mrow><mi>asc</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>asc</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mn>1</mn></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">|E_{L}|+|E_{H}|\geq\operatorname{asc}(L)+\operatorname{asc}(H)-1</annotation></semantics></math> and <math id="S6.SS2.p7.m16" class="ltx_Math" alttext="\tau(x)\leq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\tau(x)\leq 1</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S6.SS2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of <a href="#S6.Thmtheorem2" title="Theorem 6.2. ‣ 6.2 A subfactorial upper bound ‣ 6 The boxed mesh pattern 123 ‣ Coincidences and Growth of Boxed Mesh Patterns" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">6.2</span></a>.</h6>
<div id="S6.SS2.p8" class="ltx_para">
<p id="S6.SS2.p8.1" class="ltx_p"><span id="S6.SS2.p8.1.1" class="ltx_text">Condition (<a href="#S6.E11" title="Equation 11 ‣ Theorem 6.2. ‣ 6.2 A subfactorial upper bound ‣ 6 The boxed mesh pattern 123 ‣ Coincidences and Growth of Boxed Mesh Patterns" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>) is precisely <math id="S6.SS2.p8.m1" class="ltx_Math" alttext="\tau(x)\leq x" display="inline" intent=":literal"><semantics><mrow><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mi>x</mi></mrow><annotation encoding="application/x-tex">\tau(x)\leq x</annotation></semantics></math>.
Since <math id="S6.SS2.p8.m2" class="ltx_Math" alttext="Z_{h}(y)" display="inline" intent=":literal"><semantics><mrow><msub><mi>Z</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Z_{h}(y)</annotation></semantics></math> is increasing in <math id="S6.SS2.p8.m3" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math>, Lemma <a href="#S6.Thmtheorem3" title="Lemma 6.3. ‣ 6.2 A subfactorial upper bound ‣ 6 The boxed mesh pattern 123 ‣ Coincidences and Growth of Boxed Mesh Patterns" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.3</span></a> yields</span></p>
<table id="S6.Ex29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex29.m1" class="ltx_Math" alttext="Z_{n}(x)\leq\frac{2}{\tau(x)}(1+\sqrt{x})^{n-1}Z_{h_{1}}(x)Z_{h_{2}}(x)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>Z</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mfrac><mn>2</mn><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msqrt><mi>x</mi></msqrt></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>Z</mi><msub><mi>h</mi><mn>1</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>Z</mi><msub><mi>h</mi><mn>2</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Z_{n}(x)\leq\frac{2}{\tau(x)}(1+\sqrt{x})^{n-1}Z_{h_{1}}(x)Z_{h_{2}}(x).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.p8.2" class="ltx_p"><span id="S6.SS2.p8.2.1" class="ltx_text">Put</span></p>
<table id="S6.Ex30" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex30.m1" class="ltx_Math" alttext="F(n)=\log_{2}Z_{n}(x),\qquad\gamma_{x}=\log_{2}(1+\sqrt{x}),\qquad c=\log_{2}\frac{2}{x^{*}}&lt;1.64." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0.167em">⁡</mo><msub><mi>Z</mi><mi>n</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mi>γ</mi><mi>x</mi></msub><mo>=</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msqrt><mi>x</mi></msqrt></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mi>c</mi><mo>=</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0.167em">⁡</mo><mfrac><mn>2</mn><msup><mi>x</mi><mo>∗</mo></msup></mfrac></mrow><mo>&lt;</mo><mn>1.64</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">F(n)=\log_{2}Z_{n}(x),\qquad\gamma_{x}=\log_{2}(1+\sqrt{x}),\qquad c=\log_{2}\frac{2}{x^{*}}&lt;1.64.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.p8.3" class="ltx_p"><span id="S6.SS2.p8.3.1" class="ltx_text">The function <math id="S6.SS2.p8.m4" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> is increasing on <math id="S6.SS2.p8.m5" class="ltx_Math" alttext="(0,1]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">(0,1]</annotation></semantics></math>, so
<math id="S6.SS2.p8.m6" class="ltx_Math" alttext="\tau(x)\geq\tau(x^{*})=x^{*}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mi>x</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">\tau(x)\geq\tau(x^{*})=x^{*}</annotation></semantics></math> for admissible <math id="S6.SS2.p8.m7" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>. Hence <math id="S6.SS2.p8.m8" class="ltx_Math" alttext="F(1)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">F(1)=0</annotation></semantics></math> and <math id="S6.SS2.p8.m9" class="ltx_Math" alttext="F(n)\leq\gamma_{x}n+c+F(h_{1})+F(h_{2})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><msub><mi>γ</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mi>c</mi><mo>+</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>h</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>h</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">F(n)\leq\gamma_{x}n+c+F(h_{1})+F(h_{2})</annotation></semantics></math>. Induction gives</span></p>
<table id="S6.Ex31" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex31.m1" class="ltx_Math" alttext="F(n)\leq\gamma_{x}n\lceil\log_{2}n\rceil+c(2n-1)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><msub><mi>γ</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow><mo stretchy="false">⌉</mo></mrow></mrow><mo>+</mo><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">F(n)\leq\gamma_{x}n\lceil\log_{2}n\rceil+c(2n-1).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.p8.4" class="ltx_p"><span id="S6.SS2.p8.4.1" class="ltx_text">Indeed, both <math id="S6.SS2.p8.m10" class="ltx_Math" alttext="h_{i}" display="inline" intent=":literal"><semantics><msub><mi>h</mi><mi>i</mi></msub><annotation encoding="application/x-tex">h_{i}</annotation></semantics></math> are at most
<math id="S6.SS2.p8.m11" class="ltx_Math" alttext="2^{\lceil\log_{2}n\rceil-1}" display="inline" intent=":literal"><semantics><msup><mn>2</mn><mrow><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow><mo stretchy="false">⌉</mo></mrow><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">2^{\lceil\log_{2}n\rceil-1}</annotation></semantics></math>, so substituting the two inductive bounds cancels
one halving level and gives the displayed inequality.</span></p>
</div>
<div id="S6.SS2.p9" class="ltx_para">
<p id="S6.SS2.p9.1" class="ltx_p"><span id="S6.SS2.p9.1.1" class="ltx_text">Since <math id="S6.SS2.p9.m1" class="ltx_Math" alttext="\operatorname{asc}(\pi)\leq n-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>asc</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\operatorname{asc}(\pi)\leq n-1</annotation></semantics></math> and <math id="S6.SS2.p9.m2" class="ltx_Math" alttext="x\leq 1" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">x\leq 1</annotation></semantics></math>, we have
<math id="S6.SS2.p9.m3" class="ltx_Math" alttext="a_{n}\leq x^{-n}Z_{n}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>n</mi></msub><mo>≤</mo><mrow><msup><mi>x</mi><mrow><mo>−</mo><mi>n</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>Z</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">a_{n}\leq x^{-n}Z_{n}(x)</annotation></semantics></math>. Using
<math id="S6.SS2.p9.m4" class="ltx_Math" alttext="\lceil\log_{2}n\rceil\leq\log_{2}n+1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow><mo stretchy="false">⌉</mo></mrow><mo>≤</mo><mrow><mrow><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\lceil\log_{2}n\rceil\leq\log_{2}n+1</annotation></semantics></math>,
<math id="S6.SS2.p9.m5" class="ltx_Math" alttext="\gamma_{x}\leq 1" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mi>x</mi></msub><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\gamma_{x}\leq 1</annotation></semantics></math>, and <math id="S6.SS2.p9.m6" class="ltx_Math" alttext="\log_{2}(1/x^{*})&lt;0.64" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><msup><mi>x</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mn>0.64</mn></mrow><annotation encoding="application/x-tex">\log_{2}(1/x^{*})&lt;0.64</annotation></semantics></math>, we obtain</span></p>
<table id="S6.Ex32" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex32.m1" class="ltx_Math" alttext="\log_{2}a_{n}\leq\gamma_{x}n\log_{2}n+(\gamma_{x}+3.28+0.64)n\leq\gamma_{x}n\log_{2}n+5n," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0.167em">⁡</mo><msub><mi>a</mi><mi>n</mi></msub></mrow><mo>≤</mo><mrow><mrow><msub><mi>γ</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>γ</mi><mi>x</mi></msub><mo>+</mo><mn>3.28</mn><mo>+</mo><mn>0.64</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>≤</mo><mrow><mrow><msub><mi>γ</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\log_{2}a_{n}\leq\gamma_{x}n\log_{2}n+(\gamma_{x}+3.28+0.64)n\leq\gamma_{x}n\log_{2}n+5n,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.p9.2" class="ltx_p"><span id="S6.SS2.p9.2.1" class="ltx_text">which proves (<a href="#S6.E12" title="Equation 12 ‣ Theorem 6.2. ‣ 6.2 A subfactorial upper bound ‣ 6 The boxed mesh pattern 123 ‣ Coincidences and Growth of Boxed Mesh Patterns" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>).</span></p>
</div>
<div id="S6.SS2.p10" class="ltx_para">
<p id="S6.SS2.p10.1" class="ltx_p"><span id="S6.SS2.p10.1.1" class="ltx_text">Finally, with <math id="S6.SS2.p10.m1" class="ltx_Math" alttext="s=\sqrt{x}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>=</mo><msqrt><mi>x</mi></msqrt></mrow><annotation encoding="application/x-tex">s=\sqrt{x}</annotation></semantics></math>, condition
(<a href="#S6.E11" title="Equation 11 ‣ Theorem 6.2. ‣ 6.2 A subfactorial upper bound ‣ 6 The boxed mesh pattern 123 ‣ Coincidences and Growth of Boxed Mesh Patterns" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>) becomes
<math id="S6.SS2.p10.m2" class="ltx_Math" alttext="s^{3}+2s^{2}-s-1\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>s</mi><mn>3</mn></msup><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>s</mi><mn>2</mn></msup></mrow></mrow><mo>−</mo><mi>s</mi><mo>−</mo><mn>1</mn></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">s^{3}+2s^{2}-s-1\geq 0</annotation></semantics></math>. On <math id="S6.SS2.p10.m3" class="ltx_Math" alttext="0&lt;s\leq 1" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><mi>s</mi><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">0&lt;s\leq 1</annotation></semantics></math> its unique threshold is
<math id="S6.SS2.p10.m4" class="ltx_Math" alttext="s^{*}=2\cos(\pi/7)-1" display="inline" intent=":literal"><semantics><mrow><msup><mi>s</mi><mo>∗</mo></msup><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo>/</mo><mn>7</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">s^{*}=2\cos(\pi/7)-1</annotation></semantics></math>: after setting <math id="S6.SS2.p10.m5" class="ltx_Math" alttext="t=1+s" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mrow><mn>1</mn><mo>+</mo><mi>s</mi></mrow></mrow><annotation encoding="application/x-tex">t=1+s</annotation></semantics></math>, the corresponding equation is
<math id="S6.SS2.p10.m6" class="ltx_Math" alttext="t^{3}-t^{2}-2t+1=0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>t</mi><mn>3</mn></msup><mo>−</mo><msup><mi>t</mi><mn>2</mn></msup><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo>+</mo><mn>1</mn></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t^{3}-t^{2}-2t+1=0</annotation></semantics></math>. Its three roots are
<math id="S6.SS2.p10.m7" class="ltx_Math" alttext="2\cos(\pi/7)" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo>/</mo><mn>7</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">2\cos(\pi/7)</annotation></semantics></math>, <math id="S6.SS2.p10.m8" class="ltx_Math" alttext="2\cos(3\pi/7)" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi></mrow><mo>/</mo><mn>7</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">2\cos(3\pi/7)</annotation></semantics></math>, and <math id="S6.SS2.p10.m9" class="ltx_Math" alttext="2\cos(5\pi/7)" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi></mrow><mo>/</mo><mn>7</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">2\cos(5\pi/7)</annotation></semantics></math>, of which only the
first lies in <math id="S6.SS2.p10.m10" class="ltx_Math" alttext="(1,2]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>2</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">(1,2]</annotation></semantics></math>. That <math id="S6.SS2.p10.m11" class="ltx_Math" alttext="s^{*}" display="inline" intent=":literal"><semantics><msup><mi>s</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">s^{*}</annotation></semantics></math> is the only sign change on <math id="S6.SS2.p10.m12" class="ltx_Math" alttext="(0,1]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">(0,1]</annotation></semantics></math> follows
from a direct inspection: writing <math id="S6.SS2.p10.m13" class="ltx_Math" alttext="p(s)=s^{3}+2s^{2}-s-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msup><mi>s</mi><mn>3</mn></msup><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>s</mi><mn>2</mn></msup></mrow></mrow><mo>−</mo><mi>s</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">p(s)=s^{3}+2s^{2}-s-1</annotation></semantics></math>, the derivative
<math id="S6.SS2.p10.m14" class="ltx_Math" alttext="p^{\prime}(s)=3s^{2}+4s-1" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>p</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>s</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">p^{\prime}(s)=3s^{2}+4s-1</annotation></semantics></math> vanishes only at <math id="S6.SS2.p10.m15" class="ltx_Math" alttext="s=(\sqrt{7}-2)/3=0.2153\ldots" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msqrt><mn>7</mn></msqrt><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mn>3</mn></mrow><mo>=</mo><mrow><mn>0.2153</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">…</mi></mrow></mrow><annotation encoding="application/x-tex">s=(\sqrt{7}-2)/3=0.2153\ldots</annotation></semantics></math>, so <math id="S6.SS2.p10.m16" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>
decreases on <math id="S6.SS2.p10.m17" class="ltx_Math" alttext="(0,(\sqrt{7}-2)/3)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msqrt><mn>7</mn></msqrt><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0,(\sqrt{7}-2)/3)</annotation></semantics></math> and increases on <math id="S6.SS2.p10.m18" class="ltx_Math" alttext="((\sqrt{7}-2)/3,1]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msqrt><mn>7</mn></msqrt><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mn>3</mn></mrow><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">((\sqrt{7}-2)/3,1]</annotation></semantics></math>; since
<math id="S6.SS2.p10.m19" class="ltx_Math" alttext="p(0)=-1&lt;0&lt;1=p(1)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo>&lt;</mo><mn>0</mn><mo>&lt;</mo><mn>1</mn><mo>=</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">p(0)=-1&lt;0&lt;1=p(1)</annotation></semantics></math>, the polynomial <math id="S6.SS2.p10.m20" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> is negative on <math id="S6.SS2.p10.m21" class="ltx_Math" alttext="(0,s^{*})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msup><mi>s</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0,s^{*})</annotation></semantics></math> and
nonnegative on <math id="S6.SS2.p10.m22" class="ltx_Math" alttext="[s^{*},1]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><msup><mi>s</mi><mo>∗</mo></msup><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[s^{*},1]</annotation></semantics></math>. Thus <math id="S6.SS2.p10.m23" class="ltx_Math" alttext="x^{*}=(s^{*})^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mi>x</mi><mo>∗</mo></msup><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>s</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">x^{*}=(s^{*})^{2}</annotation></semantics></math> and
<math id="S6.SS2.p10.m24" class="ltx_Math" alttext="1+\sqrt{x^{*}}=2\cos(\pi/7)" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>+</mo><msqrt><msup><mi>x</mi><mo>∗</mo></msup></msqrt></mrow><mo>=</mo><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo>/</mo><mn>7</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">1+\sqrt{x^{*}}=2\cos(\pi/7)</annotation></semantics></math>, proving (<a href="#S6.E13" title="Equation 13 ‣ Theorem 6.2. ‣ 6.2 A subfactorial upper bound ‣ 6 The boxed mesh pattern 123 ‣ Coincidences and Growth of Boxed Mesh Patterns" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>).
∎</span></p>
</div>
</div>
</section>
<section id="S6.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">6.3 </span>Average occurrence counts for boxed patterns</h3>

<div id="S6.SS3.p1" class="ltx_para">
<p id="S6.SS3.p1.1" class="ltx_p">For <math id="S6.SS3.p1.m1" class="ltx_Math" alttext="\tau\in\mathfrak{S}_{k}" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>∈</mo><msub><mi>𝔖</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">\tau\in\mathfrak{S}_{k}</annotation></semantics></math> define</p>
<table id="S6.E17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.E17.m1" class="ltx_Math" alttext="F_{n,\tau}(q)=\sum_{\pi\in\mathfrak{S}_{n}}q^{N_{\operatorname{Box}(\tau)}(\pi)}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>F</mi><mrow><mi>n</mi><mo>,</mo><mi>τ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>π</mi><mo>∈</mo><msub><mi>𝔖</mi><mi>n</mi></msub></mrow></munder><msup><mi>q</mi><mrow><msub><mi>N</mi><mrow><mi>Box</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow></mrow></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">F_{n,\tau}(q)=\sum_{\pi\in\mathfrak{S}_{n}}q^{N_{\operatorname{Box}(\tau)}(\pi)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(17)</span></td></tr></tbody>
</table>
<p id="S6.SS3.p1.2" class="ltx_p">where <math id="S6.SS3.p1.m2" class="ltx_Math" alttext="N_{\operatorname{Box}(\tau)}(\pi)" display="inline" intent=":literal"><semantics><mrow><msub><mi>N</mi><mrow><mi>Box</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">N_{\operatorname{Box}(\tau)}(\pi)</annotation></semantics></math> is the number of occurrences of <math id="S6.SS3.p1.m3" class="ltx_Math" alttext="\operatorname{Box}(\tau)" display="inline" intent=":literal"><semantics><mrow><mi>Box</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{Box}(\tau)</annotation></semantics></math> in
<math id="S6.SS3.p1.m4" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math>. Its constant term is the avoidance number: <math id="S6.SS3.p1.m5" class="ltx_Math" alttext="F_{n,\tau}(0)=|\operatorname{Av}_{n}(\operatorname{Box}(\tau))|" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>F</mi><mrow><mi>n</mi><mo>,</mo><mi>τ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>Av</mi><mi>n</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>Box</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">F_{n,\tau}(0)=|\operatorname{Av}_{n}(\operatorname{Box}(\tau))|</annotation></semantics></math>. For uniformly random <math id="S6.SS3.p1.m6" class="ltx_Math" alttext="\pi\in\mathfrak{S}_{n}" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo>∈</mo><msub><mi>𝔖</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\pi\in\mathfrak{S}_{n}</annotation></semantics></math>, its derivative satisfies</p>
<table id="S6.E18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.E18.m1" class="ltx_Math" alttext="\frac{F^{\prime}_{n,\tau}(1)}{n!}=\mathbb{E}\bigl[N_{\operatorname{Box}(\tau)}(\pi)\bigr]." display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mrow><msubsup><mi>F</mi><mrow><mi>n</mi><mo>,</mo><mi>τ</mi></mrow><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>n</mi><mo>!</mo></mrow></mfrac><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msub><mi>N</mi><mrow><mi>Box</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{F^{\prime}_{n,\tau}(1)}{n!}=\mathbb{E}\bigl[N_{\operatorname{Box}(\tau)}(\pi)\bigr].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(18)</span></td></tr></tbody>
</table>
<p id="S6.SS3.p1.3" class="ltx_p">The full occurrence distribution for <math id="S6.SS3.p1.m7" class="ltx_Math" alttext="\operatorname{Box}(123)" display="inline" intent=":literal"><semantics><mrow><mi>Box</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>123</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{Box}(123)</annotation></semantics></math> is open, but the first moment
has a simple closed form. In fact, it is independent of the choice of the
underlying pattern of a fixed length.</p>
</div>
<div id="S6.Thmtheorem4" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmtheorem4.2" class="ltx_text ltx_font_bold">Proposition 6.4</span></span><span id="S6.Thmtheorem4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmtheorem4.p1" class="ltx_para">
<p id="S6.Thmtheorem4.p1.1" class="ltx_p"><span id="S6.Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S6.Thmtheorem4.p1.m1" class="ltx_Math" alttext="k\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">k\geq 2</annotation></semantics></math>, let <math id="S6.Thmtheorem4.p1.m2" class="ltx_Math" alttext="\tau\in\mathfrak{S}_{k}" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>∈</mo><msub><mi>𝔖</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">\tau\in\mathfrak{S}_{k}</annotation></semantics></math>, and write
<math id="S6.Thmtheorem4.p1.m3" class="ltx_Math" alttext="N_{\operatorname{Box}(\tau)}(\pi)" display="inline" intent=":literal"><semantics><mrow><msub><mi>N</mi><mrow><mi>Box</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">N_{\operatorname{Box}(\tau)}(\pi)</annotation></semantics></math> as in (<a href="#S6.E17" title="Equation 17 ‣ 6.3 Average occurrence counts for boxed patterns ‣ 6 The boxed mesh pattern 123 ‣ Coincidences and Growth of Boxed Mesh Patterns" class="ltx_ref"><span class="ltx_text ltx_ref_tag">17</span></a>). If
<math id="S6.Thmtheorem4.p1.m4" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> is uniformly distributed over <math id="S6.Thmtheorem4.p1.m5" class="ltx_Math" alttext="\mathfrak{S}_{n}" display="inline" intent=":literal"><semantics><msub><mi>𝔖</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\mathfrak{S}_{n}</annotation></semantics></math>, where <math id="S6.Thmtheorem4.p1.m6" class="ltx_Math" alttext="n\geq k" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">n\geq k</annotation></semantics></math>, then</span></p>
<table id="S6.E19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.E19.m1" class="ltx_Math" alttext="\mathbb{E}\bigl[N_{\operatorname{Box}(\tau)}(\pi)\bigr]=\frac{(n+k-1)(H_{n}-H_{k-2})-2(n-k+2)}{(k-2)!}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msub><mi>N</mi><mrow><mi>Box</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>n</mi><mo>+</mo><mi>k</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>H</mi><mi>n</mi></msub><mo>−</mo><msub><mi>H</mi><mrow><mi>k</mi><mo>−</mo><mn>2</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>n</mi><mo>−</mo><mi>k</mi></mrow><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow></mfrac></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\bigl[N_{\operatorname{Box}(\tau)}(\pi)\bigr]=\frac{(n+k-1)(H_{n}-H_{k-2})-2(n-k+2)}{(k-2)!},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(19)</span></td></tr></tbody>
</table>
<p id="S6.Thmtheorem4.p1.2" class="ltx_p"><span id="S6.Thmtheorem4.p1.2.1" class="ltx_text ltx_font_italic">where <math id="S6.Thmtheorem4.p1.m7" class="ltx_Math" alttext="H_{m}=\sum_{j=1}^{m}1/j" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mi>m</mi></msub><mo rspace="0.111em">=</mo><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><mn>1</mn></mrow><mo>/</mo><mi>j</mi></mrow></mrow><annotation encoding="application/x-tex">H_{m}=\sum_{j=1}^{m}1/j</annotation></semantics></math> is the <math id="S6.Thmtheorem4.p1.m8" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math>-th harmonic number and <math id="S6.Thmtheorem4.p1.m9" class="ltx_Math" alttext="H_{0}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mn>0</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">H_{0}=0</annotation></semantics></math>. In particular,</span></p>
<table id="S6.E20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.E20.m1" class="ltx_Math" alttext="\mathbb{E}\bigl[N_{\operatorname{Box}(123)}(\pi)\bigr]=(n+2)H_{n}-3n." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msub><mi>N</mi><mrow><mi>Box</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>123</mn><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>H</mi><mi>n</mi></msub></mrow><mo>−</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\bigl[N_{\operatorname{Box}(123)}(\pi)\bigr]=(n+2)H_{n}-3n.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(20)</span></td></tr></tbody>
</table>
<p id="S6.Thmtheorem4.p1.3" class="ltx_p"><span id="S6.Thmtheorem4.p1.3.1" class="ltx_text ltx_font_italic">Moreover, for fixed <math id="S6.Thmtheorem4.p1.m10" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> and <math id="S6.Thmtheorem4.p1.m11" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, the expectation in
(<a href="#S6.E19" title="Equation 19 ‣ Proposition 6.4. ‣ 6.3 Average occurrence counts for boxed patterns ‣ 6 The boxed mesh pattern 123 ‣ Coincidences and Growth of Boxed Mesh Patterns" class="ltx_ref"><span class="ltx_text ltx_ref_tag">19</span></a>) is independent of the choice of
<math id="S6.Thmtheorem4.p1.m12" class="ltx_Math" alttext="\tau\in\mathfrak{S}_{k}" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>∈</mo><msub><mi>𝔖</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">\tau\in\mathfrak{S}_{k}</annotation></semantics></math>: all boxed patterns of length <math id="S6.Thmtheorem4.p1.m13" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> have the same first
moment on <math id="S6.Thmtheorem4.p1.m14" class="ltx_Math" alttext="\mathfrak{S}_{n}" display="inline" intent=":literal"><semantics><msub><mi>𝔖</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\mathfrak{S}_{n}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S6.SS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S6.SS3.p2" class="ltx_para">
<p id="S6.SS3.p2.1" class="ltx_p"><span id="S6.SS3.p2.1.1" class="ltx_text">Fix selected positions
<math id="S6.SS3.p2.m1" class="ltx_math_unparsed" alttext="I=\{i_{1}&lt;\cdots&lt;i_{k}\}" display="inline" intent=":literal"><semantics><mrow><mi>I</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>i</mi><mn>1</mn></msub><mo rspace="0.1389em">&lt;</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">&lt;</mo><msub><mi>i</mi><mi>k</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">I=\{i_{1}&lt;\cdots&lt;i_{k}\}</annotation></semantics></math> and put <math id="S6.SS3.p2.m2" class="ltx_Math" alttext="d=i_{k}-i_{1}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><mrow><msub><mi>i</mi><mi>k</mi></msub><mo>−</mo><msub><mi>i</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">d=i_{k}-i_{1}</annotation></semantics></math>. The block from <math id="S6.SS3.p2.m3" class="ltx_Math" alttext="i_{1}" display="inline" intent=":literal"><semantics><msub><mi>i</mi><mn>1</mn></msub><annotation encoding="application/x-tex">i_{1}</annotation></semantics></math> to
<math id="S6.SS3.p2.m4" class="ltx_Math" alttext="i_{k}" display="inline" intent=":literal"><semantics><msub><mi>i</mi><mi>k</mi></msub><annotation encoding="application/x-tex">i_{k}</annotation></semantics></math> has length <math id="S6.SS3.p2.m5" class="ltx_Math" alttext="d+1" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">d+1</annotation></semantics></math>, and its relative order is uniformly distributed over
<math id="S6.SS3.p2.m6" class="ltx_Math" alttext="\mathfrak{S}_{d+1}" display="inline" intent=":literal"><semantics><msub><mi>𝔖</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\mathfrak{S}_{d+1}</annotation></semantics></math>. The selected entries form an occurrence of
<math id="S6.SS3.p2.m7" class="ltx_Math" alttext="\operatorname{Box}(\tau)" display="inline" intent=":literal"><semantics><mrow><mi>Box</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{Box}(\tau)</annotation></semantics></math> exactly when they receive <math id="S6.SS3.p2.m8" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> consecutive ranks in this block,
arranged in the order <math id="S6.SS3.p2.m9" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math>. There are <math id="S6.SS3.p2.m10" class="ltx_Math" alttext="d-k+2" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo>−</mo><mi>k</mi></mrow><mo>+</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">d-k+2</annotation></semantics></math> choices for this interval of
ranks, after which the other <math id="S6.SS3.p2.m11" class="ltx_Math" alttext="d-k+1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo>−</mo><mi>k</mi></mrow><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">d-k+1</annotation></semantics></math> ranks may be arranged arbitrarily.
Consequently,</span></p>
<table id="S6.Ex33" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex33.m1" class="ltx_Math" alttext="\Pr\bigl(I\text{ is a }\operatorname{Box}(\tau)\text{-occurrence}\bigr)=\frac{(d-k+2)!}{(d+1)!}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Pr</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mtext> is a </mtext><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Box</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mtext>-occurrence</mtext></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>d</mi><mo>−</mo><mi>k</mi></mrow><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Pr\bigl(I\text{ is a }\operatorname{Box}(\tau)\text{-occurrence}\bigr)=\frac{(d-k+2)!}{(d+1)!}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS3.p2.2" class="ltx_p"><span id="S6.SS3.p2.2.1" class="ltx_text">For a fixed span <math id="S6.SS3.p2.m12" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>, there are
<math id="S6.SS3.p2.m13" class="ltx_Math" alttext="(n-d)\binom{d-1}{k-2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mfrac linethickness="0pt"><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mrow><mi>k</mi><mo>−</mo><mn>2</mn></mrow></mfrac><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">(n-d)\binom{d-1}{k-2}</annotation></semantics></math> possible sets <math id="S6.SS3.p2.m14" class="ltx_Math" alttext="I" display="inline" intent=":literal"><semantics><mi>I</mi><annotation encoding="application/x-tex">I</annotation></semantics></math>. Linearity of expectation therefore
gives</span></p>
<table id="S6.EGx4" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S6.Ex34"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S6.Ex34.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\bigl[N_{\operatorname{Box}(\tau)}(\pi)\bigr]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msub><mi>N</mi><mrow><mi>Box</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\bigl[N_{\operatorname{Box}(\tau)}(\pi)\bigr]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.Ex34.m2" class="ltx_Math" alttext="\displaystyle=\sum_{d=k-1}^{n-1}(n-d)\binom{d-1}{k-2}\frac{(d-k+2)!}{(d+1)!}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>d</mi><mo>=</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac linethickness="0pt"><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mrow><mi>k</mi><mo>−</mo><mn>2</mn></mrow></mfrac></mstyle><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>d</mi><mo>−</mo><mi>k</mi></mrow><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow></mfrac></mstyle></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{d=k-1}^{n-1}(n-d)\binom{d-1}{k-2}\frac{(d-k+2)!}{(d+1)!}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S6.Ex35"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.Ex35.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{(k-2)!}\sum_{d=k-1}^{n-1}\frac{(n-d)(d-k+2)}{d(d+1)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>d</mi><mo>=</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>d</mi><mo>−</mo><mi>k</mi></mrow><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{(k-2)!}\sum_{d=k-1}^{n-1}\frac{(n-d)(d-k+2)}{d(d+1)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S6.Ex36"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.Ex36.m1" class="ltx_Math" alttext="\displaystyle=\frac{(n+k-1)(H_{n}-H_{k-2})-2(n-k+2)}{(k-2)!}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>n</mi><mo>+</mo><mi>k</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>H</mi><mi>n</mi></msub><mo>−</mo><msub><mi>H</mi><mrow><mi>k</mi><mo>−</mo><mn>2</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>n</mi><mo>−</mo><mi>k</mi></mrow><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{(n+k-1)(H_{n}-H_{k-2})-2(n-k+2)}{(k-2)!}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS3.p2.3" class="ltx_p"><span id="S6.SS3.p2.3.1" class="ltx_text">Setting <math id="S6.SS3.p2.m15" class="ltx_Math" alttext="k=3" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">k=3</annotation></semantics></math> proves (<a href="#S6.E20" title="Equation 20 ‣ Proposition 6.4. ‣ 6.3 Average occurrence counts for boxed patterns ‣ 6 The boxed mesh pattern 123 ‣ Coincidences and Growth of Boxed Mesh Patterns" class="ltx_ref"><span class="ltx_text ltx_ref_tag">20</span></a>).
∎</span></p>
</div>
</div>
<div id="S6.Thmtheorem5" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmtheorem5.2" class="ltx_text ltx_font_italic">Remark 6.5</span></span><span id="S6.Thmtheorem5.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S6.Thmtheorem5.p1" class="ltx_para">
<p id="S6.Thmtheorem5.p1.1" class="ltx_p">Since
<math id="S6.Thmtheorem5.p1.m1" class="ltx_Math" alttext="H_{n}=\log n+\gamma+O(1/n)," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>H</mi><mi>n</mi></msub><mo>=</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow><mo>+</mo><mi>γ</mi><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">H_{n}=\log n+\gamma+O(1/n),</annotation></semantics></math>
where <math id="S6.Thmtheorem5.p1.m2" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math> is the Euler–Mascheroni constant,
(<a href="#S6.E20" title="Equation 20 ‣ Proposition 6.4. ‣ 6.3 Average occurrence counts for boxed patterns ‣ 6 The boxed mesh pattern 123 ‣ Coincidences and Growth of Boxed Mesh Patterns" class="ltx_ref"><span class="ltx_text ltx_ref_tag">20</span></a>) gives <math id="S6.Thmtheorem5.p1.m3" class="ltx_Math" alttext="\mathbb{E}\bigl[N_{\operatorname{Box}(123)}(\pi)\bigr]=n\log n+(\gamma-3)n+O(\log n)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msub><mi>N</mi><mrow><mi>Box</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>123</mn><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>n</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>γ</mi><mo>−</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}\bigl[N_{\operatorname{Box}(123)}(\pi)\bigr]=n\log n+(\gamma-3)n+O(\log n)</annotation></semantics></math>. Thus a uniformly random permutation of length <math id="S6.Thmtheorem5.p1.m4" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> has <math id="S6.Thmtheorem5.p1.m5" class="ltx_Math" alttext="n\log n+O(n)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>n</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">n\log n+O(n)</annotation></semantics></math> boxed
<math id="S6.Thmtheorem5.p1.m6" class="ltx_Math" alttext="123" display="inline" intent=":literal"><semantics><mn>123</mn><annotation encoding="application/x-tex">123</annotation></semantics></math> occurrences on average. This identifies the natural
scale of the statistic, although a first-moment estimate alone does not imply
concentration or determine the probability of avoidance.</p>
</div>
</div>
</section>
</section>
<section id="S7" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">7 </span>The remaining orbit
<math id="S7.m1" class="ltx_Math" alttext="\{2143,3412\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mn>2143</mn><mo>,</mo><mn>3412</mn><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{2143,3412\}</annotation></semantics></math></h2>

<div id="S7.p1" class="ltx_para">
<p id="S7.p1.1" class="ltx_p">There is a useful one-sided analogue of the tightening lemma from
<a href="#S4" title="4 The exceptional length-four patterns ‣ Coincidences and Growth of Boxed Mesh Patterns" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">4</span></a>. Recall that an occurrence of
<math id="S7.p1.m1" class="ltx_Math" alttext="2\underline{14}3" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mn>14</mn><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">2\underline{14}3</annotation></semantics></math> has the form <math id="S7.p1.m2" class="ltx_Math" alttext="a,x,y,d" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>,</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">a,x,y,d</annotation></semantics></math> in positional order, where <math id="S7.p1.m3" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> and
<math id="S7.p1.m4" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math> are adjacent and <math id="S7.p1.m5" class="ltx_Math" alttext="x&lt;a&lt;d&lt;y" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>&lt;</mo><mi>a</mi><mo>&lt;</mo><mi>d</mi><mo>&lt;</mo><mi>y</mi></mrow><annotation encoding="application/x-tex">x&lt;a&lt;d&lt;y</annotation></semantics></math>.</p>
</div>
<div id="S7.Thmtheorem1" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmtheorem1.2" class="ltx_text ltx_font_bold">Lemma 7.1</span></span><span id="S7.Thmtheorem1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmtheorem1.p1" class="ltx_para">
<p id="S7.Thmtheorem1.p1.1" class="ltx_p"><span id="S7.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">Every permutation containing <math id="S7.Thmtheorem1.p1.m1" class="ltx_Math" alttext="\operatorname{Box}(2143)" display="inline" intent=":literal"><semantics><mrow><mi>Box</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2143</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{Box}(2143)</annotation></semantics></math> contains
<math id="S7.Thmtheorem1.p1.m2" class="ltx_Math" alttext="2\underline{14}3" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mn>14</mn><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">2\underline{14}3</annotation></semantics></math>. Equivalently,</span></p>
<table id="S7.Ex37" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex37.m1" class="ltx_Math" alttext="\operatorname{Av}_{n}(2\underline{14}3)\subseteq\operatorname{Av}_{n}(\operatorname{Box}(2143))\qquad(n\geq 0)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>Av</mi><mi>n</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mn>14</mn><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊆</mo><mrow><msub><mi>Av</mi><mi>n</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>Box</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2143</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\operatorname{Av}_{n}(2\underline{14}3)\subseteq\operatorname{Av}_{n}(\operatorname{Box}(2143))\qquad(n\geq 0).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S7.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S7.p2" class="ltx_para">
<p id="S7.p2.1" class="ltx_p"><span id="S7.p2.1.1" class="ltx_text">Let <math id="S7.p2.m1" class="ltx_Math" alttext="a,b,c,d" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>,</mo><mi>b</mi><mo>,</mo><mi>c</mi><mo>,</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">a,b,c,d</annotation></semantics></math> be a boxed <math id="S7.p2.m2" class="ltx_Math" alttext="2143" display="inline" intent=":literal"><semantics><mn>2143</mn><annotation encoding="application/x-tex">2143</annotation></semantics></math> occurrence in positional order, so <math id="S7.p2.m3" class="ltx_Math" alttext="b&lt;a&lt;d&lt;c" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>&lt;</mo><mi>a</mi><mo>&lt;</mo><mi>d</mi><mo>&lt;</mo><mi>c</mi></mrow><annotation encoding="application/x-tex">b&lt;a&lt;d&lt;c</annotation></semantics></math>.
Every entry strictly between <math id="S7.p2.m4" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi>b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math> and <math id="S7.p2.m5" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math> in position lies either below <math id="S7.p2.m6" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi>b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math> or
above <math id="S7.p2.m7" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math>; an entry with value strictly between them would lie in the empty
bounding rectangle. Read the permutation from <math id="S7.p2.m8" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi>b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math> to <math id="S7.p2.m9" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math>, regarding <math id="S7.p2.m10" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi>b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math> as
belonging to the lower region and <math id="S7.p2.m11" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math> as belonging to the upper region. At
some point there is an adjacent transition <math id="S7.p2.m12" class="ltx_Math" alttext="x,y" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow><annotation encoding="application/x-tex">x,y</annotation></semantics></math> from the lower region to the
upper region. Hence <math id="S7.p2.m13" class="ltx_Math" alttext="x\leq b&lt;a&lt;d&lt;c\leq y" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>≤</mo><mi>b</mi><mo>&lt;</mo><mi>a</mi><mo>&lt;</mo><mi>d</mi><mo>&lt;</mo><mi>c</mi><mo>≤</mo><mi>y</mi></mrow><annotation encoding="application/x-tex">x\leq b&lt;a&lt;d&lt;c\leq y</annotation></semantics></math>. The inequalities relevant to the four distinct entries <math id="S7.p2.m14" class="ltx_Math" alttext="a,x,y,d" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>,</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">a,x,y,d</annotation></semantics></math> are strict,
so these entries form an occurrence of <math id="S7.p2.m15" class="ltx_Math" alttext="2\underline{14}3" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mn>14</mn><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">2\underline{14}3</annotation></semantics></math>.
The avoidance-class inclusion is the contrapositive.
∎</span></p>
</div>
</div>
<div id="S7.Thmtheorem2" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmtheorem2.2" class="ltx_text ltx_font_italic">Remark 7.2</span></span><span id="S7.Thmtheorem2.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S7.Thmtheorem2.p1" class="ltx_para">
<p id="S7.Thmtheorem2.p1.1" class="ltx_p">The reverse implication in Lemma <a href="#S7.Thmtheorem1" title="Lemma 7.1. ‣ 7 The remaining orbit {2143,3412} ‣ Coincidences and Growth of Boxed Mesh Patterns" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.1</span></a> is false. For
example, <math id="S7.Thmtheorem2.p1.m1" class="ltx_Math" alttext="24153" display="inline" intent=":literal"><semantics><mn>24153</mn><annotation encoding="application/x-tex">24153</annotation></semantics></math> contains <math id="S7.Thmtheorem2.p1.m2" class="ltx_Math" alttext="2\underline{14}3" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mn>14</mn><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">2\underline{14}3</annotation></semantics></math> in the entries <math id="S7.Thmtheorem2.p1.m3" class="ltx_Math" alttext="2,1,5,3" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>5</mn><mo>,</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">2,1,5,3</annotation></semantics></math>, but
avoids <math id="S7.Thmtheorem2.p1.m4" class="ltx_Math" alttext="\operatorname{Box}(2143)" display="inline" intent=":literal"><semantics><mrow><mi>Box</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2143</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{Box}(2143)</annotation></semantics></math>: the intervening entry <math id="S7.Thmtheorem2.p1.m5" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math> obstructs the only candidate.
This is also forced by the classification in
<a href="#S5.Thmtheorem2" title="Theorem 5.2. ‣ 5 Classical, vincular and bivincular coincidences ‣ Coincidences and Growth of Boxed Mesh Patterns" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">5.2</span></a>. Moreover,
<math id="S7.Thmtheorem2.p1.m6" class="ltx_Math" alttext="2\underline{14}3" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mn>14</mn><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">2\underline{14}3</annotation></semantics></math>-avoiders are the plane permutations and are enumerated by
the semi-Baxter numbers <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib7" title="" class="ltx_ref">7</a>]</cite>. Thus the lemma gives only the
exponential lower bound <math id="S7.Thmtheorem2.p1.m7" class="ltx_Math" alttext="\mathsf{SB}_{n}\leq|\operatorname{Av}_{n}(\operatorname{Box}(2143))|" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝖲𝖡</mi><mi>n</mi></msub><mo>≤</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>Av</mi><mi>n</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>Box</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2143</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">\mathsf{SB}_{n}\leq|\operatorname{Av}_{n}(\operatorname{Box}(2143))|</annotation></semantics></math>. The inclusion has the wrong direction for an exponential upper bound and is
far too small to yield a factorial lower bound. Its value is structural: it
identifies the semi-Baxter class as a canonical subclass of the remaining
boxed avoidance class and explains why tightening alone cannot resolve the
Stanley–Wilf question.</p>
</div>
</div>
<div id="S7.p3" class="ltx_para">
<p id="S7.p3.1" class="ltx_p">We next observe that an injection from <math id="S7.p3.m1" class="ltx_Math" alttext="\mathfrak{S}_{m}" display="inline" intent=":literal"><semantics><msub><mi>𝔖</mi><mi>m</mi></msub><annotation encoding="application/x-tex">\mathfrak{S}_{m}</annotation></semantics></math> into avoiders whose
length is an affine function of <math id="S7.p3.m2" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> is sufficient to disprove the
Stanley–Wilf property. The observation applies to any mesh pattern,
not only to boxed ones.</p>
</div>
<div id="S7.Thmtheorem3" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmtheorem3.2" class="ltx_text ltx_font_bold">Proposition 7.3</span></span><span id="S7.Thmtheorem3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmtheorem3.p1" class="ltx_para">
<p id="S7.Thmtheorem3.p1.1" class="ltx_p"><span id="S7.Thmtheorem3.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S7.Thmtheorem3.p1.m1" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> be a fixed mesh pattern. Suppose that there is a
constant integer <math id="S7.Thmtheorem3.p1.m2" class="ltx_Math" alttext="c\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c\geq 1</annotation></semantics></math>, an integer <math id="S7.Thmtheorem3.p1.m3" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>, and, for all sufficiently large
<math id="S7.Thmtheorem3.p1.m4" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math>, an injection</span></p>
<table id="S7.Ex38" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex38.m1" class="ltx_Math" alttext="\Phi_{m}:\mathfrak{S}_{m}\longrightarrow\operatorname{Av}_{cm+r}(P)," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">Φ</mi><mi>m</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>𝔖</mi><mi>m</mi></msub><mo stretchy="false">⟶</mo><mrow><msub><mi>Av</mi><mrow><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mi>r</mi></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>P</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\Phi_{m}:\mathfrak{S}_{m}\longrightarrow\operatorname{Av}_{cm+r}(P),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.Thmtheorem3.p1.2" class="ltx_p"><span id="S7.Thmtheorem3.p1.2.1" class="ltx_text ltx_font_italic">where <math id="S7.Thmtheorem3.p1.m5" class="ltx_Math" alttext="cm+r\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mi>r</mi></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">cm+r\geq 0</annotation></semantics></math>.
Then <math id="S7.Thmtheorem3.p1.m6" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> does not have the Stanley–Wilf property.</span></p>
</div>
</div>
<div id="S7.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S7.p4" class="ltx_para">
<p id="S7.p4.1" class="ltx_p"><span id="S7.p4.1.1" class="ltx_text">Writing <math id="S7.p4.m1" class="ltx_Math" alttext="A_{n}=|\operatorname{Av}_{n}(P)|" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mi>n</mi></msub><mo>=</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>Av</mi><mi>n</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>P</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">A_{n}=|\operatorname{Av}_{n}(P)|</annotation></semantics></math>, injectivity gives <math id="S7.p4.m2" class="ltx_Math" alttext="A_{cm+r}\geq m!" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mrow><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mi>r</mi></mrow></msub><mo>≥</mo><mrow><mi>m</mi><mo>!</mo></mrow></mrow><annotation encoding="application/x-tex">A_{cm+r}\geq m!</annotation></semantics></math>. Hence, by
Stirling’s formula,</span></p>
<table id="S7.Ex39" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex39.m1" class="ltx_Math" alttext="A_{cm+r}^{1/(cm+r)}\geq(m!)^{1/(cm+r)}\sim\left(\frac{m}{e}\right)^{1/c}\longrightarrow\infty." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>A</mi><mrow><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mi>r</mi></mrow><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo>≥</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>!</mo></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mo>∼</mo><msup><mrow><mo>(</mo><mfrac><mi>m</mi><mi>e</mi></mfrac><mo>)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mi>c</mi></mrow></msup><mo stretchy="false">⟶</mo><mi mathvariant="normal">∞</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">A_{cm+r}^{1/(cm+r)}\geq(m!)^{1/(cm+r)}\sim\left(\frac{m}{e}\right)^{1/c}\longrightarrow\infty.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p4.2" class="ltx_p"><span id="S7.p4.2.1" class="ltx_text">Thus <math id="S7.p4.m3" class="ltx_Math" alttext="\limsup_{n\to\infty}A_{n}^{1/n}=\infty" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>lim sup</mo><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><msubsup><mi>A</mi><mi>n</mi><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow></msubsup></mrow><mo>=</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\limsup_{n\to\infty}A_{n}^{1/n}=\infty</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S7.p5" class="ltx_para">
<p id="S7.p5.1" class="ltx_p">Consequently there is no need to insist on doubling: an embedding into
permutations of length <math id="S7.p5.m1" class="ltx_Math" alttext="2m-1" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">2m-1</annotation></semantics></math>, <math id="S7.p5.m2" class="ltx_Math" alttext="3m" display="inline" intent=":literal"><semantics><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">3m</annotation></semantics></math>, <math id="S7.p5.m3" class="ltx_Math" alttext="4m" display="inline" intent=":literal"><semantics><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">4m</annotation></semantics></math>, or, more generally, <math id="S7.p5.m4" class="ltx_Math" alttext="cm+r" display="inline" intent=":literal"><semantics><mrow><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">cm+r</annotation></semantics></math> for
fixed <math id="S7.p5.m5" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math> and <math id="S7.p5.m6" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> would be equally decisive. Increasing <math id="S7.p5.m7" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math> may provide more
room for blockers, although the extra entries can also create new occurrences.</p>
</div>
<div id="S7.p6" class="ltx_para">
<p id="S7.p6.1" class="ltx_p">Here is a concrete format in which such an injection may exist. For
<math id="S7.p6.m1" class="ltx_math_unparsed" alttext="\pi=\pi_{1}\cdots\pi_{m}\in\mathfrak{S}_{m}" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo>=</mo><mi>π</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>π</mi><msub><mrow></mrow><mi>m</mi></msub><mo>∈</mo><mi>𝔖</mi><msub><mrow></mrow><mi>m</mi></msub></mrow><annotation encoding="application/x-tex">\pi=\pi_{1}\cdots\pi_{m}\in\mathfrak{S}_{m}</annotation></semantics></math> and
<math id="S7.p6.m2" class="ltx_math_unparsed" alttext="\rho=\rho_{1}\cdots\rho_{m-1}\in\mathfrak{S}_{m-1}" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>=</mo><mi>ρ</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>ρ</mi><msub><mrow></mrow><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>∈</mo><mi>𝔖</mi><msub><mrow></mrow><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\rho=\rho_{1}\cdots\rho_{m-1}\in\mathfrak{S}_{m-1}</annotation></semantics></math>, define the strict
interleaving</p>
<table id="S7.E21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.E21.m1" class="ltx_Math" alttext="J_{\rho}(\pi)=(2\pi_{1}-1,2\rho_{1},2\pi_{2}-1,2\rho_{2},\ldots,2\rho_{m-1},2\pi_{m}-1)\in\mathfrak{S}_{2m-1}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>J</mi><mi>ρ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mn>1</mn></msub></mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mn>1</mn></msub></mrow><mo>,</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mn>2</mn></msub></mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mn>2</mn></msub></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo>,</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mi>m</mi></msub></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi>𝔖</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">J_{\rho}(\pi)=(2\pi_{1}-1,2\rho_{1},2\pi_{2}-1,2\rho_{2},\ldots,2\rho_{m-1},2\pi_{m}-1)\in\mathfrak{S}_{2m-1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(21)</span></td></tr></tbody>
</table>
<p id="S7.p6.2" class="ltx_p">For <math id="S7.p6.m3" class="ltx_Math" alttext="m=1" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">m=1</annotation></semantics></math> the even word is empty. Thus the prescribed odd entries occur in
their original order, and exactly one even entry is placed in each internal
gap. Equivalently, one permutes the set
<math id="S7.p6.m4" class="ltx_Math" alttext="\{2,4,\ldots,2m-2\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mn>2</mn><mo>,</mo><mn>4</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>−</mo><mn>2</mn></mrow></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{2,4,\ldots,2m-2\}</annotation></semantics></math> between the fixed odd entries
<math id="S7.p6.m5" class="ltx_Math" alttext="2\pi_{1}-1,\ldots,2\pi_{m}-1" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mn>1</mn></msub></mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mi>m</mi></msub></mrow><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">2\pi_{1}-1,\ldots,2\pi_{m}-1</annotation></semantics></math>.</p>
</div>
<div id="S7.p7" class="ltx_para">
<p id="S7.p7.1" class="ltx_p">The odd-position entries recover the input without any auxiliary data:</p>
<table id="S7.E22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.E22.m1" class="ltx_Math" alttext="\pi_{i}=\frac{J_{\rho}(\pi)_{2i-1}+1}{2}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>π</mi><mi>i</mi></msub><mo>=</mo><mfrac><mrow><mrow><msub><mi>J</mi><mi>ρ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo>+</mo><mn>1</mn></mrow><mn>2</mn></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\pi_{i}=\frac{J_{\rho}(\pi)_{2i-1}+1}{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(22)</span></td></tr></tbody>
</table>
<p id="S7.p7.2" class="ltx_p">For example, if <math id="S7.p7.m1" class="ltx_Math" alttext="\pi=231" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo>=</mo><mn>231</mn></mrow><annotation encoding="application/x-tex">\pi=231</annotation></semantics></math> and <math id="S7.p7.m2" class="ltx_Math" alttext="\rho=21" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>=</mo><mn>21</mn></mrow><annotation encoding="application/x-tex">\rho=21</annotation></semantics></math>, then <math id="S7.p7.m3" class="ltx_Math" alttext="J_{21}(231)=(3,4,5,2,1)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>J</mi><mn>21</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>231</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><mo>,</mo><mn>4</mn><mo>,</mo><mn>5</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">J_{21}(231)=(3,4,5,2,1)</annotation></semantics></math>, which avoids <math id="S7.p7.m4" class="ltx_Math" alttext="\operatorname{Box}(2143)" display="inline" intent=":literal"><semantics><mrow><mi>Box</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2143</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{Box}(2143)</annotation></semantics></math>, and its odd-position entries <math id="S7.p7.m5" class="ltx_Math" alttext="3,5,1" display="inline" intent=":literal"><semantics><mrow><mn>3</mn><mo>,</mo><mn>5</mn><mo>,</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">3,5,1</annotation></semantics></math> recover
<math id="S7.p7.m6" class="ltx_Math" alttext="231" display="inline" intent=":literal"><semantics><mn>231</mn><annotation encoding="application/x-tex">231</annotation></semantics></math> by (<a href="#S7.E22" title="Equation 22 ‣ 7 The remaining orbit {2143,3412} ‣ Coincidences and Growth of Boxed Mesh Patterns" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a>).</p>
</div>
<div id="S7.p8" class="ltx_para">
<p id="S7.p8.1" class="ltx_p">There is also a simple reason that formulations beginning with a forced
global minimum can be shortened. If a permutation beginning with <math id="S7.p8.m1" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> avoids
<math id="S7.p8.m2" class="ltx_Math" alttext="\operatorname{Box}(2143)" display="inline" intent=":literal"><semantics><mrow><mi>Box</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2143</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{Box}(2143)</annotation></semantics></math>, then deleting this <math id="S7.p8.m3" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> and reducing all other entries by one
preserves avoidance. Conversely, adjoining a new global minimum on the left
preserves avoidance, since the minimum in the underlying pattern <math id="S7.p8.m4" class="ltx_Math" alttext="2143" display="inline" intent=":literal"><semantics><mn>2143</mn><annotation encoding="application/x-tex">2143</annotation></semantics></math> is
its second entry and therefore cannot be played by the new leftmost entry.
This is a special case of the general observation that deleting a global
extremum cannot uncover a boxed occurrence: the deleted point lies outside
the vertical bounding interval of every occurrence formed by the remaining
entries.</p>
</div>
<div id="S7.Thmtheorem4" class="ltx_theorem ltx_theorem_conjecture">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmtheorem4.2" class="ltx_text ltx_font_bold">Conjecture 7.4</span></span><span id="S7.Thmtheorem4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmtheorem4.p1" class="ltx_para">
<p id="S7.Thmtheorem4.p1.1" class="ltx_p">Let <math id="S7.Thmtheorem4.p1.m1" class="ltx_Math" alttext="m\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">m\geq 1</annotation></semantics></math>. For every <math id="S7.Thmtheorem4.p1.m2" class="ltx_Math" alttext="\pi\in\mathfrak{S}_{m}" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo>∈</mo><msub><mi>𝔖</mi><mi>m</mi></msub></mrow><annotation encoding="application/x-tex">\pi\in\mathfrak{S}_{m}</annotation></semantics></math>, there exists
<math id="S7.Thmtheorem4.p1.m3" class="ltx_Math" alttext="\rho\in\mathfrak{S}_{m-1}" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>∈</mo><msub><mi>𝔖</mi><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\rho\in\mathfrak{S}_{m-1}</annotation></semantics></math> such that <math id="S7.Thmtheorem4.p1.m4" class="ltx_Math" alttext="J_{\rho}(\pi)" display="inline" intent=":literal"><semantics><mrow><msub><mi>J</mi><mi>ρ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">J_{\rho}(\pi)</annotation></semantics></math> avoids <math id="S7.Thmtheorem4.p1.m5" class="ltx_Math" alttext="\operatorname{Box}(2143)" display="inline" intent=":literal"><semantics><mrow><mi>Box</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2143</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{Box}(2143)</annotation></semantics></math>.</p>
</div>
</div>
<div id="S7.p9" class="ltx_para">
<p id="S7.p9.1" class="ltx_p">The conjecture has been verified exhaustively for <math id="S7.p9.m1" class="ltx_Math" alttext="m\leq 8" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>≤</mo><mn>8</mn></mrow><annotation encoding="application/x-tex">m\leq 8</annotation></semantics></math>. If true, choose
the lexicographically first admissible <math id="S7.p9.m2" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>; equation
(<a href="#S7.E22" title="Equation 22 ‣ 7 The remaining orbit {2143,3412} ‣ Coincidences and Growth of Boxed Mesh Patterns" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a>) then gives an explicit injection</p>
<table id="S7.Ex40" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex40.m1" class="ltx_Math" alttext="\mathfrak{S}_{m}\hookrightarrow\operatorname{Av}_{2m-1}(\operatorname{Box}(2143)),\qquad\pi\longmapsto J_{\rho(\pi)}(\pi)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝔖</mi><mi>m</mi></msub><mo stretchy="false">↪</mo><mrow><msub><mi>Av</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>−</mo><mn>1</mn></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>Box</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2143</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mi>π</mi><mo stretchy="false">⟼</mo><mrow><msub><mi>J</mi><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathfrak{S}_{m}\hookrightarrow\operatorname{Av}_{2m-1}(\operatorname{Box}(2143)),\qquad\pi\longmapsto J_{\rho(\pi)}(\pi),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p9.2" class="ltx_p">and hence, by Proposition <a href="#S7.Thmtheorem3" title="Proposition 7.3. ‣ 7 The remaining orbit {2143,3412} ‣ Coincidences and Growth of Boxed Mesh Patterns" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.3</span></a>, the factorial lower
bound sought in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib3" title="" class="ltx_ref">3</a>]</cite>. Conjecture <a href="#S7.Thmtheorem4" title="Conjecture 7.4. ‣ 7 The remaining orbit {2143,3412} ‣ Coincidences and Growth of Boxed Mesh Patterns" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.4</span></a> is stronger than the growth conclusion that
it would imply, since factorial growth might arise from a different
construction. We therefore record the expected growth statement separately.</p>
</div>
<div id="S7.Thmtheorem5" class="ltx_theorem ltx_theorem_conjecture">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmtheorem5.2" class="ltx_text ltx_font_bold">Conjecture 7.5</span></span><span id="S7.Thmtheorem5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmtheorem5.p1" class="ltx_para">
<p id="S7.Thmtheorem5.p1.1" class="ltx_p">The avoidance sequence of <math id="S7.Thmtheorem5.p1.m1" class="ltx_Math" alttext="\operatorname{Box}(2143)" display="inline" intent=":literal"><semantics><mrow><mi>Box</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2143</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{Box}(2143)</annotation></semantics></math> has factorial growth, and hence
<math id="S7.Thmtheorem5.p1.m2" class="ltx_Math" alttext="\operatorname{Box}(2143)" display="inline" intent=":literal"><semantics><mrow><mi>Box</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2143</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{Box}(2143)</annotation></semantics></math> does not have the Stanley–Wilf property.</p>
</div>
</div>
<div id="S7.p10" class="ltx_para">
<p id="S7.p10.1" class="ltx_p">The following occurrence-preserving doubling provides a first step toward the
conjecture. For <math id="S7.p10.m1" class="ltx_math_unparsed" alttext="\pi=\pi_{1}\cdots\pi_{m}\in\mathfrak{S}_{m}" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo>=</mo><mi>π</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>π</mi><msub><mrow></mrow><mi>m</mi></msub><mo>∈</mo><mi>𝔖</mi><msub><mrow></mrow><mi>m</mi></msub></mrow><annotation encoding="application/x-tex">\pi=\pi_{1}\cdots\pi_{m}\in\mathfrak{S}_{m}</annotation></semantics></math>, define</p>
<table id="S7.E23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.E23.m1" class="ltx_math_unparsed" alttext="\Delta(\pi)=(2\pi_{1}-1)(2\pi_{1})\,(2\pi_{2}-1)(2\pi_{2})\cdots(2\pi_{m}-1)(2\pi_{m})." display="block" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><msub><mi>π</mi><mn>1</mn></msub><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><msub><mi>π</mi><mn>1</mn></msub><mo rspace="0.170em" stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><msub><mi>π</mi><mn>2</mn></msub><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><msub><mi>π</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">⋯</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><msub><mi>π</mi><mi>m</mi></msub><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><msub><mi>π</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Delta(\pi)=(2\pi_{1}-1)(2\pi_{1})\,(2\pi_{2}-1)(2\pi_{2})\cdots(2\pi_{m}-1)(2\pi_{m}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(23)</span></td></tr></tbody>
</table>
<p id="S7.p10.2" class="ltx_p">Thus each entry is replaced by an adjacent increasing pair of consecutive
values, and the entries in the odd positions recover <math id="S7.p10.m2" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math>.</p>
</div>
<div id="S7.Thmtheorem6" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmtheorem6.2" class="ltx_text ltx_font_bold">Proposition 7.6</span></span><span id="S7.Thmtheorem6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmtheorem6.p1" class="ltx_para">
<p id="S7.Thmtheorem6.p1.1" class="ltx_p"><span id="S7.Thmtheorem6.p1.1.1" class="ltx_text ltx_font_italic">For every <math id="S7.Thmtheorem6.p1.m1" class="ltx_Math" alttext="\pi\in\mathfrak{S}_{m}" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo>∈</mo><msub><mi>𝔖</mi><mi>m</mi></msub></mrow><annotation encoding="application/x-tex">\pi\in\mathfrak{S}_{m}</annotation></semantics></math>,</span></p>
<table id="S7.E24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.E24.m1" class="ltx_Math" alttext="N_{\operatorname{Box}(2143)}(\Delta(\pi))=N_{\operatorname{Box}(2143)}(\pi)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>N</mi><mrow><mi>Box</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2143</mn><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>N</mi><mrow><mi>Box</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2143</mn><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">N_{\operatorname{Box}(2143)}(\Delta(\pi))=N_{\operatorname{Box}(2143)}(\pi).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(24)</span></td></tr></tbody>
</table>
<p id="S7.Thmtheorem6.p1.2" class="ltx_p"><span id="S7.Thmtheorem6.p1.2.1" class="ltx_text ltx_font_italic">In particular, <math id="S7.Thmtheorem6.p1.m2" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> avoids <math id="S7.Thmtheorem6.p1.m3" class="ltx_Math" alttext="\operatorname{Box}(2143)" display="inline" intent=":literal"><semantics><mrow><mi>Box</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2143</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{Box}(2143)</annotation></semantics></math> if and only if <math id="S7.Thmtheorem6.p1.m4" class="ltx_Math" alttext="\Delta(\pi)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta(\pi)</annotation></semantics></math> does.</span></p>
</div>
</div>
<div id="S7.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S7.p11" class="ltx_para">
<p id="S7.p11.1" class="ltx_p"><span id="S7.p11.1.1" class="ltx_text">Call the two entries replacing <math id="S7.p11.m1" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> the <math id="S7.p11.m2" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>-block. A <math id="S7.p11.m3" class="ltx_Math" alttext="2143" display="inline" intent=":literal"><semantics><mn>2143</mn><annotation encoding="application/x-tex">2143</annotation></semantics></math> occurrence in
<math id="S7.p11.m4" class="ltx_Math" alttext="\Delta(\pi)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta(\pi)</annotation></semantics></math> uses at most one entry from any block. Indeed, two entries from
one block would be adjacent selected entries in increasing order. The only
adjacent ascent in <math id="S7.p11.m5" class="ltx_Math" alttext="2143" display="inline" intent=":literal"><semantics><mn>2143</mn><annotation encoding="application/x-tex">2143</annotation></semantics></math> is from its second selected entry, the minimum, to
its third, the maximum; two consecutive values cannot play these roles while
leaving two further selected values strictly between them.</span></p>
</div>
<div id="S7.p12" class="ltx_para">
<p id="S7.p12.1" class="ltx_p"><span id="S7.p12.1.1" class="ltx_text">Write <math id="S7.p12.m1" class="ltx_Math" alttext="\varphi" display="inline" intent=":literal"><semantics><mi>φ</mi><annotation encoding="application/x-tex">\varphi</annotation></semantics></math> for the projection that sends a selected entry of the
<math id="S7.p12.m2" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>-block to <math id="S7.p12.m3" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>; it is well defined on the selected entries by the previous
paragraph, since each block contributes at most one of them. It follows that
the four selected blocks of any <math id="S7.p12.m4" class="ltx_Math" alttext="2143" display="inline" intent=":literal"><semantics><mn>2143</mn><annotation encoding="application/x-tex">2143</annotation></semantics></math> occurrence project under <math id="S7.p12.m5" class="ltx_Math" alttext="\varphi" display="inline" intent=":literal"><semantics><mi>φ</mi><annotation encoding="application/x-tex">\varphi</annotation></semantics></math> to
four entries <math id="S7.p12.m6" class="ltx_Math" alttext="a,b,c,d" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>,</mo><mi>b</mi><mo>,</mo><mi>c</mi><mo>,</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">a,b,c,d</annotation></semantics></math> of <math id="S7.p12.m7" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math>, in positional order, with
<math id="S7.p12.m8" class="ltx_Math" alttext="b&lt;a&lt;d&lt;c" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>&lt;</mo><mi>a</mi><mo>&lt;</mo><mi>d</mi><mo>&lt;</mo><mi>c</mi></mrow><annotation encoding="application/x-tex">b&lt;a&lt;d&lt;c</annotation></semantics></math>. If the occurrence in <math id="S7.p12.m9" class="ltx_Math" alttext="\Delta(\pi)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta(\pi)</annotation></semantics></math> is boxed, then the projected
occurrence is boxed as well: any intervening entry <math id="S7.p12.m10" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> of <math id="S7.p12.m11" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> with
<math id="S7.p12.m12" class="ltx_Math" alttext="b&lt;x&lt;c" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>&lt;</mo><mi>x</mi><mo>&lt;</mo><mi>c</mi></mrow><annotation encoding="application/x-tex">b&lt;x&lt;c</annotation></semantics></math> would place both entries of its block inside the bounding rectangle
in <math id="S7.p12.m13" class="ltx_Math" alttext="\Delta(\pi)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta(\pi)</annotation></semantics></math>.</span></p>
</div>
<div id="S7.p13" class="ltx_para">
<p id="S7.p13.1" class="ltx_p"><span id="S7.p13.1.1" class="ltx_text">Conversely, let <math id="S7.p13.m1" class="ltx_Math" alttext="a,b,c,d" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>,</mo><mi>b</mi><mo>,</mo><mi>c</mi><mo>,</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">a,b,c,d</annotation></semantics></math> be a boxed <math id="S7.p13.m2" class="ltx_Math" alttext="2143" display="inline" intent=":literal"><semantics><mn>2143</mn><annotation encoding="application/x-tex">2143</annotation></semantics></math> occurrence of <math id="S7.p13.m3" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math>. It has the
unique boxed lift</span></p>
<table id="S7.E25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.E25.m1" class="ltx_Math" alttext="2a,\quad 2b,\quad 2c-1,\quad 2d-1." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo rspace="1.167em">,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>−</mo><mn>1</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">2a,\quad 2b,\quad 2c-1,\quad 2d-1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(25)</span></td></tr></tbody>
</table>
<p id="S7.p13.2" class="ltx_p"><span id="S7.p13.2.1" class="ltx_text">To see uniqueness, choosing <math id="S7.p13.m4" class="ltx_Math" alttext="2a-1" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">2a-1</annotation></semantics></math> would put its mate <math id="S7.p13.m5" class="ltx_Math" alttext="2a" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><annotation encoding="application/x-tex">2a</annotation></semantics></math> immediately to the
right inside the rectangle; choosing <math id="S7.p13.m6" class="ltx_Math" alttext="2b-1" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">2b-1</annotation></semantics></math> would put <math id="S7.p13.m7" class="ltx_Math" alttext="2b" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow><annotation encoding="application/x-tex">2b</annotation></semantics></math> inside; choosing
<math id="S7.p13.m8" class="ltx_Math" alttext="2c" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><annotation encoding="application/x-tex">2c</annotation></semantics></math> would put <math id="S7.p13.m9" class="ltx_Math" alttext="2c-1" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">2c-1</annotation></semantics></math> inside; and choosing <math id="S7.p13.m10" class="ltx_Math" alttext="2d" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">2d</annotation></semantics></math> would put <math id="S7.p13.m11" class="ltx_Math" alttext="2d-1" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">2d-1</annotation></semantics></math> inside.
The choices in (<a href="#S7.E25" title="Equation 25 ‣ Proof. ‣ 7 The remaining orbit {2143,3412} ‣ Coincidences and Growth of Boxed Mesh Patterns" class="ltx_ref"><span class="ltx_text ltx_ref_tag">25</span></a>) avoid these obstructions. Their
unselected mates lie, respectively, to the left of the rectangle, below it,
above it, and to its right. Any other point inside the lifted rectangle would
belong to an intervening block <math id="S7.p13.m12" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> with <math id="S7.p13.m13" class="ltx_Math" alttext="b&lt;x&lt;c" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>&lt;</mo><mi>x</mi><mo>&lt;</mo><mi>c</mi></mrow><annotation encoding="application/x-tex">b&lt;x&lt;c</annotation></semantics></math>, contradicting that the
original occurrence was boxed. Thus <math id="S7.p13.m14" class="ltx_Math" alttext="\varphi" display="inline" intent=":literal"><semantics><mi>φ</mi><annotation encoding="application/x-tex">\varphi</annotation></semantics></math> and this unique lift are
mutually inverse maps between the boxed <math id="S7.p13.m15" class="ltx_Math" alttext="2143" display="inline" intent=":literal"><semantics><mn>2143</mn><annotation encoding="application/x-tex">2143</annotation></semantics></math> occurrences of <math id="S7.p13.m16" class="ltx_Math" alttext="\Delta(\pi)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta(\pi)</annotation></semantics></math>
and those of <math id="S7.p13.m17" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math>, proving (<a href="#S7.E24" title="Equation 24 ‣ Proposition 7.6. ‣ 7 The remaining orbit {2143,3412} ‣ Coincidences and Growth of Boxed Mesh Patterns" class="ltx_ref"><span class="ltx_text ltx_ref_tag">24</span></a>).
∎</span></p>
</div>
</div>
<div id="S7.p14" class="ltx_para">
<p id="S7.p14.1" class="ltx_p">Thus increasing doubling itself creates no additional boxed <math id="S7.p14.m1" class="ltx_Math" alttext="2143" display="inline" intent=":literal"><semantics><mn>2143</mn><annotation encoding="application/x-tex">2143</annotation></semantics></math> occurrences.
It supplies a canonical alternating extension of length <math id="S7.p14.m2" class="ltx_Math" alttext="2m" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">2m</annotation></semantics></math> whenever the
prescribed odd subsequence already avoids the pattern. This is not yet the
strict length-<math id="S7.p14.m3" class="ltx_Math" alttext="(2m-1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(2m-1)</annotation></semantics></math> completion required by Conjecture <a href="#S7.Thmtheorem4" title="Conjecture 7.4. ‣ 7 The remaining orbit {2143,3412} ‣ Coincidences and Growth of Boxed Mesh Patterns" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.4</span></a>; for a
general input, the remaining task is to arrange the even entries so as to
destroy the projected occurrences without creating new ones.</p>
</div>
</section>
<section id="S8" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">8 </span>Boxed <math id="S8.m1" class="ltx_Math" alttext="12" display="inline" intent=":literal"><semantics><mn>12</mn><annotation encoding="application/x-tex">12</annotation></semantics></math> and strong Bruhat covers</h2>

<div id="S8.p1" class="ltx_para">
<p id="S8.p1.1" class="ltx_p">We finish the structural part of the paper with a distributional observation
about the smallest nontrivial boxed pattern, <math id="S8.p1.m1" class="ltx_Math" alttext="\operatorname{Box}(12)=\raisebox{2.58334pt}{\hbox to15.83pt{\vbox to15.83pt{\pgfpicture\makeatletter\hbox{\hskip 0.14825pt\lower-0.14825pt\hbox to0.0pt{\lxSVG@begingroup@{_scopebegin=1} \lxSVG@begingroup@{stroke=#000000} \lxSVG@begingroup@{fill=#000000} \lxSVG@setlinewidth{\the\pgflinewidth}\lxSVG@begingroup@{stroke-width=0.4pt} \lx@inpgf@ignorespaces\nullfont\hbox to0.0pt{\lxSVG@begingroup@{_scopebegin=1} {{\lx@inpgf@ignorespaces}}{{\lx@inpgf@ignorespaces}}
{}{{}}{}
{{}{}}{{}}{}{}{}{}{{}}{}\lxSVG@begingroup@{_scopebegin=1} \color[rgb]{0.75,0.75,0.75}\lxSVG@fill\lxSVG@drawpath@unclipped{M 7.17 7.17 M 7.17 7.17 L 7.17 14.33 L 14.33 14.33 L 14.33 7.17 Z M 14.33 14.33}{stroke:none} \lx@inpgf@ignorespaces
\lxSVG@closescope 
{}{{}}{}{}{
{\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}{}{}{
}{
}{
}{
}{}}{}\lxSVG@stroke\lxSVG@drawpath@unclipped{M 0.07 0.07 M 0.07 7.17 L 21.42 7.17 M 0.07 14.33 L 21.42 14.33 M 7.17 0.07 L 7.17 21.42 M 14.33 0.07 L 14.33 21.42 M 21.42 21.42}{fill:none} \lx@inpgf@ignorespaces
{}{{}}{}{{{}}{\lx@inpgf@ignorespaces}{}{\lx@inpgf@ignorespaces}{}{}{}{}{}}{}\lxSVG@fillstroke\lxSVG@drawpath@unclipped{M 7.17 7.17 M 8.68 7.17 C 8.68 8 8 8.68 7.17 8.68 C 6.33 8.68 5.65 8 5.65 7.17 C 5.65 6.33 6.33 5.65 7.17 5.65 C 8 5.65 8.68 6.33 8.68 7.17 Z M 7.17 7.17}{} \lx@inpgf@ignorespaces
{}{{}}{}{{{}}{\lx@inpgf@ignorespaces}{}{\lx@inpgf@ignorespaces}{}{}{}{}{}}{}\lxSVG@fillstroke\lxSVG@drawpath@unclipped{M 14.33 14.33 M 15.84 14.33 C 15.84 15.16 15.16 15.84 14.33 15.84 C 13.5 15.84 12.82 15.16 12.82 14.33 C 12.82 13.5 13.5 12.82 14.33 12.82 C 15.16 12.82 15.84 13.5 15.84 14.33 Z M 14.33 14.33}{} \lx@inpgf@ignorespaces
\lxSVG@closescope {{
{}{}{}{\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}}}{\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}\hss}\lxSVG@discardpath\lxSVG@closescope \hss}}\lxSVG@closescope\endpgfpicture}}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Box</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>12</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mpadded voffset="2.6pt"><mtext> <svg style="vertical-align:-10.95px" height="21.91" overflow="visible" version="1.1" viewBox="0 0 21.91 21.91" width="21.91"> <g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,21.91) matrix(1 0 0 -1 0 0) translate(0.21,0) translate(0,0.21)"> <g style="--ltx-stroke-color:#BFBFBF;--ltx-fill-color:#BFBFBF;--ltx-fg-color:#BFBFBF;" color="#BFBFBF" fill="#BFBFBF" stroke="#BFBFBF"> <path style="stroke:none" d="M 7.17 7.17 M 7.17 7.17 L 7.17 14.33 L 14.33 14.33 L 14.33 7.17 Z M 14.33 14.33"></path> </g> <path style="fill:none" d="M 0.07 0.07 M 0.07 7.17 L 21.42 7.17 M 0.07 14.33 L 21.42 14.33 M 7.17 0.07 L 7.17 21.42 M 14.33 0.07 L 14.33 21.42 M 21.42 21.42"></path> <path d="M 7.17 7.17 M 8.68 7.17 C 8.68 8 8 8.68 7.17 8.68 C 6.33 8.68 5.65 8 5.65 7.17 C 5.65 6.33 6.33 5.65 7.17 5.65 C 8 5.65 8.68 6.33 8.68 7.17 Z M 7.17 7.17"></path> <path d="M 14.33 14.33 M 15.84 14.33 C 15.84 15.16 15.16 15.84 14.33 15.84 C 13.5 15.84 12.82 15.16 12.82 14.33 C 12.82 13.5 13.5 12.82 14.33 12.82 C 15.16 12.82 15.84 13.5 15.84 14.33 Z M 14.33 14.33"></path> </g> </svg> </mtext></mpadded></mrow><annotation encoding="application/x-tex">\operatorname{Box}(12)=\raisebox{2.58334pt}{\hbox to15.83pt{\vbox to15.83pt{\pgfpicture\makeatletter\hbox{\hskip 0.14825pt\lower-0.14825pt\hbox to0.0pt{\lxSVG@begingroup@{_scopebegin=1} \lxSVG@begingroup@{stroke=#000000} \lxSVG@begingroup@{fill=#000000} \lxSVG@setlinewidth{\the\pgflinewidth}\lxSVG@begingroup@{stroke-width=0.4pt} \lx@inpgf@ignorespaces\nullfont\hbox to0.0pt{\lxSVG@begingroup@{_scopebegin=1} {{\lx@inpgf@ignorespaces}}{{\lx@inpgf@ignorespaces}}
