<td id="S4.T5.2.3.4" class="ltx_td ltx_align_right"><math id="S4.T5.m3" class="ltx_Math" alttext="393+69+24" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.900em">393</mn><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">69</mn><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">24</mn></mrow><annotation encoding="application/x-tex">393+69+24</annotation></semantics></math></td></tr>
<tr id="S4.T5.2.4" class="ltx_tr">
