34 0 Z M 451.58 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 439.55 -14.19)"><foreignObject style="--ltx-fo-width:2.12em;--ltx-fo-height:0.64em;--ltx-fo-depth:0.21em;font-size:8.19pt;" height="9.69" overflow="visible" transform="matrix(1 0 0 -1 0 7.26)" width="24.05"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.F2.pic1.m19" class="ltx_Math" alttext="(b,0)" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">b</mi><mo mathsize="0.700em">,</mo><mn mathsize="0.700em">0</mn><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow><annotation encoding="application/x-tex">(b,0)</annotation></semantics></math></span></span></foreignObject></g><g stroke-dasharray="0.4pt,1.0pt" stroke-dashoffset="0.0pt"><path style="fill:none" d="M 402.76 122.05 L 402.76 0"></path></g><g stroke-dasharray="0.4pt,1.0pt" stroke-dashoffset="0.0pt"><path style="fill:none" d="M 451.58 122.05 L 451.58 0"></path></g><g style="--ltx-stroke-color:#B30000;--ltx-fill-color:#B30000;--ltx-fg-color:#B30000;" color="#B30000" fill="#B30000" stroke="#B30000" transform="matrix(1.0 0.0 0.0 1.0 407.14 11.52)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:2.18em;--ltx-fo-height:0.38em;--ltx-fo-depth:0em;font-size:7.97pt;" color="#000000" height="4.17" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="24"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F2.pic1.4" class="ltx_text" style="font-size:70%;--ltx-fg-color:#B30000;">area <math id="S2.F2.pic1.m20" class="ltx_Math" alttext="0.9" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#B30000;" mathcolor="#B30000">0.9</mn><annotation encoding="application/x-tex">0.9</annotation></semantics></math></span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 419.34 -42.17)"><foreignObject style="--ltx-fo-width:1.22em;--ltx-fo-height:0.73em;--ltx-fo-depth:0.24em;font-size:9.25pt;" height="12.45" overflow="visible" transform="matrix(1 0 0 -1 0 9.34)" width="15.64"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F2.pic1.5" class="ltx_text" style="font-size:90%;">(c)</span></span></span></foreignObject></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 2: </span>(a) Notation: corners <math id="S2.F2.m13" class="ltx_Math" alttext="A,B,C,D" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>,</mo><mi>B</mi><mo>,</mo><mi>C</mi><mo>,</mo><mi>D</mi></mrow><annotation encoding="application/x-tex">A,B,C,D</annotation></semantics></math>, edges <math id="S2.F2.m14" class="ltx_Math" alttext="\sigma_{\mathrm{b}},\sigma_{\mathrm{r}},\sigma_{\mathrm{t}},\sigma_{\ell}" display="inline" intent=":literal"><semantics><mrow><msub><mi>σ</mi><mi>b</mi></msub><mo>,</mo><msub><mi>σ</mi><mi>r</mi></msub><mo>,</mo><msub><mi>σ</mi><mi>t</mi></msub><mo>,</mo><msub><mi>σ</mi><mi mathvariant="normal">ℓ</mi></msub></mrow><annotation encoding="application/x-tex">\sigma_{\mathrm{b}},\sigma_{\mathrm{r}},\sigma_{\mathrm{t}},\sigma_{\ell}</annotation></semantics></math>, and the convex hull <math id="S2.F2.m15" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> of a configuration with the boundary pattern of Definition <a href="#Thmdefinition1" title="Definition 1 (Boundary pattern). ‣ 2.2 Boundary structure of optimal configurations ‣ 2 Original formulation and theoretical results ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>.
(b) Idea of Lemma <a href="#Thmlemma2" title="Lemma 2 (Contact properties). ‣ 2.2 Boundary structure of optimal configurations ‣ 2 Original formulation and theoretical results ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>(B): if every edge of <math id="S2.F2.m16" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> touches <math id="S2.F2.m17" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> in a single point, a slightly rotated rectangle (dashed) encloses <math id="S2.F2.m18" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> with area smaller than <math id="S2.F2.m19" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>. Here opposite contacts face each other, so <math id="S2.F2.m20" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> satisfies (C) but violates (B).
(c) Idea of Lemma <a href="#Thmlemma2" title="Lemma 2 (Contact properties). ‣ 2.2 Boundary structure of optimal configurations ‣ 2 Original formulation and theoretical results ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>(C): if the top contact lies to the left of the bottom contact, tilting the top and bottom edges yields a covering parallelogram (dashed) of area smaller than <math id="S2.F2.m21" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>, although it extends beyond <math id="S2.F2.m22" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>. Here <math id="S2.F2.m23" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> contains an edge on <math id="S2.F2.m24" class="ltx_Math" alttext="\sigma_{\mathrm{r}}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>r</mi></msub><annotation encoding="application/x-tex">\sigma_{\mathrm{r}}</annotation></semantics></math>, so it satisfies (B) but violates (C).</figcaption>
</figure>
<div id="Thmdefinition1" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmdefinition1.2" class="ltx_text ltx_font_bold">Definition 1</span></span><span id="Thmdefinition1.3" class="ltx_text ltx_font_bold"> </span>(Boundary pattern)<span id="Thmdefinition1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmdefinition1.p1" class="ltx_para">
<p id="Thmdefinition1.p1.1" class="ltx_p">A labeled configuration <math id="Thmdefinition1.p1.m1" class="ltx_Math" alttext="p_{1},\dots,p_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>p</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">p_{1},\dots,p_{n}</annotation></semantics></math> with <math id="Thmdefinition1.p1.m2" class="ltx_Math" alttext="n\geq 5" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">n\geq 5</annotation></semantics></math> has the <em id="Thmdefinition1.p1.1.1" class="ltx_emph ltx_font_italic">boundary pattern</em> if
<math id="Thmdefinition1.p1.m3" class="ltx_Math" alttext="x_{1}=x_{5}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>=</mo><msub><mi>x</mi><mn>5</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">x_{1}=x_{5}=0</annotation></semantics></math>, <math id="Thmdefinition1.p1.m4" class="ltx_Math" alttext="y_{2}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mn>2</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">y_{2}=0</annotation></semantics></math>, <math id="Thmdefinition1.p1.m5" class="ltx_Math" alttext="x_{3}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>3</mn></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">x_{3}=1</annotation></semantics></math>, <math id="Thmdefinition1.p1.m6" class="ltx_Math" alttext="y_{4}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mn>4</mn></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">y_{4}=1</annotation></semantics></math>, <math id="Thmdefinition1.p1.m7" class="ltx_Math" alttext="y_{1}\leq y_{5}" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mn>1</mn></msub><mo>≤</mo><msub><mi>y</mi><mn>5</mn></msub></mrow><annotation encoding="application/x-tex">y_{1}\leq y_{5}</annotation></semantics></math>, <math id="Thmdefinition1.p1.m8" class="ltx_Math" alttext="x_{2}\leq x_{4}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>2</mn></msub><mo>≤</mo><msub><mi>x</mi><mn>4</mn></msub></mrow><annotation encoding="application/x-tex">x_{2}\leq x_{4}</annotation></semantics></math>, and <math id="Thmdefinition1.p1.m9" class="ltx_Math" alttext="x_{6}\leq x_{7}\leq\dots\leq x_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>6</mn></msub><mo>≤</mo><msub><mi>x</mi><mn>7</mn></msub><mo>≤</mo><mi mathvariant="normal">⋯</mi><mo>≤</mo><msub><mi>x</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">x_{6}\leq x_{7}\leq\dots\leq x_{n}</annotation></semantics></math>.</p>
</div>
</div>
<div id="Thmlemma1" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma1.2" class="ltx_text ltx_font_bold">Lemma 1</span></span><span id="Thmlemma1.3" class="ltx_text ltx_font_bold"> </span>(Minimal covering parallelogram)<span id="Thmlemma1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma1.p1" class="ltx_para">
<p id="Thmlemma1.p1.1" class="ltx_p"><span id="Thmlemma1.p1.1.1" class="ltx_text ltx_font_italic">If <math id="Thmlemma1.p1.m1" class="ltx_Math" alttext="P\subseteq S" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>⊆</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">P\subseteq S</annotation></semantics></math> is an optimal configuration, then <math id="Thmlemma1.p1.m2" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> is a minimum-area parallelogram containing <math id="Thmlemma1.p1.m3" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S2.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S2.SS2.p2" class="ltx_para">
<p id="S2.SS2.p2.1" class="ltx_p"><span id="S2.SS2.p2.1.1" class="ltx_text">Assume for contradiction that there exists a parallelogram <math id="S2.SS2.p2.m1" class="ltx_Math" alttext="S^{\prime}\supseteq K" display="inline" intent=":literal"><semantics><mrow><msup><mi>S</mi><mo>′</mo></msup><mo>⊇</mo><mi>K</mi></mrow><annotation encoding="application/x-tex">S^{\prime}\supseteq K</annotation></semantics></math>
with <math id="S2.SS2.p2.m2" class="ltx_Math" alttext="\operatorname{area}(S^{\prime})&lt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>area</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>S</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\operatorname{area}(S^{\prime})&lt;1</annotation></semantics></math>.
Since every parallelogram is an affine image of the unit square,
there exists an affine bijection <math id="S2.SS2.p2.m3" class="ltx_Math" alttext="\varphi:S^{\prime}\to S" display="inline" intent=":literal"><semantics><mrow><mi>φ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>S</mi><mo>′</mo></msup><mo stretchy="false">→</mo><mi>S</mi></mrow></mrow><annotation encoding="application/x-tex">\varphi:S^{\prime}\to S</annotation></semantics></math>
satisfying</span></p>
<table id="S2.Ex11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex11.m1" class="ltx_Math" alttext="|\det\varphi|=\frac{\operatorname{area}(S)}{\operatorname{area}(S^{\prime})}=\frac{1}{\operatorname{area}(S^{\prime})}&gt;1." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><mo lspace="0em" movablelimits="false" rspace="0.167em">det</mo><mi>φ</mi></mrow><mo stretchy="false">|</mo></mrow><mo>=</mo><mfrac><mrow><mi>area</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>area</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>S</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>=</mo><mfrac><mn>1</mn><mrow><mi>area</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>S</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>&gt;</mo><mn>1</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">|\det\varphi|=\frac{\operatorname{area}(S)}{\operatorname{area}(S^{\prime})}=\frac{1}{\operatorname{area}(S^{\prime})}&gt;1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS2.p2.2" class="ltx_p"><span id="S2.SS2.p2.2.1" class="ltx_text">Because <math id="S2.SS2.p2.m4" class="ltx_Math" alttext="K\subseteq S^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>⊆</mo><msup><mi>S</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">K\subseteq S^{\prime}</annotation></semantics></math>, we have <math id="S2.SS2.p2.m5" class="ltx_Math" alttext="\varphi(P)\subseteq S" display="inline" intent=":literal"><semantics><mrow><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>P</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊆</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">\varphi(P)\subseteq S</annotation></semantics></math>.
Every triangle spanned by points of <math id="S2.SS2.p2.m6" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> has its area multiplied by <math id="S2.SS2.p2.m7" class="ltx_Math" alttext="|\det\varphi|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><mo lspace="0em" rspace="0.167em">det</mo><mi>φ</mi></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\det\varphi|</annotation></semantics></math>, hence
<math id="S2.SS2.p2.m8" class="ltx_Math" alttext="\Delta(\varphi(P))=|\det\varphi|\,\Delta(P)&gt;\Delta(P)" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>P</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">|</mo><mrow><mo lspace="0em" rspace="0.167em">det</mo><mi>φ</mi></mrow><mo stretchy="false">|</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>P</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>P</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Delta(\varphi(P))=|\det\varphi|\,\Delta(P)&gt;\Delta(P)</annotation></semantics></math>,
contradicting the optimality of <math id="S2.SS2.p2.m9" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S2.SS2.p3" class="ltx_para">
<p id="S2.SS2.p3.1" class="ltx_p">The next lemma collects three contact properties of a minimum-area covering parallelogram. They are purely geometric.</p>
</div>
<div id="Thmlemma2" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma2.2" class="ltx_text ltx_font_bold">Lemma 2</span></span><span id="Thmlemma2.3" class="ltx_text ltx_font_bold"> </span>(Contact properties)<span id="Thmlemma2.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma2.p1" class="ltx_para">
<p id="Thmlemma2.p1.1" class="ltx_p"><span id="Thmlemma2.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmlemma2.p1.m1" class="ltx_Math" alttext="K\subseteq S" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>⊆</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">K\subseteq S</annotation></semantics></math> be a convex polygon such that <math id="Thmlemma2.p1.m2" class="ltx_Math" alttext="S=[0,1]^{2}" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>=</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">S=[0,1]^{2}</annotation></semantics></math> is a minimum-area parallelogram containing <math id="Thmlemma2.p1.m3" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>. Then:</span></p>
<ol id="S2.I1" class="ltx_enumerate">
<li id="S2.I1.ix1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(A)</span> 
<div id="S2.I1.ix1.p1" class="ltx_para">
<p id="S2.I1.ix1.p1.1" class="ltx_p"><span id="S2.I1.ix1.p1.1.1" class="ltx_text ltx_font_italic">Each edge of </span><math id="S2.I1.ix1.p1.m1" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math><span id="S2.I1.ix1.p1.1.2" class="ltx_text ltx_font_italic"> meets </span><math id="S2.I1.ix1.p1.m2" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math><span id="S2.I1.ix1.p1.1.3" class="ltx_text ltx_font_italic">, and each contact </span><math id="S2.I1.ix1.p1.m3" class="ltx_Math" alttext="K\cap\sigma" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>∩</mo><mi>σ</mi></mrow><annotation encoding="application/x-tex">K\cap\sigma</annotation></semantics></math><span id="S2.I1.ix1.p1.1.4" class="ltx_text ltx_font_italic"> is a vertex or an edge of </span><math id="S2.I1.ix1.p1.m4" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math><span id="S2.I1.ix1.p1.1.5" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S2.I1.ix2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(B)</span> 
<div id="S2.I1.ix2.p1" class="ltx_para">
<p id="S2.I1.ix2.p1.1" class="ltx_p"><span id="S2.I1.ix2.p1.1.1" class="ltx_text ltx_font_italic">At least one edge of </span><math id="S2.I1.ix2.p1.m1" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math><span id="S2.I1.ix2.p1.1.2" class="ltx_text ltx_font_italic"> contains an entire edge of </span><math id="S2.I1.ix2.p1.m2" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math><span id="S2.I1.ix2.p1.1.3" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S2.I1.ix3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(C)</span> 
<div id="S2.I1.ix3.p1" class="ltx_para">
<p id="S2.I1.ix3.p1.1" class="ltx_p"><span id="S2.I1.ix3.p1.1.1" class="ltx_text ltx_font_italic">The projections to the </span><math id="S2.I1.ix3.p1.m1" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math><span id="S2.I1.ix3.p1.1.2" class="ltx_text ltx_font_italic">-axis of </span><math id="S2.I1.ix3.p1.m2" class="ltx_Math" alttext="K\cap\sigma_{\mathrm{b}}" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>∩</mo><msub><mi>σ</mi><mi>b</mi></msub></mrow><annotation encoding="application/x-tex">K\cap\sigma_{\mathrm{b}}</annotation></semantics></math><span id="S2.I1.ix3.p1.1.3" class="ltx_text ltx_font_italic"> and </span><math id="S2.I1.ix3.p1.m3" class="ltx_Math" alttext="K\cap\sigma_{\mathrm{t}}" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>∩</mo><msub><mi>σ</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">K\cap\sigma_{\mathrm{t}}</annotation></semantics></math><span id="S2.I1.ix3.p1.1.4" class="ltx_text ltx_font_italic"> intersect, and so do the projections to the </span><math id="S2.I1.ix3.p1.m4" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math><span id="S2.I1.ix3.p1.1.5" class="ltx_text ltx_font_italic">-axis of </span><math id="S2.I1.ix3.p1.m5" class="ltx_Math" alttext="K\cap\sigma_{\ell}" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>∩</mo><msub><mi>σ</mi><mi mathvariant="normal">ℓ</mi></msub></mrow><annotation encoding="application/x-tex">K\cap\sigma_{\ell}</annotation></semantics></math><span id="S2.I1.ix3.p1.1.6" class="ltx_text ltx_font_italic"> and </span><math id="S2.I1.ix3.p1.m6" class="ltx_Math" alttext="K\cap\sigma_{\mathrm{r}}" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>∩</mo><msub><mi>σ</mi><mi>r</mi></msub></mrow><annotation encoding="application/x-tex">K\cap\sigma_{\mathrm{r}}</annotation></semantics></math><span id="S2.I1.ix3.p1.1.7" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S2.SS2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S2.SS2.p4" class="ltx_para">
<p id="S2.SS2.p4.1" class="ltx_p"><em id="S2.SS2.p4.1.1" class="ltx_emph ltx_font_italic">(A).</em><span id="S2.SS2.p4.1.2" class="ltx_text"> If <math id="S2.SS2.p4.m1" class="ltx_Math" alttext="\sigma_{\mathrm{b}}\cap K=\emptyset" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>σ</mi><mi>b</mi></msub><mo>∩</mo><mi>K</mi></mrow><mo>=</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">\sigma_{\mathrm{b}}\cap K=\emptyset</annotation></semantics></math>, then <math id="S2.SS2.p4.m2" class="ltx_Math" alttext="\delta:=\min_{K}y&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>:=</mo><mrow><msub><mi>min</mi><mi>K</mi></msub><mo lspace="0.167em">⁡</mo><mi>y</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\delta:=\min_{K}y&gt;0</annotation></semantics></math>, and the rectangle <math id="S2.SS2.p4.m3" class="ltx_Math" alttext="[0,1]\times[\delta,1]" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">[</mo><mrow><mi>δ</mi><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">[0,1]\times[\delta,1]</annotation></semantics></math> contains <math id="S2.SS2.p4.m4" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> and has area <math id="S2.SS2.p4.m5" class="ltx_Math" alttext="1-\delta&lt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">1-\delta&lt;1</annotation></semantics></math>. The other edges are analogous. The line through an edge of <math id="S2.SS2.p4.m6" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> is then a supporting line of <math id="S2.SS2.p4.m7" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>, so the contact is a face of <math id="S2.SS2.p4.m8" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>.</span></p>
</div>
<div id="S2.SS2.p5" class="ltx_para">
<p id="S2.SS2.p5.1" class="ltx_p"><em id="S2.SS2.p5.1.1" class="ltx_emph ltx_font_italic">(B).</em><span id="S2.SS2.p5.1.2" class="ltx_text"> The idea is illustrated in Figure <a href="#S2.F2" title="Figure 2 ‣ 2.2 Boundary structure of optimal configurations ‣ 2 Original formulation and theoretical results ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>b. For <math id="S2.SS2.p5.m1" class="ltx_Math" alttext="(\alpha,\beta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>α</mi><mo>,</mo><mi>β</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\alpha,\beta)</annotation></semantics></math> close to <math id="S2.SS2.p5.m2" class="ltx_Math" alttext="(0,0)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0,0)</annotation></semantics></math> let <math id="S2.SS2.p5.m3" class="ltx_Math" alttext="\ell_{1}=x-\beta y" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">ℓ</mi><mn>1</mn></msub><mo>=</mo><mrow><mi>x</mi><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\ell_{1}=x-\beta y</annotation></semantics></math> and <math id="S2.SS2.p5.m4" class="ltx_Math" alttext="\ell_{2}=y-\alpha x" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">ℓ</mi><mn>2</mn></msub><mo>=</mo><mrow><mi>y</mi><mo>−</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\ell_{2}=y-\alpha x</annotation></semantics></math>, and let <math id="S2.SS2.p5.m5" class="ltx_Math" alttext="S(\alpha,\beta)" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo>,</mo><mi>β</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">S(\alpha,\beta)</annotation></semantics></math> be the parallelogram bounded by the lines <math id="S2.SS2.p5.m6" class="ltx_Math" alttext="\ell_{1}=\min_{K}\ell_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">ℓ</mi><mn>1</mn></msub><mo>=</mo><mrow><msub><mi>min</mi><mi>K</mi></msub><mo lspace="0.167em">⁡</mo><msub><mi mathvariant="normal">ℓ</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\ell_{1}=\min_{K}\ell_{1}</annotation></semantics></math>, <math id="S2.SS2.p5.m7" class="ltx_Math" alttext="\ell_{1}=\max_{K}\ell_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">ℓ</mi><mn>1</mn></msub><mo>=</mo><mrow><msub><mi>max</mi><mi>K</mi></msub><mo lspace="0.167em">⁡</mo><msub><mi mathvariant="normal">ℓ</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\ell_{1}=\max_{K}\ell_{1}</annotation></semantics></math>, <math id="S2.SS2.p5.m8" class="ltx_Math" alttext="\ell_{2}=\min_{K}\ell_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">ℓ</mi><mn>2</mn></msub><mo>=</mo><mrow><msub><mi>min</mi><mi>K</mi></msub><mo lspace="0.167em">⁡</mo><msub><mi mathvariant="normal">ℓ</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\ell_{2}=\min_{K}\ell_{2}</annotation></semantics></math>, and <math id="S2.SS2.p5.m9" class="ltx_Math" alttext="\ell_{2}=\max_{K}\ell_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">ℓ</mi><mn>2</mn></msub><mo>=</mo><mrow><msub><mi>max</mi><mi>K</mi></msub><mo lspace="0.167em">⁡</mo><msub><mi mathvariant="normal">ℓ</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\ell_{2}=\max_{K}\ell_{2}</annotation></semantics></math>. It contains <math id="S2.SS2.p5.m10" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>, <math id="S2.SS2.p5.m11" class="ltx_Math" alttext="S(0,0)=S" display="inline" intent=":literal"><semantics><mrow><mrow><mi>S</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">S(0,0)=S</annotation></semantics></math>, and</span></p>
<table id="S2.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex12.m1" class="ltx_Math" alttext="\operatorname{area}S(\alpha,\beta)=\frac{w_{1}(\beta)\,w_{2}(\alpha)}{1-\alpha\beta},\qquad w_{1}(\beta)=\max_{K}\ell_{1}-\min_{K}\ell_{1},\quad w_{2}(\alpha)=\max_{K}\ell_{2}-\min_{K}\ell_{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>area</mi><mo lspace="0.167em">⁡</mo><mrow><mi>S</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo>,</mo><mi>β</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mfrac><mrow><msub><mi>w</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>β</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>w</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></mrow></mfrac></mrow><mo rspace="2.167em">,</mo><mrow><mrow><msub><mi>w</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>β</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><munder><mi>max</mi><mi>K</mi></munder><mo lspace="0.167em">⁡</mo><msub><mi mathvariant="normal">ℓ</mi><mn>1</mn></msub></mrow><mo>−</mo><mrow><munder><mi>min</mi><mi>K</mi></munder><mo lspace="0.167em">⁡</mo><msub><mi mathvariant="normal">ℓ</mi><mn>1</mn></msub></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><msub><mi>w</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><munder><mi>max</mi><mi>K</mi></munder><mo lspace="0.167em">⁡</mo><msub><mi mathvariant="normal">ℓ</mi><mn>2</mn></msub></mrow><mo>−</mo><mrow><munder><mi>min</mi><mi>K</mi></munder><mo lspace="0.167em">⁡</mo><msub><mi mathvariant="normal">ℓ</mi><mn>2</mn></msub></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\operatorname{area}S(\alpha,\beta)=\frac{w_{1}(\beta)\,w_{2}(\alpha)}{1-\alpha\beta},\qquad w_{1}(\beta)=\max_{K}\ell_{1}-\min_{K}\ell_{1},\quad w_{2}(\alpha)=\max_{K}\ell_{2}-\min_{K}\ell_{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS2.p5.2" class="ltx_p"><span id="S2.SS2.p5.2.1" class="ltx_text">Suppose that every contact is a single vertex, say <math id="S2.SS2.p5.m12" class="ltx_Math" alttext="(b_{1},0)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>b</mi><mn>1</mn></msub><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(b_{1},0)</annotation></semantics></math>, <math id="S2.SS2.p5.m13" class="ltx_Math" alttext="(t_{1},1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>1</mn></msub><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(t_{1},1)</annotation></semantics></math>, <math id="S2.SS2.p5.m14" class="ltx_Math" alttext="(0,l_{2})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msub><mi>l</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0,l_{2})</annotation></semantics></math>, <math id="S2.SS2.p5.m15" class="ltx_Math" alttext="(1,r_{2})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><msub><mi>r</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1,r_{2})</annotation></semantics></math>. These vertices remain the unique optimizers of <math id="S2.SS2.p5.m16" class="ltx_Math" alttext="\pm\ell_{1},\pm\ell_{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>±</mo><msub><mi mathvariant="normal">ℓ</mi><mn>1</mn></msub></mrow><mo>,</mo><mrow><mo>±</mo><msub><mi mathvariant="normal">ℓ</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\pm\ell_{1},\pm\ell_{2}</annotation></semantics></math> for small <math id="S2.SS2.p5.m17" class="ltx_Math" alttext="(\alpha,\beta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>α</mi><mo>,</mo><mi>β</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\alpha,\beta)</annotation></semantics></math>, so <math id="S2.SS2.p5.m18" class="ltx_Math" alttext="w_{1}(\beta)=1-c\beta" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>w</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>β</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">w_{1}(\beta)=1-c\beta</annotation></semantics></math> and <math id="S2.SS2.p5.m19" class="ltx_Math" alttext="w_{2}(\alpha)=1-d\alpha" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>w</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">w_{2}(\alpha)=1-d\alpha</annotation></semantics></math> with <math id="S2.SS2.p5.m20" class="ltx_Math" alttext="c=r_{2}-l_{2}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>=</mo><mrow><msub><mi>r</mi><mn>2</mn></msub><mo>−</mo><msub><mi>l</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">c=r_{2}-l_{2}</annotation></semantics></math> and <math id="S2.SS2.p5.m21" class="ltx_Math" alttext="d=t_{1}-b_{1}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>−</mo><msub><mi>b</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">d=t_{1}-b_{1}</annotation></semantics></math>. Along <math id="S2.SS2.p5.m22" class="ltx_Math" alttext="(\alpha,\beta)=(s,-s)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>α</mi><mo>,</mo><mi>β</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mrow><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(\alpha,\beta)=(s,-s)</annotation></semantics></math> we obtain</span></p>
<table id="S2.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex13.m1" class="ltx_Math" alttext="\operatorname{area}S(s,-s)=\frac{(1+cs)(1-ds)}{1+s^{2}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>area</mi><mo lspace="0.167em">⁡</mo><mrow><mi>S</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mrow><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mn>1</mn><mo>+</mo><msup><mi>s</mi><mn>2</mn></msup></mrow></mfrac></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\operatorname{area}S(s,-s)=\frac{(1+cs)(1-ds)}{1+s^{2}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS2.p5.3" class="ltx_p"><span id="S2.SS2.p5.3.1" class="ltx_text">which is smaller than <math id="S2.SS2.p5.m23" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> for a suitable small <math id="S2.SS2.p5.m24" class="ltx_Math" alttext="s\neq 0" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">s\neq 0</annotation></semantics></math>: if <math id="S2.SS2.p5.m25" class="ltx_Math" alttext="c\neq d" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>≠</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">c\neq d</annotation></semantics></math>, the linear term <math id="S2.SS2.p5.m26" class="ltx_Math" alttext="(c-d)s" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo>−</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><annotation encoding="application/x-tex">(c-d)s</annotation></semantics></math> can be made negative, and if <math id="S2.SS2.p5.m27" class="ltx_Math" alttext="c=d" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>=</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">c=d</annotation></semantics></math>, the value is <math id="S2.SS2.p5.m28" class="ltx_Math" alttext="(1-c^{2}s^{2})/(1+s^{2})&lt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msup><mi>c</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>s</mi><mn>2</mn></msup></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msup><mi>s</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">(1-c^{2}s^{2})/(1+s^{2})&lt;1</annotation></semantics></math>. This contradicts minimality.</span></p>
</div>
<div id="S2.SS2.p6" class="ltx_para">
<p id="S2.SS2.p6.1" class="ltx_p"><em id="S2.SS2.p6.1.1" class="ltx_emph ltx_font_italic">(C).</em><span id="S2.SS2.p6.1.2" class="ltx_text"> The idea is illustrated in Figure <a href="#S2.F2" title="Figure 2 ‣ 2.2 Boundary structure of optimal configurations ‣ 2 Original formulation and theoretical results ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>c. For <math id="S2.SS2.p6.m1" class="ltx_Math" alttext="\beta=0" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\beta=0</annotation></semantics></math>, <math id="S2.SS2.p6.m2" class="ltx_Math" alttext="S(\alpha,0)" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">S(\alpha,0)</annotation></semantics></math> has the vertical edges of <math id="S2.SS2.p6.m3" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> and area <math id="S2.SS2.p6.m4" class="ltx_Math" alttext="w_{2}(\alpha)" display="inline" intent=":literal"><semantics><mrow><msub><mi>w</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">w_{2}(\alpha)</annotation></semantics></math>. The convex function <math id="S2.SS2.p6.m5" class="ltx_Math" alttext="w_{2}" display="inline" intent=":literal"><semantics><msub><mi>w</mi><mn>2</mn></msub><annotation encoding="application/x-tex">w_{2}</annotation></semantics></math> is minimal at <math id="S2.SS2.p6.m6" class="ltx_Math" alttext="\alpha=0" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\alpha=0</annotation></semantics></math>, so <math id="S2.SS2.p6.m7" class="ltx_Math" alttext="0\in\partial w_{2}(0)" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo rspace="0.111em">∈</mo><mrow><mo>∂</mo><mrow><msub><mi>w</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">0\in\partial w_{2}(0)</annotation></semantics></math>. If <math id="S2.SS2.p6.m8" class="ltx_Math" alttext="[b^{-},b^{+}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><msup><mi>b</mi><mo>−</mo></msup><mo>,</mo><msup><mi>b</mi><mo>+</mo></msup><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[b^{-},b^{+}]</annotation></semantics></math> and <math id="S2.SS2.p6.m9" class="ltx_Math" alttext="[t^{-},t^{+}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><msup><mi>t</mi><mo>−</mo></msup><mo>,</mo><msup><mi>t</mi><mo>+</mo></msup><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[t^{-},t^{+}]</annotation></semantics></math> denote the <math id="S2.SS2.p6.m10" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>-ranges of <math id="S2.SS2.p6.m11" class="ltx_Math" alttext="K\cap\sigma_{\mathrm{b}}" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>∩</mo><msub><mi>σ</mi><mi>b</mi></msub></mrow><annotation encoding="application/x-tex">K\cap\sigma_{\mathrm{b}}</annotation></semantics></math> and <math id="S2.SS2.p6.m12" class="ltx_Math" alttext="K\cap\sigma_{\mathrm{t}}" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>∩</mo><msub><mi>σ</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">K\cap\sigma_{\mathrm{t}}</annotation></semantics></math>, then <math id="S2.SS2.p6.m13" class="ltx_Math" alttext="\partial w_{2}(0)=[b^{-}-t^{+},\ b^{+}-t^{-}]" display="inline" intent=":literal"><semantics><mrow><mo>∂</mo><mphantom></mphantom><mrow><mrow><msub><mi>w</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msup><mi>b</mi><mo>−</mo></msup><mo>−</mo><msup><mi>t</mi><mo>+</mo></msup></mrow><mo rspace="0.667em">,</mo><mrow><msup><mi>b</mi><mo>+</mo></msup><mo>−</mo><msup><mi>t</mi><mo>−</mo></msup></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\partial w_{2}(0)=[b^{-}-t^{+},\ b^{+}-t^{-}]</annotation></semantics></math>, and <math id="S2.SS2.p6.m14" class="ltx_Math" alttext="0\in\partial w_{2}(0)" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo rspace="0.111em">∈</mo><mrow><mo>∂</mo><mrow><msub><mi>w</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">0\in\partial w_{2}(0)</annotation></semantics></math> says that the two ranges intersect. The case <math id="S2.SS2.p6.m15" class="ltx_Math" alttext="\alpha=0" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\alpha=0</annotation></semantics></math> gives the statement for the vertical edges.
∎</span></p>
</div>
</div>
<div id="Thmremark3" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmremark3.2" class="ltx_text ltx_font_italic">Remark 3</span></span><span id="Thmremark3.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="Thmremark3.p1" class="ltx_para">
<p id="Thmremark3.p1.1" class="ltx_p">Part (B) is closely related to the classical fact that a minimum-area rectangle enclosing a convex polygon has a side containing an edge of the polygon <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx20" title="" class="ltx_ref">20</a>]</cite>. Part (C) generalizes conditions (a)–(c) in case 1 of Lemma 2 of Zeng and Chen <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx42" title="" class="ltx_ref">42</a>]</cite>: contacts on opposite edges face each other, and two single-point contacts lie on a line parallel to the other two edges. That lemma covers the cases of no common vertex, one common vertex, and two opposite common vertices, but not two adjacent common vertices. For the fixed unit square this case must be handled explicitly, which is done in Lemma <a href="#Thmlemma3" title="Lemma 3 (Shear normalization). ‣ 2.2 Boundary structure of optimal configurations ‣ 2 Original formulation and theoretical results ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> and Theorem <a href="#Thmtheorem1" title="Theorem 1 (Structure of optimal configurations). ‣ 2.2 Boundary structure of optimal configurations ‣ 2 Original formulation and theoretical results ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> below.</p>
</div>
</div>
<div id="S2.SS2.p7" class="ltx_para">
<p id="S2.SS2.p7.1" class="ltx_p">A corner of <math id="S2.SS2.p7.m1" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> lies in <math id="S2.SS2.p7.m2" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> if and only if it is a vertex of <math id="S2.SS2.p7.m3" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>, that is, a point of <math id="S2.SS2.p7.m4" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math>.
We call two corners <em id="S2.SS2.p7.1.1" class="ltx_emph ltx_font_italic">adjacent</em> if they share an edge of <math id="S2.SS2.p7.m5" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>.</p>
</div>
<div id="Thmproposition2" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmproposition2.2" class="ltx_text ltx_font_bold">Proposition 2</span></span><span id="Thmproposition2.3" class="ltx_text ltx_font_bold"> </span>(Configurations without adjacent corners)<span id="Thmproposition2.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmproposition2.p1" class="ltx_para">
<p id="Thmproposition2.p1.1" class="ltx_p"><span id="Thmproposition2.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmproposition2.p1.m1" class="ltx_Math" alttext="n\geq 5" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">n\geq 5</annotation></semantics></math> and let <math id="Thmproposition2.p1.m2" class="ltx_Math" alttext="P\subseteq S" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>⊆</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">P\subseteq S</annotation></semantics></math> be an optimal configuration that does not contain two adjacent corners of <math id="Thmproposition2.p1.m3" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>.
Then at least five points of <math id="Thmproposition2.p1.m4" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> lie on <math id="Thmproposition2.p1.m5" class="ltx_Math" alttext="\partial S" display="inline" intent=":literal"><semantics><mrow><mo>∂</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">\partial S</annotation></semantics></math>, and the image of <math id="Thmproposition2.p1.m6" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> under a suitable symmetry of <math id="Thmproposition2.p1.m7" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> can be labeled so that it has the boundary pattern.</span></p>
</div>
</div>
<div id="S2.SS2.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S2.SS2.p8" class="ltx_para">
<p id="S2.SS2.p8.1" class="ltx_p"><span id="S2.SS2.p8.1.1" class="ltx_text">By Lemma <a href="#Thmlemma1" title="Lemma 1 (Minimal covering parallelogram). ‣ 2.2 Boundary structure of optimal configurations ‣ 2 Original formulation and theoretical results ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, Lemma <a href="#Thmlemma2" title="Lemma 2 (Contact properties). ‣ 2.2 Boundary structure of optimal configurations ‣ 2 Original formulation and theoretical results ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> applies to <math id="S2.SS2.p8.m1" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> and <math id="S2.SS2.p8.m2" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>. By assumption, <math id="S2.SS2.p8.m3" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> contains at most two corners, and if it contains two, they are opposite.</span></p>
</div>
<div id="S2.SS2.p9" class="ltx_para">
<p id="S2.SS2.p9.1" class="ltx_p"><em id="S2.SS2.p9.1.1" class="ltx_emph ltx_font_italic">No corner.</em><span id="S2.SS2.p9.1.2" class="ltx_text"> By (A), every contact lies in the relative interior of its edge, which gives four distinct boundary points. By (B), some edge contains an entire edge of <math id="S2.SS2.p9.m1" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> and hence a second point. We rotate <math id="S2.SS2.p9.m2" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> so that this edge becomes <math id="S2.SS2.p9.m3" class="ltx_Math" alttext="\sigma_{\ell}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi mathvariant="normal">ℓ</mi></msub><annotation encoding="application/x-tex">\sigma_{\ell}</annotation></semantics></math> and call its two points <math id="S2.SS2.p9.m4" class="ltx_Math" alttext="p_{1}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mn>1</mn></msub><annotation encoding="application/x-tex">p_{1}</annotation></semantics></math> and <math id="S2.SS2.p9.m5" class="ltx_Math" alttext="p_{5}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mn>5</mn></msub><annotation encoding="application/x-tex">p_{5}</annotation></semantics></math> with <math id="S2.SS2.p9.m6" class="ltx_Math" alttext="y_{1}&lt;y_{5}" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mn>1</mn></msub><mo>&lt;</mo><msub><mi>y</mi><mn>5</mn></msub></mrow><annotation encoding="application/x-tex">y_{1}&lt;y_{5}</annotation></semantics></math>, and the contacts on <math id="S2.SS2.p9.m7" class="ltx_Math" alttext="\sigma_{\mathrm{b}}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>b</mi></msub><annotation encoding="application/x-tex">\sigma_{\mathrm{b}}</annotation></semantics></math>, <math id="S2.SS2.p9.m8" class="ltx_Math" alttext="\sigma_{\mathrm{r}}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>r</mi></msub><annotation encoding="application/x-tex">\sigma_{\mathrm{r}}</annotation></semantics></math>, <math id="S2.SS2.p9.m9" class="ltx_Math" alttext="\sigma_{\mathrm{t}}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\sigma_{\mathrm{t}}</annotation></semantics></math> <math id="S2.SS2.p9.m10" class="ltx_Math" alttext="p_{2}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mn>2</mn></msub><annotation encoding="application/x-tex">p_{2}</annotation></semantics></math>, <math id="S2.SS2.p9.m11" class="ltx_Math" alttext="p_{3}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mn>3</mn></msub><annotation encoding="application/x-tex">p_{3}</annotation></semantics></math>, <math id="S2.SS2.p9.m12" class="ltx_Math" alttext="p_{4}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mn>4</mn></msub><annotation encoding="application/x-tex">p_{4}</annotation></semantics></math>.</span></p>
</div>
<div id="S2.SS2.p10" class="ltx_para">
<p id="S2.SS2.p10.1" class="ltx_p"><em id="S2.SS2.p10.1.1" class="ltx_emph ltx_font_italic">One corner.</em><span id="S2.SS2.p10.1.2" class="ltx_text"> After a rotation, <math id="S2.SS2.p10.m1" class="ltx_Math" alttext="A\in P" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>∈</mo><mi>P</mi></mrow><annotation encoding="application/x-tex">A\in P</annotation></semantics></math> and <math id="S2.SS2.p10.m2" class="ltx_Math" alttext="B,C,D\notin P" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>,</mo><mi>C</mi><mo>,</mo><mrow><mi>D</mi><mo>∉</mo><mi>P</mi></mrow></mrow><annotation encoding="application/x-tex">B,C,D\notin P</annotation></semantics></math>. If <math id="S2.SS2.p10.m3" class="ltx_Math" alttext="\sigma_{\mathrm{b}}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>b</mi></msub><annotation encoding="application/x-tex">\sigma_{\mathrm{b}}</annotation></semantics></math> met <math id="S2.SS2.p10.m4" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> only in <math id="S2.SS2.p10.m5" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>, its <math id="S2.SS2.p10.m6" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>-range would be <math id="S2.SS2.p10.m7" class="ltx_Math" alttext="\{0\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mn>0</mn><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{0\}</annotation></semantics></math>, and by (C) the contact on <math id="S2.SS2.p10.m8" class="ltx_Math" alttext="\sigma_{\mathrm{t}}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\sigma_{\mathrm{t}}</annotation></semantics></math> would contain a point with <math id="S2.SS2.p10.m9" class="ltx_Math" alttext="x=0" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">x=0</annotation></semantics></math>, that is, <math id="S2.SS2.p10.m10" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math>, which is excluded. Hence <math id="S2.SS2.p10.m11" class="ltx_Math" alttext="\sigma_{\mathrm{b}}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>b</mi></msub><annotation encoding="application/x-tex">\sigma_{\mathrm{b}}</annotation></semantics></math> contains an edge <math id="S2.SS2.p10.m12" class="ltx_Math" alttext="A\,(\beta,0)" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo lspace="0.170em">⁡</mo><mrow><mo stretchy="false">(</mo><mi>β</mi><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">A\,(\beta,0)</annotation></semantics></math> of <math id="S2.SS2.p10.m13" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> with <math id="S2.SS2.p10.m14" class="ltx_Math" alttext="0&lt;\beta&lt;1" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><mi>β</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">0&lt;\beta&lt;1</annotation></semantics></math>, and in the same way <math id="S2.SS2.p10.m15" class="ltx_Math" alttext="\sigma_{\ell}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi mathvariant="normal">ℓ</mi></msub><annotation encoding="application/x-tex">\sigma_{\ell}</annotation></semantics></math> contains an edge <math id="S2.SS2.p10.m16" class="ltx_Math" alttext="A\,(0,\lambda)" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo lspace="0.170em">⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">A\,(0,\lambda)</annotation></semantics></math> with <math id="S2.SS2.p10.m17" class="ltx_Math" alttext="0&lt;\lambda&lt;1" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><mi>λ</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">0&lt;\lambda&lt;1</annotation></semantics></math>. Together with a point on <math id="S2.SS2.p10.m18" class="ltx_Math" alttext="\sigma_{\mathrm{r}}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>r</mi></msub><annotation encoding="application/x-tex">\sigma_{\mathrm{r}}</annotation></semantics></math> and a point on <math id="S2.SS2.p10.m19" class="ltx_Math" alttext="\sigma_{\mathrm{t}}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\sigma_{\mathrm{t}}</annotation></semantics></math>, which differ from each other and from the previous ones because <math id="S2.SS2.p10.m20" class="ltx_Math" alttext="B,C,D\notin P" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>,</mo><mi>C</mi><mo>,</mo><mrow><mi>D</mi><mo>∉</mo><mi>P</mi></mrow></mrow><annotation encoding="application/x-tex">B,C,D\notin P</annotation></semantics></math>, this gives five boundary points. We set <math id="S2.SS2.p10.m21" class="ltx_Math" alttext="p_{1}=A" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mn>1</mn></msub><mo>=</mo><mi>A</mi></mrow><annotation encoding="application/x-tex">p_{1}=A</annotation></semantics></math>, <math id="S2.SS2.p10.m22" class="ltx_Math" alttext="p_{2}=(\beta,0)" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mn>2</mn></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>β</mi><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{2}=(\beta,0)</annotation></semantics></math>, <math id="S2.SS2.p10.m23" class="ltx_Math" alttext="p_{5}=(0,\lambda)" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mn>5</mn></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{5}=(0,\lambda)</annotation></semantics></math>, and let <math id="S2.SS2.p10.m24" class="ltx_Math" alttext="p_{3}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mn>3</mn></msub><annotation encoding="application/x-tex">p_{3}</annotation></semantics></math> and <math id="S2.SS2.p10.m25" class="ltx_Math" alttext="p_{4}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mn>4</mn></msub><annotation encoding="application/x-tex">p_{4}</annotation></semantics></math> be the points on <math id="S2.SS2.p10.m26" class="ltx_Math" alttext="\sigma_{\mathrm{r}}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>r</mi></msub><annotation encoding="application/x-tex">\sigma_{\mathrm{r}}</annotation></semantics></math> and <math id="S2.SS2.p10.m27" class="ltx_Math" alttext="\sigma_{\mathrm{t}}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\sigma_{\mathrm{t}}</annotation></semantics></math>.</span></p>
</div>
<div id="S2.SS2.p11" class="ltx_para">
<p id="S2.SS2.p11.1" class="ltx_p"><em id="S2.SS2.p11.1.1" class="ltx_emph ltx_font_italic">Two opposite corners.</em><span id="S2.SS2.p11.1.2" class="ltx_text"> After a rotation, <math id="S2.SS2.p11.m1" class="ltx_Math" alttext="A,C\in P" display="inline" intent=":literal"><semantics><mrow><mrow><mi>A</mi><mo>,</mo><mi>C</mi></mrow><mo>∈</mo><mi>P</mi></mrow><annotation encoding="application/x-tex">A,C\in P</annotation></semantics></math> and <math id="S2.SS2.p11.m2" class="ltx_Math" alttext="B,D\notin P" display="inline" intent=":literal"><semantics><mrow><mrow><mi>B</mi><mo>,</mo><mi>D</mi></mrow><mo>∉</mo><mi>P</mi></mrow><annotation encoding="application/x-tex">B,D\notin P</annotation></semantics></math>. The argument of the previous case, applied to all four edges, shows that every edge contains an edge of <math id="S2.SS2.p11.m3" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>, which gives the six boundary points <math id="S2.SS2.p11.m4" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>, <math id="S2.SS2.p11.m5" class="ltx_Math" alttext="(\beta,0)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>β</mi><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\beta,0)</annotation></semantics></math>, <math id="S2.SS2.p11.m6" class="ltx_Math" alttext="(1,\rho)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mi>ρ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1,\rho)</annotation></semantics></math>, <math id="S2.SS2.p11.m7" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math>, <math id="S2.SS2.p11.m8" class="ltx_Math" alttext="(\tau,1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\tau,1)</annotation></semantics></math>, <math id="S2.SS2.p11.m9" class="ltx_Math" alttext="(0,\lambda)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0,\lambda)</annotation></semantics></math>. We set <math id="S2.SS2.p11.m10" class="ltx_Math" alttext="p_{1}=A" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mn>1</mn></msub><mo>=</mo><mi>A</mi></mrow><annotation encoding="application/x-tex">p_{1}=A</annotation></semantics></math>, <math id="S2.SS2.p11.m11" class="ltx_Math" alttext="p_{2}=(\beta,0)" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mn>2</mn></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>β</mi><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{2}=(\beta,0)</annotation></semantics></math>, <math id="S2.SS2.p11.m12" class="ltx_Math" alttext="p_{3}=(1,\rho)" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mn>3</mn></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mi>ρ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{3}=(1,\rho)</annotation></semantics></math>, <math id="S2.SS2.p11.m13" class="ltx_Math" alttext="p_{4}=(\tau,1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mn>4</mn></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{4}=(\tau,1)</annotation></semantics></math>, <math id="S2.SS2.p11.m14" class="ltx_Math" alttext="p_{5}=(0,\lambda)" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mn>5</mn></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{5}=(0,\lambda)</annotation></semantics></math>.</span></p>
</div>
<div id="S2.SS2.p12" class="ltx_para">
<p id="S2.SS2.p12.1" class="ltx_p"><span id="S2.SS2.p12.1.1" class="ltx_text">In all cases <math id="S2.SS2.p12.m1" class="ltx_Math" alttext="p_{1},\dots,p_{5}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>p</mi><mn>5</mn></msub></mrow><annotation encoding="application/x-tex">p_{1},\dots,p_{5}</annotation></semantics></math> are distinct, <math id="S2.SS2.p12.m2" class="ltx_Math" alttext="x_{1}=x_{5}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>=</mo><msub><mi>x</mi><mn>5</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">x_{1}=x_{5}=0</annotation></semantics></math>, <math id="S2.SS2.p12.m3" class="ltx_Math" alttext="y_{2}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mn>2</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">y_{2}=0</annotation></semantics></math>, <math id="S2.SS2.p12.m4" class="ltx_Math" alttext="x_{3}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>3</mn></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">x_{3}=1</annotation></semantics></math>, <math id="S2.SS2.p12.m5" class="ltx_Math" alttext="y_{4}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mn>4</mn></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">y_{4}=1</annotation></semantics></math>, and <math id="S2.SS2.p12.m6" class="ltx_Math" alttext="y_{1}\leq y_{5}" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mn>1</mn></msub><mo>≤</mo><msub><mi>y</mi><mn>5</mn></msub></mrow><annotation encoding="application/x-tex">y_{1}\leq y_{5}</annotation></semantics></math>.
If <math id="S2.SS2.p12.m7" class="ltx_Math" alttext="x_{2}&gt;x_{4}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>2</mn></msub><mo>&gt;</mo><msub><mi>x</mi><mn>4</mn></msub></mrow><annotation encoding="application/x-tex">x_{2}&gt;x_{4}</annotation></semantics></math>, we apply the reflection <math id="S2.SS2.p12.m8" class="ltx_Math" alttext="(x,y)\mapsto(x,1-y)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">↦</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mrow><mn>1</mn><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(x,y)\mapsto(x,1-y)</annotation></semantics></math>, which preserves <math id="S2.SS2.p12.m9" class="ltx_Math" alttext="\sigma_{\ell}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi mathvariant="normal">ℓ</mi></msub><annotation encoding="application/x-tex">\sigma_{\ell}</annotation></semantics></math> and exchanges <math id="S2.SS2.p12.m10" class="ltx_Math" alttext="\sigma_{\mathrm{b}}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>b</mi></msub><annotation encoding="application/x-tex">\sigma_{\mathrm{b}}</annotation></semantics></math> and <math id="S2.SS2.p12.m11" class="ltx_Math" alttext="\sigma_{\mathrm{t}}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\sigma_{\mathrm{t}}</annotation></semantics></math>, and relabel the reflected points <math id="S2.SS2.p12.m12" class="ltx_Math" alttext="p_{5},p_{4},p_{3},p_{2},p_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mn>5</mn></msub><mo>,</mo><msub><mi>p</mi><mn>4</mn></msub><mo>,</mo><msub><mi>p</mi><mn>3</mn></msub><mo>,</mo><msub><mi>p</mi><mn>2</mn></msub><mo>,</mo><msub><mi>p</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">p_{5},p_{4},p_{3},p_{2},p_{1}</annotation></semantics></math> as <math id="S2.SS2.p12.m13" class="ltx_Math" alttext="p_{1},\dots,p_{5}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>p</mi><mn>5</mn></msub></mrow><annotation encoding="application/x-tex">p_{1},\dots,p_{5}</annotation></semantics></math>. This preserves all conditions above and exchanges <math id="S2.SS2.p12.m14" class="ltx_Math" alttext="x_{2}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>2</mn></msub><annotation encoding="application/x-tex">x_{2}</annotation></semantics></math> and <math id="S2.SS2.p12.m15" class="ltx_Math" alttext="x_{4}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>4</mn></msub><annotation encoding="application/x-tex">x_{4}</annotation></semantics></math>.
Finally, we label the remaining points by nondecreasing <math id="S2.SS2.p12.m16" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>-coordinate.
∎</span></p>
</div>
</div>
<div id="S2.SS2.p13" class="ltx_para">
<p id="S2.SS2.p13.1" class="ltx_p">It remains to treat configurations with two adjacent corners. Such configurations do occur: the known optimal configuration for <math id="S2.SS2.p13.m1" class="ltx_Math" alttext="n=7" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>7</mn></mrow><annotation encoding="application/x-tex">n=7</annotation></semantics></math> contains <math id="S2.SS2.p13.m2" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> and <math id="S2.SS2.p13.m3" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> (Table <a href="#S5.T6" title="Table 6 ‣ Step 1: Numerical global optimization ‣ 5.2 Illustration of the methodology for 𝑛=7 ‣ 5 The optimize-then-refine framework ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>).</p>
</div>
<div id="Thmlemma3" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma3.2" class="ltx_text ltx_font_bold">Lemma 3</span></span><span id="Thmlemma3.3" class="ltx_text ltx_font_bold"> </span>(Shear normalization)<span id="Thmlemma3.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma3.p1" class="ltx_para">
<p id="Thmlemma3.p1.1" class="ltx_p"><span id="Thmlemma3.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmlemma3.p1.m1" class="ltx_Math" alttext="P\subseteq S" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>⊆</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">P\subseteq S</annotation></semantics></math> be an optimal configuration that contains the corners <math id="Thmlemma3.p1.m2" class="ltx_Math" alttext="(1,1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1,1)</annotation></semantics></math> and <math id="Thmlemma3.p1.m3" class="ltx_Math" alttext="(0,1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0,1)</annotation></semantics></math>. Then there is an optimal configuration <math id="Thmlemma3.p1.m4" class="ltx_Math" alttext="P^{\prime}\subseteq S" display="inline" intent=":literal"><semantics><mrow><msup><mi>P</mi><mo>′</mo></msup><mo>⊆</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">P^{\prime}\subseteq S</annotation></semantics></math> that contains <math id="Thmlemma3.p1.m5" class="ltx_Math" alttext="(1,1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1,1)</annotation></semantics></math>, <math id="Thmlemma3.p1.m6" class="ltx_Math" alttext="(0,1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0,1)</annotation></semantics></math>, a point on the bottom edge, and a point <math id="Thmlemma3.p1.m7" class="ltx_Math" alttext="(0,\lambda)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0,\lambda)</annotation></semantics></math> with <math id="Thmlemma3.p1.m8" class="ltx_Math" alttext="\lambda&lt;1" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\lambda&lt;1</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S2.SS2.5" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S2.SS2.p14" class="ltx_para">
<p id="S2.SS2.p14.1" class="ltx_p"><span id="S2.SS2.p14.1.1" class="ltx_text">By Lemma <a href="#Thmlemma1" title="Lemma 1 (Minimal covering parallelogram). ‣ 2.2 Boundary structure of optimal configurations ‣ 2 Original formulation and theoretical results ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> and Lemma <a href="#Thmlemma2" title="Lemma 2 (Contact properties). ‣ 2.2 Boundary structure of optimal configurations ‣ 2 Original formulation and theoretical results ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>(A), <math id="S2.SS2.p14.m1" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> contains a point <math id="S2.SS2.p14.m2" class="ltx_Math" alttext="(b,0)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>b</mi><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(b,0)</annotation></semantics></math> on <math id="S2.SS2.p14.m3" class="ltx_Math" alttext="\sigma_{\mathrm{b}}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>b</mi></msub><annotation encoding="application/x-tex">\sigma_{\mathrm{b}}</annotation></semantics></math>. If <math id="S2.SS2.p14.m4" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> already contains a point <math id="S2.SS2.p14.m5" class="ltx_Math" alttext="(0,\lambda)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0,\lambda)</annotation></semantics></math> with <math id="S2.SS2.p14.m6" class="ltx_Math" alttext="\lambda&lt;1" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\lambda&lt;1</annotation></semantics></math>, we take <math id="S2.SS2.p14.m7" class="ltx_Math" alttext="P^{\prime}=P" display="inline" intent=":literal"><semantics><mrow><msup><mi>P</mi><mo>′</mo></msup><mo>=</mo><mi>P</mi></mrow><annotation encoding="application/x-tex">P^{\prime}=P</annotation></semantics></math>. Otherwise every point <math id="S2.SS2.p14.m8" class="ltx_Math" alttext="p\in P" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><mi>P</mi></mrow><annotation encoding="application/x-tex">p\in P</annotation></semantics></math> with <math id="S2.SS2.p14.m9" class="ltx_Math" alttext="y_{p}&lt;1" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mi>p</mi></msub><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">y_{p}&lt;1</annotation></semantics></math> has <math id="S2.SS2.p14.m10" class="ltx_Math" alttext="x_{p}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mi>p</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">x_{p}&gt;0</annotation></semantics></math>, and we set</span></p>
<table id="S2.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex14.m1" class="ltx_math_unparsed" alttext="s^{\ast}:=\min\Bigl\{\frac{x_{p}}{1-y_{p}}\;\Big|\;p\in P,\ y_{p}&lt;1\Bigr\}\in(0,1]," display="block" intent=":literal"><semantics><mrow><msup><mi>s</mi><mo>∗</mo></msup><mo>:=</mo><mi>min</mi><mrow><mo stretchy="false">{</mo><mfrac><msub><mi>x</mi><mi>p</mi></msub><mrow><mn>1</mn><mo>−</mo><msub><mi>y</mi><mi>p</mi></msub></mrow></mfrac><mo fence="false" lspace="0.280em" maxsize="1.600em" minsize="1.600em" rspace="0.447em" stretchy="true">|</mo><mi>p</mi><mo>∈</mo><mi>P</mi><mo rspace="0.667em">,</mo><msub><mi>y</mi><mi>p</mi></msub><mo>&lt;</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">s^{\ast}:=\min\Bigl\{\frac{x_{p}}{1-y_{p}}\;\Big|\;p\in P,\ y_{p}&lt;1\Bigr\}\in(0,1],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS2.p14.2" class="ltx_p"><span id="S2.SS2.p14.2.1" class="ltx_text">where <math id="S2.SS2.p14.m11" class="ltx_Math" alttext="s^{\ast}\leq 1" display="inline" intent=":literal"><semantics><mrow><msup><mi>s</mi><mo>∗</mo></msup><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">s^{\ast}\leq 1</annotation></semantics></math> follows from the point <math id="S2.SS2.p14.m12" class="ltx_Math" alttext="(b,0)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>b</mi><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(b,0)</annotation></semantics></math>. The shear <math id="S2.SS2.p14.m13" class="ltx_Math" alttext="\psi(x,y)=(x-s^{\ast}(1-y),\,y)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>−</mo><mrow><msup><mi>s</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\psi(x,y)=(x-s^{\ast}(1-y),\,y)</annotation></semantics></math> has determinant <math id="S2.SS2.p14.m14" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> and therefore preserves all triangle areas. It fixes every point with <math id="S2.SS2.p14.m15" class="ltx_Math" alttext="y=1" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">y=1</annotation></semantics></math>, in particular <math id="S2.SS2.p14.m16" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> and <math id="S2.SS2.p14.m17" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math>, and it does not change <math id="S2.SS2.p14.m18" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math>-coordinates. By the choice of <math id="S2.SS2.p14.m19" class="ltx_Math" alttext="s^{\ast}" display="inline" intent=":literal"><semantics><msup><mi>s</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">s^{\ast}</annotation></semantics></math>, every point <math id="S2.SS2.p14.m20" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> with <math id="S2.SS2.p14.m21" class="ltx_Math" alttext="y_{p}&lt;1" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mi>p</mi></msub><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">y_{p}&lt;1</annotation></semantics></math> satisfies <math id="S2.SS2.p14.m22" class="ltx_Math" alttext="0\leq x_{p}-s^{\ast}(1-y_{p})\leq x_{p}\leq 1" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><mrow><msub><mi>x</mi><mi>p</mi></msub><mo>−</mo><mrow><msup><mi>s</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>y</mi><mi>p</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><msub><mi>x</mi><mi>p</mi></msub><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">0\leq x_{p}-s^{\ast}(1-y_{p})\leq x_{p}\leq 1</annotation></semantics></math>, so <math id="S2.SS2.p14.m23" class="ltx_Math" alttext="P^{\prime}=\psi(P)\subseteq S" display="inline" intent=":literal"><semantics><mrow><msup><mi>P</mi><mo>′</mo></msup><mo>=</mo><mrow><mi>ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>P</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊆</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">P^{\prime}=\psi(P)\subseteq S</annotation></semantics></math> is optimal, contains <math id="S2.SS2.p14.m24" class="ltx_Math" alttext="(b-s^{\ast},0)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>b</mi><mo>−</mo><msup><mi>s</mi><mo>∗</mo></msup></mrow><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(b-s^{\ast},0)</annotation></semantics></math> on <math id="S2.SS2.p14.m25" class="ltx_Math" alttext="\sigma_{\mathrm{b}}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>b</mi></msub><annotation encoding="application/x-tex">\sigma_{\mathrm{b}}</annotation></semantics></math>, and contains a point on <math id="S2.SS2.p14.m26" class="ltx_Math" alttext="\sigma_{\ell}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi mathvariant="normal">ℓ</mi></msub><annotation encoding="application/x-tex">\sigma_{\ell}</annotation></semantics></math> below <math id="S2.SS2.p14.m27" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math>, namely the image of a minimizer of <math id="S2.SS2.p14.m28" class="ltx_Math" alttext="s^{\ast}" display="inline" intent=":literal"><semantics><msup><mi>s</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">s^{\ast}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="Thmtheorem1" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem1.2" class="ltx_text ltx_font_bold">Theorem 1</span></span><span id="Thmtheorem1.3" class="ltx_text ltx_font_bold"> </span>(Structure of optimal configurations)<span id="Thmtheorem1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem1.p1" class="ltx_para">
<p id="Thmtheorem1.p1.1" class="ltx_p"><span id="Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmtheorem1.p1.m1" class="ltx_Math" alttext="n\geq 5" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">n\geq 5</annotation></semantics></math>. There exists an optimal configuration that, after a symmetry of <math id="Thmtheorem1.p1.m2" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> and a relabeling, has one of the following types:</span></p>
<ol id="S2.I2" class="ltx_enumerate">
<li id="S2.I2.ix1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">I.</span> 
<div id="S2.I2.ix1.p1" class="ltx_para">
<p id="S2.I2.ix1.p1.1" class="ltx_p"><span id="S2.I2.ix1.p1.1.1" class="ltx_text ltx_font_italic">it has the boundary pattern of Definition </span><a href="#Thmdefinition1" title="Definition 1 (Boundary pattern). ‣ 2.2 Boundary structure of optimal configurations ‣ 2 Original formulation and theoretical results ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref ltx_font_italic"><span class="ltx_text ltx_ref_tag">1</span></a><span id="S2.I2.ix1.p1.1.2" class="ltx_text ltx_font_italic">,</span></p>
</div></li>
<li id="S2.I2.ix2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">II.</span> 
<div id="S2.I2.ix2.p1" class="ltx_para">
<p id="S2.I2.ix2.p1.1" class="ltx_p"><span id="S2.I2.ix2.p1.1.1" class="ltx_text ltx_font_italic">it contains the corners </span><math id="S2.I2.ix2.p1.m1" class="ltx_Math" alttext="(1,1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1,1)</annotation></semantics></math><span id="S2.I2.ix2.p1.1.2" class="ltx_text ltx_font_italic"> and </span><math id="S2.I2.ix2.p1.m2" class="ltx_Math" alttext="(0,1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0,1)</annotation></semantics></math><span id="S2.I2.ix2.p1.1.3" class="ltx_text ltx_font_italic">, a point </span><math id="S2.I2.ix2.p1.m3" class="ltx_Math" alttext="(0,\lambda)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0,\lambda)</annotation></semantics></math><span id="S2.I2.ix2.p1.1.4" class="ltx_text ltx_font_italic"> with </span><math id="S2.I2.ix2.p1.m4" class="ltx_Math" alttext="\lambda&lt;1" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\lambda&lt;1</annotation></semantics></math><span id="S2.I2.ix2.p1.1.5" class="ltx_text ltx_font_italic">, and a different point </span><math id="S2.I2.ix2.p1.m5" class="ltx_Math" alttext="(b,0)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>b</mi><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(b,0)</annotation></semantics></math><span id="S2.I2.ix2.p1.1.6" class="ltx_text ltx_font_italic">,</span></p>
</div></li>
<li id="S2.I2.ix3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">III.</span> 
<div id="S2.I2.ix3.p1" class="ltx_para">
<p id="S2.I2.ix3.p1.1" class="ltx_p"><span id="S2.I2.ix3.p1.1.1" class="ltx_text ltx_font_italic">it contains the corners </span><math id="S2.I2.ix3.p1.m1" class="ltx_Math" alttext="(0,0)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0,0)</annotation></semantics></math><span id="S2.I2.ix3.p1.1.2" class="ltx_text ltx_font_italic">, </span><math id="S2.I2.ix3.p1.m2" class="ltx_Math" alttext="(1,1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1,1)</annotation></semantics></math><span id="S2.I2.ix3.p1.1.3" class="ltx_text ltx_font_italic">, and </span><math id="S2.I2.ix3.p1.m3" class="ltx_Math" alttext="(0,1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0,1)</annotation></semantics></math><span id="S2.I2.ix3.p1.1.4" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S2.SS2.6" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S2.SS2.p15" class="ltx_para">
<p id="S2.SS2.p15.1" class="ltx_p"><span id="S2.SS2.p15.1.1" class="ltx_text">Let <math id="S2.SS2.p15.m1" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> be optimal. If <math id="S2.SS2.p15.m2" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> contains no two adjacent corners, Proposition <a href="#Thmproposition2" title="Proposition 2 (Configurations without adjacent corners). ‣ 2.2 Boundary structure of optimal configurations ‣ 2 Original formulation and theoretical results ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> gives type I. Otherwise, after a rotation, <math id="S2.SS2.p15.m3" class="ltx_Math" alttext="C,D\in P" display="inline" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo>,</mo><mi>D</mi></mrow><mo>∈</mo><mi>P</mi></mrow><annotation encoding="application/x-tex">C,D\in P</annotation></semantics></math>, and Lemma <a href="#Thmlemma3" title="Lemma 3 (Shear normalization). ‣ 2.2 Boundary structure of optimal configurations ‣ 2 Original formulation and theoretical results ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> yields an optimal configuration containing <math id="S2.SS2.p15.m4" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math>, <math id="S2.SS2.p15.m5" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math>, a point <math id="S2.SS2.p15.m6" class="ltx_Math" alttext="(0,\lambda)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0,\lambda)</annotation></semantics></math> with <math id="S2.SS2.p15.m7" class="ltx_Math" alttext="\lambda&lt;1" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\lambda&lt;1</annotation></semantics></math>, and a point <math id="S2.SS2.p15.m8" class="ltx_Math" alttext="(b,0)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>b</mi><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(b,0)</annotation></semantics></math>. If these two points differ, the configuration has type II. If they coincide, the point is <math id="S2.SS2.p15.m9" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>, and the configuration has type III.
∎</span></p>
</div>
</div>
<div id="S2.SS2.p16" class="ltx_para">
<p id="S2.SS2.p16.1" class="ltx_p">In each type, the prescribed boundary points determine the orientation of many triangles, which allows the corresponding sign variables to be fixed (Sections <a href="#S3.SS2.SSS3" title="3.2.3 Sign fixing ‣ 3.2 Enhancements ‣ 3 Mixed-integer nonlinear optimization models ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2.3</span></a> and <a href="#S3.SS4" title="3.4 Variants for the types II and III ‣ 3 Mixed-integer nonlinear optimization models ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.4</span></a>).
Consequently, <math id="S2.SS2.p16.m1" class="ltx_Math" alttext="\Delta_{n}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\Delta_{n}</annotation></semantics></math> is the largest of the optimal values of three restricted problems, one for each type.
The model of Section <a href="#S3" title="3 Mixed-integer nonlinear optimization models ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> covers type I. Types II and III are covered by two variants with different fixings, which we solve separately (Section <a href="#S4" title="4 Computational study ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>).
A configuration can have several types. For example, the optimal configuration for <math id="S2.SS2.p16.m2" class="ltx_Math" alttext="n=7" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>7</mn></mrow><annotation encoding="application/x-tex">n=7</annotation></semantics></math> in Table <a href="#S5.T6" title="Table 6 ‣ Step 1: Numerical global optimization ‣ 5.2 Illustration of the methodology for 𝑛=7 ‣ 5 The optimize-then-refine framework ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a> has the boundary pattern, so it has type I, and it contains <math id="S2.SS2.p16.m3" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math>, <math id="S2.SS2.p16.m4" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math>, <math id="S2.SS2.p16.m5" class="ltx_Math" alttext="(0,y_{1})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msub><mi>y</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0,y_{1})</annotation></semantics></math>, and <math id="S2.SS2.p16.m6" class="ltx_Math" alttext="(x_{2},0)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>2</mn></msub><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(x_{2},0)</annotation></semantics></math>, so it also has type II.</p>
</div>
</section>
</section>
<section id="S3" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">3 </span>Mixed-integer nonlinear optimization models</h2>

<div id="S3.p1" class="ltx_para">
<p id="S3.p1.1" class="ltx_p">In Section <a href="#S3.SS1" title="3.1 A first MINLP formulation ‣ 3 Mixed-integer nonlinear optimization models ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a> we present a baseline MINLP formulation that is an exact reformulation of the nonsmooth problem <math id="S3.p1.m1" class="ltx_Math" alttext="P_{\Delta}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi mathvariant="normal">Δ</mi></msub><annotation encoding="application/x-tex">P_{\Delta}</annotation></semantics></math> without any additional structure. It solves small instances to global optimality within solver tolerances but does not solve <math id="S3.p1.m2" class="ltx_Math" alttext="n=7" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>7</mn></mrow><annotation encoding="application/x-tex">n=7</annotation></semantics></math> within one hour.
Section <a href="#S3.SS2" title="3.2 Enhancements ‣ 3 Mixed-integer nonlinear optimization models ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a> then develops several enhancements, in particular a symmetry-breaking strategy based on the boundary structure of Section <a href="#S2.SS2" title="2.2 Boundary structure of optimal configurations ‣ 2 Original formulation and theoretical results ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.2</span></a> that, as a byproduct, also fixes the signs of certain triangle areas.
The resulting final model is collected in Section <a href="#S3.SS3" title="3.3 The final model ‣ 3 Mixed-integer nonlinear optimization models ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.3</span></a>. Section <a href="#S3.SS4" title="3.4 Variants for the types II and III ‣ 3 Mixed-integer nonlinear optimization models ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.4</span></a> describes the variants for the configuration types II and III of Theorem <a href="#Thmtheorem1" title="Theorem 1 (Structure of optimal configurations). ‣ 2.2 Boundary structure of optimal configurations ‣ 2 Original formulation and theoretical results ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, and Section <a href="#S3.SS5" title="3.5 Comparison with Monji, Modir, and Kocuk ‣ 3 Mixed-integer nonlinear optimization models ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.5</span></a> compares our formulation with that of Monji, Modir, and Kocuk <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx33" title="" class="ltx_ref">33</a>]</cite>.</p>
</div>
<section id="S3.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.1 </span>A first MINLP formulation</h3>

<div id="S3.SS1.p1" class="ltx_para">
<p id="S3.SS1.p1.1" class="ltx_p">For each triangle <math id="S3.SS1.p1.m1" class="ltx_Math" alttext="t=(i,j,k)\in T" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">t=(i,j,k)\in T</annotation></semantics></math> we introduce a continuous auxiliary variable
<math id="S3.SS1.p1.m2" class="ltx_Math" alttext="A_{t}^{\pm}\in[-\tfrac{1}{2},\tfrac{1}{2}]" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>A</mi><mi>t</mi><mo>±</mo></msubsup><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow><mo>,</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">A_{t}^{\pm}\in[-\tfrac{1}{2},\tfrac{1}{2}]</annotation></semantics></math> representing the signed area</p>
<table id="S3.Ex15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex15.m1" class="ltx_Math" alttext="A_{t}^{\pm}=\frac{1}{2}\left(x_{i}y_{j}+x_{j}y_{k}+x_{k}y_{i}-x_{i}y_{k}-x_{j}y_{i}-x_{k}y_{j}\right)." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>A</mi><mi>t</mi><mo>±</mo></msubsup><mo>=</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><msub><mi>x</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>j</mi></msub></mrow><mo>+</mo><mrow><msub><mi>x</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>k</mi></msub></mrow><mo>+</mo><mrow><msub><mi>x</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>i</mi></msub></mrow></mrow><mo>−</mo><mrow><msub><mi>x</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>k</mi></msub></mrow><mo>−</mo><mrow><msub><mi>x</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>i</mi></msub></mrow><mo>−</mo><mrow><msub><mi>x</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>j</mi></msub></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">A_{t}^{\pm}=\frac{1}{2}\left(x_{i}y_{j}+x_{j}y_{k}+x_{k}y_{i}-x_{i}y_{k}-x_{j}y_{i}-x_{k}y_{j}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p1.2" class="ltx_p">To eliminate the minimum over triangles in the objective, we introduce an auxiliary variable
<math id="S3.SS1.p1.m3" class="ltx_Math" alttext="z" display="inline" intent=":literal"><semantics><mi>z</mi><annotation encoding="application/x-tex">z</annotation></semantics></math> and impose</p>
<table id="S3.Ex16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex16.m1" class="ltx_Math" alttext="z\leq|A_{t}^{\pm}|,\qquad t\in T." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>z</mi><mo>≤</mo><mrow><mo stretchy="false">|</mo><msubsup><mi>A</mi><mi>t</mi><mo>±</mo></msubsup><mo stretchy="false">|</mo></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mi>t</mi><mo>∈</mo><mi>T</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">z\leq|A_{t}^{\pm}|,\qquad t\in T.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p1.3" class="ltx_p">This formulation remains nonsmooth because of the absolute value.
To handle it, we introduce a binary variable <math id="S3.SS1.p1.m4" class="ltx_Math" alttext="b_{t}\in\{0,1\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>b</mi><mi>t</mi></msub><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">b_{t}\in\{0,1\}</annotation></semantics></math> for each triangle <math id="S3.SS1.p1.m5" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>
that selects the sign of <math id="S3.SS1.p1.m6" class="ltx_Math" alttext="A_{t}^{\pm}" display="inline" intent=":literal"><semantics><msubsup><mi>A</mi><mi>t</mi><mo>±</mo></msubsup><annotation encoding="application/x-tex">A_{t}^{\pm}</annotation></semantics></math>,
and replace the absolute-value constraint by</p>
<table id="S3.Ex17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex17.m1" class="ltx_Math" alttext="z\leq(2b_{t}-1)\,A_{t}^{\pm},\qquad t\in T." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>z</mi><mo>≤</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>t</mi></msub></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mi>A</mi><mi>t</mi><mo>±</mo></msubsup></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mi>t</mi><mo>∈</mo><mi>T</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">z\leq(2b_{t}-1)\,A_{t}^{\pm},\qquad t\in T.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p1.4" class="ltx_p">Maximizing <math id="S3.SS1.p1.m7" class="ltx_Math" alttext="z" display="inline" intent=":literal"><semantics><mi>z</mi><annotation encoding="application/x-tex">z</annotation></semantics></math> forces the model to choose the sign that yields the larger of <math id="S3.SS1.p1.m8" class="ltx_Math" alttext="-A_{t}^{\pm}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><msubsup><mi>A</mi><mi>t</mi><mo>±</mo></msubsup></mrow><annotation encoding="application/x-tex">-A_{t}^{\pm}</annotation></semantics></math> and <math id="S3.SS1.p1.m9" class="ltx_Math" alttext="A_{t}^{\pm}" display="inline" intent=":literal"><semantics><msubsup><mi>A</mi><mi>t</mi><mo>±</mo></msubsup><annotation encoding="application/x-tex">A_{t}^{\pm}</annotation></semantics></math>, which gives the absolute value
<math id="S3.SS1.p1.m10" class="ltx_Math" alttext="|A_{t}^{\pm}|=\max(A_{t}^{\pm},-A_{t}^{\pm})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msubsup><mi>A</mi><mi>t</mi><mo>±</mo></msubsup><mo stretchy="false">|</mo></mrow><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>A</mi><mi>t</mi><mo>±</mo></msubsup><mo>,</mo><mrow><mo>−</mo><msubsup><mi>A</mi><mi>t</mi><mo>±</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">|A_{t}^{\pm}|=\max(A_{t}^{\pm},-A_{t}^{\pm})</annotation></semantics></math>. For fixed coordinates, the optimal choice of the <math id="S3.SS1.p1.m11" class="ltx_Math" alttext="b_{t}" display="inline" intent=":literal"><semantics><msub><mi>b</mi><mi>t</mi></msub><annotation encoding="application/x-tex">b_{t}</annotation></semantics></math> and of <math id="S3.SS1.p1.m12" class="ltx_Math" alttext="z" display="inline" intent=":literal"><semantics><mi>z</mi><annotation encoding="application/x-tex">z</annotation></semantics></math> therefore yields <math id="S3.SS1.p1.m13" class="ltx_Math" alttext="z=\min_{t\in T}|A_{t}^{\pm}|" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>=</mo><mrow><msub><mi>min</mi><mrow><mi>t</mi><mo>∈</mo><mi>T</mi></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">|</mo><msubsup><mi>A</mi><mi>t</mi><mo>±</mo></msubsup><mo stretchy="false">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">z=\min_{t\in T}|A_{t}^{\pm}|</annotation></semantics></math>, so the following model is equivalent to <math id="S3.SS1.p1.m14" class="ltx_Math" alttext="P_{\Delta}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi mathvariant="normal">Δ</mi></msub><annotation encoding="application/x-tex">P_{\Delta}</annotation></semantics></math>: both have the same optimal value and the same optimal coordinates.</p>
</div>
<div id="S3.SS1.p2" class="ltx_para">
<p id="S3.SS1.p2.1" class="ltx_p">Our first baseline model is therefore</p>
</div>
<div id="S3.SS1.p3" class="ltx_para">
<table id="S3.EGx1" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex18"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex18.m1" class="ltx_math_unparsed" alttext="\displaystyle P_{\Delta}^{0}:\qquad\max_{z,x,y}\quad" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><msub><mrow></mrow><mi mathvariant="normal">Δ</mi></msub><msup><mrow></mrow><mn>0</mn></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mi>max</mi><msub><mrow></mrow><mrow><mi>z</mi><mo>,</mo><mi>x</mi><mo>,</mo><mi>y</mi></mrow></msub><mspace style="width:1.167em;" width="1.167em"></mspace></mrow><annotation encoding="application/x-tex">\displaystyle P_{\Delta}^{0}:\qquad\max_{z,x,y}\quad</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex18.m2" class="ltx_Math" alttext="\displaystyle z" display="inline" intent=":literal"><semantics><mi>z</mi><annotation encoding="application/x-tex">\displaystyle z</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex19"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><span id="S3.Ex19.1.1" class="ltx_text ltx_markedasmath">s.t.</span></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex19.m2" class="ltx_Math" alttext="\displaystyle(x_{i},y_{i})\in[0,1]^{2},\quad i\in I," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup></mrow><mo rspace="1.167em">,</mo><mrow><mi>i</mi><mo>∈</mo><mi>I</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle(x_{i},y_{i})\in[0,1]^{2},\quad i\in I,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex20"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex20.m1" class="ltx_Math" alttext="\displaystyle A_{t}^{\pm}=\frac{1}{2}\left(x_{i}y_{j}+x_{j}y_{k}+x_{k}y_{i}-x_{i}y_{k}-x_{j}y_{i}-x_{k}y_{j}\right),\quad t\in T," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>A</mi><mi>t</mi><mo>±</mo></msubsup><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><msub><mi>x</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>j</mi></msub></mrow><mo>+</mo><mrow><msub><mi>x</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>k</mi></msub></mrow><mo>+</mo><mrow><msub><mi>x</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>i</mi></msub></mrow></mrow><mo>−</mo><mrow><msub><mi>x</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>k</mi></msub></mrow><mo>−</mo><mrow><msub><mi>x</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>i</mi></msub></mrow><mo>−</mo><mrow><msub><mi>x</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>j</mi></msub></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>t</mi><mo>∈</mo><mi>T</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle A_{t}^{\pm}=\frac{1}{2}\left(x_{i}y_{j}+x_{j}y_{k}+x_{k}y_{i}-x_{i}y_{k}-x_{j}y_{i}-x_{k}y_{j}\right),\quad t\in T,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex21"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex21.m1" class="ltx_Math" alttext="\displaystyle z\leq(2b_{t}-1)\,A_{t}^{\pm},\quad t\in T," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>z</mi><mo>≤</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>t</mi></msub></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mi>A</mi><mi>t</mi><mo>±</mo></msubsup></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>t</mi><mo>∈</mo><mi>T</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle z\leq(2b_{t}-1)\,A_{t}^{\pm},\quad t\in T,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex22.m1" class="ltx_Math" alttext="\displaystyle A_{t}^{\pm}\in\left[-\frac{1}{2},\frac{1}{2}\right]," display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>A</mi><mi>t</mi><mo>±</mo></msubsup><mo>∈</mo><mrow><mo>[</mo><mrow><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle></mrow><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle></mrow><mo>]</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle A_{t}^{\pm}\in\left[-\frac{1}{2},\frac{1}{2}\right],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex23"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex23.m1" class="ltx_Math" alttext="\displaystyle b_{t}\in\{0,1\},\quad t\in T," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>b</mi><mi>t</mi></msub><mo>∈</mo><mrow><mo stretchy="false">{</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">}</mo></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>t</mi><mo>∈</mo><mi>T</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle b_{t}\in\{0,1\},\quad t\in T,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex24.m1" class="ltx_Math" alttext="\displaystyle 0\leq z\leq\frac{1}{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mn>0</mn><mo>≤</mo><mi>z</mi><mo>≤</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle 0\leq z\leq\frac{1}{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S3.SS1.p4" class="ltx_para">
<p id="S3.SS1.p4.1" class="ltx_p">This formulation is an MINLP and can in principle be solved by any global MINLP solver.
In our experiments (Section <a href="#S4" title="4 Computational study ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>), it solves <math id="S3.SS1.p4.m1" class="ltx_Math" alttext="n=5" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">n=5</annotation></semantics></math> and <math id="S3.SS1.p4.m2" class="ltx_Math" alttext="n=6" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>6</mn></mrow><annotation encoding="application/x-tex">n=6</annotation></semantics></math> in 0.8 and 216 seconds but does not terminate within one hour for <math id="S3.SS1.p4.m3" class="ltx_Math" alttext="n=7" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>7</mn></mrow><annotation encoding="application/x-tex">n=7</annotation></semantics></math>, where the relative gap is still 78%.</p>
</div>
</section>
<section id="S3.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.2 </span>Enhancements</h3>

<div id="S3.SS2.p1" class="ltx_para">
<p id="S3.SS2.p1.1" class="ltx_p">We enhance the baseline model with three groups of improvements.</p>
</div>
<section id="S3.SS2.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">3.2.1 </span>Bounds and variable substitution</h4>

<div id="S3.SS2.SSS1.p1" class="ltx_para">
<p id="S3.SS2.SSS1.p1.1" class="ltx_p">Removing a point from an optimal configuration with <math id="S3.SS2.SSS1.p1.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> points does not decrease the minimum triangle area, so <math id="S3.SS2.SSS1.p1.m2" class="ltx_Math" alttext="\Delta_{n}\leq\Delta_{n-1}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mi>n</mi></msub><mo>≤</mo><msub><mi mathvariant="normal">Δ</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\Delta_{n}\leq\Delta_{n-1}</annotation></semantics></math>, and we add the constraint <math id="S3.SS2.SSS1.p1.m3" class="ltx_Math" alttext="z\leq\Delta_{n-1}" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>≤</mo><msub><mi mathvariant="normal">Δ</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">z\leq\Delta_{n-1}</annotation></semantics></math>.
For <math id="S3.SS2.SSS1.p1.m4" class="ltx_Math" alttext="n\leq 9" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≤</mo><mn>9</mn></mrow><annotation encoding="application/x-tex">n\leq 9</annotation></semantics></math> we use the proven values of <math id="S3.SS2.SSS1.p1.m5" class="ltx_Math" alttext="\Delta_{n-1}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\Delta_{n-1}</annotation></semantics></math>. For <math id="S3.SS2.SSS1.p1.m6" class="ltx_Math" alttext="n=10" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">n=10</annotation></semantics></math>, where no proof for <math id="S3.SS2.SSS1.p1.m7" class="ltx_Math" alttext="\Delta_{9}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mn>9</mn></msub><annotation encoding="application/x-tex">\Delta_{9}</annotation></semantics></math> is available, we use the dual bound <math id="S3.SS2.SSS1.p1.m8" class="ltx_Math" alttext="0.0548818" display="inline" intent=":literal"><semantics><mn>0.0548818</mn><annotation encoding="application/x-tex">0.0548818</annotation></semantics></math> computed for <math id="S3.SS2.SSS1.p1.m9" class="ltx_Math" alttext="n=9" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>9</mn></mrow><annotation encoding="application/x-tex">n=9</annotation></semantics></math> (Section <a href="#S4.SS2" title="4.2 Main results ‣ 4 Computational study ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a>, rounded up). The cap only removes configurations whose minimum area exceeds this bound, but our result for <math id="S3.SS2.SSS1.p1.m10" class="ltx_Math" alttext="n=10" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">n=10</annotation></semantics></math> therefore also rests on the numerical result for <math id="S3.SS2.SSS1.p1.m11" class="ltx_Math" alttext="n=9" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>9</mn></mrow><annotation encoding="application/x-tex">n=9</annotation></semantics></math>.</p>
</div>
<div id="S3.SS2.SSS1.p2" class="ltx_para">
<p id="S3.SS2.SSS1.p2.1" class="ltx_p">Additionally, we introduce auxiliary variables <math id="S3.SS2.SSS1.p2.m1" class="ltx_Math" alttext="w_{ij}\in[0,1]" display="inline" intent=":literal"><semantics><mrow><msub><mi>w</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">w_{ij}\in[0,1]</annotation></semantics></math> with <math id="S3.SS2.SSS1.p2.m2" class="ltx_Math" alttext="w_{ij}=x_{i}y_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>w</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>=</mo><mrow><msub><mi>x</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>j</mi></msub></mrow></mrow><annotation encoding="application/x-tex">w_{ij}=x_{i}y_{j}</annotation></semantics></math> for all <math id="S3.SS2.SSS1.p2.m3" class="ltx_Math" alttext="i,j\in I" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>∈</mo><mi>I</mi></mrow><annotation encoding="application/x-tex">i,j\in I</annotation></semantics></math>. The signed areas then become linear in <math id="S3.SS2.SSS1.p2.m4" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math>,</p>
<table id="S3.Ex25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex25.m1" class="ltx_Math" alttext="A^{\pm}_{ijk}=\tfrac{1}{2}\left(w_{ij}+w_{jk}+w_{ki}-w_{ik}-w_{ji}-w_{kj}\right)," display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>A</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>±</mo></msubsup><mo>=</mo><mrow><mstyle displaystyle="false"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>w</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>+</mo><msub><mi>w</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo>+</mo><msub><mi>w</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub></mrow><mo>−</mo><msub><mi>w</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo>−</mo><msub><mi>w</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo>−</mo><msub><mi>w</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">A^{\pm}_{ijk}=\tfrac{1}{2}\left(w_{ij}+w_{jk}+w_{ki}-w_{ik}-w_{ji}-w_{kj}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.SSS1.p2.2" class="ltx_p">and all nonconvexity of the area definitions is concentrated in the <math id="S3.SS2.SSS1.p2.m5" class="ltx_Math" alttext="n^{2}" display="inline" intent=":literal"><semantics><msup><mi>n</mi><mn>2</mn></msup><annotation encoding="application/x-tex">n^{2}</annotation></semantics></math> bilinear equations <math id="S3.SS2.SSS1.p2.m6" class="ltx_Math" alttext="w_{ij}=x_{i}y_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>w</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>=</mo><mrow><msub><mi>x</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>j</mi></msub></mrow></mrow><annotation encoding="application/x-tex">w_{ij}=x_{i}y_{j}</annotation></semantics></math>.
Global solvers handle such equations by spatial branch-and-bound <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx4" title="" class="ltx_ref">4</a>, <a href="#bib.bibx8" title="" class="ltx_ref">8</a>]</cite>. For two bounded variables, the McCormick inequalities <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx32" title="" class="ltx_ref">32</a>]</cite> describe the convex hull of the graph of the bilinear term over the box. They are a relaxation of <math id="S3.SS2.SSS1.p2.m7" class="ltx_Math" alttext="w_{ij}=x_{i}y_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>w</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>=</mo><mrow><msub><mi>x</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>j</mi></msub></mrow></mrow><annotation encoding="application/x-tex">w_{ij}=x_{i}y_{j}</annotation></semantics></math>, not an exact linearization, and spatial branching tightens them.
Since each product occurs in the <math id="S3.SS2.SSS1.p2.m8" class="ltx_Math" alttext="n-2" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">n-2</annotation></semantics></math> triangles containing both <math id="S3.SS2.SSS1.p2.m9" class="ltx_Math" alttext="p_{i}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>i</mi></msub><annotation encoding="application/x-tex">p_{i}</annotation></semantics></math> and <math id="S3.SS2.SSS1.p2.m10" class="ltx_Math" alttext="p_{j}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>j</mi></msub><annotation encoding="application/x-tex">p_{j}</annotation></semantics></math>, tightening the relaxation of one <math id="S3.SS2.SSS1.p2.m11" class="ltx_Math" alttext="w_{ij}" display="inline" intent=":literal"><semantics><msub><mi>w</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">w_{ij}</annotation></semantics></math> strengthens all of them at once.
Monji, Modir, and Kocuk <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx33" title="" class="ltx_ref">33</a>]</cite> use the same substitution, so it does not explain the difference between the two formulations. In the ablation of Section <a href="#S4.SS4" title="4.4 Contribution of the model ingredients ‣ 4 Computational study ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.4</span></a> its effect turns out to be negligible, presumably because Gurobi introduces such auxiliary variables itself.</p>
</div>
</section>
<section id="S3.SS2.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">3.2.2 </span>Symmetry breaking</h4>

<div id="S3.SS2.SSS2.p1" class="ltx_para">
<p id="S3.SS2.SSS2.p1.1" class="ltx_p">The primary obstacle is the enormous symmetry: the dihedral group <math id="S3.SS2.SSS2.p1.m1" class="ltx_Math" alttext="D_{4}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mn>4</mn></msub><annotation encoding="application/x-tex">D_{4}</annotation></semantics></math> acts on coordinates (8 symmetries: 4 rotations, 4 reflections) and the symmetric group <math id="S3.SS2.SSS2.p1.m2" class="ltx_Math" alttext="S_{n}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>n</mi></msub><annotation encoding="application/x-tex">S_{n}</annotation></semantics></math> permutes point labels, yielding a combined symmetry group of order <math id="S3.SS2.SSS2.p1.m3" class="ltx_Math" alttext="8\cdot n!" display="inline" intent=":literal"><semantics><mrow><mn>8</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>n</mi><mo>!</mo></mrow></mrow><annotation encoding="application/x-tex">8\cdot n!</annotation></semantics></math>. For <math id="S3.SS2.SSS2.p1.m4" class="ltx_Math" alttext="n=9" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>9</mn></mrow><annotation encoding="application/x-tex">n=9</annotation></semantics></math>, this is about 2.9 million equivalent copies of every configuration.
By Theorem <a href="#Thmtheorem1" title="Theorem 1 (Structure of optimal configurations). ‣ 2.2 Boundary structure of optimal configurations ‣ 2 Original formulation and theoretical results ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, some optimal configuration has type I, II, or III. The model of this section covers type I and requires the boundary pattern of Definition <a href="#Thmdefinition1" title="Definition 1 (Boundary pattern). ‣ 2.2 Boundary structure of optimal configurations ‣ 2 Original formulation and theoretical results ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>. This amounts to three steps.</p>
</div>
<section id="S3.SS2.SSS2.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Step 1: Choice of the left edge.</h5>

<div id="S3.SS2.SSS2.Px1.p1" class="ltx_para">
<p id="S3.SS2.SSS2.Px1.p1.1" class="ltx_p">An edge carrying two boundary points is designated as the left edge, and the constraint <math id="S3.SS2.SSS2.Px1.p1.m1" class="ltx_Math" alttext="x_{2}\leq x_{4}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>2</mn></msub><mo>≤</mo><msub><mi>x</mi><mn>4</mn></msub></mrow><annotation encoding="application/x-tex">x_{2}\leq x_{4}</annotation></semantics></math> selects one of the two configurations related by the reflection <math id="S3.SS2.SSS2.Px1.p1.m2" class="ltx_Math" alttext="(x,y)\mapsto(x,1-y)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">↦</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mrow><mn>1</mn><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(x,y)\mapsto(x,1-y)</annotation></semantics></math>.</p>
</div>
</section>
<section id="S3.SS2.SSS2.Px2" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Step 2: Canonical boundary labeling.</h5>

<div id="S3.SS2.SSS2.Px2.p1" class="ltx_para">
<p id="S3.SS2.SSS2.Px2.p1.1" class="ltx_p">The five boundary points <math id="S3.SS2.SSS2.Px2.p1.m1" class="ltx_Math" alttext="p_{1},\ldots,p_{5}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>p</mi><mn>5</mn></msub></mrow><annotation encoding="application/x-tex">p_{1},\ldots,p_{5}</annotation></semantics></math> are labeled counterclockwise starting from the left edge: <math id="S3.SS2.SSS2.Px2.p1.m2" class="ltx_Math" alttext="p_{1}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mn>1</mn></msub><annotation encoding="application/x-tex">p_{1}</annotation></semantics></math> (left, lower), <math id="S3.SS2.SSS2.Px2.p1.m3" class="ltx_Math" alttext="p_{2}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mn>2</mn></msub><annotation encoding="application/x-tex">p_{2}</annotation></semantics></math> (bottom), <math id="S3.SS2.SSS2.Px2.p1.m4" class="ltx_Math" alttext="p_{3}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mn>3</mn></msub><annotation encoding="application/x-tex">p_{3}</annotation></semantics></math> (right), <math id="S3.SS2.SSS2.Px2.p1.m5" class="ltx_Math" alttext="p_{4}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mn>4</mn></msub><annotation encoding="application/x-tex">p_{4}</annotation></semantics></math> (top), <math id="S3.SS2.SSS2.Px2.p1.m6" class="ltx_Math" alttext="p_{5}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mn>5</mn></msub><annotation encoding="application/x-tex">p_{5}</annotation></semantics></math> (left, upper). The constraint <math id="S3.SS2.SSS2.Px2.p1.m7" class="ltx_Math" alttext="y_{5}\geq y_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mn>5</mn></msub><mo>≥</mo><msub><mi>y</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">y_{5}\geq y_{1}</annotation></semantics></math> fixes the order of the two points on the left edge.</p>
</div>
</section>
<section id="S3.SS2.SSS2.Px3" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Step 3: Interior point ordering.</h5>

<div id="S3.SS2.SSS2.Px3.p1" class="ltx_para">
<p id="S3.SS2.SSS2.Px3.p1.1" class="ltx_p">The remaining points <math id="S3.SS2.SSS2.Px3.p1.m1" class="ltx_Math" alttext="p_{6},\ldots,p_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mn>6</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>p</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">p_{6},\ldots,p_{n}</annotation></semantics></math> are ordered by nondecreasing <math id="S3.SS2.SSS2.Px3.p1.m2" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>-coordinate.</p>
</div>
<div id="S3.SS2.SSS2.Px3.p2" class="ltx_para">
<p id="S3.SS2.SSS2.Px3.p2.1" class="ltx_p">These steps fix five coordinate variables outright and remove most, but not all, of the symmetry.
If several edges carry two boundary points, or if the configuration contains a corner of <math id="S3.SS2.SSS2.Px3.p2.m1" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>, several rotated or reflected copies remain feasible. Points with equal <math id="S3.SS2.SSS2.Px3.p2.m2" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>-coordinates can still be interchanged in Step 3.
Figure <a href="#S3.F3" title="Figure 3 ‣ Step 3: Interior point ordering. ‣ 3.2.2 Symmetry breaking ‣ 3.2 Enhancements ‣ 3 Mixed-integer nonlinear optimization models ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> illustrates the resulting configuration structure, and Table <a href="#S3.T1" title="Table 1 ‣ Step 3: Interior point ordering. ‣ 3.2.2 Symmetry breaking ‣ 3.2 Enhancements ‣ 3 Mixed-integer nonlinear optimization models ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> reports how many copies of each best-known configuration remain feasible.</p>
</div>
