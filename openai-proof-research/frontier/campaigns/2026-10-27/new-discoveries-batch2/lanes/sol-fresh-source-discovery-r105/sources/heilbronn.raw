<td id="S4.T2.2.3.2" class="ltx_td ltx_align_right"><span id="S4.T2.2.3.2.1" class="ltx_text" style="font-size:90%;">0.2</span></td>
<td id="S4.T2.2.3.3" class="ltx_td ltx_align_right"><span id="S4.T2.2.3.3.1" class="ltx_text" style="font-size:90%;">0.2–0.7</span></td>
