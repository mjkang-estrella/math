<td id="S5.T7.2.3.1" class="ltx_td ltx_align_center"><math id="S5.T7.m6" class="ltx_Math" alttext="p_{2}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mn>2</mn></msub><annotation encoding="application/x-tex">p_{2}</annotation></semantics></math></td>
