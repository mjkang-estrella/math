<td id="S4.T3.2.7.2" class="ltx_td ltx_align_right ltx_border_bb"><span id="S4.T3.2.7.2.1" class="ltx_text" style="font-size:90%;">0.0418335</span></td>
<td id="S4.T3.2.7.3" class="ltx_td ltx_align_right ltx_border_bb"><span id="S4.T3.2.7.3.1" class="ltx_text" style="font-size:90%;">5,463</span></td>
