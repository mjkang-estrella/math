isible" transform="matrix(1 0 0 -1 0 8.92)" width="19.99"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S1.F1.pic1.m16" class="ltx_Math" alttext="0.2" display="inline" intent=":literal"><semantics><mn>0.2</mn><annotation encoding="application/x-tex">0.2</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -24.88 58.21)"><foreignObject style="--ltx-fo-width:1.44em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="19.99"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S1.F1.pic1.m17" class="ltx_Math" alttext="0.3" display="inline" intent=":literal"><semantics><mn>0.3</mn><annotation encoding="application/x-tex">0.3</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -24.88 79.1)"><foreignObject style="--ltx-fo-width:1.44em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="19.99"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S1.F1.pic1.m18" class="ltx_Math" alttext="0.4" display="inline" intent=":literal"><semantics><mn>0.4</mn><annotation encoding="application/x-tex">0.4</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -24.88 99.99)"><foreignObject style="--ltx-fo-width:1.44em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="19.99"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S1.F1.pic1.m19" class="ltx_Math" alttext="0.5" display="inline" intent=":literal"><semantics><mn>0.5</mn><annotation encoding="application/x-tex">0.5</annotation></semantics></math></span></span></foreignObject></g><clipPath id="pgfcp1"><path d="M 0 0 L 360.23 0 L 360.23 114.89 L 0 114.89 Z"></path></clipPath><g clip-path="url(#pgfcp1)"><g stroke-width="1.2pt"><path style="fill:none" d="M 5.38 104.45 L 32.26 104.45 L 59.14 40.2 L 86.03 26.11 L 112.91 17.51 L 139.79 15.12 L 166.68 11.46 L 193.56 9.71 L 220.44 7.74 L 247.32 6.79 L 274.21 5.64 L 301.09 5.08 L 327.97 4.43 L 354.86 4.29"></path></g><g></g><g stroke-width="0.4pt"><path style="fill:none" d="M 5.38 59.49 L 32.26 42.81 L 59.14 33.17 L 86.03 26.93 L 112.91 22.58 L 139.79 19.38 L 166.68 16.94 L 193.56 15.02 L 220.44 13.47 L 247.32 12.19 L 274.21 11.12 L 301.09 10.22 L 327.97 9.45 L 354.86 8.77"></path></g><g></g></g><g stroke-width="1.2pt"><path d="M 8.84 104.45 C 8.84 106.36 7.29 107.91 5.38 107.91 C 3.47 107.91 1.92 106.36 1.92 104.45 C 1.92 102.54 3.47 100.99 5.38 100.99 C 7.29 100.99 8.84 102.54 8.84 104.45 Z M 5.38 104.45"></path><path d="M 35.72 104.45 C 35.72 106.36 34.17 107.91 32.26 107.91 C 30.35 107.91 28.8 106.36 28.8 104.45 C 28.8 102.54 30.35 100.99 32.26 100.99 C 34.17 100.99 35.72 102.54 35.72 104.45 Z M 32.26 104.45"></path><path d="M 62.6 40.2 C 62.6 42.11 61.05 43.66 59.14 43.66 C 57.23 43.66 55.68 42.11 55.68 40.2 C 55.68 38.29 57.23 36.74 59.14 36.74 C 61.05 36.74 62.6 38.29 62.6 40.2 Z M 59.14 40.2"></path><path d="M 89.49 26.11 C 89.49 28.02 87.94 29.57 86.03 29.57 C 84.12 29.57 82.57 28.02 82.57 26.11 C 82.57 24.2 84.12 22.65 86.03 22.65 C 87.94 22.65 89.49 24.2 89.49 26.11 Z M 86.03 26.11"></path><path d="M 116.37 17.51 C 116.37 19.42 114.82 20.96 112.91 20.96 C 111 20.96 109.45 19.42 109.45 17.51 C 109.45 15.6 111 14.05 112.91 14.05 C 114.82 14.05 116.37 15.6 116.37 17.51 Z M 112.91 17.51"></path><path d="M 143.25 15.12 C 143.25 17.03 141.7 18.58 139.79 18.58 C 137.88 18.58 136.33 17.03 136.33 15.12 C 136.33 13.21 137.88 11.66 139.79 11.66 C 141.7 11.66 143.25 13.21 143.25 15.12 Z M 139.79 15.12"></path><path d="M 170.13 11.46 C 170.13 13.37 168.59 14.92 166.68 14.92 C 164.76 14.92 163.22 13.37 163.22 11.46 C 163.22 9.55 164.76 8 166.68 8 C 168.59 8 170.13 9.55 170.13 11.46 Z M 166.68 11.46"></path><path d="M 197.02 9.71 C 197.02 11.62 195.47 13.17 193.56 13.17 C 191.65 13.17 190.1 11.62 190.1 9.71 C 190.1 7.8 191.65 6.25 193.56 6.25 C 195.47 6.25 197.02 7.8 197.02 9.71 Z M 193.56 9.71"></path><path d="M 223.9 7.74 C 223.9 9.65 222.35 11.2 220.44 11.2 C 218.53 11.2 216.98 9.65 216.98 7.74 C 216.98 5.83 218.53 4.28 220.44 4.28 C 222.35 4.28 223.9 5.83 223.9 7.74 Z M 220.44 7.74"></path><path d="M 250.78 6.79 C 250.78 8.7 249.23 10.25 247.32 10.25 C 245.41 10.25 243.87 8.7 243.87 6.79 C 243.87 4.88 245.41 3.33 247.32 3.33 C 249.23 3.33 250.78 4.88 250.78 6.79 Z M 247.32 6.79"></path><path d="M 277.67 5.64 C 277.67 7.55 276.12 9.1 274.21 9.1 C 272.3 9.1 270.75 7.55 270.75 5.64 C 270.75 3.73 272.3 2.18 274.21 2.18 C 276.12 2.18 277.67 3.73 277.67 5.64 Z M 274.21 5.64"></path><path d="M 304.55 5.08 C 304.55 6.99 303 8.54 301.09 8.54 C 299.18 8.54 297.63 6.99 297.63 5.08 C 297.63 3.17 299.18 1.62 301.09 1.62 C 303 1.62 304.55 3.17 304.55 5.08 Z M 301.09 5.08"></path><path d="M 331.43 4.43 C 331.43 6.34 329.88 7.89 327.97 7.89 C 326.06 7.89 324.51 6.34 324.51 4.43 C 324.51 2.52 326.06 0.97 327.97 0.97 C 329.88 0.97 331.43 2.52 331.43 4.43 Z M 327.97 4.43"></path><path d="M 358.32 4.29 C 358.32 6.2 356.77 7.75 354.86 7.75 C 352.95 7.75 351.4 6.2 351.4 4.29 C 351.4 2.38 352.95 0.83 354.86 0.83 C 356.77 0.83 358.32 2.38 358.32 4.29 Z M 354.86 4.29"></path></g><path d="M 2.61 56.72 h 5.53 v 5.53 h -5.53 Z"></path><path d="M 29.49 40.04 h 5.53 v 5.53 h -5.53 Z"></path><path d="M 56.38 30.4 h 5.53 v 5.53 h -5.53 Z"></path><path d="M 83.26 24.16 h 5.53 v 5.53 h -5.53 Z"></path><path d="M 110.14 19.81 h 5.53 v 5.53 h -5.53 Z"></path><path d="M 137.02 16.61 h 5.53 v 5.53 h -5.53 Z"></path><path d="M 163.91 14.17 h 5.53 v 5.53 h -5.53 Z"></path><path d="M 190.79 12.25 h 5.53 v 5.53 h -5.53 Z"></path><path d="M 217.67 10.7 h 5.53 v 5.53 h -5.53 Z"></path><path d="M 244.56 9.42 h 5.53 v 5.53 h -5.53 Z"></path><path d="M 271.44 8.36 h 5.53 v 5.53 h -5.53 Z"></path><path d="M 298.32 7.45 h 5.53 v 5.53 h -5.53 Z"></path><path d="M 325.21 6.68 h 5.53 v 5.53 h -5.53 Z"></path><path d="M 352.09 6.01 h 5.53 v 5.53 h -5.53 Z"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 175.96 -29.26)"><foreignObject style="--ltx-fo-width:0.6em;--ltx-fo-height:0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="8.31"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S1.F1.pic1.m20" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.0 1.0 -1.0 0.0 -34.38 41.88)"><foreignObject style="--ltx-fo-width:2.31em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="31.9"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S1.F1.pic1.1" class="ltx_text">value</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 98.54 75.97)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 32.52)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 8.13)"><g style="--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke-width="1.2pt" transform="matrix(1 0 0 -1 0 0) translate(0.83,0)"><path style="fill:none" d="M 0 0 L 11.81 0 L 23.62 0"></path><path d="M 15.27 0 C 15.27 1.91 13.72 3.46 11.81 3.46 C 9.9 3.46 8.35 1.91 8.35 0 C 8.35 -1.91 9.9 -3.46 11.81 -3.46 C 13.72 -3.46 15.27 -1.91 15.27 0 Z M 11.81 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 76.67 0) translate(46.59,0) matrix(1.0 0.0 0.0 1.0 -43.82 -3.29)"><foreignObject style="--ltx-fo-width:5.46em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="69.94"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S1.F1.pic1.2" class="ltx_text" style="font-size:90%;">Best-known <math id="S1.F1.pic1.m21" class="ltx_Math" alttext="\Delta_{n}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\Delta_{n}</annotation></semantics></math></span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 24.39)"><g style="--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke-width="0.4pt" transform="matrix(1 0 0 -1 0.55 0) translate(0.28,0)"><path style="fill:none" d="M 0 0 L 11.81 0 L 23.62 0"></path><path d="M 9.04 -2.77 h 5.53 v 5.53 h -5.53 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 25.28 0) translate(97.98,0) matrix(1.0 0.0 0.0 1.0 -95.21 -3.29)"><foreignObject style="--ltx-fo-width:14.91em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="190.78"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S1.F1.pic1.3" class="ltx_text" style="font-size:90%;">Cohen–Pohoata–Zakharov bound</span></span></span></foreignObject></g></g></g></g></g></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 1: </span>Best-known values of <math id="S1.F1.m3" class="ltx_Math" alttext="\Delta_{n}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\Delta_{n}</annotation></semantics></math> for the Heilbronn problem in the unit square compared with the asymptotic upper bound <math id="S1.F1.m4" class="ltx_math_unparsed" alttext="n^{-8/7-1/2000}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>8</mn><mo>/</mo><mn>7</mn><mo>−</mo><mn>1</mn><mo>/</mo><mn>2000</mn></mrow></msup></mrow><annotation encoding="application/x-tex">n^{-8/7-1/2000}</annotation></semantics></math> of Cohen, Pohoata, and Zakharov <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx14" title="" class="ltx_ref">14</a>]</cite>.</figcaption>
</figure>
</section>
<section id="S1.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">1.3 </span>Lower bounds</h3>

<div id="S1.SS3.p1" class="ltx_para">
<p id="S1.SS3.p1.1" class="ltx_p">A simple lower bound of order <math id="S1.SS3.p1.m1" class="ltx_Math" alttext="c/n^{3}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>/</mo><msup><mi>n</mi><mn>3</mn></msup></mrow><annotation encoding="application/x-tex">c/n^{3}</annotation></semantics></math> for <math id="S1.SS3.p1.m2" class="ltx_Math" alttext="\Delta_{n}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\Delta_{n}</annotation></semantics></math> can be obtained as follows.
Without regard to the unit-square constraint, consider the <math id="S1.SS3.p1.m3" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> points <math id="S1.SS3.p1.m4" class="ltx_Math" alttext="(i,i^{2})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><msup><mi>i</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(i,i^{2})</annotation></semantics></math> for <math id="S1.SS3.p1.m5" class="ltx_Math" alttext="i=0,\ldots,n-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">i=0,\ldots,n-1</annotation></semantics></math>.
No three of these points are collinear, and hence every triangle determined by them has strictly positive area.
Moreover, each triangle area can be expressed as half the absolute value of a <math id="S1.SS3.p1.m6" class="ltx_Math" alttext="3\times 3" display="inline" intent=":literal"><semantics><mrow><mn>3</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">3\times 3</annotation></semantics></math> determinant formed from the vertices’ coordinates (see Section <a href="#S2.SS1" title="2.1 The original formulation and its solvability ‣ 2 Original formulation and theoretical results ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.1</span></a>).
Since all coordinates are integers and the area is positive, the determinant has absolute value at least <math id="S1.SS3.p1.m7" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>, implying that every triangle has area at least <math id="S1.SS3.p1.m8" class="ltx_Math" alttext="1/2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">1/2</annotation></semantics></math>.
To place the configuration inside the unit square, scale the <math id="S1.SS3.p1.m9" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>-coordinates by <math id="S1.SS3.p1.m10" class="ltx_Math" alttext="1/n" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">1/n</annotation></semantics></math> and the <math id="S1.SS3.p1.m11" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math>-coordinates by <math id="S1.SS3.p1.m12" class="ltx_Math" alttext="1/n^{2}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><msup><mi>n</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">1/n^{2}</annotation></semantics></math>.
Areas then scale by <math id="S1.SS3.p1.m13" class="ltx_Math" alttext="1/n^{3}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><msup><mi>n</mi><mn>3</mn></msup></mrow><annotation encoding="application/x-tex">1/n^{3}</annotation></semantics></math>, giving</p>
<table id="S1.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S1.Ex4.m1" class="ltx_Math" alttext="\Delta_{n}\geq\frac{1}{2n^{3}}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">Δ</mi><mi>n</mi></msub><mo>≥</mo><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>3</mn></msup></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Delta_{n}\geq\frac{1}{2n^{3}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S1.SS3.p1.2" class="ltx_p">As noted in the appendix of Roth’s paper <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx35" title="" class="ltx_ref">35</a>]</cite>, Paul Erdős refined this idea by choosing a prime <math id="S1.SS3.p1.m14" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> with <math id="S1.SS3.p1.m15" class="ltx_Math" alttext="n\leq p\leq 2n" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≤</mo><mi>p</mi><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><annotation encoding="application/x-tex">n\leq p\leq 2n</annotation></semantics></math> and considering the points <math id="S1.SS3.p1.m16" class="ltx_Math" alttext="(i,i^{2}\bmod p)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mrow><msup><mi>i</mi><mn>2</mn></msup><mo>mod</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(i,i^{2}\bmod p)</annotation></semantics></math> for <math id="S1.SS3.p1.m17" class="ltx_Math" alttext="i=0,\ldots,p-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">i=0,\ldots,p-1</annotation></semantics></math>.
This construction preserves the key properties used above, namely integral coordinates and the absence of collinear triples, while having the advantage that the <math id="S1.SS3.p1.m18" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math>-coordinates are bounded by <math id="S1.SS3.p1.m19" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>.
Consequently, scaling to the unit square reduces areas only by a factor of <math id="S1.SS3.p1.m20" class="ltx_Math" alttext="1/p^{2}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><msup><mi>p</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">1/p^{2}</annotation></semantics></math>, leading to</p>
<table id="S1.Ex5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S1.Ex5.m1" class="ltx_Math" alttext="\Delta_{n}\geq\frac{1}{2p^{2}}\geq\frac{1}{8n^{2}}" display="block" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mi>n</mi></msub><mo>≥</mo><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mn>2</mn></msup></mrow></mfrac><mo>≥</mo><mfrac><mn>1</mn><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>2</mn></msup></mrow></mfrac></mrow><annotation encoding="application/x-tex">\Delta_{n}\geq\frac{1}{2p^{2}}\geq\frac{1}{8n^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S1.SS3.p1.3" class="ltx_p">for all <math id="S1.SS3.p1.m21" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>.</p>
</div>
<div id="S1.SS3.p2" class="ltx_para">
<p id="S1.SS3.p2.1" class="ltx_p">Combined with Heilbronn’s conjecture, this would have yielded the correct asymptotic order of magnitude for the problem.
However, in 1982, following a suggestion by Roth that the conjecture might be false, Komlós, Pintz, and Szemerédi proved in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx26" title="" class="ltx_ref">26</a>]</cite> that there exists a constant <math id="S1.SS3.p2.m1" class="ltx_Math" alttext="c&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c&gt;0</annotation></semantics></math> such that</p>
<table id="S1.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S1.Ex6.m1" class="ltx_Math" alttext="\Delta_{n}\geq\frac{c\log n}{n^{2}}" display="block" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mi>n</mi></msub><mo>≥</mo><mfrac><mrow><mi>c</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mrow><msup><mi>n</mi><mn>2</mn></msup></mfrac></mrow><annotation encoding="application/x-tex">\Delta_{n}\geq\frac{c\log n}{n^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S1.SS3.p2.2" class="ltx_p">for infinitely many <math id="S1.SS3.p2.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>, using a nonconstructive probabilistic argument.
Since <math id="S1.SS3.p2.m3" class="ltx_Math" alttext="\log n" display="inline" intent=":literal"><semantics><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">\log n</annotation></semantics></math> is unbounded, this lower bound eventually exceeds <math id="S1.SS3.p2.m4" class="ltx_Math" alttext="C/n^{2}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>/</mo><msup><mi>n</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">C/n^{2}</annotation></semantics></math> for every constant <math id="S1.SS3.p2.m5" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math>, so the conjectured bound <math id="S1.SS3.p2.m6" class="ltx_Math" alttext="\Delta_{n}=O(1/n^{2})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mi>n</mi></msub><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><msup><mi>n</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Delta_{n}=O(1/n^{2})</annotation></semantics></math> cannot hold.</p>
</div>
<div id="S1.SS3.p3" class="ltx_para">
<p id="S1.SS3.p3.1" class="ltx_p">This gap between existence and construction was closed in 2000 by Bertram-Kretzberg, Hofmeister, and Lefmann <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx7" title="" class="ltx_ref">7</a>]</cite>, who presented a polynomial-time algorithm producing configurations with asymptotic lower bound <math id="S1.SS3.p3.m1" class="ltx_Math" alttext="\Omega(\log n/n^{2})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow><mo>/</mo><msup><mi>n</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Omega(\log n/n^{2})</annotation></semantics></math>.</p>
</div>
</section>
<section id="S1.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">1.4 </span>Results for small-<math id="S1.SS4.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>-configurations</h3>

<div id="S1.SS4.p1" class="ltx_para">
<p id="S1.SS4.p1.1" class="ltx_p">For many years, best-known configurations for the Heilbronn problem were documented on <em id="S1.SS4.p1.1.1" class="ltx_emph ltx_font_italic">Erich’s Packing Center</em>, a website maintained by Erich Friedman <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx21" title="" class="ltx_ref">21</a>]</cite>.
Since 2026, the records are maintained on the website of Tej Stead <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx40" title="" class="ltx_ref">40</a>]</cite>, which continues the tables of the Packing Center in a considerably more elaborate and automated form, reflecting the strong renewed interest in the problem.
For each record, the site lists exact coordinates, closed forms where known, critical triangles, history, and proofs, and all submitted configurations are verified automatically in exact arithmetic. We use it as the reference for best-known values.
The first case requiring a nontrivial proof, <math id="S1.SS4.p1.m1" class="ltx_Math" alttext="n=5" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">n=5</annotation></semantics></math>, was resolved in 1991 by Yang, Zhang, and Zeng <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx41" title="" class="ltx_ref">41</a>]</cite>, who proved
<math id="S1.SS4.p1.m2" class="ltx_Math" alttext="\Delta_{5}=\sqrt{3}/9" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mn>5</mn></msub><mo>=</mo><mrow><msqrt><mn>3</mn></msqrt><mo>/</mo><mn>9</mn></mrow></mrow><annotation encoding="application/x-tex">\Delta_{5}=\sqrt{3}/9</annotation></semantics></math>.
In the same work, they disproved a conjecture of Goldberg, who had suggested that optimal configurations for <math id="S1.SS4.p1.m3" class="ltx_Math" alttext="n\leq 7" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≤</mo><mn>7</mn></mrow><annotation encoding="application/x-tex">n\leq 7</annotation></semantics></math> arise from affine images of regular <math id="S1.SS4.p1.m4" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>-gons, a statement that turns out to hold only for <math id="S1.SS4.p1.m5" class="ltx_Math" alttext="n=6" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>6</mn></mrow><annotation encoding="application/x-tex">n=6</annotation></semantics></math>.
In 1995, Dress, Yang, and Zeng <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx19" title="" class="ltx_ref">19</a>]</cite> established the optimal value <math id="S1.SS4.p1.m6" class="ltx_Math" alttext="\Delta_{6}=1/8" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mn>6</mn></msub><mo>=</mo><mrow><mn>1</mn><mo>/</mo><mn>8</mn></mrow></mrow><annotation encoding="application/x-tex">\Delta_{6}=1/8</annotation></semantics></math>.</p>
</div>
<div id="S1.SS4.p2" class="ltx_para">
<p id="S1.SS4.p2.1" class="ltx_p">In 2002, Comellas and Yebra <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx15" title="" class="ltx_ref">15</a>]</cite> used simulated annealing followed by an analytical refinement procedure to discover best-known configurations and exact coordinates for many cases with <math id="S1.SS4.p2.m1" class="ltx_Math" alttext="n\leq 12" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≤</mo><mn>12</mn></mrow><annotation encoding="application/x-tex">n\leq 12</annotation></semantics></math>.
Their configurations for <math id="S1.SS4.p2.m2" class="ltx_Math" alttext="n=7" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>7</mn></mrow><annotation encoding="application/x-tex">n=7</annotation></semantics></math> and <math id="S1.SS4.p2.m3" class="ltx_Math" alttext="n=8" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>8</mn></mrow><annotation encoding="application/x-tex">n=8</annotation></semantics></math> have since been proved optimal, their configurations for <math id="S1.SS4.p2.m4" class="ltx_Math" alttext="n=9" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>9</mn></mrow><annotation encoding="application/x-tex">n=9</annotation></semantics></math> and <math id="S1.SS4.p2.m5" class="ltx_Math" alttext="n=10" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">n=10</annotation></semantics></math> are optimal according to all available numerical evidence, including the computations in this paper, and their configuration for <math id="S1.SS4.p2.m6" class="ltx_Math" alttext="n=12" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>12</mn></mrow><annotation encoding="application/x-tex">n=12</annotation></semantics></math> remains the best known to date.
The optimality of their configuration for <math id="S1.SS4.p2.m7" class="ltx_Math" alttext="n=7" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>7</mn></mrow><annotation encoding="application/x-tex">n=7</annotation></semantics></math>, with <math id="S1.SS4.p2.m8" class="ltx_Math" alttext="\Delta_{7}\approx 0.083859" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mn>7</mn></msub><mo>≈</mo><mn>0.083859</mn></mrow><annotation encoding="application/x-tex">\Delta_{7}\approx 0.083859</annotation></semantics></math>, was proved in 2011 by Zeng and Chen <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx42" title="" class="ltx_ref">42</a>]</cite>, who decomposed the problem into 226 nonlinear optimization subproblems.
For <math id="S1.SS4.p2.m9" class="ltx_Math" alttext="n=9" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>9</mn></mrow><annotation encoding="application/x-tex">n=9</annotation></semantics></math>, Chen, Xu, and Zeng <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx12" title="" class="ltx_ref">12</a>]</cite> used an extensive search on CPU and GPU clusters, requiring a total of 125 days of wall-clock time, to enclose <math id="S1.SS4.p2.m10" class="ltx_Math" alttext="\Delta_{9}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mn>9</mn></msub><annotation encoding="application/x-tex">\Delta_{9}</annotation></semantics></math> in a narrow numerical interval.
In 2022, Dehbi and Zeng <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx18" title="" class="ltx_ref">18</a>]</cite> combined numerical search with symbolic computation to prove that the configuration for <math id="S1.SS4.p2.m11" class="ltx_Math" alttext="n=8" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>8</mn></mrow><annotation encoding="application/x-tex">n=8</annotation></semantics></math> found by Comellas and Yebra, satisfying
<math id="S1.SS4.p2.m12" class="ltx_Math" alttext="\Delta_{8}=(\sqrt{13}-1)/36" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mn>8</mn></msub><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msqrt><mn>13</mn></msqrt><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mn>36</mn></mrow></mrow><annotation encoding="application/x-tex">\Delta_{8}=(\sqrt{13}-1)/36</annotation></semantics></math>,
is indeed optimal.</p>
</div>
<div id="S1.SS4.p3" class="ltx_para">
<p id="S1.SS4.p3.1" class="ltx_p">For <math id="S1.SS4.p3.m1" class="ltx_Math" alttext="13\leq n\leq 16" display="inline" intent=":literal"><semantics><mrow><mn>13</mn><mo>≤</mo><mi>n</mi><mo>≤</mo><mn>16</mn></mrow><annotation encoding="application/x-tex">13\leq n\leq 16</annotation></semantics></math>, the best-known configurations are due to Peter Karpov (<math id="S1.SS4.p3.m2" class="ltx_Math" alttext="n=13" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>13</mn></mrow><annotation encoding="application/x-tex">n=13</annotation></semantics></math>), Mark Beyleveld (<math id="S1.SS4.p3.m3" class="ltx_Math" alttext="n=14,16" display="inline" intent=":literal"><semantics><mrow><mrow><mi>n</mi><mo>=</mo><mn>14</mn></mrow><mo>,</mo><mn>16</mn></mrow><annotation encoding="application/x-tex">n=14,16</annotation></semantics></math>), and the author (<math id="S1.SS4.p3.m4" class="ltx_Math" alttext="n=15" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>15</mn></mrow><annotation encoding="application/x-tex">n=15</annotation></semantics></math>, found in 2026 with a heuristic search). None of them has been formally published. Karpov’s configuration is available on his website <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx24" title="" class="ltx_ref">24</a>]</cite>, Beyleveld’s only through Erich Friedman. We reproduce all of them in Appendix <a href="#A2" title="Appendix B Best-known configurations for 11≤𝑛≤16 ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B</span></a>.</p>
</div>
<div id="S1.SS4.p4" class="ltx_para">
<p id="S1.SS4.p4.1" class="ltx_p">More recently, Monji, Modir, and Kocuk <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx33" title="" class="ltx_ref">33</a>]</cite> applied general-purpose MINLP solvers to the problem and solved <math id="S1.SS4.p4.m1" class="ltx_Math" alttext="n=9" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>9</mn></mrow><annotation encoding="application/x-tex">n=9</annotation></semantics></math> with Gurobi to global optimality within solver tolerances.
Their final solve took 633 seconds and relies on structural properties of optimal configurations that they establish in precomputations of about 23 hours in total (Section <a href="#S4.SS6" title="4.6 Comparison of the total effort ‣ 4 Computational study ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.6</span></a>).</p>
</div>
<div id="S1.SS4.p5" class="ltx_para">
<p id="S1.SS4.p5.1" class="ltx_p">Deterministic global optimization has a long record on extremal problems in discrete geometry.
Global QCQP methods determined the largest small octagon <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">3</a>]</cite> and a series of related extremal polygons <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx2" title="" class="ltx_ref">2</a>]</cite>, and interval branch-and-bound has produced computer-assisted proofs for covering problems <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx9" title="" class="ltx_ref">9</a>]</cite>.
What has changed since then is efficiency, driven by hardware, solver implementations, relaxations, preprocessing and, not least, the mathematical formulation.
Recent systematic studies by Berthold et al. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx6" title="" class="ltx_ref">6</a>, <a href="#bib.bibx5" title="" class="ltx_ref">5</a>]</cite> show that off-the-shelf MINLP solvers can match or improve best-known solutions for a range of packing problems.
The present paper illustrates the role of formulation for the Heilbronn problem: Gurobi, which in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx33" title="" class="ltx_ref">33</a>]</cite> needed about 23 hours of precomputation for <math id="S1.SS4.p5.m1" class="ltx_Math" alttext="n=9" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>9</mn></mrow><annotation encoding="application/x-tex">n=9</annotation></semantics></math>, solves our formulation in about eight minutes, and <math id="S1.SS4.p5.m2" class="ltx_Math" alttext="n=10" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">n=10</annotation></semantics></math> in under seven hours, because the structural information enters through an analytical result rather than a computation.</p>
</div>
</section>
<section id="S1.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">1.5 </span>Related work on symmetry</h3>

<div id="S1.SS5.p1" class="ltx_para">
<p id="S1.SS5.p1.1" class="ltx_p">Problems of placing points in a region typically combine the Euclidean symmetries of the region with the permutation symmetry of the points, and exploiting both is standard in deterministic global optimization.
General techniques for symmetry in integer programming are surveyed by Margot <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx31" title="" class="ltx_ref">31</a>]</cite>, and the automatic detection and exploitation of symmetry in mathematical programs is studied by Liberti <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx29" title="" class="ltx_ref">29</a>]</cite>.
For packing equal circles in a square, Locatelli and Raber <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx30" title="" class="ltx_ref">30</a>]</cite> derive geometric properties of optimal configurations to fix coordinates and eliminate symmetric solutions, and Costa, Hansen, and Liberti <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx16" title="" class="ltx_ref">16</a>]</cite> study the effect of symmetry-breaking constraints on spatial branch-and-bound.
For Lennard-Jones clusters, coordinates are fixed relative to reference particles <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx23" title="" class="ltx_ref">23</a>, <a href="#bib.bibx27" title="" class="ltx_ref">27</a>]</cite>, and for the Thomson problem, branch-and-bound has been combined with analytical arguments and symmetry elimination <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx39" title="" class="ltx_ref">39</a>, <a href="#bib.bibx28" title="" class="ltx_ref">28</a>]</cite>.
Our symmetry breaking follows the same principle but derives the fixings from the boundary structure of optimal Heilbronn configurations (Proposition <a href="#Thmproposition2" title="Proposition 2 (Configurations without adjacent corners). ‣ 2.2 Boundary structure of optimal configurations ‣ 2 Original formulation and theoretical results ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>).
A feature specific to determinant-based formulations is that the fixed boundary order also determines the orientation of many triangles, which allows sign variables to be fixed a priori (Section <a href="#S3.SS2.SSS3" title="3.2.3 Sign fixing ‣ 3.2 Enhancements ‣ 3 Mixed-integer nonlinear optimization models ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2.3</span></a>).</p>
</div>
</section>
<section id="S1.SS6" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">1.6 </span>Contributions</h3>

<div id="S1.SS6.p1" class="ltx_para">
<p id="S1.SS6.p1.1" class="ltx_p">We make the following contributions.</p>
</div>
<section id="S1.SS6.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">A compact MINLP formulation with analytically justified structure.</h5>

<div id="S1.SS6.SSS0.Px1.p1" class="ltx_para">
<p id="S1.SS6.SSS0.Px1.p1.1" class="ltx_p">Our model fixes several coordinates a priori using the boundary structure of optimal configurations, which also fixes the signs of many triangle areas. It needs no precomputation and solves <math id="S1.SS6.SSS0.Px1.p1.m1" class="ltx_Math" alttext="n=9" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>9</mn></mrow><annotation encoding="application/x-tex">n=9</annotation></semantics></math> to global optimality within solver tolerances in about eight minutes on a laptop. It also solves <math id="S1.SS6.SSS0.Px1.p1.m2" class="ltx_Math" alttext="n=10" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">n=10</annotation></semantics></math>, for the first time, in under seven hours. An ablation study quantifies the contribution of each ingredient (Section <a href="#S4" title="4 Computational study ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>).</p>
</div>
</section>
<section id="S1.SS6.SSS0.Px2" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">A complete justification of the boundary structure.</h5>

<div id="S1.SS6.SSS0.Px2.p1" class="ltx_para">
<p id="S1.SS6.SSS0.Px2.p1.1" class="ltx_p">The argument previously used for the boundary structure relies on a lemma of Zeng and Chen <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx42" title="" class="ltx_ref">42</a>]</cite> that does not address two adjacent corners of the square. We give a self-contained proof without this case and reduce the remaining configurations, by an area-preserving shear, to two further types, which we solve with separate models.</p>
</div>
</section>
<section id="S1.SS6.SSS0.Px3" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Exact coordinates via an optimize-then-refine framework.</h5>

<div id="S1.SS6.SSS0.Px3.p1" class="ltx_para">
<p id="S1.SS6.SSS0.Px3.p1.1" class="ltx_p">The numerical solution identifies the critical triangles and the boundary points, which yields a polynomial system that we solve exactly. Every resulting configuration is verified in exact arithmetic over all <math id="S1.SS6.SSS0.Px3.p1.m1" class="ltx_Math" alttext="\binom{n}{3}" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mfrac linethickness="0pt"><mi>n</mi><mn>3</mn></mfrac><mo>)</mo></mrow><annotation encoding="application/x-tex">\binom{n}{3}</annotation></semantics></math> triangles. For each <math id="S1.SS6.SSS0.Px3.p1.m2" class="ltx_Math" alttext="n=5,\dots,10" display="inline" intent=":literal"><semantics><mrow><mrow><mi>n</mi><mo>=</mo><mn>5</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">n=5,\dots,10</annotation></semantics></math> we obtain exact coordinates of one configuration (for <math id="S1.SS6.SSS0.Px3.p1.m3" class="ltx_Math" alttext="n=6" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>6</mn></mrow><annotation encoding="application/x-tex">n=6</annotation></semantics></math>, of a one-parameter family), which is proven optimal for <math id="S1.SS6.SSS0.Px3.p1.m4" class="ltx_Math" alttext="n\leq 8" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≤</mo><mn>8</mn></mrow><annotation encoding="application/x-tex">n\leq 8</annotation></semantics></math> and optimal within solver tolerances for <math id="S1.SS6.SSS0.Px3.p1.m5" class="ltx_Math" alttext="n=9" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>9</mn></mrow><annotation encoding="application/x-tex">n=9</annotation></semantics></math> and <math id="S1.SS6.SSS0.Px3.p1.m6" class="ltx_Math" alttext="n=10" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">n=10</annotation></semantics></math>, matching those of Comellas and Yebra <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx15" title="" class="ltx_ref">15</a>]</cite>.</p>
</div>
</section>
<section id="S1.SS6.SSS0.Px4" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Structural observations.</h5>

<div id="S1.SS6.SSS0.Px4.p1" class="ltx_para">
<p id="S1.SS6.SSS0.Px4.p1.1" class="ltx_p">We determine for which optimal configurations the linear independence constraint qualification holds (<math id="S1.SS6.SSS0.Px4.p1.m1" class="ltx_Math" alttext="n=5,7,9" display="inline" intent=":literal"><semantics><mrow><mrow><mi>n</mi><mo>=</mo><mn>5</mn></mrow><mo>,</mo><mn>7</mn><mo>,</mo><mn>9</mn></mrow><annotation encoding="application/x-tex">n=5,7,9</annotation></semantics></math>) and fails (<math id="S1.SS6.SSS0.Px4.p1.m2" class="ltx_Math" alttext="n=6,8" display="inline" intent=":literal"><semantics><mrow><mrow><mi>n</mi><mo>=</mo><mn>6</mn></mrow><mo>,</mo><mn>8</mn></mrow><annotation encoding="application/x-tex">n=6,8</annotation></semantics></math>), conjecture a lower bound of <math id="S1.SS6.SSS0.Px4.p1.m3" class="ltx_Math" alttext="2n-7" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>7</mn></mrow><annotation encoding="application/x-tex">2n-7</annotation></semantics></math> on the number of critical triangles, and document a clustering of the noncritical triangle areas that symmetry alone does not explain. We also report an observation of Tej Stead (personal communication, 2026) on the cube structure of the configuration for <math id="S1.SS6.SSS0.Px4.p1.m4" class="ltx_Math" alttext="n=16" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>16</mn></mrow><annotation encoding="application/x-tex">n=16</annotation></semantics></math>.</p>
</div>
</section>
<section id="S1.SS6.SSS0.Px5" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Reproducibility and data.</h5>

<div id="S1.SS6.SSS0.Px5.p1" class="ltx_para">
<p id="S1.SS6.SSS0.Px5.p1.1" class="ltx_p">We collect the best-known configurations for <math id="S1.SS6.SSS0.Px5.p1.m1" class="ltx_Math" alttext="n\leq 16" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≤</mo><mn>16</mn></mrow><annotation encoding="application/x-tex">n\leq 16</annotation></semantics></math>, several of which were never formally published. The source code, data, solution files, and the scripts that generate all tables are available at <a href="https://github.com/spiralulam/heilbronn" title="" class="ltx_ref ltx_url ltx_font_typewriter">https://github.com/spiralulam/heilbronn</a>.</p>
</div>
</section>
<section id="S1.SS6.SSS0.Px6" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Mathematical status of the results.</h5>

<div id="S1.SS6.SSS0.Px6.p1" class="ltx_para">
<p id="S1.SS6.SSS0.Px6.p1.1" class="ltx_p">Since the solver works in floating-point arithmetic, we distinguish throughout between rigorous lower bounds (exactly verified configurations), numerical upper bounds (solver dual bounds), and proofs of optimality, which are available in the literature for <math id="S1.SS6.SSS0.Px6.p1.m1" class="ltx_Math" alttext="n\leq 8" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≤</mo><mn>8</mn></mrow><annotation encoding="application/x-tex">n\leq 8</annotation></semantics></math> but not for <math id="S1.SS6.SSS0.Px6.p1.m2" class="ltx_Math" alttext="n=9" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>9</mn></mrow><annotation encoding="application/x-tex">n=9</annotation></semantics></math> and <math id="S1.SS6.SSS0.Px6.p1.m3" class="ltx_Math" alttext="n=10" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">n=10</annotation></semantics></math> (Section <a href="#S5.SS1" title="5.1 The framework ‣ 5 The optimize-then-refine framework ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a>).</p>
</div>
</section>
</section>
<section id="S1.SS7" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">1.7 </span>Paper outline</h3>

<div id="S1.SS7.p1" class="ltx_para">
<p id="S1.SS7.p1.1" class="ltx_p">Section <a href="#S2" title="2 Original formulation and theoretical results ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> establishes a formal setting for the Heilbronn problem and derives the boundary structure of optimal configurations that is exploited in the optimization model.
Section <a href="#S3" title="3 Mixed-integer nonlinear optimization models ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> develops the MINLP formulation and its enhancements.
Section <a href="#S4" title="4 Computational study ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a> reports the computational study.
Section <a href="#S5" title="5 The optimize-then-refine framework ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a> presents the optimize-then-refine framework and illustrates it in detail for <math id="S1.SS7.p1.m1" class="ltx_Math" alttext="n=7" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>7</mn></mrow><annotation encoding="application/x-tex">n=7</annotation></semantics></math>.
Section <a href="#S6" title="6 Exact configurations for 5≤𝑛≤10 ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a> reports the exact configurations for <math id="S1.SS7.p1.m2" class="ltx_Math" alttext="n=5,\ldots,10" display="inline" intent=":literal"><semantics><mrow><mrow><mi>n</mi><mo>=</mo><mn>5</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">n=5,\ldots,10</annotation></semantics></math>.
Section <a href="#S7" title="7 Further observations and research questions ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a> discusses structural observations and open questions.
Section <a href="#S8" title="8 Outlook and final remarks ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a> concludes with an outlook.
Appendix <a href="#A1" title="Appendix A Exact coordinates for 5≤𝑛≤10 ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A</span></a> lists the exact coordinates for <math id="S1.SS7.p1.m3" class="ltx_Math" alttext="n=5,\ldots,10" display="inline" intent=":literal"><semantics><mrow><mrow><mi>n</mi><mo>=</mo><mn>5</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">n=5,\ldots,10</annotation></semantics></math>, and Appendix <a href="#A2" title="Appendix B Best-known configurations for 11≤𝑛≤16 ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B</span></a> collects the best-known configurations for <math id="S1.SS7.p1.m4" class="ltx_Math" alttext="n=11,\ldots,16" display="inline" intent=":literal"><semantics><mrow><mrow><mi>n</mi><mo>=</mo><mn>11</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>16</mn></mrow><annotation encoding="application/x-tex">n=11,\ldots,16</annotation></semantics></math>.</p>
</div>
</section>
</section>
<section id="S2" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">2 </span>Original formulation and theoretical results</h2>

<div id="S2.p1" class="ltx_para">
<p id="S2.p1.1" class="ltx_p">This section establishes a basic formulation of the Heilbronn problem in Section <a href="#S2.SS1" title="2.1 The original formulation and its solvability ‣ 2 Original formulation and theoretical results ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.1</span></a>, which already suffices to prove its solvability.
The results of Section <a href="#S2.SS2" title="2.2 Boundary structure of optimal configurations ‣ 2 Original formulation and theoretical results ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.2</span></a> on the boundary structure of optimal configurations are not only of theoretical interest but provide structure that is exploited in the optimization model of Section <a href="#S3" title="3 Mixed-integer nonlinear optimization models ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>.</p>
</div>
<section id="S2.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">2.1 </span>The original formulation and its solvability</h3>

<div id="S2.SS1.p1" class="ltx_para">
<p id="S2.SS1.p1.1" class="ltx_p">Let <math id="S2.SS1.p1.m1" class="ltx_Math" alttext="n\geq 3" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">n\geq 3</annotation></semantics></math> denote the number of points <math id="S2.SS1.p1.m2" class="ltx_Math" alttext="p_{1}=(x_{1},y_{1}),\ldots,p_{n}=(x_{n},y_{n})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>p</mi><mn>1</mn></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>y</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>p</mi><mi>n</mi></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>n</mi></msub><mo>,</mo><msub><mi>y</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">p_{1}=(x_{1},y_{1}),\ldots,p_{n}=(x_{n},y_{n})</annotation></semantics></math> we want to place in <math id="S2.SS1.p1.m3" class="ltx_Math" alttext="\R^{2}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mn>2</mn></msup><annotation encoding="application/x-tex">\R^{2}</annotation></semantics></math>, <math id="S2.SS1.p1.m4" class="ltx_Math" alttext="I=\{1,\ldots,n\}" display="inline" intent=":literal"><semantics><mrow><mi>I</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>n</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">I=\{1,\ldots,n\}</annotation></semantics></math>, and</p>
<table id="S2.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex7.m1" class="ltx_Math" alttext="T\ =\ \{(i,j,k)|\ 1\leq i&lt;j&lt;k\leq n\}\subset\N^{3}" display="block" intent=":literal"><semantics><mrow><mi>T</mi><mo lspace="0.778em" rspace="0.778em">=</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">|</mo><mrow><mn> 1</mn><mo>≤</mo><mi>i</mi><mo>&lt;</mo><mi>j</mi><mo>&lt;</mo><mi>k</mi><mo>≤</mo><mi>n</mi></mrow><mo stretchy="false">}</mo></mrow><mo>⊂</mo><msup><mi>ℕ</mi><mn>3</mn></msup></mrow><annotation encoding="application/x-tex">T\ =\ \{(i,j,k)|\ 1\leq i&lt;j&lt;k\leq n\}\subset\N^{3}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS1.p1.2" class="ltx_p">the set of all triangles, where each triangle <math id="S2.SS1.p1.m5" class="ltx_Math" alttext="t=(i,j,k)\in T" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">t=(i,j,k)\in T</annotation></semantics></math> is identified with the indices of the defining points <math id="S2.SS1.p1.m6" class="ltx_Math" alttext="p_{i}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>i</mi></msub><annotation encoding="application/x-tex">p_{i}</annotation></semantics></math>, <math id="S2.SS1.p1.m7" class="ltx_Math" alttext="p_{j}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>j</mi></msub><annotation encoding="application/x-tex">p_{j}</annotation></semantics></math> and <math id="S2.SS1.p1.m8" class="ltx_Math" alttext="p_{k}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>k</mi></msub><annotation encoding="application/x-tex">p_{k}</annotation></semantics></math>.
By construction, <math id="S2.SS1.p1.m9" class="ltx_Math" alttext="|T|=\binom{n}{3}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>T</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mrow><mo>(</mo><mfrac linethickness="0pt"><mi>n</mi><mn>3</mn></mfrac><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">|T|=\binom{n}{3}</annotation></semantics></math>.</p>
</div>
<div id="Thmremark1" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmremark1.2" class="ltx_text ltx_font_italic">Remark 1</span></span><span id="Thmremark1.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="Thmremark1.p1" class="ltx_para">
<p id="Thmremark1.p1.1" class="ltx_p">The enumeration of the points heavily influences the symmetry breaking and therefore
becomes a crucial modeling choice, as discussed in Section <a href="#S3.SS2.SSS2" title="3.2.2 Symmetry breaking ‣ 3.2 Enhancements ‣ 3 Mixed-integer nonlinear optimization models ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2.2</span></a>.</p>
</div>
</div>
<div id="S2.SS1.p2" class="ltx_para">
<p id="S2.SS1.p2.1" class="ltx_p">For a triangle <math id="S2.SS1.p2.m1" class="ltx_Math" alttext="t=(i,j,k)\in T" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">t=(i,j,k)\in T</annotation></semantics></math>, the <em id="S2.SS1.p2.1.1" class="ltx_emph ltx_font_italic">signed area</em></p>
<table id="S2.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex8.m1" class="ltx_Math" alttext="A^{\pm}_{t}=A^{\pm}_{ijk}:=\frac{1}{2}\det\!\begin{pmatrix}x_{i}&amp;y_{i}&amp;1\\
x_{j}&amp;y_{j}&amp;1\\
x_{k}&amp;y_{k}&amp;1\end{pmatrix}=\frac{1}{2}\left(x_{i}y_{j}+x_{j}y_{k}+x_{k}y_{i}-x_{i}y_{k}-x_{j}y_{i}-x_{k}y_{j}\right)" display="block" intent=":literal"><semantics><mrow><msubsup><mi>A</mi><mi>t</mi><mo>±</mo></msubsup><mo>=</mo><msubsup><mi>A</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>±</mo></msubsup><mo>:=</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mpadded style="width:1.177em;" width="1.177em"><mo movablelimits="false">det</mo></mpadded><mrow><mo>(</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><msub><mi>x</mi><mi>i</mi></msub></mtd><mtd><msub><mi>y</mi><mi>i</mi></msub></mtd><mtd><mn>1</mn></mtd></mtr><mtr><mtd><msub><mi>x</mi><mi>j</mi></msub></mtd><mtd><msub><mi>y</mi><mi>j</mi></msub></mtd><mtd><mn>1</mn></mtd></mtr><mtr><mtd><msub><mi>x</mi><mi>k</mi></msub></mtd><mtd><msub><mi>y</mi><mi>k</mi></msub></mtd><mtd><mn>1</mn></mtd></mtr></mtable><mo>)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><msub><mi>x</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>j</mi></msub></mrow><mo>+</mo><mrow><msub><mi>x</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>k</mi></msub></mrow><mo>+</mo><mrow><msub><mi>x</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>i</mi></msub></mrow></mrow><mo>−</mo><mrow><msub><mi>x</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>k</mi></msub></mrow><mo>−</mo><mrow><msub><mi>x</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>i</mi></msub></mrow><mo>−</mo><mrow><msub><mi>x</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>j</mi></msub></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">A^{\pm}_{t}=A^{\pm}_{ijk}:=\frac{1}{2}\det\!\begin{pmatrix}x_{i}&amp;y_{i}&amp;1\\
x_{j}&amp;y_{j}&amp;1\\
x_{k}&amp;y_{k}&amp;1\end{pmatrix}=\frac{1}{2}\left(x_{i}y_{j}+x_{j}y_{k}+x_{k}y_{i}-x_{i}y_{k}-x_{j}y_{i}-x_{k}y_{j}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS1.p2.2" class="ltx_p">is positive if <math id="S2.SS1.p2.m2" class="ltx_Math" alttext="p_{i},p_{j},p_{k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>i</mi></msub><mo>,</mo><msub><mi>p</mi><mi>j</mi></msub><mo>,</mo><msub><mi>p</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">p_{i},p_{j},p_{k}</annotation></semantics></math> are ordered counterclockwise, negative if they are ordered clockwise, and zero if they are collinear, and <math id="S2.SS1.p2.m3" class="ltx_Math" alttext="A_{t}:=|A^{\pm}_{t}|" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mi>t</mi></msub><mo>:=</mo><mrow><mo stretchy="false">|</mo><msubsup><mi>A</mi><mi>t</mi><mo>±</mo></msubsup><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">A_{t}:=|A^{\pm}_{t}|</annotation></semantics></math> is the area of the triangle.
The sign information plays a key role in the optimization model of Section <a href="#S3" title="3 Mixed-integer nonlinear optimization models ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>.
With <math id="S2.SS1.p2.m4" class="ltx_Math" alttext="S=[0,1]^{2}" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>=</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">S=[0,1]^{2}</annotation></semantics></math>, the Heilbronn problem is the optimization problem</p>
<table id="S2.Ex9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex9.m1" class="ltx_math_unparsed" alttext="P_{\Delta}:\qquad\max_{x,y}\ \min_{t\in T}A_{t}\quad\text{s.t. }(x_{i},y_{i})\in S,\ i\in I," display="block" intent=":literal"><semantics><mrow><msub><mi>P</mi><mi mathvariant="normal">Δ</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><munder><mi>max</mi><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow></munder><munder><mi>min</mi><mrow><mi>t</mi><mo>∈</mo><mi>T</mi></mrow></munder><msub><mi>A</mi><mi>t</mi></msub><mtext>s.t. </mtext><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi>S</mi><mo rspace="0.667em">,</mo><mi>i</mi><mo>∈</mo><mi>I</mi><mo>,</mo></mrow><annotation encoding="application/x-tex">P_{\Delta}:\qquad\max_{x,y}\ \min_{t\in T}A_{t}\quad\text{s.t. }(x_{i},y_{i})\in S,\ i\in I,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS1.p2.3" class="ltx_p">and <math id="S2.SS1.p2.m5" class="ltx_Math" alttext="\Delta_{n}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\Delta_{n}</annotation></semantics></math> is its optimal value.
All further specifications of this problem amount to modeling decisions, of which there are many and which must be made carefully.
As stated, <math id="S2.SS1.p2.m6" class="ltx_Math" alttext="P_{\Delta}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi mathvariant="normal">Δ</mi></msub><annotation encoding="application/x-tex">P_{\Delta}</annotation></semantics></math> is a nonsmooth, nonconvex optimization problem over a box, and it has the following properties.</p>
</div>
<div id="Thmproposition1" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmproposition1.2" class="ltx_text ltx_font_bold">Proposition 1</span></span><span id="Thmproposition1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmproposition1.p1" class="ltx_para">
<p id="Thmproposition1.p1.1" class="ltx_p"><span id="Thmproposition1.p1.1.1" class="ltx_text ltx_font_italic">The optimization problem <math id="Thmproposition1.p1.m1" class="ltx_Math" alttext="P_{\Delta}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi mathvariant="normal">Δ</mi></msub><annotation encoding="application/x-tex">P_{\Delta}</annotation></semantics></math> admits a solution for every <math id="Thmproposition1.p1.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>, and its optimal value <math id="Thmproposition1.p1.m3" class="ltx_Math" alttext="\Delta_{n}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\Delta_{n}</annotation></semantics></math> is strictly positive.</span></p>
</div>
</div>
<div id="S2.SS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S2.SS1.p3" class="ltx_para">
<p id="S2.SS1.p3.1" class="ltx_p"><span id="S2.SS1.p3.1.1" class="ltx_text">Existence of a solution follows from the Weierstraß theorem.
The objective function is continuous, and the feasible set is nonempty, closed, and bounded, hence compact.
Therefore, the maximum is attained. Strict positivity of <math id="S2.SS1.p3.m1" class="ltx_Math" alttext="\Delta_{n}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\Delta_{n}</annotation></semantics></math> follows, for example, from Erdős’ construction discussed in Section <a href="#S1.SS3" title="1.3 Lower bounds ‣ 1 Introduction ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.3</span></a>, which provides an explicit positive lower bound.
∎</span></p>
</div>
</div>
<div id="Thmremark2" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmremark2.2" class="ltx_text ltx_font_italic">Remark 2</span></span><span id="Thmremark2.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="Thmremark2.p1" class="ltx_para">
<p id="Thmremark2.p1.1" class="ltx_p">In <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx35" title="" class="ltx_ref">35</a>]</cite>, Roth argues that <math id="Thmremark2.p1.m1" class="ltx_Math" alttext="P_{\Delta}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi mathvariant="normal">Δ</mi></msub><annotation encoding="application/x-tex">P_{\Delta}</annotation></semantics></math> is solvable because its feasible set <span id="Thmremark2.p1.1.1" class="ltx_text ltx_inline-quote ltx_outerquote">“is a closed convex region”</span>.
However, closedness and convexity alone do not guarantee existence of a maximizer. Compactness (or an equivalent coercivity argument) is required.</p>
</div>
</div>
<div id="S2.SS1.p4" class="ltx_para">
<p id="S2.SS1.p4.1" class="ltx_p">The following corollaries are immediate consequences of Proposition <a href="#Thmproposition1" title="Proposition 1. ‣ 2.1 The original formulation and its solvability ‣ 2 Original formulation and theoretical results ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, since otherwise the configuration would contain a triangle of zero area.</p>
</div>
<div id="Thmcorollary1" class="ltx_theorem ltx_theorem_corollary">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmcorollary1.2" class="ltx_text ltx_font_bold">Corollary 1</span></span><span id="Thmcorollary1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmcorollary1.p1" class="ltx_para">
<p id="Thmcorollary1.p1.1" class="ltx_p"><span id="Thmcorollary1.p1.1.1" class="ltx_text ltx_font_italic">An optimal configuration for the Heilbronn problem does not contain two coincident points.</span></p>
</div>
</div>
<div id="Thmcorollary2" class="ltx_theorem ltx_theorem_corollary">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmcorollary2.2" class="ltx_text ltx_font_bold">Corollary 2</span></span><span id="Thmcorollary2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmcorollary2.p1" class="ltx_para">
<p id="Thmcorollary2.p1.1" class="ltx_p"><span id="Thmcorollary2.p1.1.1" class="ltx_text ltx_font_italic">An optimal configuration for the Heilbronn problem does not contain three collinear points.</span></p>
</div>
</div>
</section>
<section id="S2.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">2.2 </span>Boundary structure of optimal configurations</h3>

<div id="S2.SS2.p1" class="ltx_para">
<p id="S2.SS2.p1.1" class="ltx_p">The symmetry breaking of Section <a href="#S3" title="3 Mixed-integer nonlinear optimization models ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> fixes five points on the boundary of the unit square <math id="S2.SS2.p1.m1" class="ltx_Math" alttext="S=[0,1]^{2}" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>=</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">S=[0,1]^{2}</annotation></semantics></math> in a prescribed pattern.
This subsection shows that this is justified.
We first fix notation.
A <em id="S2.SS2.p1.1.1" class="ltx_emph ltx_font_italic">configuration</em> is a set <math id="S2.SS2.p1.m2" class="ltx_Math" alttext="P=\{p_{1},\dots,p_{n}\}\subseteq S" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>p</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>p</mi><mi>n</mi></msub><mo stretchy="false">}</mo></mrow><mo>⊆</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">P=\{p_{1},\dots,p_{n}\}\subseteq S</annotation></semantics></math> of <math id="S2.SS2.p1.m3" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> points.
We let <math id="S2.SS2.p1.m4" class="ltx_Math" alttext="\Delta(P)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>P</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta(P)</annotation></semantics></math> denote the smallest area of a triangle spanned by three points of <math id="S2.SS2.p1.m5" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> and call <math id="S2.SS2.p1.m6" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> <em id="S2.SS2.p1.1.2" class="ltx_emph ltx_font_italic">optimal</em> if <math id="S2.SS2.p1.m7" class="ltx_Math" alttext="\Delta(P)=\Delta_{n}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>P</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi mathvariant="normal">Δ</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\Delta(P)=\Delta_{n}</annotation></semantics></math>.
The objective and the constraints of <math id="S2.SS2.p1.m8" class="ltx_Math" alttext="P_{\Delta}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi mathvariant="normal">Δ</mi></msub><annotation encoding="application/x-tex">P_{\Delta}</annotation></semantics></math> do not depend on the order of the points, but the symmetry breaking of Section <a href="#S3" title="3 Mixed-integer nonlinear optimization models ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> does.
We therefore call a configuration together with a fixed order <math id="S2.SS2.p1.m9" class="ltx_Math" alttext="(p_{1},\dots,p_{n})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>p</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(p_{1},\dots,p_{n})</annotation></semantics></math> of its points a <em id="S2.SS2.p1.1.3" class="ltx_emph ltx_font_italic">labeled configuration</em>, and a change of this order a <em id="S2.SS2.p1.1.4" class="ltx_emph ltx_font_italic">relabeling</em>.
Finally, let</p>
<table id="S2.Ex10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex10.m1" class="ltx_math_unparsed" alttext="K:=\operatorname{conv}(P)=\Bigl\{\sum_{i=1}^{n}\lambda_{i}\,p_{i}\;\Big|\;\lambda_{i}\geq 0,\;\sum_{i=1}^{n}\lambda_{i}=1\Bigr\}" display="block" intent=":literal"><semantics><mrow><mi>K</mi><mo>:=</mo><mi>conv</mi><mrow><mo stretchy="false">(</mo><mi>P</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">{</mo><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><msub><mi>λ</mi><mi>i</mi></msub><msub><mi>p</mi><mi>i</mi></msub><mo fence="false" maxsize="1.600em" minsize="1.600em" rspace="0.447em" stretchy="true">|</mo><msub><mi>λ</mi><mi>i</mi></msub><mo>≥</mo><mn>0</mn><mo rspace="0.280em">,</mo><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><msub><mi>λ</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">K:=\operatorname{conv}(P)=\Bigl\{\sum_{i=1}^{n}\lambda_{i}\,p_{i}\;\Big|\;\lambda_{i}\geq 0,\;\sum_{i=1}^{n}\lambda_{i}=1\Bigr\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS2.p1.2" class="ltx_p">denote its convex hull.
We write <math id="S2.SS2.p1.m10" class="ltx_Math" alttext="A=(0,0)" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">A=(0,0)</annotation></semantics></math>, <math id="S2.SS2.p1.m11" class="ltx_Math" alttext="B=(1,0)" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B=(1,0)</annotation></semantics></math>, <math id="S2.SS2.p1.m12" class="ltx_Math" alttext="C=(1,1)" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C=(1,1)</annotation></semantics></math>, <math id="S2.SS2.p1.m13" class="ltx_Math" alttext="D=(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D=(0,1)</annotation></semantics></math> for the corners of <math id="S2.SS2.p1.m14" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> and <math id="S2.SS2.p1.m15" class="ltx_Math" alttext="\sigma_{\mathrm{b}}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>b</mi></msub><annotation encoding="application/x-tex">\sigma_{\mathrm{b}}</annotation></semantics></math>, <math id="S2.SS2.p1.m16" class="ltx_Math" alttext="\sigma_{\mathrm{r}}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>r</mi></msub><annotation encoding="application/x-tex">\sigma_{\mathrm{r}}</annotation></semantics></math>, <math id="S2.SS2.p1.m17" class="ltx_Math" alttext="\sigma_{\mathrm{t}}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\sigma_{\mathrm{t}}</annotation></semantics></math>, <math id="S2.SS2.p1.m18" class="ltx_Math" alttext="\sigma_{\ell}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi mathvariant="normal">ℓ</mi></msub><annotation encoding="application/x-tex">\sigma_{\ell}</annotation></semantics></math> for its bottom, right, top, and left edge (Figure <a href="#S2.F2" title="Figure 2 ‣ 2.2 Boundary structure of optimal configurations ‣ 2 Original formulation and theoretical results ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>a).</p>
</div>
