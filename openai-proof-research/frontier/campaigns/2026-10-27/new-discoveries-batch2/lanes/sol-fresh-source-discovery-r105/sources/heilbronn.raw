<span id="S5.F5.pic1.1.3.3.1.1.1" class="ltx_p"><span id="S5.F5.pic1.1.3.3.1.1.1.1" class="ltx_text" style="font-size:90%;">• Identify critical triangles and boundary points</span></span>
</span></span></span>
</span>
</span>
</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#595959;--ltx-fill-color:#F5F5F5;" fill="#F5F5F5" stroke="#595959"><path d="M 192.87 -80.74 L -192.87 -80.74 C -199.4 -80.74 -204.69 -86.03 -204.69 -92.55 L -204.69 -150.57 C -204.69 -157.09 -199.4 -162.38 -192.87 -162.38 L 192.87 -162.38 C 199.4 -162.38 204.69 -157.09 204.69 -150.57 L 204.69 -92.55 C 204.69 -86.03 199.4 -80.74 192.87 -80.74 Z M -204.69 -162.38"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -195 -99.08)"><foreignObject style="--ltx-fo-width:30.48em;--ltx-fo-height:0.63em;--ltx-fo-depth:3.88em;font-size:10pt;" height="62.27" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="421.76"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
