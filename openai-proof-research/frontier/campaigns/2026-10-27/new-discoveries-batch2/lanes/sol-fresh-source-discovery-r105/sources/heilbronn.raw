000000" transform="matrix(1.0 0.0 0.0 1.0 78.23 76.3)"><foreignObject style="--ltx-fo-width:0.97em;--ltx-fo-height:0.42em;--ltx-fo-depth:0.19em;font-size:9.25pt;" height="7.78" overflow="visible" transform="matrix(1 0 0 -1 0 5.36)" width="12.44"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F3.pic1.m7" class="ltx_Math" alttext="p_{7}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">p</mi><mn mathsize="0.900em">7</mn></msub><annotation encoding="application/x-tex">p_{7}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-fill-color:#000000;" fill="#000000"><path style="stroke:none" d="M 117.31 61.42 C 117.31 62.6 116.35 63.57 115.16 63.57 C 113.97 63.57 113 62.6 113 61.42 C 113 60.23 113.97 59.26 115.16 59.26 C 116.35 59.26 117.31 60.23 117.31 61.42 Z M 115.16 61.42"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 119.94 59.95)"><foreignObject style="--ltx-fo-width:0.97em;--ltx-fo-height:0.42em;--ltx-fo-depth:0.19em;font-size:9.25pt;" height="7.78" overflow="visible" transform="matrix(1 0 0 -1 0 5.36)" width="12.44"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F3.pic1.m8" class="ltx_Math" alttext="p_{8}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">p</mi><mn mathsize="0.900em">8</mn></msub><annotation encoding="application/x-tex">p_{8}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#B3B3B3;--ltx-fill-color:#B3B3B3;--ltx-fg-color:#B3B3B3;" color="#B3B3B3" fill="#B3B3B3" stroke="#B3B3B3" stroke-dasharray="3.0pt,2.0pt" stroke-dashoffset="0.0pt" stroke-width="0.5pt"><path style="fill:none" d="M 38.39 0 L 38.39 153.54"></path></g><g style="--ltx-stroke-color:#B3B3B3;--ltx-fill-color:#B3B3B3;--ltx-fg-color:#B3B3B3;" color="#B3B3B3" fill="#B3B3B3" stroke="#B3B3B3" stroke-dasharray="3.0pt,2.0pt" stroke-dashoffset="0.0pt" stroke-width="0.5pt"><path style="fill:none" d="M 92.13 153.54 L 92.13 -0"></path></g><g style="--ltx-stroke-color:#A6A6A6;--ltx-fill-color:#A6A6A6;--ltx-fg-color:#A6A6A6;" color="#A6A6A6" fill="#A6A6A6" stroke="#A6A6A6" transform="matrix(1.0 0.0 0.0 1.0 45.23 92.85)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:3.13em;--ltx-fo-height:0.63em;--ltx-fo-depth:0.15em;font-size:9.25pt;" color="#000000" height="10.02" overflow="visible" transform="matrix(1 0 0 -1 0 8.12)" width="40.06"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F3.pic1.m9" class="ltx_Math" alttext="x_{2}\leq x_{4}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#A6A6A6;" mathcolor="#A6A6A6" mathsize="0.900em">x</mi><mn style="--ltx-fg-color:#A6A6A6;" mathcolor="#A6A6A6" mathsize="0.900em">2</mn></msub><mo style="--ltx-fg-color:#A6A6A6;" mathcolor="#A6A6A6" mathsize="0.900em">≤</mo><msub><mi style="--ltx-fg-color:#A6A6A6;" mathcolor="#A6A6A6" mathsize="0.900em">x</mi><mn style="--ltx-fg-color:#A6A6A6;" mathcolor="#A6A6A6" mathsize="0.900em">4</mn></msub></mrow><annotation encoding="application/x-tex">x_{2}\leq x_{4}</annotation></semantics></math></span></span></foreignObject></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 3: </span>Symmetry breaking used in the optimization model.
Five points are fixed on the boundary in counterclockwise order (<math id="S3.F3.m8" class="ltx_Math" alttext="x_{1}=x_{5}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>=</mo><msub><mi>x</mi><mn>5</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">x_{1}=x_{5}=0</annotation></semantics></math>, <math id="S3.F3.m9" class="ltx_Math" alttext="y_{2}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mn>2</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">y_{2}=0</annotation></semantics></math>, <math id="S3.F3.m10" class="ltx_Math" alttext="x_{3}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>3</mn></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">x_{3}=1</annotation></semantics></math>, <math id="S3.F3.m11" class="ltx_Math" alttext="y_{4}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mn>4</mn></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">y_{4}=1</annotation></semantics></math>, with <math id="S3.F3.m12" class="ltx_Math" alttext="y_{1}\leq y_{5}" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mn>1</mn></msub><mo>≤</mo><msub><mi>y</mi><mn>5</mn></msub></mrow><annotation encoding="application/x-tex">y_{1}\leq y_{5}</annotation></semantics></math>), the remaining points are ordered by nondecreasing <math id="S3.F3.m13" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>-coordinate, and additionally <math id="S3.F3.m14" class="ltx_Math" alttext="x_{2}\leq x_{4}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>2</mn></msub><mo>≤</mo><msub><mi>x</mi><mn>4</mn></msub></mrow><annotation encoding="application/x-tex">x_{2}\leq x_{4}</annotation></semantics></math>.</figcaption>
</figure>
<div id="Thmremark4" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmremark4.2" class="ltx_text ltx_font_italic">Remark 4</span></span><span id="Thmremark4.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="Thmremark4.p1" class="ltx_para">
<p id="Thmremark4.p1.1" class="ltx_p">This symmetry-breaking approach also yields correct results for <math id="Thmremark4.p1.m1" class="ltx_Math" alttext="n&lt;5" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>&lt;</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">n&lt;5</annotation></semantics></math>, although the theoretical justification does not stem from Proposition <a href="#Thmproposition2" title="Proposition 2 (Configurations without adjacent corners). ‣ 2.2 Boundary structure of optimal configurations ‣ 2 Original formulation and theoretical results ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>
but from a separate investigation of the cases <math id="Thmremark4.p1.m2" class="ltx_Math" alttext="n=3" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">n=3</annotation></semantics></math> and <math id="Thmremark4.p1.m3" class="ltx_Math" alttext="n=4" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">n=4</annotation></semantics></math>.</p>
</div>
</div>
<figure id="S3.T1" class="ltx_table">
<table id="S3.T1.2" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="S3.T1.2.1" class="ltx_tr">
<th id="S3.T1.2.1.1" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="S3.T1.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math></th>
<th id="S3.T1.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S3.T1.2.1.2.1" class="ltx_text" style="font-size:90%;">5</span></th>
<th id="S3.T1.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S3.T1.2.1.3.1" class="ltx_text" style="font-size:90%;">7</span></th>
<th id="S3.T1.2.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S3.T1.2.1.4.1" class="ltx_text" style="font-size:90%;">8</span></th>
<th id="S3.T1.2.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S3.T1.2.1.5.1" class="ltx_text" style="font-size:90%;">9</span></th>
<th id="S3.T1.2.1.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S3.T1.2.1.6.1" class="ltx_text" style="font-size:90%;">10</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S3.T1.2.2" class="ltx_tr">
<td id="S3.T1.2.2.1" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T1.2.2.1.1" class="ltx_text" style="font-size:90%;">order <math id="S3.T1.m2" class="ltx_Math" alttext="8\cdot n!" display="inline" intent=":literal"><semantics><mrow><mn>8</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>n</mi><mo>!</mo></mrow></mrow><annotation encoding="application/x-tex">8\cdot n!</annotation></semantics></math> of the symmetry group</span></td>
<td id="S3.T1.2.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T1.2.2.2.1" class="ltx_text" style="font-size:90%;">960</span></td>
<td id="S3.T1.2.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T1.2.2.3.1" class="ltx_text" style="font-size:90%;">40,320</span></td>
<td id="S3.T1.2.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T1.2.2.4.1" class="ltx_text" style="font-size:90%;">322,560</span></td>
<td id="S3.T1.2.2.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T1.2.2.5.1" class="ltx_text" style="font-size:90%;">2,903,040</span></td>
<td id="S3.T1.2.2.6" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T1.2.2.6.1" class="ltx_text" style="font-size:90%;">29,030,400</span></td></tr>
<tr id="S3.T1.2.3" class="ltx_tr">
<td id="S3.T1.2.3.1" class="ltx_td ltx_align_center ltx_border_bb"><span id="S3.T1.2.3.1.1" class="ltx_text" style="font-size:90%;">feasible copies of the best-known configuration</span></td>
<td id="S3.T1.2.3.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="S3.T1.2.3.2.1" class="ltx_text" style="font-size:90%;">1</span></td>
<td id="S3.T1.2.3.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="S3.T1.2.3.3.1" class="ltx_text" style="font-size:90%;">3</span></td>
<td id="S3.T1.2.3.4" class="ltx_td ltx_align_center ltx_border_bb"><span id="S3.T1.2.3.4.1" class="ltx_text" style="font-size:90%;">7</span></td>
<td id="S3.T1.2.3.5" class="ltx_td ltx_align_center ltx_border_bb"><span id="S3.T1.2.3.5.1" class="ltx_text" style="font-size:90%;">24</span></td>
<td id="S3.T1.2.3.6" class="ltx_td ltx_align_center ltx_border_bb"><span id="S3.T1.2.3.6.1" class="ltx_text" style="font-size:90%;">8</span></td></tr>
</tbody>
</table>
<figcaption class="ltx_caption ltx_centering" style="font-size:90%;"><span class="ltx_tag ltx_tag_table">Table 1: </span>Number of labeled copies of the best-known configuration that are feasible for the final model <math id="S3.T1.m5" class="ltx_Math" alttext="P^{\star}_{\Delta}" display="inline" intent=":literal"><semantics><msubsup><mi>P</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup><annotation encoding="application/x-tex">P^{\star}_{\Delta}</annotation></semantics></math>, counted in exact arithmetic by applying all eight symmetries of the square and all labelings. For <math id="S3.T1.m6" class="ltx_Math" alttext="n=6" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>6</mn></mrow><annotation encoding="application/x-tex">n=6</annotation></semantics></math> the optimal configurations form a one-parameter family, so the count is infinite.</figcaption>
</figure>
<div id="S3.SS2.SSS2.Px3.p3" class="ltx_para">
<p id="S3.SS2.SSS2.Px3.p3.1" class="ltx_p">The counts in Table <a href="#S3.T1" title="Table 1 ‣ Step 3: Interior point ordering. ‣ 3.2.2 Symmetry breaking ‣ 3.2 Enhancements ‣ 3 Mixed-integer nonlinear optimization models ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> were computed in exact arithmetic. For each of the eight symmetries <math id="S3.SS2.SSS2.Px3.p3.m1" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> of the square, we enumerate all labelings of <math id="S3.SS2.SSS2.Px3.p3.m2" class="ltx_Math" alttext="g(P)" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>P</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">g(P)</annotation></semantics></math>, where <math id="S3.SS2.SSS2.Px3.p3.m3" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> is the best-known configuration, keep those that satisfy all constraints of <math id="S3.SS2.SSS2.Px3.p3.m4" class="ltx_Math" alttext="P^{\star}_{\Delta}" display="inline" intent=":literal"><semantics><msubsup><mi>P</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup><annotation encoding="application/x-tex">P^{\star}_{\Delta}</annotation></semantics></math> (allowing every order among points with equal <math id="S3.SS2.SSS2.Px3.p3.m5" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>-coordinates), and count the distinct labeled configurations. The script is part of the accompanying repository.</p>
</div>
<div id="S3.SS2.SSS2.Px3.p4" class="ltx_para">
<p id="S3.SS2.SSS2.Px3.p4.1" class="ltx_p">The remaining copies have three sources:
(i) the choice of the left edge among the edges carrying two boundary points,
(ii) the choice of <math id="S3.SS2.SSS2.Px3.p4.m1" class="ltx_Math" alttext="p_{2}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mn>2</mn></msub><annotation encoding="application/x-tex">p_{2}</annotation></semantics></math>, <math id="S3.SS2.SSS2.Px3.p4.m2" class="ltx_Math" alttext="p_{3}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mn>3</mn></msub><annotation encoding="application/x-tex">p_{3}</annotation></semantics></math>, or <math id="S3.SS2.SSS2.Px3.p4.m3" class="ltx_Math" alttext="p_{4}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mn>4</mn></msub><annotation encoding="application/x-tex">p_{4}</annotation></semantics></math> when an edge carries a second point, which then joins the points ordered by <math id="S3.SS2.SSS2.Px3.p4.m4" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>-coordinate, and
(iii) ties in an order constraint, including <math id="S3.SS2.SSS2.Px3.p4.m5" class="ltx_Math" alttext="x_{2}\leq x_{4}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>2</mn></msub><mo>≤</mo><msub><mi>x</mi><mn>4</mn></msub></mrow><annotation encoding="application/x-tex">x_{2}\leq x_{4}</annotation></semantics></math>, which otherwise selects one of two mirror images.
All three depend on the boundary structure of the particular configuration, so the counts follow no simple pattern in <math id="S3.SS2.SSS2.Px3.p4.m6" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>.</p>
</div>
<div id="Thmexample1" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmexample1.2" class="ltx_text ltx_font_bold">Example 1</span></span><span id="Thmexample1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmexample1.p1" class="ltx_para">
<p id="Thmexample1.p1.1" class="ltx_p">For <math id="Thmexample1.p1.m1" class="ltx_Math" alttext="n=7" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>7</mn></mrow><annotation encoding="application/x-tex">n=7</annotation></semantics></math>, only source (i) occurs. Three edges carry two points (Table <a href="#S5.T6" title="Table 6 ‣ Step 1: Numerical global optimization ‣ 5.2 Illustration of the methodology for 𝑛=7 ‣ 5 The optimize-then-refine framework ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>): the left edge (<math id="Thmexample1.p1.m2" class="ltx_Math" alttext="(0,0.1352)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0.1352</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0,0.1352)</annotation></semantics></math> and <math id="Thmexample1.p1.m3" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math>), the right edge (<math id="Thmexample1.p1.m4" class="ltx_Math" alttext="(1,0.1808)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>0.1808</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1,0.1808)</annotation></semantics></math> and <math id="Thmexample1.p1.m5" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math>), and the top edge (<math id="Thmexample1.p1.m6" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> and <math id="Thmexample1.p1.m7" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math>). Each of them can become the left edge, which gives the three copies: the solution in Table <a href="#S5.T6" title="Table 6 ‣ Step 1: Numerical global optimization ‣ 5.2 Illustration of the methodology for 𝑛=7 ‣ 5 The optimize-then-refine framework ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a> itself, its reflection <math id="Thmexample1.p1.m8" class="ltx_Math" alttext="(x,y)\mapsto(1-x,y)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">↦</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>x</mi></mrow><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(x,y)\mapsto(1-x,y)</annotation></semantics></math>, and its reflection <math id="Thmexample1.p1.m9" class="ltx_Math" alttext="(x,y)\mapsto(1-y,1-x)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">↦</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>y</mi></mrow><mo>,</mo><mrow><mn>1</mn><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(x,y)\mapsto(1-y,1-x)</annotation></semantics></math> in the anti-diagonal.</p>
</div>
<div id="Thmexample1.p2" class="ltx_para">
<p id="Thmexample1.p2.1" class="ltx_p">For <math id="Thmexample1.p2.m1" class="ltx_Math" alttext="n=9" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>9</mn></mrow><annotation encoding="application/x-tex">n=9</annotation></semantics></math>, all three sources occur. The configuration of Comellas and Yebra (Table <a href="#A1.T12" title="Table 12 ‣ Appendix A Exact coordinates for 5≤𝑛≤10 ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>) carries two points on every edge and is itself symmetric under reflection in the anti-diagonal, so the eight symmetries of the square produce only four different images. In each image, <math id="Thmexample1.p2.m2" class="ltx_Math" alttext="p_{2}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mn>2</mn></msub><annotation encoding="application/x-tex">p_{2}</annotation></semantics></math>, <math id="Thmexample1.p2.m3" class="ltx_Math" alttext="p_{3}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mn>3</mn></msub><annotation encoding="application/x-tex">p_{3}</annotation></semantics></math>, and <math id="Thmexample1.p2.m4" class="ltx_Math" alttext="p_{4}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mn>4</mn></msub><annotation encoding="application/x-tex">p_{4}</annotation></semantics></math> can each be chosen in two ways, which gives <math id="Thmexample1.p2.m5" class="ltx_Math" alttext="2\cdot 2\cdot 2=8" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><mn>2</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><mn>2</mn></mrow><mo>=</mo><mn>8</mn></mrow><annotation encoding="application/x-tex">2\cdot 2\cdot 2=8</annotation></semantics></math> labelings of the boundary pattern (source (ii)). The constraint <math id="Thmexample1.p2.m6" class="ltx_Math" alttext="x_{2}\leq x_{4}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>2</mn></msub><mo>≤</mo><msub><mi>x</mi><mn>4</mn></msub></mrow><annotation encoding="application/x-tex">x_{2}\leq x_{4}</annotation></semantics></math> keeps six of them in two of the images and four in the other two, and in each image two of the kept labelings satisfy <math id="Thmexample1.p2.m7" class="ltx_Math" alttext="x_{2}=x_{4}=\tfrac{3}{8}-\tfrac{\sqrt{65}}{40}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>2</mn></msub><mo>=</mo><msub><mi>x</mi><mn>4</mn></msub><mo>=</mo><mrow><mfrac><mn>3</mn><mn>8</mn></mfrac><mo>−</mo><mfrac><msqrt><mn>65</mn></msqrt><mn>40</mn></mfrac></mrow></mrow><annotation encoding="application/x-tex">x_{2}=x_{4}=\tfrac{3}{8}-\tfrac{\sqrt{65}}{40}</annotation></semantics></math>, so both mirror images pass (source (iii)). In the first two images, two of the remaining points also share an <math id="Thmexample1.p2.m8" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>-coordinate, which doubles two labelings (source (iii)). This gives <math id="Thmexample1.p2.m9" class="ltx_Math" alttext="8+8+4+4=24" display="inline" intent=":literal"><semantics><mrow><mrow><mn>8</mn><mo>+</mo><mn>8</mn><mo>+</mo><mn>4</mn><mo>+</mo><mn>4</mn></mrow><mo>=</mo><mn>24</mn></mrow><annotation encoding="application/x-tex">8+8+4+4=24</annotation></semantics></math> copies.</p>
</div>
</div>
</section>
</section>
<section id="S3.SS2.SSS3" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">3.2.3 </span>Sign fixing</h4>

<div id="S3.SS2.SSS3.p1" class="ltx_para">
<p id="S3.SS2.SSS3.p1.1" class="ltx_p">The boundary pattern allows us to fix the signs for two groups of triangles:</p>
<ol id="S3.I1" class="ltx_enumerate">
<li id="S3.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="S3.I1.i1.p1" class="ltx_para">
<p id="S3.I1.i1.p1.1" class="ltx_p">All triangles in the set <math id="S3.I1.i1.p1.m1" class="ltx_Math" alttext="T^{+}=\{(i,j,k)\in T\mid k\leq 5\}" display="inline" intent=":literal"><semantics><mrow><msup><mi>T</mi><mo>+</mo></msup><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi>T</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>k</mi><mo>≤</mo><mn>5</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">T^{+}=\{(i,j,k)\in T\mid k\leq 5\}</annotation></semantics></math> have their three vertices on the boundary, and <math id="S3.I1.i1.p1.m2" class="ltx_Math" alttext="p_{1},\dots,p_{5}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>p</mi><mn>5</mn></msub></mrow><annotation encoding="application/x-tex">p_{1},\dots,p_{5}</annotation></semantics></math> occur in counterclockwise order along <math id="S3.I1.i1.p1.m3" class="ltx_Math" alttext="\partial S" display="inline" intent=":literal"><semantics><mrow><mo>∂</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">\partial S</annotation></semantics></math>. Since no three points of an optimal configuration are collinear, <math id="S3.I1.i1.p1.m4" class="ltx_Math" alttext="A_{t}^{\pm}&gt;0" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>A</mi><mi>t</mi><mo>±</mo></msubsup><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">A_{t}^{\pm}&gt;0</annotation></semantics></math> for all <math id="S3.I1.i1.p1.m5" class="ltx_Math" alttext="t\in T^{+}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><msup><mi>T</mi><mo>+</mo></msup></mrow><annotation encoding="application/x-tex">t\in T^{+}</annotation></semantics></math>.</p>
</div></li>
<li id="S3.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="S3.I1.i2.p1" class="ltx_para">
<p id="S3.I1.i2.p1.1" class="ltx_p">Since <math id="S3.I1.i2.p1.m1" class="ltx_Math" alttext="p_{1}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mn>1</mn></msub><annotation encoding="application/x-tex">p_{1}</annotation></semantics></math> and <math id="S3.I1.i2.p1.m2" class="ltx_Math" alttext="p_{5}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mn>5</mn></msub><annotation encoding="application/x-tex">p_{5}</annotation></semantics></math> are located on the left edge with <math id="S3.I1.i2.p1.m3" class="ltx_Math" alttext="y_{5}\geq y_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mn>5</mn></msub><mo>≥</mo><msub><mi>y</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">y_{5}\geq y_{1}</annotation></semantics></math>, we have <math id="S3.I1.i2.p1.m4" class="ltx_Math" alttext="A^{\pm}_{15k}=-\tfrac{1}{2}(y_{5}-y_{1})x_{k}\leq 0" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>A</mi><mrow><mn>15</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>±</mo></msubsup><mo>=</mo><mrow><mo>−</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>y</mi><mn>5</mn></msub><mo>−</mo><msub><mi>y</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>k</mi></msub></mrow></mrow><mo>≤</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">A^{\pm}_{15k}=-\tfrac{1}{2}(y_{5}-y_{1})x_{k}\leq 0</annotation></semantics></math> for all <math id="S3.I1.i2.p1.m5" class="ltx_math_unparsed" alttext="t\in T^{-}:=\{(i,j,k)\in T\mid i=1,\ j=5\}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><msup><mi>T</mi><mo>−</mo></msup><mo>:=</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi>T</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>i</mi><mo>=</mo><mn>1</mn><mo rspace="0.667em">,</mo><mi>j</mi><mo>=</mo><mn>5</mn><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">t\in T^{-}:=\{(i,j,k)\in T\mid i=1,\ j=5\}</annotation></semantics></math>.</p>
</div></li>
</ol>
</div>
<div id="S3.SS2.SSS3.p2" class="ltx_para">
<p id="S3.SS2.SSS3.p2.1" class="ltx_p">This allows us to add the constraints</p>
<table id="S3.Ex26" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex26.m1" class="ltx_math_unparsed" alttext="b_{t}=1,\ t\in T^{+}\qquad\text{and}\qquad b_{t}=0,\ t\in T^{-}" display="block" intent=":literal"><semantics><mrow><mi>b</mi><msub><mrow></mrow><mi>t</mi></msub><mo>=</mo><mn>1</mn><mo rspace="0.667em">,</mo><mi>t</mi><mo>∈</mo><mi>T</mi><msup><mrow></mrow><mo>+</mo></msup><mtext>and</mtext><mi>b</mi><msub><mrow></mrow><mi>t</mi></msub><mo>=</mo><mn>0</mn><mo rspace="0.667em">,</mo><mi>t</mi><mo>∈</mo><mi>T</mi><msup><mrow></mrow><mo>−</mo></msup></mrow><annotation encoding="application/x-tex">b_{t}=1,\ t\in T^{+}\qquad\text{and}\qquad b_{t}=0,\ t\in T^{-}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.SSS3.p2.2" class="ltx_p">and thereby fix <math id="S3.SS2.SSS3.p2.m1" class="ltx_Math" alttext="\binom{5}{3}+(n-5)" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mfrac linethickness="0pt"><mn>5</mn><mn>3</mn></mfrac><mo>)</mo></mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>5</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\binom{5}{3}+(n-5)</annotation></semantics></math> binary variables in advance.</p>
</div>
<div id="Thmremark5" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmremark5.2" class="ltx_text ltx_font_italic">Remark 5</span></span><span id="Thmremark5.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="Thmremark5.p1" class="ltx_para">
<p id="Thmremark5.p1.1" class="ltx_p">It is also valid to introduce binary variables only for the triangles whose sign is not fixed and to impose <math id="Thmremark5.p1.m1" class="ltx_Math" alttext="z\leq A^{\pm}_{t}" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>≤</mo><msubsup><mi>A</mi><mi>t</mi><mo>±</mo></msubsup></mrow><annotation encoding="application/x-tex">z\leq A^{\pm}_{t}</annotation></semantics></math> or <math id="Thmremark5.p1.m2" class="ltx_Math" alttext="z\leq-A^{\pm}_{t}" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>≤</mo><mrow><mo>−</mo><msubsup><mi>A</mi><mi>t</mi><mo>±</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">z\leq-A^{\pm}_{t}</annotation></semantics></math> directly for the others. Section <a href="#S4.SS4" title="4.4 Contribution of the model ingredients ‣ 4 Computational study ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.4</span></a> compares both variants.</p>
</div>
</div>
</section>
</section>
<section id="S3.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.3 </span>The final model</h3>

<div id="S3.SS3.p1" class="ltx_para">
<p id="S3.SS3.p1.1" class="ltx_p">Combining all ingredients from the previous subsection we arrive at the formulation <math id="S3.SS3.p1.m1" class="ltx_Math" alttext="P_{\Delta}^{\star}" display="inline" intent=":literal"><semantics><msubsup><mi>P</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup><annotation encoding="application/x-tex">P_{\Delta}^{\star}</annotation></semantics></math> displayed in Figure <a href="#S3.F4" title="Figure 4 ‣ 3.3 The final model ‣ 3 Mixed-integer nonlinear optimization models ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>.
The colored boxes highlight the individual enhancement groups. The core model corresponds to the baseline formulation <math id="S3.SS3.p1.m2" class="ltx_Math" alttext="P_{\Delta}^{0}" display="inline" intent=":literal"><semantics><msubsup><mi>P</mi><mi mathvariant="normal">Δ</mi><mn>0</mn></msubsup><annotation encoding="application/x-tex">P_{\Delta}^{0}</annotation></semantics></math> expressed in the substituted variables.
Unlike <math id="S3.SS3.p1.m3" class="ltx_Math" alttext="P_{\Delta}^{0}" display="inline" intent=":literal"><semantics><msubsup><mi>P</mi><mi mathvariant="normal">Δ</mi><mn>0</mn></msubsup><annotation encoding="application/x-tex">P_{\Delta}^{0}</annotation></semantics></math>, the model <math id="S3.SS3.p1.m4" class="ltx_Math" alttext="P_{\Delta}^{\star}" display="inline" intent=":literal"><semantics><msubsup><mi>P</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup><annotation encoding="application/x-tex">P_{\Delta}^{\star}</annotation></semantics></math> is not equivalent to <math id="S3.SS3.p1.m5" class="ltx_Math" alttext="P_{\Delta}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi mathvariant="normal">Δ</mi></msub><annotation encoding="application/x-tex">P_{\Delta}</annotation></semantics></math>. It is a restriction to labeled configurations of type I, so its optimal value is at most <math id="S3.SS3.p1.m6" class="ltx_Math" alttext="\Delta_{n}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\Delta_{n}</annotation></semantics></math>. By Theorem <a href="#Thmtheorem1" title="Theorem 1 (Structure of optimal configurations). ‣ 2.2 Boundary structure of optimal configurations ‣ 2 Original formulation and theoretical results ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, <math id="S3.SS3.p1.m7" class="ltx_Math" alttext="\Delta_{n}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\Delta_{n}</annotation></semantics></math> is attained by <math id="S3.SS3.p1.m8" class="ltx_Math" alttext="P_{\Delta}^{\star}" display="inline" intent=":literal"><semantics><msubsup><mi>P</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup><annotation encoding="application/x-tex">P_{\Delta}^{\star}</annotation></semantics></math> or by one of the variants of Section <a href="#S3.SS4" title="3.4 Variants for the types II and III ‣ 3 Mixed-integer nonlinear optimization models ‣ From Global Optimization to Exact Coordinates:Heilbronn’s Triangle Problem on the Unit SquareUsing Mixed-Integer Nonlinear Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.4</span></a>.</p>
</div>
<figure id="S3.F4" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_1">
<table id="S3.EGx2" class="ltx_equationgroup ltx_centering ltx_eqn_align ltx_figure_panel ltx_eqn_table">

<tbody id="S3.Ex27"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex27.m1" class="ltx_math_unparsed" alttext="\displaystyle P_{\Delta}^{\star}:\qquad\max_{z,x,y}\quad" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><msub><mrow></mrow><mi mathvariant="normal">Δ</mi></msub><msup><mrow></mrow><mo>⋆</mo></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mi>max</mi><msub><mrow></mrow><mrow><mi>z</mi><mo>,</mo><mi>x</mi><mo>,</mo><mi>y</mi></mrow></msub><mspace style="width:1.167em;" width="1.167em"></mspace></mrow><annotation encoding="application/x-tex">\displaystyle P_{\Delta}^{\star}:\qquad\max_{z,x,y}\quad</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex27.m2" class="ltx_Math" alttext="\displaystyle z" display="inline" intent=":literal"><semantics><mi>z</mi><annotation encoding="application/x-tex">\displaystyle z</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex28"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><span id="S3.Ex28.1.1" class="ltx_text ltx_markedasmath">s.t.</span></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex28.m2" class="ltx_Math" alttext="\displaystyle\hbox to0pt{\vbox to0pt{\pgfpicture\makeatletter\hbox{\hskip 0.0pt\lower 0.0pt\hbox to0.0pt{\lxSVG@begingroup@{_scopebegin=1} \lxSVG@begingroup@{stroke=#000000} \lxSVG@begingroup@{fill=#000000} \lxSVG@setlinewidth{\the\pgflinewidth}\lxSVG@begingroup@{stroke-width=0.4pt} \lx@inpgf@ignorespaces\nullfont\lxSVG@begingroup@{_scopebegin=1} \lxSVG@closescope \hbox to0.0pt{\lxSVG@begingroup@{_scopebegin=1} {{}}\lx@inpgf@ignorespaces\hbox{\hbox{{\lxSVG@begingroup@{_scopebegin=1} {{}{{}}{}{}}
\lxSVG@closescope }}}
\lxSVG@closescope \hbox to0.0pt{}{\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}\hss}\lxSVG@discardpath\lxSVG@closescope \hss}}\lxSVG@closescope\endpgfpicture}}(x_{i},y_{i})\in[0,1]^{2},\quad i\in I," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mtext> <svg height="1" overflow="visible" version="1.1" viewBox="0 0 1 1" width="1"> <g transform="translate(0,1) matrix(1 0 0 -1 0 0)"></g> </svg> </mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup></mrow><mo rspace="1.167em">,</mo><mrow><mi>i</mi><mo>∈</mo><mi>I</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\hbox to0pt{\vbox to0pt{\pgfpicture\makeatletter\hbox{\hskip 0.0pt\lower 0.0pt\hbox to0.0pt{\lxSVG@begingroup@{_scopebegin=1} \lxSVG@begingroup@{stroke=#000000} \lxSVG@begingroup@{fill=#000000} \lxSVG@setlinewidth{\the\pgflinewidth}\lxSVG@begingroup@{stroke-width=0.4pt} \lx@inpgf@ignorespaces\nullfont\lxSVG@begingroup@{_scopebegin=1} \lxSVG@closescope \hbox to0.0pt{\lxSVG@begingroup@{_scopebegin=1} {{}}\lx@inpgf@ignorespaces\hbox{\hbox{{\lxSVG@begingroup@{_scopebegin=1} {{}{{}}{}{}}
\lxSVG@closescope }}}
\lxSVG@closescope \hbox to0.0pt{}{\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}\hss}\lxSVG@discardpath\lxSVG@closescope \hss}}\lxSVG@closescope\endpgfpicture}}(x_{i},y_{i})\in[0,1]^{2},\quad i\in I,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex29"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex29.m1" class="ltx_Math" alttext="\displaystyle A_{ijk}^{\pm}\ =\ \frac{1}{2}\left(w_{ij}+w_{jk}+w_{ki}-w_{ik}-w_{ji}-w_{kj}\right),\quad(i,j,k)\in T" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>A</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>±</mo></msubsup><mo lspace="0.778em" rspace="0.778em">=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>w</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>+</mo><msub><mi>w</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo>+</mo><msub><mi>w</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub></mrow><mo>−</mo><msub><mi>w</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo>−</mo><msub><mi>w</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo>−</mo><msub><mi>w</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow><mo>)</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi>T</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle A_{ijk}^{\pm}\ =\ \frac{1}{2}\left(w_{ij}+w_{jk}+w_{ki}-w_{ik}-w_{ji}-w_{kj}\right),\quad(i,j,k)\in T</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex30"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
