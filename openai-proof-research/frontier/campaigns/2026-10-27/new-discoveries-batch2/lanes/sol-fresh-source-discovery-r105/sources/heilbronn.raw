<td id="S4.T5.2.2.3" class="ltx_td ltx_align_left ltx_border_t"><span id="S4.T5.2.2.3.1" class="ltx_text" style="font-size:90%;">2 <math id="S4.T5.m1" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math> 48-core Xeon Gold 6248R</span></td>
<td id="S4.T5.2.2.4" class="ltx_td ltx_align_right ltx_border_t"><math id="S4.T5.m2" class="ltx_Math" alttext="318+82{,}359+35+633" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.900em">318</mn><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">82,359</mn><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">35</mn><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">633</mn></mrow><annotation encoding="application/x-tex">318+82{,}359+35+633</annotation></semantics></math></td></tr>
