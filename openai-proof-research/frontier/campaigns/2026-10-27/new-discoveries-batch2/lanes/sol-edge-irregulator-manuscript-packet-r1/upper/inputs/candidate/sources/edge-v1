</mi></mrow></mrow><annotation encoding="application/x-tex">\leq 5\,\mathrm{vc}</annotation></semantics></math></span></span></foreignObject></g></g></g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 223.75 137.02)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 22.14)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 8.65)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 11.08 0)"><foreignObject style="--ltx-fo-width:6.37em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.19em;font-size:9.25pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="81.52"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F2.pic1.3" class="ltx_text" style="font-size:90%;">All neighbours</span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 19.72)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:5.48em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.19em;font-size:9.25pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="70.09"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F2.pic1.4" class="ltx_text" style="font-size:90%;">have degree </span><math id="S3.F2.pic1.m5" class="ltx_Math" alttext="&gt;5\,\mathrm{vc}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo mathsize="0.900em">&gt;</mo><mrow><mn mathsize="0.900em">5</mn><mo lspace="0.170em" rspace="0em">​</mo><mi mathsize="0.900em">vc</mi></mrow></mrow><annotation encoding="application/x-tex">&gt;5\,\mathrm{vc}</annotation></semantics></math></span></span></foreignObject></g></g></g></g><g stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" stroke-width="0.8pt"><path style="fill:none" d="M 19.69 118.11 M 46.62 44.12 C 138.56 77.58 201.04 137.84 186.17 178.71 C 171.29 219.57 84.7 225.57 -7.25 192.1 C -99.19 158.64 -161.67 98.38 -146.8 57.52 C -131.92 16.65 -45.33 10.65 46.62 44.12 Z M 19.69 118.11"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -47.39 193.29)"><foreignObject style="--ltx-fo-width:1.25em;--ltx-fo-height:0.66em;--ltx-fo-depth:0.11em;font-size:9.25pt;" height="9.89" overflow="visible" transform="matrix(1 0 0 -1 0 8.51)" width="16.04"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F2.pic1.m6" class="ltx_Math" alttext="G_{1}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">G</mi><mn mathsize="0.900em">1</mn></msub><annotation encoding="application/x-tex">G_{1}</annotation></semantics></math></span></span></foreignObject></g><g stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" stroke-width="0.8pt"><path style="fill:none" d="M 216.54 118.11 M 243.47 192.1 C 151.52 225.57 64.93 219.57 50.05 178.71 C 35.18 137.84 97.66 77.58 189.6 44.12 C 281.55 10.65 368.14 16.65 383.02 57.52 C 397.89 98.38 335.41 158.64 243.47 192.1 Z M 216.54 118.11"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 267.57 193.29)"><foreignObject style="--ltx-fo-width:1.25em;--ltx-fo-height:0.66em;--ltx-fo-depth:0.11em;font-size:9.25pt;" height="9.89" overflow="visible" transform="matrix(1 0 0 -1 0 8.51)" width="16.04"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F2.pic1.m7" class="ltx_Math" alttext="G_{2}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">G</mi><mn mathsize="0.900em">2</mn></msub><annotation encoding="application/x-tex">G_{2}</annotation></semantics></math></span></span></foreignObject></g></g></g></svg></span>
