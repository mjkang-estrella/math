{2}+\omega_{3}^{2})+3(n-1)\omega_{1}\omega_{3}\right)\right)," display="block"><mrow><mrow><msub><mi href="./23.10#iii.p1" title="coefficients">A</mi><mi href="./23.1#t1.r2" title="integer">n</mi></msub><mo>=</mo><mrow><msup><mrow><mo>(</mo><mfrac><mrow><msup><mi href="./3.12#E1" title="the ratio of the circumference of a circle to its diameter">π</mi><mn>2</mn></msup><mo>⁢</mo><msup><mi href="./23.10#iii.p3" title="𝐺">G</mi><mn>2</mn></msup></mrow><msub><mi href="./23.1#t1.r8" title="lattice generators">ω</mi><mn>1</mn></msub></mfrac><mo>)</mo></mrow><mrow><msup><mi href="./23.1#t1.r2" title="integer">n</mi><mn>2</mn></msup><mo>−</mo><mn>1</mn></mrow></msup><mo>⁢</mo><mfrac><msup><mi href="./23.1#t1.r12" title="nome">q</mi><mrow><mrow><mi href="./23.1#t1.r2" title="integer">n</mi><mo>⁢</mo><mrow><mo stretchy="false">(</mo><mrow><mi href="./23.1#t1.r2" title="integer">n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mn>2</mn></mrow></msup><msup><mi href="./1.9#E1" mathvariant="normal" title="imaginary unit">i</mi><mrow><mi href="./23.1#t1.r2" title="integer">n</mi><mo>−</mo><mn>1</mn></mrow></msup></mfrac><mo lspace="0.167em">⁢</mo><mrow><mi href="./4.2#E19" title="exponential function">exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mrow><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mi href="./23.1#t1.r2" title="integer">n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>⁢</mo><msub><mi href="./23.2#iii.p2" title="complex number">η</mi><mn>1</mn></msub></mrow><mrow><mn>3</mn><mo>⁢</mo><msub><mi href="./23.1#t1.r8" title="lattice generators">ω</mi><mn>1</mn></msub></mrow></mfrac><mo>⁢</mo><mrow><mo>(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo>⁢</mo><mi href="./23.1#t1.r2" title="integer">n</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>⁢</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi href="./23.1#t1.r8" title="lattice generators">ω</mi><mn>1</mn><mn>2</mn></msubsup><mo>+</mo><msubsup><mi href="./23.1#t1.r8" title="lattice generators">ω</mi><mn>3</mn><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mn>3</mn><mo>⁢</mo><mrow><mo stretchy="false">(</mo><mrow><mi href="./23.1#t1.r2" title="integer">n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>⁢</mo><msub><mi href="./23.1#t1.r8" title="lattice generators">ω</mi><mn>1</mn></msub><mo>⁢</mo><msub><mi href="./23.1#t1.r8" title="lattice generators">ω</mi><mn>3</mn></msub></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow></math></td>
