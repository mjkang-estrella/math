x-y\right)+\sigma\left(v+x\right)\sigma\left(v-x\right)\sigma\left(u+y\right)%
\sigma\left(u-y\right)+{\sigma\left(x+u\right)\sigma\left(x-u\right)\sigma%
\left(v+y\right)\sigma\left(v-y\right)=0.}" display="block"><mrow><mtable align="baseline 1" columnalign="left" displaystyle="true"><mtr><mtd class="ltx_align_left"><mrow><mtable align="baseline 1" columnalign="left" displaystyle="true"><mtr><mtd class="ltx_align_left"><mrow><mrow><mi href="./23.2#E6" title="Weierstrass sigma function">σ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>u</mi><mo>+</mo><mi>v</mi></mrow><mo>)</mo></mrow></mrow><mo>⁢</mo><mrow><mi href="./23.2#E6" title="Weierstrass sigma function">σ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>u</mi><mo>−</mo><mi>v</mi></mrow><mo>)</mo></mrow></mrow><mo>⁢</mo><mrow><mi href="./23.2#E6" title="Weierstrass sigma function">σ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi href="./23.1#t1.r4" title="real part of 𝑧">x</mi><mo>+</mo><mi href="./23.1#t1.r4" title="imaginary part of 𝑧">y</mi></mrow><mo>)</mo></mrow></mrow><mo>⁢</mo><mrow><mi href="./23.2#E6" title="Weierstrass sigma function">σ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi href="./23.1#t1.r4" title="real part of 𝑧">x</mi><mo>−</mo><mi href="./23.1#t1.r4" title="imaginary part of 𝑧">y</mi></mrow><mo>)</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left"><mspace style="width:2em;" width="2em"></mspace><mo>+</mo><mrow><mrow><mi href="./23.2#E6" title="Weierstrass sigma function">σ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>v</mi><mo>+</mo><mi href="./23.1#t1.r4" title="real part of 𝑧">x</mi></mrow><mo>)</mo></mrow></mrow><mo>⁢</mo><mrow><mi href="./23.2#E6" title="Weierstrass sigma function">σ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>v</mi><mo>−</mo><mi href="./23.1#t1.r4" title="real part of 𝑧">x</mi></mrow><mo>)</mo></mrow></mrow><mo>⁢</mo><mrow><mi href="./23.2#E6" title="Weierstrass sigma function">σ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>u</mi><mo>+</mo><mi href="./23.1#t1.r4" title="imaginary part of 𝑧">y</mi></mrow><mo>)</mo></mrow></mrow><mo>⁢</mo><mrow><mi href="./23.2#E6" title="Weierstrass sigma function">σ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>u</mi><mo>−</mo><mi href="./23.1#t1.r4" title="imaginary part of 𝑧">y</mi></mrow><mo>)</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left"><mspace style="width:2em;" width="2em"></mspace><mo>+</mo><mrow><mrow><mi href="./23.2#E6" title="Weierstrass sigma function">σ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi href="./23.1#t1.r4" title="real part of 𝑧">x</mi><mo>+</mo><mi>u</mi></mrow><mo>)</mo></mrow></mrow><mo>⁢</mo><mrow><mi href="./23.2#E6" title="Weierstrass sigma function">σ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi href="./23.1#t1.r4" title="real part of 𝑧">x</mi><mo>−</mo><mi>u</mi></mrow><mo>)</mo></mrow></mrow><mo>⁢</mo><mrow><mi href="./23.2#E6" title="Weierstrass sigma function">σ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>v</mi><mo>+</mo><mi href="./23.1#t1.r4" title="imaginary part of 𝑧">y</mi></mrow><mo>)</mo></mrow></mrow><mo>⁢</mo><mrow><mi href="./23.2#E6" title="Weierstrass sigma function">σ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>v</mi><mo>−</mo><mi href="./23.1#t1.r4" title="imaginary part of 𝑧">y</mi></mrow><mo>)</mo></mrow></mrow></mrow></mtd></mtr></mtable></mrow></mtd></mtr><mtr><mtd class="ltx_align_left"><mspace style="width:2em;" width="2em"></mspace><mo>=</mo><mn>0</mn><mo lspace="0em">.</mo></mtd></mtr></mtable></mrow></math></td>
