<p class="ltx_p">More generally, if <math class="ltx_Math" altimg="m55.png" altimg-height="22px" altimg-valign="-6px" altimg-width="91px" alttext="j=1,2,3" display="inline"><mrow><mi>j</mi><mo>=</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>3</mn></mrow></mrow></math>, <math class="ltx_Math" altimg="m57.png" altimg-height="22px" altimg-valign="-6px" altimg-width="93px" alttext="k=1,2,3" display="inline"><mrow><mi href="./23.6#ii.p1" title="modulus">k</mi><mo>=</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>3</mn></mrow></mrow></math>, <math class="ltx_Math" altimg="m56.png" altimg-height="22px" altimg-valign="-6px" altimg-width="53px" alttext="j\neq k" display="inline"><mrow><mi>j</mi><mo>≠</mo><mi href="./23.6#ii.p1" title="modulus">k</mi></mrow></math>, and <math class="ltx_Math" altimg="m59.png" altimg-height="22px" altimg-valign="-6px" altimg-width="83px" alttext="m,n\in\mathbb{Z}" display="inline"><mrow><mrow><mi href="./23.1#t1.r3" title="integer">m</mi><mo>,</mo><mi href="./23.1#t1.r2" title="integer">n</mi></mrow><mo href="./front/introduction#common.t1.r10" title="element of">∈</mo><mi href="./front/introduction#common.t2.r20" title="set of all integers">ℤ</mi></mrow></math>, then</p>
<div class="ltx_equation_container">
<table id="E17" class="ltx_equation ltx_eqn_table">

<tbody>
<tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">23.2.17</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math class="ltx_Math" altimg="E17.png" altimg-height="57px" altimg-valign="-8px" altimg-width="751px" alttext="\ifrac{\sigma\left(z+2m\omega_{j}+2n\omega_{k}\right)}{\sigma\left(z\right)}=(%
-1)^{m+n+mn}\exp\left((2m\eta_{j}+2n\eta_{k})(m\omega_{j}+n\omega_{k}+z)\right)." display="block"><mrow><mrow><mrow><mrow><mi href="./23.2#E6" title="Weierstrass sigma function">σ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi href="./23.1#t1.r4" title="complex">z</mi><mo>+</mo><mrow><mn>2</mn><mo>⁢</mo><mi href="./23.1#t1.r3" title="integer">m</mi><mo>⁢</mo><msub><mi href="./23.1#t1.r8" title="lattice generators">ω</mi><mi>j</mi></msub></mrow><mo>+</mo><mrow><mn>2</mn><mo>⁢</mo><mi href="./23.1#t1.r2" title="integer">n</mi><mo>⁢</mo><msub><mi href="./23.1#t1.r8" title="lattice generators">ω</mi><mi href="./23.6#ii.p1" title="modulus">k</mi></msub></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em" stretchy="true" symmetric="true">/</mo><mrow><mi href="./23.2#E6" title="Weierstrass sigma function">σ</mi><mo>⁡</mo><mrow><mo>(</mo><mi href="./23.1#t1.r4" title="complex">z</mi><mo>)</mo></mrow></mrow></mrow><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi href="./23.1#t1.r3" title="integer">m</mi><mo>+</mo><mi href="./23.1#t1.r2" title="integer">n</mi><mo>+</mo><mrow><mi href="./23.1#t1.r3" title="integer">m</mi><mo>⁢</mo><mi href="./23.1#t1.r2" title="integer">n</mi></mrow></mrow></msup><mo lspace="0.167em">⁢</mo><mrow><mi href="./4.2#E19" title="exponential function">exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo>⁢</mo><mi href="./23.1#t1.r3" title="integer">m</mi><mo>⁢</mo><msub><mi href="./23.2#iii.p2" title="complex number">η</mi><mi>j</mi></msub></mrow><mo>+</mo><mrow><mn>2</mn><mo>⁢</mo><mi href="./23.1#t1.r2" title="integer">n</mi><mo>⁢</mo><msub><mi href="./23.2#iii.p2" title="complex number">η</mi><mi href="./23.6#ii.p1" title="modulus">k</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>⁢</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi href="./23.1#t1.r3" title="integer">m</mi><mo>⁢</mo><msub><mi href="./23.1#t1.r8" title="lattice generators">ω</mi><mi>j</mi></msub></mrow><mo>+</mo><mrow><mi href="./23.1#t1.r2" title="integer">n</mi><mo>⁢</mo><msub><mi href="./23.1#t1.r8" title="lattice generators">ω</mi><mi href="./23.6#ii.p1" title="modulus">k</mi></msub></mrow><mo>+</mo><mi href="./23.1#t1.r4" title="complex">z</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
</tr>
