{1}{z-w}+\frac{1}{w}+\frac{z}{w^{2}}\right)," display="block"><mrow><mrow><mrow><mi href="./23.2#E5" title="Weierstrass zeta function">ζ</mi><mo>⁡</mo><mrow><mo>(</mo><mi href="./23.1#t1.r4" title="complex">z</mi><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mi href="./23.1#t1.r4" title="complex">z</mi></mfrac><mo rspace="0.055em">+</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>w</mi><mo href="./front/introduction#common.t1.r10" title="element of">∈</mo><mrow><mi href="./23.1#t1.r1" title="lattice">𝕃</mi><mo href="./front/introduction#common.t2.r19" title="set subtraction">∖</mo><mrow><mo stretchy="false">{</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></mrow></mrow></munder><mrow><mo>(</mo><mrow><mfrac><mn>1</mn><mrow><mi href="./23.1#t1.r4" title="complex">z</mi><mo>−</mo><mi>w</mi></mrow></mfrac><mo>+</mo><mfrac><mn>1</mn><mi>w</mi></mfrac><mo>+</mo><mfrac><mi href="./23.1#t1.r4" title="complex">z</mi><msup><mi>w</mi><mn>2</mn></msup></mfrac></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow></math></td>
