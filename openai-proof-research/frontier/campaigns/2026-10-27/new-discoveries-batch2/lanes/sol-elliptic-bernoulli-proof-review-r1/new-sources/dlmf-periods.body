<td class="ltx_eqn_cell ltx_align_center"><math class="ltx_Math" altimg="E4.png" altimg-height="108px" altimg-valign="-33px" altimg-width="375px" alttext="\wp\left(z\right)=\frac{1}{z^{2}}+\sum_{w\in\mathbb{L}\setminus\{0\}}\left(%
\frac{1}{(z-w)^{2}}-\frac{1}{w^{2}}\right)," display="block"><mrow><mrow><mrow><mi href="./23.2#E4" mathvariant="normal" title="Weierstrass ℘-function">℘</mi><mo>⁡</mo><mrow><mo>(</mo><mi href="./23.1#t1.r4" title="complex">z</mi><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><msup><mi href="./23.1#t1.r4" title="complex">z</mi><mn>2</mn></msup></mfrac><mo rspace="0.055em">+</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>w</mi><mo href="./front/introduction#common.t1.r10" title="element of">∈</mo><mrow><mi href="./23.1#t1.r1" title="lattice">𝕃</mi><mo href="./front/introduction#common.t2.r19" title="set subtraction">∖</mo><mrow><mo stretchy="false">{</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></mrow></mrow></munder><mrow><mo>(</mo><mrow><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mi href="./23.1#t1.r4" title="complex">z</mi><mo>−</mo><mi>w</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac><mo>−</mo><mfrac><mn>1</mn><msup><mi>w</mi><mn>2</mn></msup></mfrac></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
</tr>
