<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">23.8.6</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math class="ltx_Math" altimg="E6.png" altimg-height="164px" altimg-valign="-28px" altimg-width="445px" alttext="\sigma\left(z\right)=\frac{2\omega_{1}}{\pi}\exp\left(\frac{\eta_{1}z^{2}}{2%
\omega_{1}}\right)\sin\left(\frac{\pi z}{2\omega_{1}}\right)\*\prod_{n=1}^{%
\infty}\frac{1-2q^{2n}\cos\left(\pi z/\omega_{1}\right)+q^{4n}}{(1-q^{2n})^{2}}," display="block"><mrow><mrow><mrow><mi href="./23.2#E6" title="Weierstrass sigma function">σ</mi><mo>⁡</mo><mrow><mo>(</mo><mi href="./23.1#t1.r4" title="complex">z</mi><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mrow><mn>2</mn><mo>⁢</mo><msub><mi href="./23.1#t1.r8" title="lattice generators">ω</mi><mn>1</mn></msub></mrow><mi href="./3.12#E1" title="the ratio of the circumference of a circle to its diameter">π</mi></mfrac><mo lspace="0.167em">⁢</mo><mrow><mi href="./4.2#E19" title="exponential function">exp</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><msub><mi href="./23.2#iii.p2" title="complex number">η</mi><mn>1</mn></msub><mo>⁢</mo><msup><mi href="./23.1#t1.r4" title="complex">z</mi><mn>2</mn></msup></mrow><mrow><mn>2</mn><mo>⁢</mo><msub><mi href="./23.1#t1.r8" title="lattice generators">ω</mi><mn>1</mn></msub></mrow></mfrac><mo>)</mo></mrow></mrow><mo lspace="0.167em">⁢</mo><mrow><mi href="./4.14#E1" title="sine function">sin</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><mi href="./3.12#E1" title="the ratio of the circumference of a circle to its diameter">π</mi><mo>⁢</mo><mi href="./23.1#t1.r4" title="complex">z</mi></mrow><mrow><mn>2</mn><mo>⁢</mo><msub><mi href="./23.1#t1.r8" title="lattice generators">ω</mi><mn>1</mn></msub></mrow></mfrac><mo>)</mo></mrow></mrow><mo>⁢</mo><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi href="./23.1#t1.r2" title="integer">n</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mfrac><mrow><mrow><mn>1</mn><mo>−</mo><mrow><mn>2</mn><mo>⁢</mo><msup><mi href="./23.1#t1.r12" title="nome">q</mi><mrow><mn>2</mn><mo>⁢</mo><mi href="./23.1#t1.r2" title="integer">n</mi></mrow></msup><mo lspace="0.167em">⁢</mo><mrow><mi href="./4.14#E2" title="cosine function">cos</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mi href="./3.12#E1" title="the ratio of the circumference of a circle to its diameter">π</mi><mo>⁢</mo><mi href="./23.1#t1.r4" title="complex">z</mi></mrow><mo>/</mo><msub><mi href="./23.1#t1.r8" title="lattice generators">ω</mi><mn>1</mn></msub></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>+</mo><msup><mi href="./23.1#t1.r12" title="nome">q</mi><mrow><mn>4</mn><mo>⁢</mo><mi href="./23.1#t1.r2" title="integer">n</mi></mrow></msup></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi href="./23.1#t1.r12" title="nome">q</mi><mrow><mn>2</mn><mo>⁢</mo><mi href="./23.1#t1.r2" title="integer">n</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mrow></mrow></mrow><mo>,</mo></mrow></math></td>
