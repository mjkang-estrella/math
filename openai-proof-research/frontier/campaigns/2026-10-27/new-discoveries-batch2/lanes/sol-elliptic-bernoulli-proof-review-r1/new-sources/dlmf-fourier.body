<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">23.8.7</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_Math ltx_eqn_cell ltx_align_center"><math class="ltx_Math" alttext="\sigma\left(z\right)=\frac{2\omega_{1}}{\pi}\exp\left(\frac{\eta_{1}z^{2}}{2%
\omega_{1}}\right)\sin\left(\frac{\pi z}{2\omega_{1}}\right)\prod_{n=1}^{%
\infty}\frac{\sin\left(\pi(2n\omega_{3}+z)/(2\omega_{1})\right)\sin\left(\pi(2%
n\omega_{3}-z)/(2\omega_{1})\right)}{{\sin}^{2}\left(\pi n\omega_{3}/\omega_{1%
}\right)}." display="block"><mrow><mrow><mi href="./23.2#E6" title="Weierstrass sigma function">σ</mi><mo>⁡</mo><mrow><mo>(</mo><mi href="./23.1#t1.r4" title="complex">z</mi><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mtable align="baseline 1" columnalign="left" displaystyle="true"><mtr><mtd class="ltx_align_left"><mfrac><mrow><mn>2</mn><mo>⁢</mo><msub><mi href="./23.1#t1.r8" title="lattice generators">ω</mi><mn>1</mn></msub></mrow><mi href="./3.12#E1" title="the ratio of the circumference of a circle to its diameter">π</mi></mfrac><mo lspace="0.167em">⁢</mo><mrow><mi href="./4.2#E19" title="exponential function">exp</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><msub><mi href="./23.2#iii.p2" title="complex number">η</mi><mn>1</mn></msub><mo>⁢</mo><msup><mi href="./23.1#t1.r4" title="complex">z</mi><mn>2</mn></msup></mrow><mrow><mn>2</mn><mo>⁢</mo><msub><mi href="./23.1#t1.r8" title="lattice generators">ω</mi><mn>1</mn></msub></mrow></mfrac><mo>)</mo></mrow></mrow><mo lspace="0.167em">⁢</mo><mrow><mi href="./4.14#E1" title="sine function">sin</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><mi href="./3.12#E1" title="the ratio of the circumference of a circle to its diameter">π</mi><mo>⁢</mo><mi href="./23.1#t1.r4" title="complex">z</mi></mrow><mrow><mn>2</mn><mo>⁢</mo><msub><mi href="./23.1#t1.r8" title="lattice generators">ω</mi><mn>1</mn></msub></mrow></mfrac><mo>)</mo></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left"><mspace style="width:2em;" width="2em"></mspace><mo>×</mo><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi href="./23.1#t1.r2" title="integer">n</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mfrac><mrow><mrow><mi href="./4.14#E1" title="sine function">sin</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mi href="./3.12#E1" title="the ratio of the circumference of a circle to its diameter">π</mi><mo>⁢</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo>⁢</mo><mi href="./23.1#t1.r2" title="integer">n</mi><mo>⁢</mo><msub><mi href="./23.1#t1.r8" title="lattice generators">ω</mi><mn>3</mn></msub></mrow><mo>+</mo><mi href="./23.1#t1.r4" title="complex">z</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo>⁢</mo><msub><mi href="./23.1#t1.r8" title="lattice generators">ω</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0.167em">⁢</mo><mrow><mi href="./4.14#E1" title="sine function">sin</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mi href="./3.12#E1" title="the ratio of the circumference of a circle to its diameter">π</mi><mo>⁢</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo>⁢</mo><mi href="./23.1#t1.r2" title="integer">n</mi><mo>⁢</mo><msub><mi href="./23.1#t1.r8" title="lattice generators">ω</mi><mn>3</mn></msub></mrow><mo>−</mo><mi href="./23.1#t1.r4" title="complex">z</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo>⁢</mo><msub><mi href="./23.1#t1.r8" title="lattice generators">ω</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mrow><msup><mi href="./4.14#E1" title="sine function">sin</mi><mn>2</mn></msup><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mi href="./3.12#E1" title="the ratio of the circumference of a circle to its diameter">π</mi><mo>⁢</mo><mi href="./23.1#t1.r2" title="integer">n</mi><mo>⁢</mo><msub><mi href="./23.1#t1.r8" title="lattice generators">ω</mi><mn>3</mn></msub></mrow><mo>/</mo><msub><mi href="./23.1#t1.r8" title="lattice generators">ω</mi><mn>1</mn></msub></mrow><mo>)</mo></mrow></mrow></mfrac></mrow><mo lspace="0em">.</mo></mtd></mtr></mtable></mrow></mrow></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
</tr>
