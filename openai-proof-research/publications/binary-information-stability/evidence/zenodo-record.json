      },
      {
        "reference": "NIST Digital Library of Mathematical Functions, Section 4.36, equation 4.36.3."
      },
      {
        "reference": "OpenAI, Sharp binary-information contraction on the discrete cube, September 24, 2026. Repository revision fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb. Pinned manuscript source."
